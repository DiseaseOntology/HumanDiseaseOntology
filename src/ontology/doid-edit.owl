# Class: obo:DOID_0050516 (O'nyong-nyong fever)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(dc:type obo:ECO_0007646) Annotation(oboInOwl:hasDbXref "url:http://books.google.com/books?id=VS5bqBQ9RWoC&pg=PA21&lpg#v=onepage&q&f=false") Annotation(oboInOwl:hasDbXref "url:https://doi.org/10.1016/0035-9203(60)90025-0") Annotation(oboInOwl:hasDbXref "url:https://ph.health.mil/PHC%20Resource%20Library/Onyong-nyongVirus_FS_18-087-0517.pdf") Annotation(oboInOwl:hasDbXref "url:https://pmc.ncbi.nlm.nih.gov/articles/PMC3293492/") Annotation(oboInOwl:hasDbXref "url:https://pmc.ncbi.nlm.nih.gov/articles/PMC5694854/") obo:IAO_0000115 obo:DOID_0050516 "A viral infectious disease that results_in infection located_in joint, has_material_basis_in Onyong-nyong virus (Alphavirus onyong), which is transmitted_by Anopheles gambiae, and transmitted_by Anopheles funestus mosquitoes. The infection has_symptom fever, has_symptom arthralgia, has_symptom rash, and has_symptom lymphadenitis.")
