# Class: obo:DOID_3732 (obsolete bovine respiratory disease complex)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://merckvetmanual.com/mvm/index.jsp?cfile=htm/bc/121205.htm") Annotation(oboInOwl:hasDbXref "url:http://www.jstor.org/stable/pdfplus/1349519.pdf") obo:IAO_0000115 obo:DOID_3732 "A pneumonia which has a multifactorial etiology and develops as a result of complex interactions between environmental factors, host factors, and pathogens leading to pulmonary lesions caused by various micro organisms ( essentially viruses and bacteria). Environmental factors (eg, weaning, transport, commingling, crowding, and inadequate ventilation) serve as stressors that adversely affect the immune and nonimmune defense mechanisms of the host. In addition, certain environmental factors (eg, crowding and inadequate ventilation) can enhance the transmission of infectious agents among animals.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_3732 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_3732 "DOID:3732")
AnnotationAssertion(rdfs:label obo:DOID_3732 "obsolete bovine respiratory disease complex")
AnnotationAssertion(owl:deprecated obo:DOID_3732 "true"^^xsd:boolean)

