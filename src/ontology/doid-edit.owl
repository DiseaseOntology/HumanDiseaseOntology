AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(dc:type obo:ECO_0007638) Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://ghr.nlm.nih.gov/condition/hennekam-syndrome") Annotation(oboInOwl:hasDbXref "url:https://en.wikipedia.org/wiki/Hennekam_syndrome") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/pubmed/14564208") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/pubmed/24870712") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/pubmed/2624276") obo:IAO_0000115 obo:DOID_0060366 "A lymphatic system disease characterized by he presence of intestinal lymphangiectasia, mental retardation, and characteristic facial anomalies. It is inherited in an autosomal recessive pattern. Most individuals with Hennekam syndrome have characteristic facial abnormalities, such as a flat face with accompanying puffy eyelids and hypertelorism; the nasal bridge is typically flat and the ears are typically small. Congenital extremity and genital lymphedema is present in most patients.")
