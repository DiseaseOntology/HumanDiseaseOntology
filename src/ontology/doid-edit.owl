# Class: obo:DOID_2047 (hepatitis D)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(dc:type obo:ECO_0007638) Annotation(oboInOwl:hasDbXref "url:https://en.wikipedia.org/wiki/Hepatitis_D") Annotation(oboInOwl:hasDbXref "url:https://www.cdc.gov/hepatitis-d/about/index.html") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/books/NBK470436/") Annotation(oboInOwl:hasDbXref "url:https://www.who.int/news-room/fact-sheets/detail/hepatitis-d") obo:IAO_0000115 obo:DOID_2047 "A viral hepatitis that results_in inflammation located_in liver, has_material_basis_in Hepatitis delta virus, which is an incomplete virus that requires the helper function of Hepatitis B virus to replicate and only occurs among people who are infected with the Hepatitis B virus (Orthohepadnavirus hominoidei). The infection has_symptom fatigue, has_symptom lethargy, has_symptom anorexia, has_symptom nausea, has_symptom jaundice, has_symptom clay-colored stools, has_symptom dark urine, has_symptom changes in personality, has_symptom disturbances in sleep, has_symptom confusion, has_symptom abnormal behavior, has_symptom somnolence, and has_symptom coma. Hepatitis delta virus, also known as Hepatitis D virus, is not a single viral species but a group of viruses from the genus Deltavirus including Deltavirus italiense, Deltavirus japanense, Deltavirus peruense, Deltavirus taiwanense, Deltavirus togense, Deltavirus carense, Deltavirus cameroonense, Deltavirus senegalense.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_2047 "DOID:2046")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_2047 "MESH:D003699")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_2047 "SNOMEDCT_US_2025_09_01:424460009")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_2047 "UMLS_CUI:C0011226")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_2047 "delta hepatitis")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_2047 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_2047 "DOID:2047")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_2047 doid:DO_infectious_disease_slim)
AnnotationAssertion(rdfs:label obo:DOID_2047 "hepatitis D")
