AnnotationAssertion(oboInOwl:id obo:DOID_14433 "DOID:14433")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_14433 doid:gram-negative_bacterial_infectious_disease)
AnnotationAssertion(rdfs:label obo:DOID_14433 "obsolete enterohemorrhagic Escherichia coli infectious disease")
AnnotationAssertion(owl:deprecated obo:DOID_14433 "true"^^xsd:boolean)

# Class: obo:DOID_14434 (obsolete enterotoxigenic Escherichia coli infectious disease)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007646) Annotation(oboInOwl:hasDbXref "url:http://www.textbookofbacteriology.net/e.coli_4.html") obo:IAO_0000115 obo:DOID_14434 "An Escherichia coli intestinal infectious disease that involves infection of the intestine caused by a serological subgroup of Escherichia coli called enterotoxigenic Escherichia coli (ETEC), which are non-invasive and produce heat-labile enterotoxin (LT) or heat stable toxin (ST). The bacteria colonize the GI tract by means of a fimbrial adhesin. The symptoms include diarrhea without fever.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_14434 "Enterotoxigenic Escherichia coli gastrointestinal tract infection")
