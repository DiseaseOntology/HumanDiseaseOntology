# Class: obo:DOID_0050130 (osmotic diarrhea)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007638) Annotation(oboInOwl:hasDbXref "url:http://en.wikipedia.org/wiki/Diarrhea#Types_of_diarrhea") obo:IAO_0000115 obo:DOID_0050130 "A dirrhea that occurs when too much water is drawn into the bowels. This can be the result of maldigestion (e.g., pancreatic disease or Coeliac disease), in which the nutrients are left in the lumen to pull in water. Osmotic diarrhea can also be caused by osmotic laxatives (which work to alleviate constipation by drawing water into the bowels). In healthy individuals, too much magnesium or vitamin C or undigested lactose can produce osmotic diarrhea and distention of the bowel. A person who does not have lactose intolerance can have difficulty absorbing lactose after an extraordinarily high intake of dairy products.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0050130 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0050130 "DOID:0050130")
AnnotationAssertion(rdfs:label obo:DOID_0050130 "osmotic diarrhea")
SubClassOf(obo:DOID_0050130 obo:DOID_13250)
SubClassOf(obo:DOID_0050130 ObjectSomeValuesFrom(obo:RO_0002452 obo:SYMP_0000570))
SubClassOf(obo:DOID_0050130 ObjectSomeValuesFrom(obo:RO_0002452 obo:SYMP_0019180))

# Class: obo:DOID_0050131 (motility-related diarrhea)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007638) Annotation(oboInOwl:hasDbXref "url:http://en.wikipedia.org/wiki/Diarrhea#Types_of_diarrhea") obo:IAO_0000115 obo:DOID_0050131 "A diarrhea which is caused by the rapid movement of food through the intestines (hypermotility). If the food moves too quickly through the GI tract, there is not enough time for sufficient nutrients and water to be absorbed.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0050131 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0050131 "DOID:0050131")
AnnotationAssertion(rdfs:label obo:DOID_0050131 "motility-related diarrhea")
SubClassOf(obo:DOID_0050131 obo:DOID_13250)
SubClassOf(obo:DOID_0050131 ObjectSomeValuesFrom(obo:RO_0002452 obo:SYMP_0000570))

# Class: obo:DOID_0050132 (inflammatory diarrhea)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007638) Annotation(oboInOwl:hasDbXref "url:http://en.wikipedia.org/wiki/Diarrhea#Types_of_diarrhea") obo:IAO_0000115 obo:DOID_0050132 "A gastrointestinal system infectious disease involving diarrhea that occurs when there is damage to the mucosal lining or brush border, which leads to a passive loss of protein-rich fluids, and a decreased ability to absorb these lost fluids. It can be caused by bacterial infections, viral infections, parasitic infections, or autoimmune problems such as inflammatory bowel diseases. It can also be caused by tuberculosis, colon cancer, and enteritis.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0050132 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0050132 "DOID:0050132")
AnnotationAssertion(rdfs:label obo:DOID_0050132 "inflammatory diarrhea")
SubClassOf(obo:DOID_0050132 obo:DOID_13250)
SubClassOf(obo:DOID_0050132 ObjectSomeValuesFrom(obo:RO_0002452 obo:SYMP_0000570))

