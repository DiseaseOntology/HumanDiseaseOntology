# Class: obo:DOID_3240 (aspiration pneumonitis)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://www.nejm.org/doi/full/10.1056/NEJM200103013440908") obo:IAO_0000115 obo:DOID_3240 "A pneumonia that is defined as an acute lung injury after the inhalation of foreign material such as regurgitated acidic gastric contents, petroleum products and laxative oils. This syndrome occurs in patients who have a marked disturbance of consciousness such as that resulting from a drug overdose, seizures, a massive cerebrovascular accident, or the use of anesthesia. Aspiration of gastric contents results in a chemical burn of the tracheobronchial tree and pulmonary parenchyma, causing an intense parenchymal inflammatory reaction. The disease has_symptom non-productive cough, has_symptom tachypnea, has_symptom bronchospasm, has_symptom bloody sputum, has_symptom frothy sputum, or has_symptom respiratory distress, 2-5 hrs after aspiration.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_3240 "DOID:13016")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_3240 "DOID:13506")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_3240 "ICD10CM:J69.0")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_3240 "MESH:D011015")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_3240 "SNOMEDCT_US_2025_09_01:47839005")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_3240 "UMLS_CUI:C0032290")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_3240 "Chemical pneumonitis")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_3240 "Mendelson's Syndrome")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_3240 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_3240 "DOID:3240")
AnnotationAssertion(rdfs:label obo:DOID_3240 "aspiration pneumonitis")
SubClassOf(obo:DOID_3240 obo:DOID_552)
SubClassOf(obo:DOID_3240 ObjectSomeValuesFrom(obo:RO_0002452 obo:SYMP_0000447))
SubClassOf(obo:DOID_3240 ObjectSomeValuesFrom(obo:RO_0002452 obo:SYMP_0000603))
