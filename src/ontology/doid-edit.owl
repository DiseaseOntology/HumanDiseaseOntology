AnnotationAssertion(oboInOwl:id obo:DOID_4616 "DOID:4616")
AnnotationAssertion(rdfs:label obo:DOID_4616 "obsolete bovine atypical interstitial pneumonia")
AnnotationAssertion(owl:deprecated obo:DOID_4616 "true"^^xsd:boolean)

