# Class: obo:DOID_0081064 (BN2 diffuse large B-cell lymphoma)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://pubmed.ncbi.nlm.nih.gov/29641966/") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/articles/PMC8459709/") obo:IAO_0000115 obo:DOID_0081064 "A diffuse large B-cell lymphoma that is categorized as BN2 with high probability by the LymphGen algorithm. This is based on a combination of genetic features and BN2 DLBCLs often, but do not always, have a translocation involving the BCL6 locus and/or some combination of mutations affecting NOTCH2, TNFAIP3, BCL10 and UBE2A. This subgroup also commonly has mutations due to aberrant somatic hypermutation affecting CD70, which can be coding or non-coding.")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0081064 "NCI:C148395")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003012) oboInOwl:hasExactSynonym obo:DOID_0081064 "BN2 DLBCL")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0081064 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0081064 "DOID:0081064")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081064 doid:DO_cancer_slim)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081064 doid:NCIthesaurus)
AnnotationAssertion(rdfs:label obo:DOID_0081064 "BN2 diffuse large B-cell lymphoma")
SubClassOf(obo:DOID_0081064 obo:DOID_0050745)

# Class: obo:DOID_0081065 (EZB diffuse large B-cell lymphoma)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://pubmed.ncbi.nlm.nih.gov/29641966/") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/articles/PMC8459709/") obo:IAO_0000115 obo:DOID_0081065 "A diffuse large B-cell lymphoma that is categorized as EZB with high probability by the LymphGen algorithm. This is based on a combination of genetic features and EZB DLBCLs often, but do not always, have hot spot mutations in EZH2 and/or a BCL2 translocation. This class can be further subdivided into two sub-classes EZB-MYC+ and EZB-MYC- using the double hit gene expression signature (DHITsig). This subgroup also commonly has mutations due to aberrant somatic hypermutation affecting IRF8, which can be coding or non-coding.")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0081065 "NCI:C148398")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003012) oboInOwl:hasExactSynonym obo:DOID_0081065 "EZB DLBCL")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0081065 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0081065 "DOID:0081065")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081065 doid:DO_cancer_slim)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081065 doid:NCIthesaurus)
AnnotationAssertion(rdfs:label obo:DOID_0081065 "EZB diffuse large B-cell lymphoma")
SubClassOf(obo:DOID_0081065 obo:DOID_0050745)

# Class: obo:DOID_0081066 (MCD diffuse large B-cell lymphoma)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://pubmed.ncbi.nlm.nih.gov/29641966/") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/articles/PMC8459709/") obo:IAO_0000115 obo:DOID_0081066 "A diffuse large B-cell lymphoma that is categorized as MCD with high probability by the LymphGen algorithm. This is based on a combination of genetic features and MCD DLBCLs often, but do not always, have the most common hot spot mutation in MYD88 (L265P) and/or activating mutations in CD79B. This subgroup also commonly has mutations due to aberrant somatic hypermutation affecting PIM1 and/or ETV6, which can be coding or non-coding.")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0081066 "NCI:C148394")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003012) oboInOwl:hasExactSynonym obo:DOID_0081066 "MCD DLBCL")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0081066 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0081066 "DOID:0081066")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081066 doid:DO_cancer_slim)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081066 doid:NCIthesaurus)
AnnotationAssertion(rdfs:label obo:DOID_0081066 "MCD diffuse large B-cell lymphoma")
SubClassOf(obo:DOID_0081066 obo:DOID_0050745)

# Class: obo:DOID_0081067 (N1 diffuse large B-cell lymphoma)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://pubmed.ncbi.nlm.nih.gov/29641966/") obo:IAO_0000115 obo:DOID_0081067 "A diffuse large B-cell lymphoma that is categorized as N1 with high probability by the LymphGen algorithm. This is based on a combination of genetic features. Although N1 DLBCLs always have an activating mutation affecting NOTCH1, LymphGen can assign cases with this mutation to other classes, depending on the presence of other genetic features.")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0081067 "NCI:C148396")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003012) oboInOwl:hasExactSynonym obo:DOID_0081067 "N1 DLBCL")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0081067 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0081067 "DOID:0081067")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081067 doid:DO_cancer_slim)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081067 doid:NCIthesaurus)
AnnotationAssertion(rdfs:label obo:DOID_0081067 "N1 diffuse large B-cell lymphoma")
SubClassOf(obo:DOID_0081067 obo:DOID_0050745)

# Class: obo:DOID_0081068 (ST2 diffuse large B-cell lymphoma)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/articles/PMC6010183/") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/articles/PMC8459709/") obo:IAO_0000115 obo:DOID_0081068 "A diffuse large B-cell lymphoma that is categorized as ST2 with high probability by the LymphGen algorithm. This is based on a combination of genetic features and ST2 DLBCLs often, but do not always, have missense or nonsense mutations affecting TET2 and NFKBIA. This subgroup also commonly has mutations due to aberrant somatic hypermutation affecting some combination of SGK1, ZFP36L1, SOCS1, HIST1H1E and CD83, which can be coding or non-coding.")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003012) oboInOwl:hasExactSynonym obo:DOID_0081068 "ST2 DLBCL")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0081068 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0081068 "DOID:0081068")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0081068 doid:DO_cancer_slim)
AnnotationAssertion(rdfs:label obo:DOID_0081068 "ST2 diffuse large B-cell lymphoma")
SubClassOf(obo:DOID_0081068 obo:DOID_0050745)

