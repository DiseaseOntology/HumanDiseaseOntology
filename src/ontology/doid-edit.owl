AnnotationAssertion(owl:deprecated obo:DOID_12210 "true"^^xsd:boolean)

# Class: obo:DOID_12211 (filarial elephantiasis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://www.cdc.gov/parasites/lymphaticfilariasis/index.html") Annotation(oboInOwl:hasDbXref "url:https://www.who.int/news-room/fact-sheets/detail/lymphatic-filariasis") obo:IAO_0000115 obo:DOID_12211 "A filariasis that is characterized by the thickening of the skin and underlying tissues, especially in the legs, male genitals and female breasts, caused by thread-like parasitic worms Wuchereria bancrofti, Brugia malayi or Brugia timori, which inhabit the lymphatics. These nematodes are transmitted by mosquitoes. Acute symptoms include fever, lymphadenitis, lymphangitis, funiculitis, and epididymitis. Chronic symptoms include abscesses, hyperkeratosis, polyarthritis, hydroceles, lymphedema, and elephantiasis.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_12211 "DOID:13433")
