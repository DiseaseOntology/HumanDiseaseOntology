# Class: obo:DOID_3730 (obsolete pneumonic pasteurellosis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:http://merckvetmanual.com/mvm/index.jsp?cfile=htm/bc/121216.htm") obo:IAO_0000115 obo:DOID_3730 "A Pasteurella infectious disease that involves infection by the bacterium Mannheimia haemolytica and less frequently by Pasteurella multocida and Histophilus somni. After stress or viral infection, the replication rate of M. haemolytica in the upper respiratory tract increases rapidly, followed by inhalation and colonization of the lungs due to suppression of the host's defense mechanism. The bacterium produces exotoxin called leukotxin which interacts with the host's defense mechanism resulting in tissue damage with charactersistic necrosis, thrombosis, and exudation and the development of pneumonia.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_3730 "Pneumonic pasteurellosis")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_3730 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_3730 "DOID:3730")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_3730 doid:gram-negative_bacterial_infectious_disease)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_3730 doid:zoonotic_infectious_disease)
AnnotationAssertion(rdfs:label obo:DOID_3730 "obsolete pneumonic pasteurellosis")
AnnotationAssertion(owl:deprecated obo:DOID_3730 "true"^^xsd:boolean)

