AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_14445 "Anatomical narrow angle glaucoma")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_14445 "chronic angle-closure glaucoma")
