AnnotationAssertion(rdfs:label obo:DOID_0081124 "craniofacial dysmorphism, skeletal anomalies, and impaired intellectual development syndrome 1")
SubClassOf(obo:DOID_0081124 obo:DOID_0081072)
SubClassOf(obo:DOID_0081124 ObjectSomeValuesFrom(obo:IDO_0000664 obo:GENO_0000148))

# Class: obo:DOID_0081125 (craniofacial dysmorphism, skeletal anomalies, and impaired intellectual development syndrome 2)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://pubmed.ncbi.nlm.nih.gov/24194475/") obo:IAO_0000115 obo:DOID_0081125 "A craniofacial dysmorphism, skeletal anomalies, and mental retardation syndrome that is characterized by flat face, low-set ears, and cleft lip and palate, as well as costovertebral anomalies including bifid and fused ribs, vertebral segmentation defects, and scoliosis. Intellectual delay can be severe, with absent speech and that has_material_basis_in homozygous mutation in the RAB5IF gene on chromosome 20q11.")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0081125 "MIM:616994")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0081125 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0081125 "DOID:0081125")
AnnotationAssertion(rdfs:label obo:DOID_0081125 "craniofacial dysmorphism, skeletal anomalies, and impaired intellectual development syndrome 2")
SubClassOf(obo:DOID_0081125 obo:DOID_0081072)

