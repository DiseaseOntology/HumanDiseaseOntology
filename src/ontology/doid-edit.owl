# Class: obo:DOID_551 (toxic pneumonitis)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://hazmap.nlm.nih.gov/category-details?id=306&table=tbldiseases") obo:IAO_0000115 obo:DOID_551 "A pneumonia that is an acute inflammation of the lungs induced by inhalation of metal fumes or toxic gases and vapors. It is a sentinel health event (occupational) associated with exposure to ammonia (refrigeration, fertilizer, and oil refining industries), chlorine (alkali and bleach industries), nitrogen oxides (silo fillers, arc welders, and nitric acid industry), sulfur dioxide (paper, refrigeration, and oil refining industries), cadmium (processors and cadmium smelters), trimellitic anhydride (plastics and organic chemical synthesis), and vanadium pentoxide (boilermakers). The two types of pulmonary agents are central and peripheral. Central pulmonary agents, for example, ammonia, are water soluble irritants that injure the upper airways. Peripheral pulmonary agents, for example, phosgene, NOx, and PFIB, are slightly water soluble irritants that injure the alveolar-capillary membranes. Chlorine has both central and peripheral effects.")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_551 "DOID:549")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_551 "DOID:550")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_551 "DOID:553")
AnnotationAssertion(oboInOwl:hasAlternativeId obo:DOID_551 "DOID:554")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_551 "ICD9CM:506.9")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_551 "UMLS_CUI:C0041881")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_551 "acute chemical fume pulmonary edema")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_551 "acute chemical pulmonary edema")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_551 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_551 "DOID:551")
AnnotationAssertion(rdfs:label obo:DOID_551 "toxic pneumonitis")
SubClassOf(obo:DOID_551 obo:DOID_552)
SubClassOf(obo:DOID_551 ObjectSomeValuesFrom(obo:RO_0002451 obo:TRANS_0000009))

