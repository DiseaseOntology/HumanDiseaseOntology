Ontology(<http://purl.obolibrary.org/obo/doid.owl>
Import(<http://purl.obolibrary.org/obo/doid/obo/ext.owl>)
Annotation(obo:IAO_0000700 obo:DOID_4)
Annotation(dc:description "The Disease Ontology has been developed as a standardized ontology for human disease with the purpose of providing the biomedical community with consistent, reusable and sustainable descriptions of human disease terms, phenotype characteristics and related medical vocabulary disease concepts.")
Annotation(dc:language "en")
Annotation(dc:title "Human Disease Ontology")
Annotation(terms:license <https://creativecommons.org/publicdomain/zero/1.0/>)
Annotation(oboInOwl:default-namespace "disease_ontology")
Annotation(oboInOwl:hasOBOFormatVersion "1.2")
Annotation(oboInOwl:saved-by "lschriml")
Annotation(rdfs:comment "The Disease Ontology content is available via the Creative Commons Public Domain Dedication CC0 1.0 Universal license (https://creativecommons.org/publicdomain/zero/1.0/).")

