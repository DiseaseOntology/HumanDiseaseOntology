AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_9395 "Croup syndrome")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_9395 "Laryngotracheobronchitis")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_9395 "acute Obstructive Laryngitis")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_9395 "acute laryngotracheobronchitis")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_9395 "disease_ontology")
