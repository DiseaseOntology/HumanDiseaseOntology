AnnotationAssertion(rdfs:comment obo:DOID_0070788 "The disease is clinically, radiographically, and pathologically distinct from the allelic disease DOID:0070027.")
AnnotationAssertion(rdfs:label obo:DOID_0070788 "autosomal dominant adult-onset leukodystrophy without amyloid angiopathy")
AnnotationAssertion(skos:exactMatch obo:DOID_0070788 "MIM:621214")
AnnotationAssertion(skos:exactMatch obo:DOID_0070788 "UMLS_CUI:C6012728")
