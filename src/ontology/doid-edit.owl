# Class: obo:DOID_4492 (avian influenza)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(dc:type obo:ECO_0007643) Annotation(oboInOwl:hasDbXref "url:http://www.cdc.gov/flu/avian/gen-info/avian-flu-humans.htm") Annotation(oboInOwl:hasDbXref "url:https://www.merriam-webster.com/dictionary/avian%20influenza#medicalDictionary") Annotation(oboInOwl:hasDbXref "url:https://www.who.int/news-room/fact-sheets/detail/influenza-(avian-and-other-zoonotic)") obo:IAO_0000115 obo:DOID_4492 "An influenza that results in infection located in respiratory tract of humans, domestic and wild birds, has_material_basis_in Influenza A virus (Alphainfluenzavirus influenzae), which is transmitted by contact with infected poultry. At least five strains of avian influenza A viruses (H5N1, H7N3, H7N2, H7N7 and H9N2) are known to cause human infections. The infection has_symptom fever, has_symptom cough, has_symptom sore throat, has_symptom muscle aches, has_symptom nausea, has_symptom diarrhea, has_symptom vomiting, has_symptom neurologic changes, has_symptom pneumonia, and has_symptom acute respiratory distress.")
