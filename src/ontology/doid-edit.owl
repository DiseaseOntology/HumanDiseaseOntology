# Class: obo:DOID_0050352 (foodborne botulism)

AnnotationAssertion(Annotation(oboInOwl:hasDbXref "url:https://www.southernnevadahealthdistrict.org/Health-Topics/foodborne-botulism/") obo:IAO_0000115 obo:DOID_0050352 "A botulism that involves intoxication caused by botulinum neurotoxins (BoNTA, B, E and F), which are transmitted by ingestion of food contaminated with preformed toxins, has_material_basis_in Clostridium botulinum A, has_material_basis_in Clostridium botulinum B, has_material_basis_in Clostridium botulinum E and has_material_basis_in Clostridium botulinum F. The infection has symptom blurred vision, has symptom diplopia, has symptom dysarthria, has symptom dysphonia, has symptom dysphagia and has symptom descending muscle paralysis.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0050352 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0050352 "DOID:0050352")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0050352 doid:DO_infectious_disease_slim)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0050352 doid:GOLD)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0050352 doid:gram-positive_bacterial_infectious_disease)
AnnotationAssertion(rdfs:label obo:DOID_0050352 "foodborne botulism")
