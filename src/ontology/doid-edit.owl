# Class: obo:DOID_0050200 (Korean hemorrhagic fever)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://books.google.com/books?id=VS5bqBQ9RWoC&pg=PR65&lpg=PR65&dq#v=onepage&q&f=false") Annotation(oboInOwl:hasDbXref "url:http://www.cdc.gov/mmwr/preview/mmwrhtml/00051521.htm") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/pubmed/1349231") obo:IAO_0000115 obo:DOID_0050200 "A hemorrhagic fever with renal syndrome that results_in infection located_in kidney, has_material_basis_in Hantaan virus, which is transmitted_by the eurasian field mouse, Apodemus agrarius, or has_material_basis_in Seoul virus, which is transmitted_by norwegian rat, Rattus norvegicus. The infection has_symptom headache, has_symptom back pain, has_symptom abdominal pain, has_symptom fever, has_symptom chills, has_symptom nausea, has_symptom blurred vision, has_symptom flushing of the face, has_symptom redness of the eyes, has_symptom rash, has_symptom low blood pressure, has_symptom acute shock, has_symptom vascular leakage, and has_symptom acute kidney failure, which can cause severe fluid overload.")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0050200 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0050200 "DOID:0050200")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0050200 doid:DO_infectious_disease_slim)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0050200 doid:zoonotic_infectious_disease)
AnnotationAssertion(rdfs:label obo:DOID_0050200 "Korean hemorrhagic fever")
