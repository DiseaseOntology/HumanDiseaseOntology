# Class: obo:DOID_11097 (obsolete pulmonary syphilis)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://sti.bmj.com/cgi/reprint/4/4/290.pdf") Annotation(oboInOwl:hasDbXref "url:http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1707740/pdf/canmedaj00442-0068.pdf") obo:IAO_0000115 obo:DOID_11097 "A tertiary syphilis that is caused by the spirochetal bacterium Treponema pallidum subspecies pallidum. It is a sexually transmitted disease although congenital syphilis can also occur. Treponema infection of the lung leads to a fibrous induration spreading from the roots of the lungs. Ulcerations occur in the superficial tissues, while in the deep tissues gummata are formed. Symptoms include dry cough, hemoptysis, hemorrhage, dyspnea, pain in the chest, loss of weight and slight fever.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_11097 "Syphilis of lung (disorder)")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_11097 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_11097 "DOID:11097")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_11097 doid:gram-negative_bacterial_infectious_disease)
AnnotationAssertion(oboInOwl:inSubset obo:DOID_11097 doid:sexually_transmitted_infectious_disease)
AnnotationAssertion(rdfs:label obo:DOID_11097 "obsolete pulmonary syphilis")
AnnotationAssertion(owl:deprecated obo:DOID_11097 "true"^^xsd:boolean)

