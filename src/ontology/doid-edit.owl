AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_12210 "Wuchereria bancrofti infectious disease")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_12210 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_12210 "DOID:12210")
