# Class: obo:DOID_4616 (obsolete bovine atypical interstitial pneumonia)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://merckvetmanual.com/mvm/index.jsp?cfile=htm/bc/121221.htm&hide=1") Annotation(oboInOwl:hasDbXref "url:http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1789549/pdf/canvetj00318-0047.pdf") obo:IAO_0000115 obo:DOID_4616 "A bovine respiratory disease complex defined as an acute, noncontagious respiratory distress caused 5-10days after change to a better, often lush, pasture. Metabolites of the naturally occurring amino acid L-tryptophan probably are responsible for the disease. Severely affected cattle show extensive respiratory distress with mouth breathing, extension of the tongue, and drooling. There is extensive edema and emphysema, often with the formation of large air-filled bullae in interlobular and subpleural regions of the lung.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_4616 "Atypical interstitial pneumonia of cattle (disorder)")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_4616 "Fog fever")
