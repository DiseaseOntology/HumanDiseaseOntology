AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/pubmed/27523608") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/pubmed/27559085") Annotation(oboInOwl:hasDbXref "url:https://www.nih.gov/news-events/news-releases/nih-researchers-discover-otulipenia-new-inflammatory-disease") obo:IAO_0000115 obo:DOID_0080163 "An autoinflammation, panniculitis, and dermatosis syndrome characterized by neonatal onset of recurrent fever, erythematous rash with painful nodules, painful joints, and lipodystrophy and has_material_basis_in homozygous or compound heterozygous loss-of-function mutation in the OTULIN gene on chromosome 5p15.")
