# Class: obo:DOID_14473 (obsolete adenovirus pneumonia)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007638) Annotation(oboInOwl:hasDbXref "url:http://en.wikipedia.org/wiki/Adenovirus_infection") Annotation(oboInOwl:hasDbXref "url:http://virology-online.com/viruses/Adenoviruses3.htm") obo:IAO_0000115 obo:DOID_14473 "An adenovirus infectious disease described as the infection of the lungs by adenoviruses (1,2, 3 and 7) especially in infants and children. In mild form of infection, findings of interstitial inflammatory cell infiltration may predominate, and nuclear inclusion bodies, most prominent in alveolar lining cells, may be identified in infected cells.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_14473 "Pneumonia due to adenovirus")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_14473 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_14473 "DOID:14473")
AnnotationAssertion(rdfs:label obo:DOID_14473 "obsolete adenovirus pneumonia")
AnnotationAssertion(owl:deprecated obo:DOID_14473 "true"^^xsd:boolean)

# Class: obo:DOID_14474 (obsolete respiratory syncytial virus pneumonia)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(oboInOwl:hasDbXref "url:http://books.google.com/books?id=12k1sTIyp1kC&pg=PA117&lpg#v=onepage&q=&f=false") Annotation(oboInOwl:hasDbXref "url:http://www.cdc.gov/RSV/") Annotation(oboInOwl:hasDbXref "url:http://www.merck.com/mmhe/sec23/ch273/ch273i.htm") obo:IAO_0000115 obo:DOID_14474 "A respiratory syncytial virus infectious disease that results_in inflammation located_in lung, has_material_basis_in Human respiratory syncytial virus, which is transmitted_by droplet spread of nasal secretions from an infected person while coughing or sneezing, or transmitted_by contaminated fomites. The disease is characterized by occasional multinucleated syncytial giant cells, hyperplasia of alveolar epithelial cells, epithelial necrosis of bronchioles and bronchi, papillary epithelial hyperplasia, and an inflammatory infiltrate composed of lymphocytes and macrophages in the peribronchial space and interstitium.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_14474 "Pneumonia due to respiratory syncytial virus (disorder)")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_14474 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_14474 "DOID:14474")
AnnotationAssertion(rdfs:label obo:DOID_14474 "obsolete respiratory syncytial virus pneumonia")
AnnotationAssertion(owl:deprecated obo:DOID_14474 "true"^^xsd:boolean)

# Class: obo:DOID_14475 (obsolete parainfluenzal pneumonia)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://books.google.com/books?id=nWtVT4n0yM8C&pg=RA1-PA452&lpg#v=onepage&q=&f=false") Annotation(oboInOwl:hasDbXref "url:http://www.springerlink.com/content/d3540088547u2n43/fulltext.pdf") obo:IAO_0000115 obo:DOID_14475 "A viral infectious disease that results_in inflammation located_in lung, has_material_basis_in Human parainfluenza virus 3, which is transmitted_by contact with the respiratory secretions of an infected person. The infection leads to the formation of multinucleated giant cells derived from the respiratory epithelium. The infection has_symptom shortness of breath, has_symptom cough, and has_symptom fever.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_14475 "Parainfluenza virus pneumonia (disorder)")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_14475 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_14475 "DOID:14475")
AnnotationAssertion(rdfs:label obo:DOID_14475 "obsolete parainfluenzal pneumonia")
AnnotationAssertion(owl:deprecated obo:DOID_14475 "true"^^xsd:boolean)

# Class: obo:DOID_14476 (obsolete SARS coronavirus pneumonia)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007638) Annotation(oboInOwl:hasDbXref "url:http://en.wikipedia.org/wiki/SARS") Annotation(oboInOwl:hasDbXref "url:http://www.doh.gov.ph/sars/may16.pdf") obo:IAO_0000115 obo:DOID_14476 "A severe acute respiratory syndrome that results_in infection located_in lungs, has_material_basis_in SARS coronavirus (SARS-CoV), which is transmitted_by droplet spread of respiratory secretions, transmitted_by ingestion of contaminated food, or transmitted_by fomites. The infection has_symptom fever, has_symptom myalgia, has_symptom lethargy, has_symptom cough, has_symptom sore throat, has_symptom shortness of breath, and other breathing difficulties which may lead to death as a result of respiratory failure.")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_14476 "SARS-associated coronavirus pneumonia")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_14476 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_14476 "DOID:14476")
AnnotationAssertion(rdfs:label obo:DOID_14476 "obsolete SARS coronavirus pneumonia")
AnnotationAssertion(owl:deprecated obo:DOID_14476 "true"^^xsd:boolean)

# Class: obo:DOID_14477 (obsolete Cytomegalovirus pneumonia)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007640) Annotation(oboInOwl:hasDbXref "url:http://www.nlm.nih.gov/medlineplus/ency/article/000664.htm") obo:IAO_0000115 obo:DOID_14477 "A Cytomegalovirus infectious disease that results_in inflammation, located_in lung, has_material_basis_in Human herpesvirus 5, a member of a group of herpes-type viruses especially in people who have a suppressed immune system and has_symptom cough, has_symptom fatigue, has_symptom shortness of breath, and has_symptom hypoxemia. Cytomegalovirus infection can be demonstrated microscopically by the detection of intranuclear inclusion bodies.")
