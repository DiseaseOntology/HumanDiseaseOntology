# Class: obo:DOID_0060536 (mitochondrial complex I deficiency)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007636) Annotation(oboInOwl:hasDbXref "url:http://www.omim.org/entry/252010") obo:IAO_0000115 obo:DOID_0060536 "A mitochondrial metabolism disease characterized by a wide range of manifestations including marked and often fatal lactic acidosis, cardiomyopathy, leukoencephalopathy, pure myopathy and hepatopathy with tubulopathy. Among the numerous clinical phenotypes observed are Leigh syndrome, Leber hereditary optic neuropathy and MELAS syndrome. It can have material basis in mutations in multiple different genes, both nuclear-encoded and mitochondrial-encoded.")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060536 "GARD:3908")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060536 "MESH:C537475")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060536 "ORDO:2609")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060536 "SNOMEDCT_US_2025_09_01:237988006")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060536 "UMLS_CUI:C1838979")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060536 "isolated NADH-CoQ reductase deficiency")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060536 "isolated NADH-coenzyme Q reductase deficiency")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060536 "isolated NADH-ubiquinone reductase deficiency")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060536 "isolated mitochondrial respiratory chain complex I deficiency")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0060536 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0060536 "DOID:0060536")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0060536 doid:DO_rare_slim)
AnnotationAssertion(rdfs:label obo:DOID_0060536 "mitochondrial complex I deficiency")
SubClassOf(obo:DOID_0060536 obo:DOID_700)

# Class: obo:DOID_0060537 (mitochondrial complex II deficiency)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/pubmed/23322652") obo:IAO_0000115 obo:DOID_0060537 "A mitochondrial metabolism disease characterized by a highly variable phenotype. Some patients have multisystem involvement of the brain, heart, muscle, liver, and kidneys resulting in death in infancy, whereas others have only isolated cardiac or muscle involvement with onset in adulthood and normal cognition. It has_material_basis_in homozygous or compound heterozygous mutation in the nuclear-encoded SDHA gene on chromosome 5p, the nuclear-encoded SDHAF1 gene on chromosome 19q, or the nuclear-encoded SDHD gene on chromosome 11q23.")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060537 "GARD:5053")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060537 "ICD10CM:G71.3")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060537 "MESH:C565375")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060537 "MIM:252011")
AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_0060537 "ORDO:3208")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060537 "isolated mitochondrial respiratory chain complex II deficiency")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060537 "isolated succinate-CoQ reductase deficiency")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060537 "isolated succinate-coenzyme Q reductase deficiency")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_0060537 "isolated succinate-ubiquinone reductase deficiency")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_0060537 "disease_ontology")
AnnotationAssertion(oboInOwl:id obo:DOID_0060537 "DOID:0060537")
AnnotationAssertion(oboInOwl:inSubset obo:DOID_0060537 doid:DO_rare_slim)
AnnotationAssertion(rdfs:label obo:DOID_0060537 "mitochondrial complex II deficiency")
