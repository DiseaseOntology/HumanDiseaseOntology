# Class: obo:DOID_0050118 (La Crosse encephalitis)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(dc:type obo:ECO_0007638) Annotation(oboInOwl:hasDbXref "url:https://en.wikipedia.org/wiki/La_Crosse_encephalitis") Annotation(oboInOwl:hasDbXref "url:https://www.cdc.gov/la-crosse-encephalitis/about/") Annotation(oboInOwl:hasDbXref "url:https://www.ncbi.nlm.nih.gov/books/NBK562248/") obo:IAO_0000115 obo:DOID_0050118 "A viral infectious disease that results_in inflammation located_in brain, has_material_basis_in La Crosse virus (Orthobunyavirus lacrosseense), which is primarily transmitted_by treehole mosquito (Ochlerotatus triseriatus) but also Asian tiger mosquito (Aedes albopictus) and Asian bush mosquito (Aedes japonicus). The infection has_symptom seizures, has_symptom headache, has_symptom fever, has_symptom coma, and has_symptom paralysis.")
