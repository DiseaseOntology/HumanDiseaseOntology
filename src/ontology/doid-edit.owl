AnnotationAssertion(oboInOwl:hasDbXref obo:DOID_12118 "UMLS_CUI:C0020807")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_12118 "Idiopathic pulmonary hemosiderosis")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_12118 "brown induration")
AnnotationAssertion(oboInOwl:hasExactSynonym obo:DOID_12118 "brown lung")
AnnotationAssertion(oboInOwl:hasOBONamespace obo:DOID_12118 "disease_ontology")
