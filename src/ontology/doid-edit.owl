# Class: obo:DOID_992 (Omsk hemorrhagic fever)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://www.phac-aspc.gc.ca/msds-ftss/msds113e-eng.php") Annotation(oboInOwl:hasDbXref "url:https://en.wikipedia.org/wiki/Omsk_hemorrhagic_fever") Annotation(oboInOwl:hasDbXref "url:https://www.cdc.gov/omsk-fever/about/") obo:IAO_0000115 obo:DOID_992 "A viral infectious disease that is a hemorrhagic fever, has_material_basis_in Omsk hemorrhagic fever virus (Orthoflavivirus omskense), which is transmitted_by Dermacentor and transmitted_by Ixodes species of ticks. The infection has_symptom fever, has_symptom chills, has_symptom headache, has_symptom pain in lower and upper extremities, has_symptom stiff neck, has_symptom papulovesicular rash on the soft palate, has_symptom cervical lymphadenopathy, has_symptom conjunctival suffusion, has_symptom blood in the urine, and has_symptom blood in the sputum.")
