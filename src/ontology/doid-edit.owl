# Class: obo:DOID_12206 (dengue hemorrhagic fever)

AnnotationAssertion(Annotation(dc:type obo:ECO_0007637) Annotation(dc:type obo:ECO_0007640) Annotation(dc:type obo:ECO_0007643) Annotation(dc:type obo:ECO_0007645) Annotation(oboInOwl:hasDbXref "url:http://www.ncbi.nlm.nih.gov/pmc/articles/PMC88892/pdf/cm000480.pdf") Annotation(oboInOwl:hasDbXref "url:http://www.nlm.nih.gov/MEDLINEPLUS/ency/article/001373.htm") Annotation(oboInOwl:hasDbXref "url:https://www.merriam-webster.com/medical/dengue%20hemorrhagic%20fever") obo:IAO_0000115 obo:DOID_12206 "A dengue disease that occurs when a person experiences a second infection with a heterologous Dengue virus (Orthoflavivirus denguei) serotype, which is transmitted_by Aedes mosquito bite. The infection has_symptom hemorrhagic lesions of the skin, has_symptom thrombocytopenia, has_symptom reduction in the fluid part of the blood, and has_symptom high fever. Four distinct Dengue virus serotypes have been identified.")
