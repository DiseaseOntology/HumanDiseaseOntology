    <!-- http://purl.obolibrary.org/obo/MP_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0000001">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <obo:IAO_0000115>the observable morphological, physiological, behavioral and other characteristics of mammalian organisms that are manifested through development and lifespan</obo:IAO_0000115>
        <oboInOwl:id>MP:0000001</oboInOwl:id>
        <rdfs:label>mammalian phenotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0000358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0000358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0005384"/>
        <obo:IAO_0000115>any structural anomaly of the minute protoplasmic masses that make up organized tissues and which are the fundamental structural and functional units of living organisms</obo:IAO_0000115>
        <oboInOwl:id>MP:0000358</oboInOwl:id>
        <rdfs:label>abnormal cell morphology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0005384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0005384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0000001"/>
        <obo:IAO_0000115>the observable morphological and physiological characteristics of the basic structural and functional unit of all mammalian organisms that are manifested through development and lifespan</obo:IAO_0000115>
        <oboInOwl:id>MP:0005384</oboInOwl:id>
        <rdfs:label>cellular phenotype</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0005621 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0005621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0005384"/>
        <obo:IAO_0000115>any functional anomaly of the vital processes of the cell</obo:IAO_0000115>
        <oboInOwl:id>MP:0005621</oboInOwl:id>
        <rdfs:label>abnormal cell physiology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0013202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0013202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0000358"/>
        <obo:IAO_0000115>any structural anomaly of the specialized eukaryotic organelle that consists of a filiform extrusion of the cell surface; each cilium is bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored basally in a centriole</obo:IAO_0000115>
        <oboInOwl:id>MP:0013202</oboInOwl:id>
        <rdfs:label>abnormal cilium morphology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0013203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0013203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0013202"/>
        <obo:IAO_0000115>any structural anomaly of a cilium found on many different cell types that is typically present in a single copy per cell; a primary cilium may have a variable array of axonemal microtubules and may or may not contain molecular motors</obo:IAO_0000115>
        <oboInOwl:id>MP:0013203</oboInOwl:id>
        <rdfs:label>abnormal primary cilium morphology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0013206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0013206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0013202"/>
        <obo:IAO_0000115>any structural anomaly of a cilium which has a variable arrangement of axonemal microtubules, contains molecular motors, and beats with a characteristic whip-like pattern that promotes cell motility or transport of fluids and other cells across a cell surface; motile cilia are typically found in multiple copies on epithelial cells that line the lumenal ducts of various tissues and may also function as sensory organelles</obo:IAO_0000115>
        <oboInOwl:id>MP:0013206</oboInOwl:id>
        <rdfs:label>abnormal motile cilium morphology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0013208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0013208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0005621"/>
        <obo:IAO_0000115>any functional anomaly of the specialized eukaryotic organelle that consists of a filiform extrusion of the cell surface; each cilium is bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored basally in a centriole</obo:IAO_0000115>
        <oboInOwl:id>MP:0013208</oboInOwl:id>
        <rdfs:label>abnormal cilium physiology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0013209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0013209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0013208"/>
        <obo:IAO_0000115>any functional anomaly of a cilium which has a variable arrangement of axonemal microtubules, contains molecular motors, and beats with a characteristic whip-like pattern that promotes cell motility or transport of fluids and other cells across a cell surface; motile cilia are typically found in multiple copies on epithelial cells that line the lumenal ducts of various tissues and may also function as sensory organelles</obo:IAO_0000115>
        <oboInOwl:id>MP:0013209</oboInOwl:id>
        <rdfs:label>abnormal motile cilium physiology</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MP_0013210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MP_0013210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MP_0013208"/>
        <obo:IAO_0000115>any functional anomaly of a cilium found on many different cell types that is typically present in a single copy per cell; a primary cilium may have a variable array of axonemal microtubules and may or may not contain molecular motors</obo:IAO_0000115>
        <oboInOwl:id>MP:0013210</oboInOwl:id>
        <rdfs:label>abnormal primary cilium physiology</rdfs:label>
    </owl:Class>
</rdf:RDF>



