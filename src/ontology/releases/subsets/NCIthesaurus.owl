        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">The term glioblastoma no longer applies to central nervous system WHO grade 4 IDH-mutant astrocytomas, removed previous name glioblastoma, IDH-mutant.</rdfs:comment>
        <rdfs:label xml:lang="en">astrocytoma, IDH-mutant, grade 4</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080877"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
