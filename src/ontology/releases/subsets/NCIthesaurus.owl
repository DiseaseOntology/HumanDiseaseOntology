    <!-- http://purl.obolibrary.org/obo/DOID_882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_883"/>
        <obo:IAO_0000115 xml:lang="en">A parasitic helminthiasis infectious disease that involves intestinal infection by the parasite of the genus Heterophyes. The symptoms are diarrhea and colicky abdominal pain. Migration of the eggs to the heart, results in fatal myocardial and valvular damage. Brain can also be infected.</obo:IAO_0000115>
