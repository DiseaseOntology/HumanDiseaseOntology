        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060020"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A severe combined immunodeficiency that is the most severe form of SCID and has_material_basis_in mutations in the gene encoding mitochondrial adenylate kinase 2. It is characterized by congenital agranulocytosis, lymphopenia, and lymphoid and thymic hypoplasia with absent cellular and humoral immunity functions.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/gene/11151?ordinalpos=2&amp;itool=EntrezSystem2.PEntrez.Gene.Gene_ResultsPanel.Gene_RVDocSum</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/gene/204?</oboInOwl:hasDbXref>
    </owl:Axiom>
    


