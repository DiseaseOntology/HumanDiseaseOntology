    <!-- http://purl.obolibrary.org/obo/DOID_6688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_6688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4"/>
        <obo:IAO_0000115 xml:lang="en">A hypersensitivity reaction type IV disease that is an inherited disorder in which the body cannot properly regulate the number of immune system cells (lymphocytes). It is characterized by the production of an abnormally large number of lymphocytes. Accumulation of excess lymphocytes results in enlargement of the lymph nodes, the liver, and the spleen.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8686</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:D89.82</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:279.41</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D056735</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:601859</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C37864</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:3261</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:702444009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1328840</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ALPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Canale-Smith syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:6688</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">Xref MGI. OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label xml:lang="en">autoimmune lymphoproliferative syndrome</rdfs:label>
        <skos:exactMatch>MESH:D056735</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_6688"/>
