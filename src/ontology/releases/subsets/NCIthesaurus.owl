        <oboInOwl:hasDbXref>NCI:C90598</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:76905008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0079301</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">congenital junctional epidermolysis bullosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3209</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">Xref MGI.</rdfs:comment>
