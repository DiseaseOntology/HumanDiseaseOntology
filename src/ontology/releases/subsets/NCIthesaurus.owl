        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:156677003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0006444</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2965</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">bursitis</rdfs:label>
