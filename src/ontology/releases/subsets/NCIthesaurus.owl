        <oboInOwl:hasDbXref>UMLS_CUI:C5669877</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">diffuse intrinsic pontine glioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">diffuse midline glioma, EGFR-mutant</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">diffuse midline glioma, H3 K27M-mutant</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">diffuse midline glioma, H3-wildtype with EZHIP overexpression</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080684</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">diffuse midline glioma, H3 K27-altered</rdfs:label>
        <skos:broadMatch>ICD10CM:C71.9</skos:broadMatch>
        <skos:exactMatch>ICDO:9385/3</skos:exactMatch>
        <skos:exactMatch>NCI:C185368</skos:exactMatch>
