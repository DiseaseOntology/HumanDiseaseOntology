        <oboInOwl:hasDbXref>url:https://www.merckmanuals.com/professional/neurologic-disorders/spinal-cord-disorders/htlv-1-associated-myelopathy-tropical-spastic-paraparesis-ham-tsp</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK560825/</oboInOwl:hasDbXref>
