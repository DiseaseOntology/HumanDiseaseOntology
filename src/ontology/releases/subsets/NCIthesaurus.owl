    <!-- http://purl.obolibrary.org/obo/DOID_3265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_612"/>
        <obo:IAO_0000115 xml:lang="en">A phagocyte bactericidal dysfunction characterized by an inability to resist repeated infectious diseases and a tendency to develop chronic inflammation. Life-threatening recurrent fungal and bacterial infections affecting the skin, lungs, liver, lymph nodes, and bones may occur along with swollen areas of inflamed tissues known as granulomas that can be widely distributed.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:D71.8</oboInOwl:hasDbXref>
