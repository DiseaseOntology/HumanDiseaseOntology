        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5048"/>
        <obo:IAO_0000115 xml:lang="en">A posterior pituitary benign neoplasm that is characterized by the presence of spindle cells with eosinophilic, granular cytoplasm forming fascicles.</obo:IAO_0000115>
