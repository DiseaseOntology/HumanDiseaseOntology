        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:50508009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0001261</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Actinomycotic madura foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Actinomycotic mycetema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Actinomycotic mycetoma of foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Madura foot due to Actinomadura</oboInOwl:hasExactSynonym>
