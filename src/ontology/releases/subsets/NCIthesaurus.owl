        <oboInOwl:hasDbXref>UMLS_CUI:C0024454</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ENCHONDROMATOSIS, MULTIPLE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Enchondromatosis with haemangiomata</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Kast&apos;s syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dyschondroplasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">osteochondromatosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4624</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">OMIM mapping confirmed by DO. [SN].</rdfs:comment>
