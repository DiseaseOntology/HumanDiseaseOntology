        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">high-grade astrocytoma with piloid features</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An anaplastic astrocytoma that is characterized by high-grade piloid and/or glioblastoma-like histological features. It may occur anywhere in the central nervous system but most often arises in the posterior fossa.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://radiopaedia.org/articles/high-grade-astrocytoma-with-piloid-features-1?lang=us</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC8131327/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060085"/>
        <obo:IAO_0000115 xml:lang="en">A central nervous system benign neoplasm that is characterized by the presence of oligodendroglioma-like components, may also contain astrocytic components and is associated with seizures and in many cases refractory epilepsy.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9413/0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C180378</oboInOwl:hasDbXref>
