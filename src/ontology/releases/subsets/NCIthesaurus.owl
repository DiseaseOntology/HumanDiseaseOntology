        <oboInOwl:hasDbXref>ICD9CM:474.00</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014069</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C116006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:195665006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:195794009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0040425</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0149517</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Throat infection - tonsillitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">chronic tonsillitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
