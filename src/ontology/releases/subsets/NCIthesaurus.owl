        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_104"/>
        <obo:IAO_0000115 xml:lang="en">A primary bacterial infectious disease that results_in infection, has_material_basis_in Mycobacterium avium complex (MAC), which is transmitted_by inhalation or transmitted_by ingestion of via the respiratory or gastrointestinal tract respectively. The bacteria cause disseminated infection in HIV infected people, while pulmonary disease in immunocompetent persons.</obo:IAO_0000115>
