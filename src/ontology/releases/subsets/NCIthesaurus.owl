        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_114"/>
        <obo:IAO_0000115 xml:lang="en">A heart conduction disease that is characterized by uncoordinated electrical activity in the heart&apos;s upper chambers (the atria), which causes the heartbeat to become fast and irregular and has symptoms palpitations, weakness, fatigue, lightheadedness, dizziness, confusion, shortness of breath and chest pain.</obo:IAO_0000115>
