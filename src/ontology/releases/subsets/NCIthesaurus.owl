    <!-- http://purl.obolibrary.org/obo/DOID_0081250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081249"/>
        <obo:IAO_0000115 xml:lang="en">An EWSERI-negative small round cell tumor that is characterized by a recurrent translocation involving the CIC gene on chromosome 19 and either DUX4 gene on chromosome 4 or DUX4L gene on chromosome 10. The translocation results in either CIC-DUX4, t(4;19)(q35;q13) or CIC-DUX4L, t(10;19)(q26;q13) fusions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9367/3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C120224</oboInOwl:hasDbXref>
