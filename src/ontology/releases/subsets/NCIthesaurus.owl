    <!-- http://purl.obolibrary.org/obo/DOID_2378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2377"/>
        <obo:IAO_0000115 xml:lang="en">A multiple sclerosis that is characterized by relapse (attacks of symptom flare-ups) followed by remission (periods of recovery). Symptoms may vary from mild to severe, and relapses and remissions may last for days or months. More than 80 percent of people who have MS begin with relapsing-remitting cycles.</obo:IAO_0000115>
