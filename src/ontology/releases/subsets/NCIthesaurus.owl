        <oboInOwl:hasDbXref>ICD10CM:C71.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICDO:9385/3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C185368</oboInOwl:hasDbXref>
