    <!-- http://purl.obolibrary.org/obo/DOID_13406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11335"/>
