        <oboInOwl:hasExactSynonym xml:lang="en">MTPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TFP deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">TFPD</oboInOwl:hasExactSynonym>
