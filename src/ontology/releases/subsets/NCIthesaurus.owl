        <rdfs:label xml:lang="en">apparent mineralocorticoid excess syndrome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4367"/>
