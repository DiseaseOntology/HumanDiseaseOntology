        <oboInOwl:hasDbXref>ORDO:602</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:702382000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1853926</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Distal myopathy, Nonaka type</oboInOwl:hasExactSynonym>
