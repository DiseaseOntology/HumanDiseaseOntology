        <oboInOwl:hasExactSynonym xml:lang="en">Pneumocystis pneumonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pneumocystosis pneumonia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pulmonary pneumocystosis</oboInOwl:hasExactSynonym>
