        <oboInOwl:hasDbXref>UMLS_CUI:C0152071</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">heterophyes infectious disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:882</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">heterophyiasis</rdfs:label>
    </owl:Class>
