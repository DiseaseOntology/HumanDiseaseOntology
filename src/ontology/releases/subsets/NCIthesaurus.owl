        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">acute hemorrhagic conjunctivitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
