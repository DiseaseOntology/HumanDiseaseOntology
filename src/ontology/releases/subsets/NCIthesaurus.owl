        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_104"/>
        <obo:IAO_0000115 xml:lang="en">A primary bacterial infectious disease that results_in infection, has_material_basis_in Burkholderia pseudomallei, which is transmitted_by contact with the contaminated water or soil. The infection has_symptom fever, has_symptom respiratory distress, has_symptom chest pain, and has_symptom stomach pain.</obo:IAO_0000115>
