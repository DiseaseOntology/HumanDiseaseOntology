    <!-- http://purl.obolibrary.org/obo/DOID_13641 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1686"/>
        <obo:IAO_0000115 xml:lang="en">A phacogenic glaucoma that is characterized by open-angle glaucoma related to deposition of extracellular fibrillar material in anterior segment structures, which blocks aqueous fluid outflow, raises intraocular pressure, and leads to eventual optic nerve atrophy and visual field loss. Exfoliation syndrome has_symptom progressive decreased vision, especially peripheral vision. Exfoliation syndrome is caused by age-related deposition of fibrillar material in anterior segment structures.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0004235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:365.52</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D017889</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:177650</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C129025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:111514006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0206368</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Pseudoexfoliation glaucoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pseudoexfoliation syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13641</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label xml:lang="en">exfoliation syndrome</rdfs:label>
        <skos:exactMatch>MESH:D017889</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13641"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A phacogenic glaucoma that is characterized by open-angle glaucoma related to deposition of extracellular fibrillar material in anterior segment structures, which blocks aqueous fluid outflow, raises intraocular pressure, and leads to eventual optic nerve atrophy and visual field loss. Exfoliation syndrome has_symptom progressive decreased vision, especially peripheral vision. Exfoliation syndrome is caused by age-related deposition of fibrillar material in anterior segment structures.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4157521/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


