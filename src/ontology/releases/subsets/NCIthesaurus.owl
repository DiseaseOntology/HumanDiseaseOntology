    <!-- http://purl.obolibrary.org/obo/DOID_9577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1508"/>
        <obo:IAO_0000115 xml:lang="en">A candidiasis that involves fungal infection in neonates caused by Candida species. Low birthweight and age, prolonged intravascular catheterization and the use of antibiotic drugs are the principle predisposing conditions for systemic candidiasis in neonates.</obo:IAO_0000115>
