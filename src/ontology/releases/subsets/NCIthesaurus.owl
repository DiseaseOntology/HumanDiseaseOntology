        <oboInOwl:hasDbXref>UMLS_CUI:C0038165</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Dermatitis exfoliativa neonatorum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pemphigus neonatorum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ritter disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Scalded skin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Staphylococcal scalded skin syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Toxic epidermal necrolysis, subcorneal type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9063</oboInOwl:id>
