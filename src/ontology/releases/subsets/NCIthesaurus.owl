    <!-- http://purl.obolibrary.org/obo/DOID_2215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1247"/>
        <obo:IAO_0000115 xml:lang="en">A blood coagulation disease that is characterized by easy bleeding, has_symptom epistaxis, bleeding of the gums, menorrhagia, and occasionally hemarthrosis, and has_material_basis_in autosomal recessive inheritance of mutation in the F7 gene, which encodes coagulation factor VII, an important factor in the clotting cascade.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:2238</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:D68.2</oboInOwl:hasDbXref>
