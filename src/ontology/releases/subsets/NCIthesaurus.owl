        <oboInOwl:hasExactSynonym xml:lang="en">5p partial monosomy syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">chromosome 5 short arm deletion syndrome</oboInOwl:hasExactSynonym>
