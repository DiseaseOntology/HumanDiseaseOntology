        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_15"/>
        <obo:IAO_0000115 xml:lang="en">A male infertility disease characterized by male sterility, has_material_basis_in azospermia without abnormal sexual development.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8406</oboInOwl:hasDbXref>
