    <!-- http://purl.obolibrary.org/obo/DOID_11549 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <obo:IAO_0000115 xml:lang="en">A syndrome that is a neurological disorder affecting the pupil of the eye and the autonomic nervous system. It is characterized by one eye with a pupil that is larger than normal and constricts slowly in bright light (tonic pupil), along with the absence of deep tendon reflexes, usually in the Achilles tendon.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:5749</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000270</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:103100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34357</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:123051004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0001519</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Adie&apos;s pupil or syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Adie&apos;s pupil syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Adie&apos;s syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Holmes-Adie syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11549</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label xml:lang="en">Adie syndrome</rdfs:label>
        <skos:exactMatch>MESH:D000270</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11549"/>
