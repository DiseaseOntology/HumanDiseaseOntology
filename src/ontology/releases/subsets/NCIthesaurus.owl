    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11102"/>
        <obo:IAO_0000115 xml:lang="en">A bartonellosis that results_in infection located_in lymph node, has_material_basis_in Bartonella henselae or has_material_basis_in Bartonella clarridgeiae, which are transmitted_by scratch or bite of a kitten, or transmitted_by contact of animal&apos;s saliva with an eye or through broken skin. The infection has_symptom regional lymphadenopathy, has_symptom headache, has_symptom chills, has_symptom backache, and has_symptom abdominal pain.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:A28.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:078.3</oboInOwl:hasDbXref>
