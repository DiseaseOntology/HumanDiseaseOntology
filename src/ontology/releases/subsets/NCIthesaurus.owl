        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">cervical verrucous carcinoma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A cervical squamous cell carcinoma that is characterized by a hyperkeratotic, undulating, warty surface and invades the underlying stroma in the form of bulbous epithelial pegs with a pushing border, broad papillae that lack fibrovascular cores and the absence of koilocytosis. It shows no more than minimal nuclear atypia and does not exhibit infiltrative growth.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/18214065</oboInOwl:hasDbXref>
    </owl:Axiom>
    


