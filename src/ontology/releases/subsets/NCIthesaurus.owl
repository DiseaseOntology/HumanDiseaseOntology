    <!-- http://purl.obolibrary.org/obo/DOID_2965 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_65"/>
        <obo:IAO_0000115 xml:lang="en">A connective tissue disease that is characterized by the inflammation of bursae, small, fluid-filled sacs that cushion the bones, tendons and muscles near your joints.</obo:IAO_0000115>
