        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4"/>
        <obo:IAO_0000115 xml:lang="en">An upper respiratory tract disease which is characterized by inflammation of the tonsils resulting from bacterial (Group A streptococcus) and viral (Epstein-Barr virus, adenovirus) infections. Symptoms include a severe sore throat, painful or difficult swallowing, coughing, headache, myalgia, fever and chills.</obo:IAO_0000115>
