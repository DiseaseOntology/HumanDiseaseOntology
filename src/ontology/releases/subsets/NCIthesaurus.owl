    <!-- http://purl.obolibrary.org/obo/DOID_11338 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_104"/>
        <obo:IAO_0000115 xml:lang="en">A primary bacterial infectious disease that results in prolonged contraction of skeletal muscle fibers, has_material_basis_in Clostridium tetani, which produces tetanospasmin, a neurotoxin, which is carried to the brain and spinal cord, where it binds irreversibly to receptors inhibiting neurotransmission. Damaged upper motor neurons cannot control reflex responses to afferent sensory stimuli.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:5144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A35</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:037</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013742</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C85185</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:154312006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0039614</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection due to Clostridium tetani</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">clostridial tetanus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11338</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="en">tetanus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A primary bacterial infectious disease that results in prolonged contraction of skeletal muscle fibers, has_material_basis_in Clostridium tetani, which produces tetanospasmin, a neurotoxin, which is carried to the brain and spinal cord, where it binds irreversibly to receptors inhibiting neurotransmission. Damaged upper motor neurons cannot control reflex responses to afferent sensory stimuli.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
