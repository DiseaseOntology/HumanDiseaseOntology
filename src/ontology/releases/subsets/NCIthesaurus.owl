        <owl:annotatedTarget xml:lang="en">A hypersensitivity reaction type IV disease that is an inherited disorder in which the body cannot properly regulate the number of immune system cells (lymphocytes). It is characterized by the production of an abnormally large number of lymphocytes. Accumulation of excess lymphocytes results in enlargement of the lymph nodes, the liver, and the spleen.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://ghr.nlm.nih.gov/condition/autoimmune-lymphoproliferative-syndrome</oboInOwl:hasDbXref>
    </owl:Axiom>
