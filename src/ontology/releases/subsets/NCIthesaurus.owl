        <oboInOwl:hasDbXref>UMLS_CUI:C0030759</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Infestation by Phthirus pubis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pediculosis Pubis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Pediculus pubis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phthiriasis pubis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phthirus pubis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Phthirus/pediculus pubis - pubic lice - crabs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">crabs</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13760</oboInOwl:id>
