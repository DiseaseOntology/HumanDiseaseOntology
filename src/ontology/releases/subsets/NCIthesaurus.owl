        <oboInOwl:hasDbXref>ICD9CM:054.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:054.41</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007617</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C35620</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:186544000</oboInOwl:hasDbXref>
