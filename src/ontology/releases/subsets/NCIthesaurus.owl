        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A glycogen storage disease that is characterized by severe hypoglycemia and hepatomegaly caused by the accumulation of glycogen. Affected individuals exhibit growth retardation, delayed puberty, lactic acidemia, hyperlipidemia, hyperuricemia, and in adults a high incidence of hepatic adenomas.</owl:annotatedTarget>
