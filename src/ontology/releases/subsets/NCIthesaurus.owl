        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:400036004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0406735</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Hypoplastic enamel-onycholysis-hypohidrosis syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Witkop&apos;s syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:6678</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">OMIM mapping confirmed by DO. [LS].</rdfs:comment>
        <rdfs:label xml:lang="en">tooth and nail syndrome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_6678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A syndrome that affects the teeth, nails, hair, and/or skin. It is characterized by absence (hypodontia) and/or malformation of certain primary (deciduous) and secondary (permanent) teeth occurring in association with improper development of the nails, particularly the toenails.</owl:annotatedTarget>
