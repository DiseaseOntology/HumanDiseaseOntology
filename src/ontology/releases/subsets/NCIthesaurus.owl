        <oboInOwl:hasDbXref>UMLS_CUI:C0042880</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">deficiency of vitamin K</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vitamin K deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vitamin K deficiency hemorrhagic disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
