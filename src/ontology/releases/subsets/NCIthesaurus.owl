        <oboInOwl:hasDbXref>UMLS_CUI:C0028968</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Dejerine-Thomas syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Thomas&apos; syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">WADIA-SWAMI SYNDROME</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14784</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_FlyBase_slim"/>
