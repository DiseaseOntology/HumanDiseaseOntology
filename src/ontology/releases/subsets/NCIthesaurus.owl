    <!-- http://purl.obolibrary.org/obo/DOID_3529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_423"/>
        <obo:IAO_0000115 xml:lang="en">A congenital myopathy that is characterized by muscle weakness primarily affecting the proximal muscles of the lower limbs beginning in infancy or early childhood, although later onset of symptoms has been reported and that has_material_basis_in heterozygous mutation in the ryanodine receptor-1 gene (RYR1) on chromosome 19q13. Heterozygous mutation in the RYR1 gene also causes susceptibility to malignant hyperthermia-1 (MHS1), patients with CMYP1A are at risk for MHS. Biallelic mutations in the RYR1 gene cause autosomal recessive CMYP1B, which shows overlapping features, but is typically more severe.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G71.29</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D020512</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:117000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C83010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:597</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:43152001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0751951</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">autosomal dominant congenital myopathy 1A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">central core disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">central core myopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3529</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label xml:lang="en">congenital myopathy 1A</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3529"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A congenital myopathy that is characterized by muscle weakness primarily affecting the proximal muscles of the lower limbs beginning in infancy or early childhood, although later onset of symptoms has been reported and that has_material_basis_in heterozygous mutation in the ryanodine receptor-1 gene (RYR1) on chromosome 19q13. Heterozygous mutation in the RYR1 gene also causes susceptibility to malignant hyperthermia-1 (MHS1), patients with CMYP1A are at risk for MHS. Biallelic mutations in the RYR1 gene cause autosomal recessive CMYP1B, which shows overlapping features, but is typically more severe.</owl:annotatedTarget>
