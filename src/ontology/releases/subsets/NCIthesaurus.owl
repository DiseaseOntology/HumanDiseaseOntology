        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5295"/>
        <obo:IAO_0000115 xml:lang="en">An intestinal disease with autosomal recessive inheritance characterized by unrestricted intestinal absorption of both cholesterol and plant-derived cholesterol-like molecules resulting in xanthomas, arthralgia, premature atherosclerosis, and hemolytic anemia with stomatocytosis and macrothrombocytopenia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7653</oboInOwl:hasDbXref>
