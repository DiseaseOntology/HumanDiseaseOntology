    <!-- http://purl.obolibrary.org/obo/DOID_4481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4483"/>
        <obo:IAO_0000115 xml:lang="en">A rhinitis that is an allergic inflammation and irritation of the nasal airways involving sneezing, runny nose, nasal congestion, itching and tearing of the eyes caused by exposure to an allergen such as pollen, dust, mold, animal dander and droppings of cockroaches or house dust mites.</obo:IAO_0000115>
