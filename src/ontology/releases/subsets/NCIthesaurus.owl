        <oboInOwl:hasDbXref>MEDDRA:10018604</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D006069</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C92950</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:186943001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0018081</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">chronic gonococcal infectious disease of lower genitourinary tract</oboInOwl:hasExactSynonym>
