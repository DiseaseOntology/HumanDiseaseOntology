        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:192685000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0038522</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Dawson&apos;s encephalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Dawson&apos;s inclusion body encephalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SSPE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Van Bogaert&apos;s sclerosing leukoencephalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">subacute sclerosing leukoencephalopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
