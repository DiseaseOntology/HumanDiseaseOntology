        <oboInOwl:hasAlternativeId>DOID:8242</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>EFO:0003956</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:607154</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34987</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:38103000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0002103</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-seasonal allergic rhinitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Perenial allergic rhinitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">atopic rhinitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hay fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pollenosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">seasonal allergic rhinitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4481</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">allergic rhinitis</rdfs:label>
        <skos:exactMatch>MESH:D065631</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4481"/>
