        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_423"/>
        <obo:IAO_0000115 xml:lang="en">A myopathy that is characterized by progressive skeletal muscle atrophy, distal muscle weakness and bilateral foot drop caused by weakness of the anterior tibialis muscles with onset in early adulthood, and that has_material_basis_in mutations in the GNE gene which encodes the rate-limiting enzyme of sialic acid biosynthesis.</obo:IAO_0000115>
