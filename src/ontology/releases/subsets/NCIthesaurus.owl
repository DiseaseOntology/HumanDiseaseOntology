    <!-- http://purl.obolibrary.org/obo/DOID_3376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3347"/>
        <obo:IAO_0000115 xml:lang="en">An osteosarcoma that is an usually aggressive malignant bone-forming mesenchymal neoplasm arising from the bone. It may arise de novo or from a pre-existing lesion of the bone. Pain and a palpable mass are the most frequent clinical sign and symptom. It may spread to other anatomic sites, particularly the lungs.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:8580</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>NCI:C53707</oboInOwl:hasDbXref>
