        <oboInOwl:hasExactSynonym xml:lang="en">ARDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-cardiogenic pulmonary edema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Shock lung</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">acute respiratory distress syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">adult RDS</oboInOwl:hasExactSynonym>
