        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9119"/>
        <obo:IAO_0000115 xml:lang="en">An acute myeloid leukemia associated with t(6;9)(p23;q34), resulting in DEK-NUP214(CAN) fusion protein expression. It is often associated with multilineage dysplasia and basophilia.</obo:IAO_0000115>
