    <!-- http://purl.obolibrary.org/obo/DOID_10112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2789"/>
        <obo:IAO_0000115 xml:lang="en">A trypanosomiasis that results from infection by Trypanosoma brucei and gambiense, which is transmitted by the bite of an infected tsetse fly (Glossina spp). The symptoms include fever, headache, joint pain, itching, confusion, sensory disturbances, poor coordination and sleep disturbances.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7826</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B56</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:086.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>KEGG:05143</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:3385</oboInOwl:hasDbXref>
