        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/33787033/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.tandfonline.com/doi/pdf/10.1080/13506129.2020.1835263?needAccess=true</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_9123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_8566"/>
        <obo:IAO_0000115 xml:lang="en">A herpes simplex that results_in infection located_in skin, effected by preexisting dermatosis, has_material_basis_in Human herpesvirus 1 (Simplexvirus humanalpha1) or 2 (Simplexvirus humanalpha2). The infection has_symptom watery blisters, has_symptom fever, and has_symptom swelling of the lymph nodes.</obo:IAO_0000115>
