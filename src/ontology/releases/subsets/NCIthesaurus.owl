    <!-- http://purl.obolibrary.org/obo/DOID_0081314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3541"/>
        <obo:IAO_0000115 xml:lang="en">A cerebral ventricle cancer that is characterized by the presence of neoplastic uniform, round cells with neuronal differentiation, that arises from the brain parenchyma. Unlike central neurocytoma, it does not involve the lateral ventricles.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9506/1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C92555</oboInOwl:hasDbXref>
