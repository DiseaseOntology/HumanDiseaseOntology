        <oboInOwl:hasDbXref>UMLS_CUI:C1175175</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">SARS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">SARS-CoV infection</oboInOwl:hasExactSynonym>
