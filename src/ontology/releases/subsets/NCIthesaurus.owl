        <oboInOwl:hasDbXref>UMLS_CUI:C0002395</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Alzheimer disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Alzheimers dementia</oboInOwl:hasExactSynonym>
