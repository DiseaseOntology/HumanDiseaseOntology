        <oboInOwl:hasDbXref>UMLS_CUI:C0019360</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Shingles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">herpes zona</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
