    <!-- http://purl.obolibrary.org/obo/DOID_0111049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2218"/>
        <obo:IAO_0000115 xml:lang="en">A blood platelet disease characterized by autosomal dominant inheritance of increased bleeding tendency, gray platelets, thrombocytopenia, thrombasthenia, abnormal megakaryocytes, decreased or absent alpha-granules in platelets, and myelofibrosis that has_material_basis_in heterozygous mutation in the GFI1B gene on chromosome 9q34.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:D69.1</oboInOwl:hasDbXref>
