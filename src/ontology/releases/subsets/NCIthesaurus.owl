    <!-- http://purl.obolibrary.org/obo/DOID_5870 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_5870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_552"/>
        <obo:IAO_0000115 xml:lang="en">A pneumonia in which certain type of white blood cell called an eosinophil accumulates in the lung. These cells cause disruption of the normal air spaces (alveoli) where oxygen is extracted from the atmosphere. It is caused by certain medications or environmental triggers, parasitic infections, and cancer. The most common symptoms include cough, fever, difficulty breathing, and sweating at night.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:107</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:J82.81</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D011657</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C35150</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:367542003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1527407</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Pneumonia, eosinophilic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:5870</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">eosinophilic pneumonia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_5870"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A pneumonia in which certain type of white blood cell called an eosinophil accumulates in the lung. These cells cause disruption of the normal air spaces (alveoli) where oxygen is extracted from the atmosphere. It is caused by certain medications or environmental triggers, parasitic infections, and cancer. The most common symptoms include cough, fever, difficulty breathing, and sweating at night.</owl:annotatedTarget>
