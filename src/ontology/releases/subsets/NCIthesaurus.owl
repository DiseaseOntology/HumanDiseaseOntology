        <oboInOwl:id>DOID:2060</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">vulvar nodular hidradenoma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A vulvar benign neoplasm that is characterized by nodules with cystic foci high in dermis on gross examination and derives_from the sweat gland distal excretory duct. Histologically characterized by nests or lobules of cells resembling eccrine poroma with either clear cytoplasm or prominent squamous metaplasia and lumina lined by cuboidal ductal cells or columnar secretory cells.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.pathologyoutlines.com/topic/skintumornonmelanocyticeccrineacrospiroma.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


