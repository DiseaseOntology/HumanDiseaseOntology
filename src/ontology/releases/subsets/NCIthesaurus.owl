    <!-- http://purl.obolibrary.org/obo/DOID_2962 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <obo:IAO_0000115 xml:lang="en">A syndrome that is characterized by an abnormally small head size (microcephaly), a failure to gain weight and grow at the expected rate (failure to thrive) leading to very short stature, and delayed development.</obo:IAO_0000115>
