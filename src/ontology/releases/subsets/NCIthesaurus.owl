        <oboInOwl:hasExactSynonym xml:lang="en">Ramsay Hunt syndrome type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ramsay Hunt syndrome type II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Ramsey Hunt syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">geniculate neuralgia</oboInOwl:hasExactSynonym>
