    <!-- http://purl.obolibrary.org/obo/DOID_9537 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_934"/>
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in infection, has_material_basis_in Lassa virus (Mammarenavirus lassaense), which is transmitted_by multimammate rat of the genus Mastomys. The infection has_symptom fever, has_symptom retrosternal pain, has_symptom sore throat, has_symptom back pain, has_symptom cough, has_symptom abdominal pain, has_symptom vomiting, has_symptom diarrhea, has_symptom conjunctivitis, has_symptom facial swelling, has_symptom proteinuria (protein in the urine), and has_symptom mucosal bleeding.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:A96.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007835</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C128418</oboInOwl:hasDbXref>
