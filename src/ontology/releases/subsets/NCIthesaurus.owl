    <!-- http://purl.obolibrary.org/obo/DOID_11289 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_841"/>
        <obo:IAO_0000115 xml:lang="en">An extrinsic allergic alveolitis caused by inhalation of antigens from thermophilic actinomycetes species growing in air conditioners and humidifiers. Fungi like Aureobasidium sp and Candida albicans that survive in the contaminated water in humidifiers and air conditioners are also known to cause the disease.</obo:IAO_0000115>
