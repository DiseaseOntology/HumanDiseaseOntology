        <oboInOwl:hasDbXref>NCI:C128408</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:186126003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0010418</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Cryptosporidial gastroenteritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection by Cryptosporidium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">intestinal cryptosporidiosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1733</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
