        <oboInOwl:hasExactSynonym xml:lang="en">facio-genito-popliteal syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">popliteal web syndrome</oboInOwl:hasExactSynonym>
