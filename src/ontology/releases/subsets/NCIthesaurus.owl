        <oboInOwl:hasDbXref>UMLS_CUI:C0152061</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Relapsing fever, louse-borne</oboInOwl:hasExactSynonym>
