        <oboInOwl:hasExactSynonym xml:lang="en">Nutritional edema with dyspigmentation of skin and hair</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Nutritional oedema with dyspigmentation of skin and/or hair</oboInOwl:hasExactSynonym>
