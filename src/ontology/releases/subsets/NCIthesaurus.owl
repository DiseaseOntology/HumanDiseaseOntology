    <!-- http://purl.obolibrary.org/obo/DOID_3284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3277"/>
        <obo:IAO_0000115 xml:lang="en">A thymus cancer that derives_from epithelial cells. The tumor cells in a thymic carcinoma look very different from the normal cells of the thymus, grow more quickly, and have usually spread to other parts of the body when the cancer is found.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:8586/3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013945</oboInOwl:hasDbXref>
