        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_627"/>
        <obo:IAO_0000115 xml:lang="en">A severe combined immunodeficiency that is characterized by deficiency of MHC class II molecules that causes lack of immune protection against bacteria, viruses, and fungi and thus causes early death in childhood, and has_material_basis_in autosomal recessive inheritance of mutation in the CIITA, RFX5, RFXANK, and RFXAP genes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:D81.6</oboInOwl:hasDbXref>
