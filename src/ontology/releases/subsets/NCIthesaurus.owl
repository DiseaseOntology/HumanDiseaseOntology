        <oboInOwl:hasDbXref>MESH:D000387</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:103400</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84544</oboInOwl:hasDbXref>
