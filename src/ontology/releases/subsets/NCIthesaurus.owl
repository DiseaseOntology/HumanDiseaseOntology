    <!-- http://purl.obolibrary.org/obo/DOID_2060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060085"/>
        <obo:IAO_0000115 xml:lang="en">A vulvar benign neoplasm that is characterized by nodules with cystic foci high in dermis on gross examination and derives_from the sweat gland distal excretory duct. Histologically characterized by nests or lobules of cells resembling eccrine poroma with either clear cytoplasm or prominent squamous metaplasia and lumina lined by cuboidal ductal cells or columnar secretory cells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C40312</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1520091</oboInOwl:hasDbXref>
