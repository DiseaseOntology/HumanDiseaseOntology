    <!-- http://purl.obolibrary.org/obo/DOID_11329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_65"/>
        <obo:IAO_0000115 xml:lang="en">A connective tissue disease that results in increasing fibrous constriction and ultimately in spontaneous amputation of the toes and especially the little toes. A painful constriction of the base of the fifth toe frequently followed by bilateral spontaneous amputation (autoamputation) a few years later.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9512</oboInOwl:hasDbXref>
