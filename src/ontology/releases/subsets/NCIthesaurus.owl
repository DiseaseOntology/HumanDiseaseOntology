    <!-- http://purl.obolibrary.org/obo/DOID_14305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3798"/>
        <obo:IAO_0000115 xml:lang="en">A pleural empyema which involves presence of pus in the pleural cavity and calcified visceral pleura. It results from a large number of mycobacteria spilling into the pleural space, usually from rupture of a cavity or an adjacent paranchymal focus via a bronchopleural fistula.</obo:IAO_0000115>
