        <oboInOwl:hasExactSynonym xml:lang="en">chronic renal disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">chronic renal failure syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">renal failure - chronic</oboInOwl:hasExactSynonym>
