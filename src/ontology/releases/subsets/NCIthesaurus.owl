    <!-- http://purl.obolibrary.org/obo/DOID_10264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_934"/>
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results in inflammation located in salivary gland, has_material_basis_in Mumps rubulavirus (Orthorubulavirus parotitidis), which is transmitted by droplet spread of saliva or mucus from the mouth, nose, or throat of an infected person, or transmitted by contaminated fomites. The infection has symptom fever, has symptom headache, has symptom muscle aches, has symptom tiredness, has symptom loss of appetite, has symptom swollen and tender salivary glands under the ears or jaw on one or both sides of the face.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7116</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B26</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:072</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D009107</oboInOwl:hasDbXref>
