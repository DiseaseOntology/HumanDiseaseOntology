        <oboInOwl:hasExactSynonym xml:lang="en">pulmonary venolobar syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">total anomalous pulmonary venous return</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vena cava bronchovascular syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
