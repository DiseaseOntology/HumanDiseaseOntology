        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11335"/>
        <obo:IAO_0000115 xml:lang="en">A sarcoidosis that is characterized by conduction abnormalities, arrhythmias, and congestive heart failure with noncaseating granulomas present on endomyocardial biopsy, and develops_from a type IV hypersensitivity reaction with noncaseating granulomas infiltrating the myocardial tissue, especially that of the left ventricle.</obo:IAO_0000115>
