    <!-- http://purl.obolibrary.org/obo/DOID_10095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_331"/>
        <obo:IAO_0000115 xml:lang="en">A central nervous system disease that is located_in the skull and is characterized by a collection of pus (infected material) inside the skull.</obo:IAO_0000115>
