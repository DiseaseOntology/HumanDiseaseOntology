        <oboInOwl:hasExactSynonym xml:lang="en">Nonaka myopathy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">inclusion body myopathy 2</oboInOwl:hasExactSynonym>
