        <rdfs:comment xml:lang="en">OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label xml:lang="en">olivopontocerebellar atrophy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14784"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A neurodegenerative disease that is characterized by progressive cerebellar ataxia, leading to clumsiness in body movements, veering from midline when walking, wide-based stance, and falls without signs of paralysis or weakness and has_material_basis_in expansion of CAG triplet repeats (glutamine) resulting in degeneration of neuron in the cerebellum, pons and inferior olives.</owl:annotatedTarget>
