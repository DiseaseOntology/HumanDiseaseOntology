    <!-- http://purl.obolibrary.org/obo/DOID_14784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1289"/>
        <obo:IAO_0000115 xml:lang="en">A neurodegenerative disease that is characterized by progressive cerebellar ataxia, leading to clumsiness in body movements, veering from midline when walking, wide-based stance, and falls without signs of paralysis or weakness and has_material_basis_in expansion of CAG triplet repeats (glutamine) resulting in degeneration of neuron in the cerebellum, pons and inferior olives.</obo:IAO_0000115>
