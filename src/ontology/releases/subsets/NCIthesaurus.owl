    <!-- http://purl.obolibrary.org/obo/DOID_8252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4483"/>
        <obo:IAO_0000115 xml:lang="en">A rhinitis which is persistent and long-lasting. It may occur with diseases such as syphilis, tuberculosis, rhinoscleroma, rhinosporidiosis, leishmaniasis, blastomycosis, histoplasmosis, and leprosy, all of which are characterized by the formation of inflamed lesions (granulomas) and the destruction of soft tissue, cartilage, and bone. Chronic rhinitis causes nasal obstruction, pus-filled discharge from the nose, and frequent bleeding.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:J31.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:472.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34479</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155522005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008711</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Rhinitis - chronic</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8252</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">chronic rhinitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8252"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A rhinitis which is persistent and long-lasting. It may occur with diseases such as syphilis, tuberculosis, rhinoscleroma, rhinosporidiosis, leishmaniasis, blastomycosis, histoplasmosis, and leprosy, all of which are characterized by the formation of inflamed lesions (granulomas) and the destruction of soft tissue, cartilage, and bone. Chronic rhinitis causes nasal obstruction, pus-filled discharge from the nose, and frequent bleeding.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmhe/sec19/ch221/ch221g.html?qt=chronic%20rhinitis&amp;alt=sh</oboInOwl:hasDbXref>
    </owl:Axiom>
    


