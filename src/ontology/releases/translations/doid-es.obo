[Term]
id: DOID:0050167
name: autoimmune polyendocrine syndrome type 1
def: "Síndrome polendocrino autoinmune que se hereda de forma autosómica recesiva y que se caracteriza por un funcionamiento anormal del sistema inmunitario que provoca una autorreactividad contra los órganos endocrinos." [url:https\://rarediseases.info.nih.gov/diseases/8466/autoimmune-polyglandular-syndrome-type-1] {comment="sn:IEDB"}
subset: DO_rare_slim
synonym: "síndrome de Whitaker" EXACT []
