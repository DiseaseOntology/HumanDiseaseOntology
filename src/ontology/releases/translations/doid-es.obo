xref: GARD:8609
xref: ICD10CM:J84.112
xref: ICD9CM:516.31
xref: MESH:D054990
xref: NCI:C35716
xref: SNOMEDCT_US_2025_09_01:28168000
xref: UMLS_CUI:C1800706
is_a: DOID:0050736 ! enfermedad autosómica dominante
is_a: DOID:3770 ! fibrosis pulmonar

[Term]
id: DOID:0050157
name: neumonía organizativa criptogénica
alt_id: DOID:2798
def: "Neumonía intersticial idiopática caracterizada por una inflamación y cicatrización pulmonar que obstruye las pequeñas vías respiratorias y los sacos de aire de los pulmones (alvéolos). Una enfermedad parecida a la gripe, con tos, fiebre, sensación de enfermedad (malestar), fatiga y pérdida de peso, anuncia su aparición en alrededor del 50% de las personas. Presencia frecuente de sonidos crepitantes (llamados crepitaciones de velcro) cuando el médico escucha con un estetoscopio." [url:http\://www.merck.com/mmhe/sec04/ch050/ch050b.html?qt=idiopathic%20interstitial%20pneumonia&alt=sh, url:https\://www.ncbi.nlm.nih.gov/pubmed/11790668]
subset: DO_rare_slim
subset: NCIthesaurus
synonym: "bronquiolitis obliterante con neumonía organizada" EXACT []
synonym: "bronquiolitis obliterante idiopática con neumonía organizada" EXACT []
synonym: "neumonitis organizada criptogénica" EXACT []
synonym: "neumonía organizada criptogénica" EXACT []
