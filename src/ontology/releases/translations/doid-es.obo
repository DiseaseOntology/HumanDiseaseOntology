xref: MIM:615785
is_a: DOID:0050448 ! nevus blanco esponjoso
is_a: DOID:0050736 ! enfermedad autosómica dominante

[Term]
id: DOID:0081289
name: síndrome de Antley-Bixler
def: "Una craneosinostosis que se caracteriza por una sinostosis radiohumeral presente desde el período perinatal." [url:https\://rarediseases.org/rare-diseases/antley-bixler-syndrome/]
subset: DO_rare_slim
synonym: "síndrome de Antley Bixler" EXACT []
synonym: "síndrome de Antley y Bixler" EXACT []
