[Term]
id: DOID:0070784
name: hormone receptor-positive breast cancer
def: "A breast cancer characterized by the presence of at least one of the estrogen or progesterone receptors." [url:https\://www.cancer.gov/types/breast/diagnosis/breast-cancer-biomarker-tests, url:https\://www.cancer.org/cancer/types/breast-cancer/understanding-a-breast-cancer-diagnosis/breast-cancer-hormone-receptor-status.html]
is_a: DOID:1612 ! cáncer de mama

[Term]
id: DOID:0070785
name: hormone receptor-negative breast cancer
def: "A breast cancer characterized by the absence of hormone receptors." [url:https\://www.cancer.gov/publications/dictionaries/cancer-terms/def/hormone-receptor-negative, url:https\://www.cancer.gov/types/breast/diagnosis/breast-cancer-biomarker-tests, url:https\://www.cancer.org/cancer/types/breast-cancer/understanding-a-breast-cancer-diagnosis/breast-cancer-hormone-receptor-status.html]
is_a: DOID:1612 ! cáncer de mama

[Term]
id: DOID:0070786
name: triple positive breast cancer
def: "A hormone receptor-positive/HER2-positive breast cancer characterized by excess HER2 (ERBB2) protein and the presence of both estrogen and progesterone receptors." [url:https\://www.cancer.gov/types/breast/diagnosis/breast-cancer-biomarker-tests, url:https\://www.cancer.org/cancer/types/breast-cancer/understanding-a-breast-cancer-diagnosis/breast-cancer-hormone-receptor-status.html]
