[Term]
id: DOID:0050068
name: obsolete pestis minor
def: "A bubonic plague that results_in a benign form of bubonic plague, has_symptom fever, has_symptom lymphadenitis, has_symptom headache and has_symptom prostration." []
is_obsolete: true

