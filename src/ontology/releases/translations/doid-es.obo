[Term]
id: DOID:0051099
name: Paget disease of bone 7
def: "A Paget disease of bone that is characterized by persistent and long-lasting active bone resorption, resulting in severe skeletal deformities and high levels of serum alkaline phosphatase and bone turnover markers and that has_material_basis_in heterozygous mutation in the PFN1 gene on chromosome 17p13." [url:https\://pubmed.ncbi.nlm.nih.gov/33599011/]
xref: MIM:621600
is_a: DOID:5408 ! Enfermedad de Paget ósea

[Term]
id: DOID:0051100
name: hydroxyprolinemia
def: "An amino acid metabolic disorder that is characterized by elevated hydroxyproline levels, caused by a deficiency of the hydroxyproline oxidase enzyme resulting in deficient degradation of hydroxyproline, and that has_material_basis_in homozygous or compound heterozygous mutation in the proline dehydrogenase-2 (PRODH2) gene on chromosome 19q13." [url:https\://lhncbc.nlm.nih.gov/newbornscreeningcodes/nb/sc/condition/OH-PRO.html, url:https\://pubmed.ncbi.nlm.nih.gov/27139199/]
xref: MIM:237000
