[Term]
id: DOID:0050165
name: obsolete tuberculous mesenteric gland
def: "A tuberculosis that involves infection of the mesenteric glands by tuberculosis causing mycobacteria. The symptoms include distended abdomen, persistent intestinal indigestion, diarrhea, flatulence, and abdominal pain." [url:http\://books.google.com/books?id=130IVak1eCwC&pg=PA694&lpg=PA694&dq#v=onepage&q=&f=false]
subset: gram-positive_bacterial_infectious_disease
is_obsolete: true

[Term]
id: DOID:0050166
name: salpingitis tuberculosa
def: "Una tuberculosis urogenital que resulta_en la formación de granulomas que se_ubica_en la trompa de Falopio." [url:http\://books.google.com/books?id=tuKGMxGRKa8C&pg=PA627&lpg=PA627&dq#v=onepage&q&f=false]
subset: DO_infectious_disease_slim
