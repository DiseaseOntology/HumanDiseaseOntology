    <!-- http://purl.obolibrary.org/obo/DOID_2800 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2800">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2797"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Neumonía intersticial idiopática que se desarrolla repentinamente y es grave. Inicialmente, el pulmón muestra edema, membranas hialinas e inflamación intersticial aguda. Más tarde, desarrolla fibrosis organizativa laxa, principalmente dentro de los septos alveolares e hiperplasia de neumocitos de tipo II. La fiebre, la tos y la dificultad respiratoria se desarrollan a lo largo de 1 a 2 semanas y suelen evolucionar a insuficiencia respiratoria aguda.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12835</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:J84.114</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:516.33</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000080203</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C35806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79126</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:129459004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0085786</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de Hamman-Rich</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Fibrosis pulmonar idiopática, forma aguda mortal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Hamman-Rich</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">neumonitis intersticial aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">neumonía intersticial acelerada</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2800</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">neumonía intersticial aguda</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2800"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonía intersticial idiopática que se desarrolla repentinamente y es grave. Inicialmente, el pulmón muestra edema, membranas hialinas e inflamación intersticial aguda. Más tarde, desarrolla fibrosis organizativa laxa, principalmente dentro de los septos alveolares e hiperplasia de neumocitos de tipo II. La fiebre, la tos y la dificultad respiratoria se desarrollan a lo largo de 1 a 2 semanas y suelen evolucionar a insuficiencia respiratoria aguda.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmhe/sec04/ch050/ch050b.html?qt=idiopathic%20interstitial%20pneumonia&amp;alt=sh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/11790668</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_2801 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2797"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Neumonía intersticial idiopática que se presenta principalmente en mujeres, personas que no fuman y personas menores de 50 años sin causa ni factores de riesgo conocidos. Las biopsias pulmonares pueden mostrar predominantemente inflamación intersticial o fibrosis, o una combinación de inflamación y fibrosis. La tos seca y la dificultad respiratoria aparecen en un periodo de 6 a 18 meses. Puede aparecer fiebre leve y sensación de enfermedad (malestar general).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C35717</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:129452008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1290344</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2801</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">neumonía intersticial inespecífica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2801"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonía intersticial idiopática que se presenta principalmente en mujeres, personas que no fuman y personas menores de 50 años sin causa ni factores de riesgo conocidos. Las biopsias pulmonares pueden mostrar predominantemente inflamación intersticial o fibrosis, o una combinación de inflamación y fibrosis. La tos seca y la dificultad respiratoria aparecen en un periodo de 6 a 18 meses. Puede aparecer fiebre leve y sensación de enfermedad (malestar general).</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmhe/sec04/ch050/ch050b.html?qt=idiopathic%20interstitial%20pneumonia&amp;alt=sh</oboInOwl:hasDbXref>
    </owl:Axiom>
    


