        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050544"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un trastorno metabólico de aminoácidos que implica un exceso del aminoácido metionina, en la sangre. Esta condición puede producirse cuando la metionina no se descompone adecuadamente en el organismo.</owl:annotatedTarget>
