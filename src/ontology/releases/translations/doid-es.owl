            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Miopatía congénita que se caracteriza por una debilidad congénita grave que suele provocar la muerte por insuficiencia respiratoria en el primer año de vida aproximadamente y que presenta una mutación heterocigota en el gen ACTA1 del cromosoma 1q42. La mutación heterocigota en el gen ACTA1 también puede causar miopatía congénita típica autosómica dominante-2A (CMYP2A). La mutación bialélica en el gen ACTA1 causa la miopatía congénita infantil grave-2B autosómica recesiva (CMYP2B).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:620278</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081340</oboInOwl:id>
        <rdfs:label xml:lang="es">Miopatía congénita 2C</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081340"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miopatía congénita que se caracteriza por una debilidad congénita grave que suele provocar la muerte por insuficiencia respiratoria en el primer año de vida aproximadamente y que presenta una mutación heterocigota en el gen ACTA1 del cromosoma 1q42. La mutación heterocigota en el gen ACTA1 también puede causar miopatía congénita típica autosómica dominante-2A (CMYP2A). La mutación bialélica en el gen ACTA1 causa la miopatía congénita infantil grave-2B autosómica recesiva (CMYP2B).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/34561123/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081337"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Miopatía congénita que se caracteriza por la aparición de debilidad muscular en la infancia manifestada como hipotonía neonatal, retraso en el desarrollo motor y, a menudo, contracturas distales y que presenta una mutación homocigota o heterocigota compuesta en el gen que codifica la titina (TTN) en el cromosoma 2q31.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:611705</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:289377</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Miopatía de Salih</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">miopatía congénita-5 con cardiomiopatía</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081341</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">miopatía congénita 5</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081341"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miopatía congénita que se caracteriza por la aparición de debilidad muscular en la infancia manifestada como hipotonía neonatal, retraso en el desarrollo motor y, a menudo, contracturas distales y que presenta una mutación homocigota o heterocigota compuesta en el gen que codifica la titina (TTN) en el cromosoma 2q31.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/24105469/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081337"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Miopatía congénita que se caracteriza por hipotonía y retraso del desarrollo motor aparente desde la infancia o la niñez, que provoca dificultades para caminar o pérdida de la deambulación en las primeras décadas y que presenta una mutación heterocigota en el gen ACTN2 del cromosoma 1q43. La mutación heterocigota en el gen ACTN2 también puede causar miopatía distal-6 (MPD6), que se manifiesta más tarde y es menos grave.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:618654</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081342</oboInOwl:id>
        <rdfs:label xml:lang="es">miopatía congénita 8</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081342"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miopatía congénita que se caracteriza por hipotonía y retraso del desarrollo motor aparente desde la infancia o la niñez, que provoca dificultades para caminar o pérdida de la deambulación en las primeras décadas y que presenta una mutación heterocigota en el gen ACTN2 del cromosoma 1q43. La mutación heterocigota en el gen ACTN2 también puede causar miopatía distal-6 (MPD6), que se manifiesta más tarde y es menos grave.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/30701273/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081337"/>
