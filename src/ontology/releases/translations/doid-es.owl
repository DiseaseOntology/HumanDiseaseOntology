    <!-- http://purl.obolibrary.org/obo/DOID_0081359 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4603"/>
        <obo:IAO_0000115 xml:lang="es">Hiperqueratosis epidermolítica que se caracteriza por eritema generalizado, erosiones, descamación y ampollas que se rompen con facilidad, que se hacen menos frecuentes más tarde en la vida, mientras que la hiperqueratosis aumenta y que presenta una mutación autosómica recesiva heterocigota u homocigota en el gen de la queratina-10 (KRT10) en el cromosoma 17q21.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
