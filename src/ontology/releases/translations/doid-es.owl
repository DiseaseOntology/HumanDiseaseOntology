        <oboInOwl:hasDbXref>UMLS_CUI:C0265235</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Sordera, miopía, cataratas, nariz en silla de montar-tipo Marshall</oboInOwl:hasExactSynonym>
