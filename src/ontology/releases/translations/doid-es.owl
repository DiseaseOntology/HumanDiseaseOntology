        <oboInOwl:id>DOID:3983</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">esofagostomiasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3983"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección del intestino de cabras, cerdos y humanos por el nematodo Oesophagostomum bifurcum. Los síntomas son fiebre baja, sensibilidad en el cuadrante inferior derecho y masas cutáneas indoloras en la región abdominal inferior. En raras ocasiones, Oesophagostomum spp perfora la pared intestinal, causando peritonitis purulenta, o migra a la piel, produciendo nódulos cutáneos.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Oesophagostomiasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


