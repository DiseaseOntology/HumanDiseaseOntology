        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2355"/>
        <obo:IAO_0000115 xml:lang="en">An anemia that is characterized by a decrease in the ratio of the weight of hemoglobin to the volume of the erythrocyte. As a result, the red cells have an area of central pallor which is increased in size. The leading cause is iron deficiency.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:D50</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000747</oboInOwl:hasDbXref>
