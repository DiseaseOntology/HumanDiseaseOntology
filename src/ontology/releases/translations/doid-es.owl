                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000232"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad carencial nutricional que se caracteriza por una anemia normocítica asociada a la deficiencia de piridoxina (vitamina B6), y tiene_material_basis_en una disminución de la ingesta, malabsorción, aumento del aclaramiento o descomposición, y ciertos medicamentos (por ejemplo, isoniazida).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:E53.1</oboInOwl:hasDbXref>
