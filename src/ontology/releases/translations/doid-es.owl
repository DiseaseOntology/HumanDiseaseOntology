    <!-- http://purl.obolibrary.org/obo/DOID_0080208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9452"/>
        <obo:IAO_0000115 xml:lang="en">A steatotic liver disease characterized by at least one of five specified cardiometabolic risk factors and no other discernible cause with normal to no alcohol use. The five cardiometabolic risk factors are: (1) higher than normal body mass index or waist circumference; (2) higher than normal serum glucose or glycated hemoglobin level, or type 2 diabetes; (3) higher than normal blood pressure or hypertensive treatment; (4) higher than normal plasma triglycerides or lipid lowering treatment; and (5) lower than normal plasma high-density lipoprotein cholesterol.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:0080546</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>MESH:D065626</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:613282</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:613387</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad del hígado graso asociada a disfunción metabólica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad del hígado graso asociada al metabolismo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad del hígado graso no alcohólico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad hepática esteatósica relacionada con disfunción metabólica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080208</oboInOwl:id>
        <rdfs:label xml:lang="es">Enfermedad hepática esteatósica asociada a disfunción metabólica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A steatotic liver disease characterized by at least one of five specified cardiometabolic risk factors and no other discernible cause with normal to no alcohol use. The five cardiometabolic risk factors are: (1) higher than normal body mass index or waist circumference; (2) higher than normal serum glucose or glycated hemoglobin level, or type 2 diabetes; (3) higher than normal blood pressure or hypertensive treatment; (4) higher than normal plasma triglycerides or lipid lowering treatment; and (5) lower than normal plasma high-density lipoprotein cholesterol.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/37364816/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


