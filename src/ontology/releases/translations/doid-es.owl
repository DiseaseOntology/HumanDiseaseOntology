    <!-- http://purl.obolibrary.org/obo/DOID_0081070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081065"/>
        <obo:IAO_0000115 xml:lang="es">Linfoma difuso de células B grandes EZB que expresa la firma de expresión génica de doble hit (DHITsig+) según el perfil de expresión génica. Además de los rasgos característicos de EZB, estos casos suelen albergar, aunque no siempre, translocaciones MYC y mutaciones DDX3X.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="es">LDCBG EZB-MYC+</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081070</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <rdfs:label xml:lang="es">Linfoma difuso de células B grandes EZB-MYC+</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
