    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_1252"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa helmintiásica parasitaria que consiste en una infección parasitaria localizada_en el intestino en los seres humanos y tiene_base_material_en Trichuris trichiura, que se transmite_por ingestión de alimentos contaminados con tierra portadora de huevos. La infección tiene_síntomas de dolor abdominal, tiene_síntomas de diarrea, tiene_síntomas de prolapso rectal y tiene_síntomas de retraso del crecimiento.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
