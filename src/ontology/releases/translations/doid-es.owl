        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Leishmaniasis que consiste en un proceso inflamatorio crónico que afecta a la mucosa nasal, faríngea y laríngea, que puede provocar una extensa destrucción tisular, causada por parásitos protozoarios pertenecientes al género Leishmania. La infección se caracteriza por lesiones granulomatosas que pueden destruir la mucosa del tracto respiratorio superior.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B55.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:085.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007897</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:721813000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1328252</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Leishmaniasis cutánea americana</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Leishmaniasis cutánea del Nuevo Mundo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Leishmaniasis mucocutánea americana</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9155</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">leishmaniasis mucocutánea</rdfs:label>
    </owl:Class>
