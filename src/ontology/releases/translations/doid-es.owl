        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8454"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad carencial nutricional que se caracteriza por estomatitis, queilosis, glositis, conjuntivitis y anemia, se desarrolla a partir de la carencia de vitamina B2 (riboflavina), tiene síntoma de labios rojos y agrietados, lengua hinchada y dolorosa, dolor de garganta, visión borrosa y fatiga, y tiene como base material la ingesta inadecuada, el trastorno endocrino, el trastorno hepático, el alcoholismo y la diálisis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007646"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK470460/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_8455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2355"/>
