        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:195648002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0009443</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Coriza aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Nasofaringitis - aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Nasofaringitis aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Nasofaringitis, aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Rinitis aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Rinofaringitis viral aguda</oboInOwl:hasExactSynonym>
