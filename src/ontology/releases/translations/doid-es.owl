        <oboInOwl:hasDbXref>MIM:PS267700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34792</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:540</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:190958003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024291</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
