    <!-- http://purl.obolibrary.org/obo/DOID_8545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_66"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004005"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MIM_145600"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004005"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MIM_601887"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del tejido muscular que se caracteriza por un aumento drástico e incontrolado del metabolismo oxidativo del músculo esquelético, que desborda la capacidad del organismo para suministrar oxígeno, eliminar dióxido de carbono y regular la temperatura corporal y que tiene base material en mutación heterocigota en el gen del receptor de rianodina (RYR1) en el cromosoma 19q13. Las manifestaciones de hipertermia maligna (HM) se precipitan por ciertos anestésicos volátiles (es decir, halotano, isoflurano, sevoflurano, desflurano, enflurano), solos o junto con un relajante muscular despolarizante (en concreto, succinilcolina).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6964</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:T88.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008305</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS145600</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:423</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:111738008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024591</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">hiperpirexia maligna debida a la anestesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">hipertermia relacionada con la anestesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8545</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">hipertermia maligna</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del tejido muscular que se caracteriza por un aumento drástico e incontrolado del metabolismo oxidativo del músculo esquelético, que desborda la capacidad del organismo para suministrar oxígeno, eliminar dióxido de carbono y regular la temperatura corporal y que tiene base material en mutación heterocigota en el gen del receptor de rianodina (RYR1) en el cromosoma 19q13. Las manifestaciones de hipertermia maligna (HM) se precipitan por ciertos anestésicos volátiles (es decir, halotano, isoflurano, sevoflurano, desflurano, enflurano), solos o junto con un relajante muscular despolarizante (en concreto, succinilcolina).</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Malignant_hyperthermia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


