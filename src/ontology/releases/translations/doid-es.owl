        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1510"/>
        <obo:IAO_0000115 xml:lang="en">A personality disorder that is characterized by a lack of interest in social relationships, a tendency towards a solitary lifestyle, secretiveness, emotional coldness and sometimes sexual apathy, with a simultaneous rich, elaborate and exclusively internal fantasy world.</obo:IAO_0000115>
