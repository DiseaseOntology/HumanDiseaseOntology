        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0111717"/>
        <obo:IAO_0000115 xml:lang="en">An isolated cryptophthalmia characterized by fusion of the upper eyelid skin to the superior aspect of the globe often associated with microphthalmia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ORDO:98948</oboInOwl:hasDbXref>
