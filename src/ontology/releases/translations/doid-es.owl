    <!-- http://purl.obolibrary.org/obo/DOID_0060358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_655"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SO_0001537"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An inherited metabolic disorder characterized by the body&apos;s inability to break down proteins and fats to produce energy. It is a disorder of fatty acid, amino acid, and choline metabolism and has an autosomal recessive inheritance pattern. It has_material_basis_in mutations in the ETFA, ETFB and ETFDH genes. It presents three clinical phenotypes: a neonatal-onset form with congenital anomalies (type I), a neonatal-onset form without congenital anomalies (type II), and a late-onset form (type III). The neonatal-onset forms are usually fatal.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-08-20T16:23:47Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>ICD10CM:E71.313</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D054069</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:231680</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84907</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:26791</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:22886006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0268596</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1856401</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1856403</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1856405</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">acidemia glutárica tipo 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">aciduria glutárica tipo 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia MAD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de flavoproteína de transferencia de electrones</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de flavoproteína de transferencia de electrones ubiquinona oxidoreductasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060358</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">deficiencia múltiple de acil-CoA deshidrogenasa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An inherited metabolic disorder characterized by the body&apos;s inability to break down proteins and fats to produce energy. It is a disorder of fatty acid, amino acid, and choline metabolism and has an autosomal recessive inheritance pattern. It has_material_basis_in mutations in the ETFA, ETFB and ETFDH genes. It presents three clinical phenotypes: a neonatal-onset form with congenital anomalies (type I), a neonatal-onset form without congenital anomalies (type II), and a late-onset form (type III). The neonatal-onset forms are usually fatal.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
