            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La atrofia óptica se caracteriza por un retraso en el desarrollo psicomotor, discapacidad intelectual, ataxia, atrofia óptica y leucoencefalopatía consistente con una disfunción mitocondrial y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen YME1L1 en el cromosoma 10p12.1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617302</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111436</oboInOwl:id>
        <rdfs:label xml:lang="es">atrofia óptica 11</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111436"/>
