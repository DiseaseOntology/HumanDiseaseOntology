    <!-- http://purl.obolibrary.org/obo/DOID_9398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_974"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de las vías respiratorias superiores que consiste en la inflamación de la epiglotis debido a una infección. Haemophilus influenzae tipo B es el agente causal bacteriano más frecuente, aunque algunos casos son atribuibles a Streptococcus pneumoniae o Streptococcus pyogenes. La infección puede hacer que la epiglotis obstruya o cierre completamente la tráquea. La epiglotitis suele afectar a los niños y se asocia a fiebre, dificultad para tragar, babeo, ronquera y estridor.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:9397</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9479</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9481</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J05.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:J05.10</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:464.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004826</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C116007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:29608009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:80384002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0014541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0155814</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">epiglotitis aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">epiglotitis aguda y supraglottitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9398</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">epiglotitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9398"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad de las vías respiratorias superiores que consiste en la inflamación de la epiglotis debido a una infección. Haemophilus influenzae tipo B es el agente causal bacteriano más frecuente, aunque algunos casos son atribuibles a Streptococcus pneumoniae o Streptococcus pyogenes. La infección puede hacer que la epiglotis obstruya o cierre completamente la tráquea. La epiglotitis suele afectar a los niños y se asocia a fiebre, dificultad para tragar, babeo, ronquera y estridor.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Epiglottitis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


