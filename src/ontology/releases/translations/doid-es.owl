        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa bacteriana comensal que da lugar a infección, tiene base material en Actinobacillus ureae, que es un comensal del tracto respiratorio humano. El patógeno causa meningitis, endocarditis, bacteriemia, rinitis atrófica, bronquitis, neumonía, conjuntivitis, peritonitis y otitis media.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://www.sciencedirect.com/science/article/pii/073646799500066J</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.merckvetmanual.com/generalized-conditions/actinobacillosis/actinobacillosis</oboInOwl:hasDbXref>
