        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:47382004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0031898</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C2980104</oboInOwl:hasDbXref>
