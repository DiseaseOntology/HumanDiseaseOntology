                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003593"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A primary immunodeficiency disease that is characterized by highly variable phenotype that may include both immunodeficiency with recurrent infections, including bacterial and fungal infections, as well as autoimmune features, including autoimmune hemolytic anemia, pancytopenia, thrombocytopenia, and inflammatory bowel disease and that has_material_basis_in homozygous or compound heterozygous mutation in the SLP76 gene on chromosome 5q33.</obo:IAO_0000115>
