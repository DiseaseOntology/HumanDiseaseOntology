    <!-- http://purl.obolibrary.org/obo/DOID_13327 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9283"/>
        <obo:IAO_0000115 xml:lang="es">Glaucoma borderline caracterizado por un ángulo anatómico estrecho de la cámara anterior con o sin características clínicas adicionales y factores de riesgo asociados con una alta probabilidad de desarrollar atrofia óptica glaucomatosa en el futuro. Estas características adicionales pueden incluir presión intraocular elevada, anomalías de la capa de fibras nerviosas de la retina, ángulos anormales de la cámara anterior y/o antecedentes familiares positivos de glaucoma sin ninguna evidencia de atrofia actual del nervio óptico.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:365.02</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0154941</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13327</oboInOwl:id>
        <rdfs:label xml:lang="es">glaucoma borderline anatómico de ángulo estrecho</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13327"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
