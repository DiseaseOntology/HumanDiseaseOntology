        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080920</oboInOwl:id>
        <rdfs:label xml:lang="es">polimicrogiria bilateral generalizada</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080920"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una polimicrogiria que se caracteriza por una discapacidad intelectual grave, problemas de movimiento y convulsiones y que afecta a todo el cerebro.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK1329/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080921 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080918"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_1059"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una polimicrogiria que se caracteriza por ser una forma simétrica y bilateral (en ambos hemisferios cerebrales) que sólo afecta a los lóbulos frontales sin incluir el área situada detrás de la fisura de Sylvius ni el área situada detrás del surco de Rolando. Los síntomas incluyen retraso en los hitos motores y del lenguaje; hemiparesia espástica (rigidez) (debilidad en un lado del cuerpo) o cuadriparesia (debilidad en las cuatro extremidades del cuerpo); y discapacidad intelectual de leve a moderada.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:208444</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080921</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">polimicrogiria frontal bilateral</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080921"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una polimicrogiria que se caracteriza por ser una forma simétrica y bilateral (en ambos hemisferios cerebrales) que sólo afecta a los lóbulos frontales sin incluir el área situada detrás de la fisura de Sylvius ni el área situada detrás del surco de Rolando. Los síntomas incluyen retraso en los hitos motores y del lenguaje; hemiparesia espástica (rigidez) (debilidad en un lado del cuerpo) o cuadriparesia (debilidad en las cuatro extremidades del cuerpo); y discapacidad intelectual de leve a moderada.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Polymicrogyria#Unilateral_polymicrogyria</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://rarediseases.info.nih.gov/diseases/10783/bilateral-frontal-polymicrogyria</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080922 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0090131"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A complex cortical dysplasia with other brain malformations that is characterized by a global developmental delay with impaired intellectual development, motor delay, poor speech development, and early-onset seizures, often focal or atypical absence and that has_material_basis_in homozygous mutation in the ADGRG1 gene on chromosome 16q21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10784</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:606854</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C148367</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080922</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">complex cortical dysplasia with other brain malformations 14A</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080922"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A complex cortical dysplasia with other brain malformations that is characterized by a global developmental delay with impaired intellectual development, motor delay, poor speech development, and early-onset seizures, often focal or atypical absence and that has_material_basis_in homozygous mutation in the ADGRG1 gene on chromosome 16q21.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/34863467/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080923 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
