        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3541"/>
        <obo:IAO_0000115 xml:lang="es">Cáncer del ventrículo cerebral que se caracteriza por la presencia de células neoplásicas uniformes y redondas con diferenciación neuronal, que surge del parénquima cerebral. A diferencia del neurocitoma central, no afecta a los ventrículos laterales.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9506/1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C92555</oboInOwl:hasDbXref>
