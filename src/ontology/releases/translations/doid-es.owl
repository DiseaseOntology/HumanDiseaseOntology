            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000041"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000095"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000570"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección parasitaria de animales y seres humanos por Trichinella spiralis, Trichinella nativa o Trichinella britovi. La invasión intestinal provoca diarrea, dolor abdominal y vómitos. La migración de las larvas a los tejidos musculares puede causar edema periorbitario y facial, conjuntivitis, fiebre, mialgias, hemorragias en astilla, erupciones cutáneas y eosinofilia sanguínea. También pueden producirse miocarditis, afectación del sistema nervioso central y neumonitis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B75</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:124</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C85199</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:709018004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0040896</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Trichinella spiralis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9784</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">triquinosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9784"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección parasitaria de animales y seres humanos por Trichinella spiralis, Trichinella nativa o Trichinella britovi. La invasión intestinal provoca diarrea, dolor abdominal y vómitos. La migración de las larvas a los tejidos musculares puede causar edema periorbitario y facial, conjuntivitis, fiebre, mialgias, hemorragias en astilla, erupciones cutáneas y eosinofilia sanguínea. También pueden producirse miocarditis, afectación del sistema nervioso central y neumonitis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Trichinellosis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


