    <!-- http://purl.obolibrary.org/obo/DOID_0081372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081370"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome LADD que se caracteriza por aplasia, atresia o hipoplasia de los sistemas lagrimal y salival, orejas en forma de copa, pérdida de audición y anomalías dentales y digitales y que presenta una mutación heterocigota en el gen FGF10 del cromosoma 5p12.</obo:IAO_0000115>
