        <oboInOwl:hasDbXref>MIM:267450</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:26168007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0020192</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">HMD - Enfermedad de la membrana hialina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de distrés respiratorio neonatal</oboInOwl:hasExactSynonym>
