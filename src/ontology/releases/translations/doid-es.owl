        <rdfs:label xml:lang="es">displasia ectodérmica e inmunodeficiencia 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081078"/>
