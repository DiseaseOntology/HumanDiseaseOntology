                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000570"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una inmunodeficiencia combinada grave que tiene_como_base los genes RAG1 y RAG2 del cromosoma 11p y en el gen Artemis del cromosoma 10p. Se caracteriza por eritrodermia, descamación, alopecia, diarrea crónica, retraso del crecimiento, linfadenopatía y hepatoesplenomegalia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8198</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:D81.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:603554</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">inmunodeficiencia combinada con hipereosinofilia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060010</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de Omenn</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una inmunodeficiencia combinada grave que tiene_como_base los genes RAG1 y RAG2 del cromosoma 11p y en el gen Artemis del cromosoma 10p. Se caracteriza por eritrodermia, descamación, alopecia, diarrea crónica, retraso del crecimiento, linfadenopatía y hepatoesplenomegalia.</owl:annotatedTarget>
