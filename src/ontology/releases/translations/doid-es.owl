        <oboInOwl:hasDbXref>ICD9CM:007.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D003457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C128408</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:186126003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0010418</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Cryptosporidium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">criptosporidiosis intestinal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
