        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">displasia espondiloepimetafisaria, tipo Genevieve</rdfs:label>
    </owl:Class>
    <owl:Axiom>
