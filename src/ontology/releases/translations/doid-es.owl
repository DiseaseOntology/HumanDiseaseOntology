                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La enfermedad del desarrollo óseo se caracteriza por un retraso grave en la osificación principalmente de las epífisis, la pelvis, las manos y los pies y un modelado óseo anormal de las manos y los pies y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen PTHR1 en el cromosoma 3p21.31.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C564010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:600002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79106</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:720863002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1838779</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Defecto en la modelación ósea de manos y pies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia esquelética de Eiken</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111732</oboInOwl:id>
