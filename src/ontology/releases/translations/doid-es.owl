                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000654"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Infestación por piojos que consiste en la colonización del cabello y la piel por el insecto parásito Pediculus humanus capitis, que se alimenta de sangre varias veces al día y reside cerca del cuero cabelludo para mantener su temperatura corporal. Los síntomas incluyen sensación de cosquilleo de algo moviéndose en el pelo, picor, causado por una reacción alérgica a la saliva del piojo, e irritabilidad.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B85.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:132.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:81000006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0030757</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infestación por Pediculus capitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:5501</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">infestación por Pediculus humanus capitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_5501"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Infestación por piojos que consiste en la colonización del cabello y la piel por el insecto parásito Pediculus humanus capitis, que se alimenta de sangre varias veces al día y reside cerca del cuero cabelludo para mantener su temperatura corporal. Los síntomas incluyen sensación de cosquilleo de algo moviéndose en el pelo, picor, causado por una reacción alérgica a la saliva del piojo, e irritabilidad.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
