    <!-- http://purl.obolibrary.org/obo/DOID_0060917 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080578"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11727"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000930"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una distrofia muscular facioescapulohumeral caracterizada por la aparición en la edad adulta de debilidad muscular proximal que afecta a la cara, el cuello, los músculos escapulares y las extremidades superiores e inferiores que tiene_como_base la combinación de una mutación homocigota en el gen LRIF1 del cromosoma 1p13 y la presencia de un haplotipo en el cromosoma 4 que es permisivo para la expresión de DUX4.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:619477</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia muscular facioscapulohumeral tipo 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060917</oboInOwl:id>
        <rdfs:label xml:lang="es">distrofia muscular facioescapulohumeral 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060917"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distrofia muscular facioescapulohumeral caracterizada por la aparición en la edad adulta de debilidad muscular proximal que afecta a la cara, el cuello, los músculos escapulares y las extremidades superiores e inferiores que tiene_como_base la combinación de una mutación homocigota en el gen LRIF1 del cromosoma 1p13 y la presencia de un haplotipo en el cromosoma 4 que es permisivo para la expresión de DUX4.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/32467133/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


