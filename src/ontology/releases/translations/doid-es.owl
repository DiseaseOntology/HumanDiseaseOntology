        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/16142185</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/16456642</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/23001799</oboInOwl:hasDbXref>
