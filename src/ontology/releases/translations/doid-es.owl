                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000868"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Tétanos que se produce en los recién nacidos cuando el muñón del cordón umbilical se ensucia al cortarlo con una cuchilla sucia o al aplicarle sustancias que contienen bacterias. La infección presenta síntomas de rigidez corporal, espasmos musculares, dificultad para respirar y agotamiento.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:A33</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:771.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C116814</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:43424001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0343312</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">tétanos neonatal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13521</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">tétanos neonatal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13521"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Tétanos que se produce en los recién nacidos cuando el muñón del cordón umbilical se ensucia al cortarlo con una cuchilla sucia o al aplicarle sustancias que contienen bacterias. La infección presenta síntomas de rigidez corporal, espasmos musculares, dificultad para respirar y agotamiento.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Neonatal_tetanus</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1080"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5614"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000014"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000970"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000672"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Filariasis que consiste en una infección parasitaria de la piel y los ojos causada por el nematodo Loa loa, que se transmite a través de la picadura de la mosca del ciervo o la mosca del mango. La enfermedad se caracteriza por angioedemas episódicos en brazos y piernas, y agrandamientos en forma de quiste del tejido conjuntivo alrededor de las vainas de los tendones musculares. Los gusanos muertos pueden causar abscesos crónicos, que pueden dar lugar a la formación de reacciones granulomatosas y fibrosis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:3283</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B74.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:125.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008118</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34784</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:44250009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0023968</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13523</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">loiasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Filariasis que consiste en una infección parasitaria de la piel y los ojos causada por el nematodo Loa loa, que se transmite a través de la picadura de la mosca del ciervo o la mosca del mango. La enfermedad se caracteriza por angioedemas episódicos en brazos y piernas, y agrandamientos en forma de quiste del tejido conjuntivo alrededor de las vainas de los tendones musculares. Los gusanos muertos pueden causar abscesos crónicos, que pueden dar lugar a la formación de reacciones granulomatosas y fibrosis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Loiasis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13526">
        <obo:IAO_0000115 xml:lang="en">A candidiasis that results_in inflammation located_in endocardium, has_material_basis_in Candida, which favors previously damaged or prosthetic heart valves. The source is often an intravascular catheter or contaminated equipment used for illicit intravenous drug injection. The illness has_symptom fever, has_symptom murmur, has_symptom congestive heart failure, has_symptom anemia, and has_symptom splenomegaly.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13526</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete candidal endocarditis</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13526"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A candidiasis that results_in inflammation located_in endocardium, has_material_basis_in Candida, which favors previously damaged or prosthetic heart valves. The source is often an intravascular catheter or contaminated equipment used for illicit intravenous drug injection. The illness has_symptom fever, has_symptom murmur, has_symptom congestive heart failure, has_symptom anemia, and has_symptom splenomegaly.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://mycology.adelaide.edu.au/Mycoses/Cutaneous/Candidiasis/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.accessmedicine.com/resourceTOC.aspx?resourceID=4</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13527">
        <obo:IAO_0000115 xml:lang="en">A candidiasis that involves fungal infection of the outer ear canal caused by Candida species. The symptoms include discharge, tinnitus, pruritus, and a feeling of fullness in the ear resulting in scratching and further damage to the epidermis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13527</oboInOwl:id>
