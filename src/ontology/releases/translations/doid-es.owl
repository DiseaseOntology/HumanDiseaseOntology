        <oboInOwl:hasDbXref>MIM:143100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C82342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:58756001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0020179</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Corea de Huntington</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de Huntington</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12858</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_FlyBase_slim"/>
