                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome caracterizado por retraso del desarrollo, microcefalia progresiva, baja estatura y rasgos dismórficos que incluyen escaso pelo en el cuero cabelludo, orejas en forma de copa, nariz y boca anchas, surco nasolabial corto y paladar de arco alto que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen WLS del cromosoma 1p31.3. Otras características variables pueden incluir anomalías oculares, esqueléticas, cardíacas y renales.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:619648</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
