    <!-- http://purl.obolibrary.org/obo/DOID_0081391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081388"/>
        <obo:IAO_0000115 xml:lang="es">Afasia primaria progresiva que se caracteriza por la pérdida progresiva, amodal y profunda del conocimiento semántico y por anomalías del comportamiento, atribuibles a la degeneración de los lóbulos temporales anteriores.</obo:IAO_0000115>
