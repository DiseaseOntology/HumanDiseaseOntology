        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9255"/>
        <obo:IAO_0000115 xml:lang="es">Demencia frontotemporal que se caracteriza por la pérdida de funciones cognitivas como la capacidad de pensar, recordar o razonar hasta el punto de que interfiere en la vida y las actividades cotidianas de la persona.</obo:IAO_0000115>
