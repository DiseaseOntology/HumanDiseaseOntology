    <!-- http://purl.obolibrary.org/obo/DOID_13117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4123"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de las uñas que se caracteriza por una infección bacteriana o fúngica de las manos o los pies, a menudo dolorosa, debida a bacterias u hongos (Candida albicans) en la zona donde la uña y la piel se unen en el lateral o la base de la uña de un dedo de la mano o del pie. La infección puede comenzar de forma repentina (paroniquia aguda) o gradual (paroniquia crónica). Suele aparecer pus, junto con un engrosamiento gradual y una decoloración marrón de la lámina ungueal.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:11398</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9689</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:L03.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D010304</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C79702</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:71906005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0030578</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Oniquia y paroniquia de dedo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Oniquia y paroniquia del dedo del pie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Pliegue ungueal infectado</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">infección por hongos en las uñas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">inflamación paroniquia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:13117</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">paroniquia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13117"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad de las uñas que se caracteriza por una infección bacteriana o fúngica de las manos o los pies, a menudo dolorosa, debida a bacterias u hongos (Candida albicans) en la zona donde la uña y la piel se unen en el lateral o la base de la uña de un dedo de la mano o del pie. La infección puede comenzar de forma repentina (paroniquia aguda) o gradual (paroniquia crónica). Suele aparecer pus, junto con un engrosamiento gradual y una decoloración marrón de la lámina ungueal.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Paronychia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


