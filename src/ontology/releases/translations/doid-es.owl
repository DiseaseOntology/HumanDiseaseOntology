        <rdfs:label xml:lang="en">obsolete Trypanosoma brucei gambiense infectious disease</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
