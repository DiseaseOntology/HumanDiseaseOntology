                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000369"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000493"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019180"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El botulismo que consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA o B) en bebés, tiene_como_base el Clostridium botulinum A o tiene_como_base el Clostridium botulinum B, que se_transmite_por ingestión de esporas bacterianas, que luego crecen en el intestino y liberan toxinas. La infección tiene_como_síntoma estreñimiento, tiene_como_síntoma letargo, tiene_como_síntoma dificultad para alimentarse, tiene_como_síntoma deglución, tiene_como_síntoma ptosis, tiene_como_síntoma pérdida de control de la cabeza y tiene_como_síntoma debilidad muscular.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050354</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">botulismo infantil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050354"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El botulismo que consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA o B) en bebés, tiene_como_base el Clostridium botulinum A o tiene_como_base el Clostridium botulinum B, que se_transmite_por ingestión de esporas bacterianas, que luego crecen en el intestino y liberan toxinas. La infección tiene_como_síntoma estreñimiento, tiene_como_síntoma letargo, tiene_como_síntoma dificultad para alimentarse, tiene_como_síntoma deglución, tiene_como_síntoma ptosis, tiene_como_síntoma pérdida de control de la cabeza y tiene_como_síntoma debilidad muscular.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.aafp.org/afp/2002/0401/p1388.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


