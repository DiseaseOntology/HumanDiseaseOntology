    <!-- http://purl.obolibrary.org/obo/DOID_0080778 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
