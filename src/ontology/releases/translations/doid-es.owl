                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019142"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_2723"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La filariasis que consiste en una infección parasitaria causada por el nematodo Onchocerca volvulus, que se transmite al ser humano a través de la picadura de una mosca negra del género Simulium. Los gusanos se extienden por todo el cuerpo y, cuando mueren, provocan un picor intenso y una fuerte respuesta del sistema inmunitario que puede destruir los tejidos cercanos. Los síntomas incluyen prurito, dermatitis ceguera, oncocercomata (nódulos subcutáneos) y linfadenopatía.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7252</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B73</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:125.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D009855</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34861</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:38539003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0029001</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Onchocerca volvulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Volvulosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11678</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">oncocercosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La filariasis que consiste en una infección parasitaria causada por el nematodo Onchocerca volvulus, que se transmite al ser humano a través de la picadura de una mosca negra del género Simulium. Los gusanos se extienden por todo el cuerpo y, cuando mueren, provocan un picor intenso y una fuerte respuesta del sistema inmunitario que puede destruir los tejidos cercanos. Los síntomas incluyen prurito, dermatitis ceguera, oncocercomata (nódulos subcutáneos) y linfadenopatía.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Filariasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


