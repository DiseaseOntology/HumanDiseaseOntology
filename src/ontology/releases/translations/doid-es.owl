    <!-- http://purl.obolibrary.org/obo/DOID_8912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050133"/>
        <obo:IAO_0000115 xml:lang="es">Micosis superficial que es una infección fúngica superficial de la piel caracterizada por máculas de color marrón a negro que suelen aparecer en la cara palmar de las manos y ocasionalmente en la cara plantar y otras superficies de la piel, causada por Hortaea werneckii, que es un hongo saprofito común que se cree que aparece en el suelo, el compost, el humus y en la madera en regiones tropicales y subtropicales húmedas.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B36.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:111.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C000656904</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:1022006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0152067</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Cladosporium werneckii</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Queratomicosis nigricans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8912</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">tiña negra</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8912"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Micosis superficial que es una infección fúngica superficial de la piel caracterizada por máculas de color marrón a negro que suelen aparecer en la cara palmar de las manos y ocasionalmente en la cara plantar y otras superficies de la piel, causada por Hortaea werneckii, que es un hongo saprofito común que se cree que aparece en el suelo, el compost, el humus y en la madera en regiones tropicales y subtropicales húmedas.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
