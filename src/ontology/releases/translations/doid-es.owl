        <oboInOwl:hasExactSynonym xml:lang="es">síndrome craneofacial-cubital-renal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome oculo-palato-esquelético</oboInOwl:hasExactSynonym>
