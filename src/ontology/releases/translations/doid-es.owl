        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La disostosis acrofacial se caracteriza por anomalías dentales, distrofia ungueal, polidactilia postaxial y estatura baja leve y tiene_base_material_en una mutación heterocigota en los genes EVC2 o EVC en el cromosoma 4p16.2.</owl:annotatedTarget>
