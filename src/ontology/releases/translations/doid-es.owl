        <owl:annotatedTarget xml:lang="en">Arachnid borne transmission is an arthropod vector-borne transmission process during which the pathogen is indirectly transferred from a reservoir, source or host via an intermediary arthropod vector such as a tick to another host.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Disease_vector</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRANS_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRANS_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Propagative transmission is an indirect vector-borne biological transmission process during which the pathogen that is ingested with the blood meal undergoes simple multiplication in the body of the vector.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>transmission_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>TRANS:0000028</oboInOwl:id>
        <rdfs:label xml:lang="en">propagative transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000028"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Propagative transmission is an indirect vector-borne biological transmission process during which the pathogen that is ingested with the blood meal undergoes simple multiplication in the body of the vector.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.32873/unl.dc.ciap070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pressbooks.nebraska.edu/ciap/chapter/chapter-4/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRANS_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRANS_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Cyclopropagative transmission is an indirect vector-borne biological transmission process during which the pathogen undergoes a developmental cycle (changes from one stage to another) as well as multiplication in the body of the vector.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>transmission_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>TRANS:0000029</oboInOwl:id>
        <rdfs:label xml:lang="en">cyclopropagative transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000029"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Cyclopropagative transmission is an indirect vector-borne biological transmission process during which the pathogen undergoes a developmental cycle (changes from one stage to another) as well as multiplication in the body of the vector.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.32873/unl.dc.ciap070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pressbooks.nebraska.edu/ciap/chapter/chapter-4/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRANS_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRANS_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Cyclodevelopmental transmission is an indirect vector-borne biological transmission process during which the pathogen undergoes developmental changes from one stage to another, but does not multiply.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>transmission_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>TRANS:0000030</oboInOwl:id>
        <rdfs:label xml:lang="en">cyclodevelopmental transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000030"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Cyclodevelopmental transmission is an indirect vector-borne biological transmission process during which the pathogen undergoes developmental changes from one stage to another, but does not multiply.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.32873/unl.dc.ciap070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pressbooks.nebraska.edu/ciap/chapter/chapter-4/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRANS_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRANS_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Transovarial transmission is an indirect vector-borne biological transmission process during which the pathogen is transmitted from the female parent through the eggs to the offspring and the developing egg is infected.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>transmission_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>TRANS:0000031</oboInOwl:id>
        <rdfs:label xml:lang="en">transovarial transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000031"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Transovarial transmission is an indirect vector-borne biological transmission process during which the pathogen is transmitted from the female parent through the eggs to the offspring and the developing egg is infected.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://pubmed.ncbi.nlm.nih.gov/15463476/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.cdc.gov/tick-borne-encephalitis/php/transmission/index.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRANS_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRANS_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Vertical transmission is an indirect vector-borne biological transmission process during which the pathogen is transmitted from the female parent through the eggs to the offspring. Only the ovarial sheath and oviduct are infected. The egg becomes infected as it passes down the oviduct and is inseminated.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>transmission_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>TRANS:0000032</oboInOwl:id>
        <rdfs:label xml:lang="en">vertical transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000032"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Vertical transmission is an indirect vector-borne biological transmission process during which the pathogen is transmitted from the female parent through the eggs to the offspring. Only the ovarial sheath and oviduct are infected. The egg becomes infected as it passes down the oviduct and is inseminated.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://www.oie.int/doc/ged/D6818.PDF</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRANS_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRANS_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Trans-stadial transmission is an indirect vector-borne biological transmission process during which the newly hatched larval stages are infected with the pathogen, which is then transmitted to subsequent development stages of the vector.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="en">transstadial transmission</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>transmission_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>TRANS:0000033</oboInOwl:id>
        <rdfs:label xml:lang="en">trans-stadial transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Trans-stadial transmission is an indirect vector-borne biological transmission process during which the newly hatched larval stages are infected with the pathogen, which is then transmitted to subsequent development stages of the vector.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://en.wikipedia.org/wiki/Transstadial_transmission</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.cdc.gov/tick-borne-encephalitis/php/transmission/index.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/TRANS_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/TRANS_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000015"/>
        <obo:IAO_0000115 xml:lang="en">Venereal transmission is an indirect vector-borne biological transmission process during which the pathogen is transferred to uninfected female vectors in the seminal fluid during copulation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>transmission_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>TRANS:0000034</oboInOwl:id>
        <rdfs:label xml:lang="en">venereal transmission</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000034"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">Venereal transmission is an indirect vector-borne biological transmission process during which the pathogen is transferred to uninfected female vectors in the seminal fluid during copulation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6136804/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


