        <oboInOwl:hasDbXref>UMLS_CUI:C1266166</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Osteosarcoma intracortical</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Osteosarcoma medular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">osteosarcoma central convencional</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">sarcoma osteogénico intracortical</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:7602</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">osteosarcoma convencional</rdfs:label>
    </owl:Class>
