                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una microftalmia aislada caracterizada por la herencia autosómica recesiva de microftalmia posterior, hipermetropía, ceguera nocturna, disminución de la agudeza visual, reducción del reflejo macular, engrosamiento escleral, respuestas impares de bastones y conos en el ERG, foveosquisis y en algunos pacientes atrofia del epitelio pigmentario de la retina, atenuación arteriolar, glaucoma de ángulo cerrado y drusas en el disco óptico que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen MFRP del cromosoma 11q23.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q15.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:611040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:251279</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">microftalmia posterior con retinitis pigmentosa, foveosquisis y drusas del disco óptico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de microftalmia-retinitis pigmentosa-foveosquisis-drusas del disco óptico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
