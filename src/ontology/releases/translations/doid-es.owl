    <!-- http://purl.obolibrary.org/obo/DOID_3240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000447"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000603"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020056"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_552"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Neumonía que se define como una lesión pulmonar aguda tras la inhalación de materias extrañas como contenidos gástricos ácidos regurgitados, productos derivados del petróleo y aceites laxantes. Este síndrome se produce en pacientes que presentan una marcada alteración de la conciencia, como la resultante de una sobredosis de fármacos, convulsiones, un accidente cerebrovascular masivo o el uso de anestesia. La aspiración del contenido gástrico provoca una quemadura química del árbol traqueobronquial y del parénquima pulmonar, causando una intensa reacción inflamatoria parenquimatosa. La enfermedad tiene síntoma de tos no productiva, tiene síntoma de taquipnea, tiene síntoma de broncoespasmo, tiene síntoma de esputo sanguinolento, tiene síntoma de esputo espumoso, o tiene síntoma de dificultad respiratoria, 2-5 horas después de la aspiración.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:13016</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:13506</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J69.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D011015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:47839005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0032290</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Neumonitis química</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Mendelson</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3240</oboInOwl:id>
        <rdfs:label xml:lang="es">neumonitis por aspiración</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3240"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonía que se define como una lesión pulmonar aguda tras la inhalación de materias extrañas como contenidos gástricos ácidos regurgitados, productos derivados del petróleo y aceites laxantes. Este síndrome se produce en pacientes que presentan una marcada alteración de la conciencia, como la resultante de una sobredosis de fármacos, convulsiones, un accidente cerebrovascular masivo o el uso de anestesia. La aspiración del contenido gástrico provoca una quemadura química del árbol traqueobronquial y del parénquima pulmonar, causando una intensa reacción inflamatoria parenquimatosa. La enfermedad tiene síntoma de tos no productiva, tiene síntoma de taquipnea, tiene síntoma de broncoespasmo, tiene síntoma de esputo sanguinolento, tiene síntoma de esputo espumoso, o tiene síntoma de dificultad respiratoria, 2-5 horas después de la aspiración.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://www.nejm.org/doi/full/10.1056/NEJM200103013440908</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_3241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3240"/>
        <obo:IAO_0000115 xml:lang="es">Neumonitis por aspiración resultante de la aspiración de lípidos. Es el resultado de una reacción de tipo cuerpo extraño a la presencia de material lipídico dentro del parénquima pulmonar. Está causada por la inhalación de gotas nasales con base oleosa o aceite cosmético y la aspiración de aceite mineral cuando se utiliza como agente laxante.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:13015</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J69.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D011017</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:416916004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0032298</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Neumonitis lipoidea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neumonía lipoide exógena</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3241</oboInOwl:id>
        <rdfs:label xml:lang="es">neumonía lipídica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3241"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonitis por aspiración resultante de la aspiración de lípidos. Es el resultado de una reacción de tipo cuerpo extraño a la presencia de material lipídico dentro del parénquima pulmonar. Está causada por la inhalación de gotas nasales con base oleosa o aceite cosmético y la aspiración de aceite mineral cuando se utiliza como agente laxante.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Lipid_pneumonia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


