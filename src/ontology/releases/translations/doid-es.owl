                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_9282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A hydrophthalmos characterized by early onset glaucoma in one or both eyes with elevated intraocular pressure, increased corneal diameter, and swelling of the globe and has_symptom early vision loss, photophobia, blepharospasm, tearing, increased corneal diameter, increased corneal thickness, and enlarged globe. Buphthalmos is caused by severe congenital defects of the trabecular meshwork and anterior chamber angle that block aqueous outflow and raises intraocular pressure, leading to optic nerve atrophy and early vision loss.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:743.21</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:231300</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:204116009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0311251</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">buftalmos simple</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">glaucoma congénito primario 3A</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11211</oboInOwl:id>
        <rdfs:label xml:lang="es">buftalmos</rdfs:label>
    </owl:Class>
    <owl:Axiom>
