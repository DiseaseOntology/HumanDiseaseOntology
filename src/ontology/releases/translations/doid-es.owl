        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de dificultad respiratoria del recién nacido</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de hipoperfusión pulmonar del recién nacido</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12716</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome de dificultad respiratoria neonatal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12716"/>
