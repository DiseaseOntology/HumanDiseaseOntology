                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019181"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Infarto del tronco cerebral que se caracteriza por ronquera, mareos, náuseas, localizada en la parte lateral de la médula oblonga que se desarrolla a partir de un bloqueo en la arteria cerebelosa posterior inferior o una de sus ramas o de la arteria vertebral, tiene síntoma de vértigo, tiene síntoma de signos cerebelosos ipsilaterales, tiene síntoma de déficit sensorial contralateral de extremidades y torso, tiene síntoma de déficit sensorial ipsilateral de cara, tiene síntoma de hemiparálisis laríngea, faríngea y palatina, tiene síntoma de síndrome de Horner ipsilateral.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:G46.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014854</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84807</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:78569004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0043019</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Wallenberg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de la arteria cerebelosa posterior inferior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3522</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome medular lateral</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3522"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Infarto del tronco cerebral que se caracteriza por ronquera, mareos, náuseas, localizada en la parte lateral de la médula oblonga que se desarrolla a partir de un bloqueo en la arteria cerebelosa posterior inferior o una de sus ramas o de la arteria vertebral, tiene síntoma de vértigo, tiene síntoma de signos cerebelosos ipsilaterales, tiene síntoma de déficit sensorial contralateral de extremidades y torso, tiene síntoma de déficit sensorial ipsilateral de cara, tiene síntoma de hemiparálisis laríngea, faríngea y palatina, tiene síntoma de síndrome de Horner ipsilateral.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Lateral_medullary_syndrome</oboInOwl:hasDbXref>
    </owl:Axiom>
    


