        <oboInOwl:hasExactSynonym xml:lang="es">Alfa-D-manosidosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de alfa-manosidasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
