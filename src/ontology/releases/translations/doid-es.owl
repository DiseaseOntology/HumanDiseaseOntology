        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070495"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una miopatía mitocondrial infantil benigna, con deficiencia de COX, caracterizada por un desarrollo temprano normal seguido de la aparición de un declive lentamente progresivo de la función neurológica en la primera década de la vida que se traduce en dificultades para caminar, espasticidad, disartria, hipotonía y discapacidad intelectual variable que tiene_como_base una mutación homocigota en el gen TACO1 del cromosoma 17q23.3.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/20727754/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


