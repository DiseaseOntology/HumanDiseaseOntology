    <!-- http://purl.obolibrary.org/obo/DOID_0050261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_883"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa helmintiásica parasitariaa que consiste en la infección de los ojos en los seres humanos por el nematodo Thelazia callipaeda que provoca diversos grados de inflamación y lagrimeo. En infecciones más graves, se produce fotofobia, edema, conjuntivitis y ceguera.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050261</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">thelaziasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050261"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa helmintiásica parasitariaa que consiste en la infección de los ojos en los seres humanos por el nematodo Thelazia callipaeda que provoca diversos grados de inflamación y lagrimeo. En infecciones más graves, se produce fotofobia, edema, conjuntivitis y ceguera.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Thelaziasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


