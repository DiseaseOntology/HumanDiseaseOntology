            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Neoplasia benigna de órgano endocrino que surge de la glándula pineal y está compuesta por células maduras, pequeñas y uniformes que se asemejan a los pineocitos, con rosetas pineocitomatosas grandes ocasionales. Puede mostrar una amplia gama de fenotipos divergentes, incluyendo diferenciación neuronal, glial, melanocítica, fotorreceptora y mesenquimal.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9361/1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C6966</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Pinealocitoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Pinealoma</oboInOwl:hasExactSynonym>
