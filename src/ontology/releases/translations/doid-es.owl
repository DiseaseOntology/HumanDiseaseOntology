        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050072"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una micosis sistémica primaria que es una infección fúngica que se_ubica_en los pulmones, o se_ubica_en la piel, que resulta_en un proceso pulmonar granulomatoso diseminado y una infección cutánea en roedores, pequeños mamíferos salvajes y humanos, tiene_como_base el Chrysosporium parvum o Emmonsia crescens.</owl:annotatedTarget>
