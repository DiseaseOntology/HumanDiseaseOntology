        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#GOLD"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">angiomatosis bacilar</rdfs:label>
    </owl:Class>
