        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">carcinoma neuroendocrino de células grandes de mama</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_6657"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Carcinoma de mama que se caracteriza por células de gran tamaño, forma poligonal, baja relación núcleo-citoplasma, citoplasma eosinofílico finamente granular, nucleolos ocasionalmente prominentes, palidez periférica, mitosis y necrosis, y en el que más del 50% de las células tumorales son positivas para marcadores neuroendocrinos (NSE, cromogranina A, sinaptofisina).</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
