    <!-- http://purl.obolibrary.org/obo/DOID_11190 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11184"/>
        <obo:IAO_0000115 xml:lang="es">La conjuntivitis aguda que implica la formación de un exudado rico en fibrina en la superficie de la conjuntiva. Las causas infecciosas de las pseudomembranas incluyen estreptococos, neumococos, virus del herpes simple, adenovirus clamidia y gonococos. Otras causas son los irritantes químicos (alcalinos), el eritema multiforme y el penfigoide ocular.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H10.22</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:372.04</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C35196</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:267643002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0155144</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11190</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">conjuntivitis pseudomembranosa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11190"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La conjuntivitis aguda que implica la formación de un exudado rico en fibrina en la superficie de la conjuntiva. Las causas infecciosas de las pseudomembranas incluyen estreptococos, neumococos, virus del herpes simple, adenovirus clamidia y gonococos. Otras causas son los irritantes químicos (alcalinos), el eritema multiforme y el penfigoide ocular.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://bjo.bmj.com/content/55/5/312.full.pdf</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/9400798</oboInOwl:hasDbXref>
