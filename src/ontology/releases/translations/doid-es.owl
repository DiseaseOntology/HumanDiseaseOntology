    <!-- http://purl.obolibrary.org/obo/DOID_0081121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050881"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003581"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una miopatía por cuerpos de inclusión con enfermedad ósea de Paget y demencia frontotemporal que se caracteriza por debilidad muscular de la cintura proximal de las extremidades que afecta a las extremidades inferiores y superiores y provoca dificultades para caminar y alas escapulares y que presenta una mutación heterocigota en el gen ANXA11 del cromosoma 10q22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:619733</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">proteinopatía multisistémica 6</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081121</oboInOwl:id>
        <rdfs:label xml:lang="es">miopatía por cuerpos de inclusión y anomalías de la sustancia blanca cerebral</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081121"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una miopatía por cuerpos de inclusión con enfermedad ósea de Paget y demencia frontotemporal que se caracteriza por debilidad muscular de la cintura proximal de las extremidades que afecta a las extremidades inferiores y superiores y provoca dificultades para caminar y alas escapulares y que presenta una mutación heterocigota en el gen ANXA11 del cromosoma 10q22.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/34048612/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080001"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad ósea que se caracteriza por la anomalía de Pierre Robin, que comprende paladar hendido, glosoptosis y micrognatia, y una forma única de hiperfalangia bilateral en la que hay un hueso accesorio insertado entre el segundo metacarpiano y su falange proximal correspondiente, lo que provoca la desviación radial del dedo índice y que presenta una mutación homocigota o heterocigota compuesta en el gen TGDS del cromosoma 13q32.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:28</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C535347</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:616145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:1388</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Hiperfalangia-clinodactilia del dedo índice con síndrome de Pierre Robin</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de micrognatia digital</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081122</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de Catel Manzke</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081122"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad ósea que se caracteriza por la anomalía de Pierre Robin, que comprende paladar hendido, glosoptosis y micrognatia, y una forma única de hiperfalangia bilateral en la que hay un hueso accesorio insertado entre el segundo metacarpiano y su falange proximal correspondiente, lo que provoca la desviación radial del dedo índice y que presenta una mutación homocigota o heterocigota compuesta en el gen TGDS del cromosoma 13q32.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/18501694/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081123 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081123">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060309"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000936"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003593"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A syndromic X-linked intellectual disability that is characterized by intrauterine growth retardation, microcephaly, hypotonia, and severe global developmental delay, usually resulting in death in infancy or early childhood that has_material_basis_in hemizygous mutation in the RBMX gene on chromosome Xq26.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:5611</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:309555</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:3078</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">retraso mental con atrofia óptica, sordera y convulsiones</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081123</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Retraso mental ligado al cromosoma X tipo Gustavson</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081123"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A syndromic X-linked intellectual disability that is characterized by intrauterine growth retardation, microcephaly, hypotonia, and severe global developmental delay, usually resulting in death in infancy or early childhood that has_material_basis_in hemizygous mutation in the RBMX gene on chromosome Xq26.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
