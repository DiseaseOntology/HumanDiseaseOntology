    <!-- http://purl.obolibrary.org/obo/DOID_0060449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060440"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una distrofia epitelial y subepitelial que se caracteriza por una amiloidosis corneal grave que conduce a la ceguera y que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen TACSTD2, que codifica el antígeno GA733-1, definido por anticuerpos monoclonales y asociado a tumores, en el cromosoma 1p32.</obo:IAO_0000115>
