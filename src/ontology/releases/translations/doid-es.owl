    <!-- http://purl.obolibrary.org/obo/DOID_0111719 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0111717"/>
        <obo:IAO_0000115 xml:lang="en">An isolated cryptophthalmia characterized by failure of formation of the lid folds and globe results in skin extending from the brow to the cheek without identifiable adnexal structures and often the presence of a vestigial ocular structure or cyst within the socket.</obo:IAO_0000115>
