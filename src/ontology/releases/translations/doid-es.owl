        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:44452003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0002884</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">ANEMIA HIPOCRÓMICA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11759</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">anemia hipocrómica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An anemia that is characterized by a decrease in the ratio of the weight of hemoglobin to the volume of the erythrocyte. As a result, the red cells have an area of central pallor which is increased in size. The leading cause is iron deficiency.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Hypochromic_anemia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


