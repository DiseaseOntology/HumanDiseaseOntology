        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de disfunciones mitocondriales múltiples 4</rdfs:label>
        <skos:exactMatch>GARD:0017809</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080136"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome de disfunciones mitocondriales múltiples que se caracteriza por un desarrollo normal durante los primeros meses de vida, seguido de una pérdida progresiva de las habilidades motoras y sociales con hipotonía, espasticidad y nistagmo, que provoca la muerte en la primera infancia, y que presenta una herencia autosómica recesiva de mutación homocigota o heterocigota compuesta en el gen del ensamblaje del grupo hierro-azufre 2 en el cromosoma 14q24.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/25539947</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/29122497</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/29297947</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/29359243</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080137 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080137">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3125"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una neoplasia endocrina múltiple que se caracteriza por hiperparatiroidismo y tumores endocrinos múltiples y que presenta mutaciones en el gen CDKN1B en el cromosoma 12p13 que dan lugar a una reducción de la cantidad de proteína supresora de tumores p27 funcional que permite que las células crezcan y se dividan sin control.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C567059</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:610755</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Neoplasia endocrina múltiple, tipo IV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080137</oboInOwl:id>
        <rdfs:label xml:lang="es">neoplasia endocrina múltiple de tipo 4</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una neoplasia endocrina múltiple que se caracteriza por hiperparatiroidismo y tumores endocrinos múltiples y que presenta mutaciones en el gen CDKN1B en el cromosoma 12p13 que dan lugar a una reducción de la cantidad de proteína supresora de tumores p27 funcional que permite que las células crezcan y se dividan sin control.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/multiple-endocrine-neoplasia</oboInOwl:hasDbXref>
