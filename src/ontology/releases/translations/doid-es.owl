        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/35809497/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081316 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2132"/>
        <obo:IAO_0000115 xml:lang="es">Sarcoma cerebral compuesto por células neoplásicas malignas pleomórficas o fusiformes que suelen mostrar diferenciación miogénica y/o condroide. Suelen estar presentes glóbulos eosinofílicos citoplasmáticos y formación de estroma mixoide. Se asocia a mutaciones en el gen DICER1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9480/3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C186610</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081316</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Sarcoma intracraneal primario, mutante para DICER1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081316"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Sarcoma cerebral compuesto por células neoplásicas malignas pleomórficas o fusiformes que suelen mostrar diferenciación miogénica y/o condroide. Suelen estar presentes glóbulos eosinofílicos citoplasmáticos y formación de estroma mixoide. Se asocia a mutaciones en el gen DICER1.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/35789272/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081317 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050794"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Un síndrome de sinostosis múltiple se caracteriza por fusiones articulares múltiples, que suelen comenzar en las manos, sordera de transmisión y rasgos faciales característicos, incluida una nariz ancha y tubular y un bermellón superior delgado y que presenta una mutación heterocigota en el gen NOG del cromosoma 17q22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:3836</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:186500</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081317</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de sinostosis múltiple 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081317"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un síndrome de sinostosis múltiple se caracteriza por fusiones articulares múltiples, que suelen comenzar en las manos, sordera de transmisión y rasgos faciales característicos, incluida una nariz ancha y tubular y un bermellón superior delgado y que presenta una mutación heterocigota en el gen NOG del cromosoma 17q22.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/11846737/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050794"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A multiple synostoses syndrome that is characterized by progressive joint fusions of the fingers, wrists, ankles, and cervical spine; characteristic facies, including a broad hemicylindrical nose; and progressive conductive hearing loss and that has_material_basis_in heterozygous mutation in the GDF5 gene on chromosome 20q11.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9916</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:610017</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081318</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de sinostosis múltiple 2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081318"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A multiple synostoses syndrome that is characterized by progressive joint fusions of the fingers, wrists, ankles, and cervical spine; characteristic facies, including a broad hemicylindrical nose; and progressive conductive hearing loss and that has_material_basis_in heterozygous mutation in the GDF5 gene on chromosome 20q11.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/16532400/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


