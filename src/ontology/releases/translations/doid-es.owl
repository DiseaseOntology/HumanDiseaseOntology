            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad carencial nutricional que se caracteriza por estomatitis, queilosis, glositis, conjuntivitis y anemia, se desarrolla a partir de la carencia de vitamina B2 (riboflavina), tiene síntoma de labios rojos y agrietados, lengua hinchada y dolorosa, dolor de garganta, visión borrosa y fatiga, y tiene como base material la ingesta inadecuada, el trastorno endocrino, el trastorno hepático, el alcoholismo y la diálisis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:E53.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:266.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012257</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:20307000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0035528</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">ariboflavinosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">carencia de vitamina B2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8454</oboInOwl:id>
        <rdfs:label xml:lang="es">deficiencia de riboflavina</rdfs:label>
    </owl:Class>
