    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa por helmintiasis parasitaria que consiste en la infección parasitaria por el nematodo Dioctophyme renale en humanos después de ingerir alimentos poco cocinados. Las larvas se encuentran en los nódulos subcutáneos y en los riñones.</owl:annotatedTarget>
