        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111189"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La miopatía distal se caracteriza por la aparición en la edad adulta de debilidad y atrofia muscular distal lentamente progresiva que afecta a las extremidades superiores e inferiores, provoca dificultades para utilizar las manos y dificultades para caminar y que tiene una vinculación significativa con 2 regiones distintas en los cromosomas 8p22-q11 y 12q13-q22 y tiene_base_material_en una mutación heterocigota en el gen HNRNPA1 en el cromosoma 12q13.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/34722876/</oboInOwl:hasDbXref>
