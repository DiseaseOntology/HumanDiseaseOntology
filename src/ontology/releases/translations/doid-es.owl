        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099"/>
        <obo:IAO_0000115>A pain that is characterized by a painful sensation with a normal, non-painful stimulation.</obo:IAO_0000115>
