    <!-- http://purl.obolibrary.org/obo/DOID_0070698 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070698">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060309"/>
