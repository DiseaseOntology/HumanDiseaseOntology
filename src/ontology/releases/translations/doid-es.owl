        <oboInOwl:hasExactSynonym xml:lang="es">boca costrosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad del cardo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">viruela ovina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
