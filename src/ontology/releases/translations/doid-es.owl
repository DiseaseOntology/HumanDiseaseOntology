                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A congenital disorder of glycosylation I that is characterized by intrauterine growth retardation, microcephaly, failure to thrive, developmental delay, intellectual disability, hypotonia, seizures, optic nerve atrophy and respiratory difficulties and has_material_basis_in homozygous mutation in the STT3B gene on chromosome 3p23.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:615597</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:370924</oboInOwl:hasDbXref>
