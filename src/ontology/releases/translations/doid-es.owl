    <!-- http://purl.obolibrary.org/obo/DOID_3127 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1285"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002451"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
