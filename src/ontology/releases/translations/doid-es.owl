    <!-- http://purl.obolibrary.org/obo/DOID_0060728 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
