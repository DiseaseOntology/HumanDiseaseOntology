    <!-- http://purl.obolibrary.org/obo/DOID_9169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por un funcionamiento anormal del sistema inmunitario y una capacidad reducida para formar coágulos sanguíneos como consecuencia de una disminución del número y tamaño de los fragmentos de células sanguíneas que intervienen en la coagulación (microtrombocitopenia).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:D82.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:279.12</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014923</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:301000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3448</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:36070007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0043194</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Wiskott</oboInOwl:hasExactSynonym>
