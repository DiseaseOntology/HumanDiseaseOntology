    <!-- http://purl.obolibrary.org/obo/DOID_0050672 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1969"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002200"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001252"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Parálisis cerebral causada por daños en el sistema motor extrapiramidal y/o en el tracto piramidal y en los ganglios basales, que da lugar a un tono muscular mixto (hipertonía e hipotonía). Los individuos tienen problemas para mantenerse en una posición erguida y estable para sentarse o caminar, y a menudo muestran movimientos involuntarios.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="es">parálisis cerebral discinética atetoide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050672</oboInOwl:id>
        <rdfs:label xml:lang="es">parálisis cerebral discinética</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050672"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Parálisis cerebral causada por daños en el sistema motor extrapiramidal y/o en el tracto piramidal y en los ganglios basales, que da lugar a un tono muscular mixto (hipertonía e hipotonía). Los individuos tienen problemas para mantenerse en una posición erguida y estable para sentarse o caminar, y a menudo muestran movimientos involuntarios.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Cerebral_palsy#Ataxic</oboInOwl:hasDbXref>
    </owl:Axiom>
    


