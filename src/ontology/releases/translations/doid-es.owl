            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A familial episodic pain syndrome characterized by adult-onset of paroxysmal pain mainly affecting the distal lower extremities that has_material_basis_in heterozygous mutation in the SCN10A gene on chromosome 3p22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:615551</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
