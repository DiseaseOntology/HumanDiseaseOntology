        <rdfs:label xml:lang="es">púrpura fulminans</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060538"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una púrpura caracterizada por manchas de sangre, hematomas y decoloración de la piel como resultado de la coagulación en pequeños vasos sanguíneos dentro de la piel y que conduce rápidamente a la necrosis cutánea y a la coagulación intravascular diseminada. A menudo es mortal.</owl:annotatedTarget>
