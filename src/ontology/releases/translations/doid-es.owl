    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050095">
        <obo:IAO_0000115 xml:lang="en">A primary systemic mycosis that results_in fungal infection located_in lung, has_material_basis_in Sporothrix schenckii, a dimorphic fungus, which is transmitted_by airborne spores and has_symptom productive cough, has_symptom nodules and cavitations of the lungs, has_symptom fibrosis, and has_symptom swollen hilar lymph nodes.</obo:IAO_0000115>
