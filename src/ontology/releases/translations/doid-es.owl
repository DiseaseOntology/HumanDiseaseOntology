        <oboInOwl:hasExactSynonym xml:lang="es">Fiebre estreptobacilar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">Estreptobacilosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="es">Fiebre estreptobacilar por mordedura de rata</oboInOwl:hasRelatedSynonym>
