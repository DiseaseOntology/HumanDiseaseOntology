                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad pulmonar que implica inflamación del parénquima pulmonar o alveolar y llenado alveolar anormal con líquido (consolidación y exudación). Es el resultado de diversas causas, como la infección por bacterias, virus, hongos o parásitos, y las lesiones químicas o físicas de los pulmones. Se acompaña de fiebre, escalofríos, tos y dificultad para respirar.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:10509</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:11742</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:5871</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>MESH:D011014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3333</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266391003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0032285</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">neumonía aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:552</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">neumonía</rdfs:label>
    </owl:Class>
