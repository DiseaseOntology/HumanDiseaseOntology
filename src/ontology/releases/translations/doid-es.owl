        <oboInOwl:hasDbXref>UMLS_CUI:C0022806</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Kwashiokor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
