        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-negative_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">Neumonía por Klebsiella</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13272"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonía bacteriana por Klebsiella pneumoniae. Los pacientes con neumonía por Klebsiella tienden a toser un esputo característico que se dice que se parece a la gelatina de grosella roja. La neumonía por Klebsiella suele afectar a personas con enfermedades subyacentes, como alcoholismo, diabetes y enfermedad pulmonar crónica. Los síntomas incluyen fiebre alta, rigidez y dolor pleurítico, y hemoptisis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
