    <!-- http://purl.obolibrary.org/obo/DOID_8252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4483"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Rinitis persistente y de larga duración. Puede aparecer con enfermedades como la sífilis, la tuberculosis, el rinoescleroma, la rinosporidiosis, la leishmaniosis, la blastomicosis, la histoplasmosis y la lepra, todas ellas caracterizadas por la formación de lesiones inflamadas (granulomas) y la destrucción de tejidos blandos, cartílagos y huesos. La rinitis crónica provoca obstrucción nasal, secreción nasal con pus y hemorragias frecuentes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:J31.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:472.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34479</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155522005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008711</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Rinitis crónica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8252</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">rinitis crónica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8252"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Rinitis persistente y de larga duración. Puede aparecer con enfermedades como la sífilis, la tuberculosis, el rinoescleroma, la rinosporidiosis, la leishmaniosis, la blastomicosis, la histoplasmosis y la lepra, todas ellas caracterizadas por la formación de lesiones inflamadas (granulomas) y la destrucción de tejidos blandos, cartílagos y huesos. La rinitis crónica provoca obstrucción nasal, secreción nasal con pus y hemorragias frecuentes.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmhe/sec19/ch221/ch221g.html?qt=chronic%20rhinitis&amp;alt=sh</oboInOwl:hasDbXref>
