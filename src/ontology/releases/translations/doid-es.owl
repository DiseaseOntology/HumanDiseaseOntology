        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An influenza that results in infection located in respiratory tract of humans, domestic and wild birds, has_material_basis_in Influenza A virus (Alphainfluenzavirus influenzae), which is transmitted by contact with infected poultry. At least five strains of avian influenza A viruses (H5N1, H7N3, H7N2, H7N7 and H9N2) are known to cause human infections. The infection has_symptom fever, has_symptom cough, has_symptom sore throat, has_symptom muscle aches, has_symptom nausea, has_symptom diarrhea, has_symptom vomiting, has_symptom neurologic changes, has_symptom pneumonia, and has_symptom acute respiratory distress.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:J09.X</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D005585</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:55604004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0016627</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">gripe aviar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4492</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">gripe aviar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
