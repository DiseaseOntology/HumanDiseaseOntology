        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La mucopolisacaridosis I se caracteriza por un fenotipo grave que incluye disostosis múltiple, deterioro cognitivo, La enfermedad cardiaca, problemas respiratorios, opacidad corneal, hepatoesplenomegalia, facies tosca y esperanza de vida reducida y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen IDUA en el cromosoma 4p16.3.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
