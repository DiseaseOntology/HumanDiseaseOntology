        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000492"/>
        <obo:IAO_0000115>A urinary incontinence that is characterized by an involuntary leakage of urine from the bladder when a sudden strong need to urinate is felt, even when the bladder isn&apos;t full.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM_2005:788.31</oboInOwl:hasDbXref>
