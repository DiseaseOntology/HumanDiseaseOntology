    <!-- http://purl.obolibrary.org/obo/DOID_0080924 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0090131"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A complex cortical dysplasia with other brain malformations that is characterized by strikingly restricted polymicrogyria limited to the cortex surrounding the Sylvian fissure and that has_material_basis_in homozygous deletion of one 15-bp tandem repeat in a regulatory region of exon 1m of the ADGRG1 gene on chromosome 16q21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:615752</oboInOwl:hasDbXref>
