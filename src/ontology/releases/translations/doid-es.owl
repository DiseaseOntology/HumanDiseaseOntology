    <!-- http://purl.obolibrary.org/obo/DOID_12118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_12119"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_850"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019153"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La enfermedad pulmonar de etiología desconocida que afecta a los pulmones y que provoca hemorragias de los diminutos capilares alveolares. El examen del esputo y del líquido de lavado broncoalveolar puede revelar macrófagos alveolares cargados de hemosiderina (siderófagos), y la biopsia pulmonar muestra numerosos siderófagos en los alvéolos. La hemorragia alveolar se caracteriza por hemoptisis, dificultad respiratoria, infiltrados alveolares en la radiografía de tórax y diversos grados de anemia. Tras un episodio hemorrágico, los macrófagos alveolares convierten el hierro de la hemoglobina en hemosiderina en un plazo de 36-72h.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:0050330</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J84.03</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:516.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000097545</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:178550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:235500</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:99931</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:190848001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0020807</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Hemosiderosis pulmonar idiopática</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">induración marrón</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">pulmón marrón</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12118</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">hemosiderosis pulmonar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12118"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad pulmonar de etiología desconocida que afecta a los pulmones y que provoca hemorragias de los diminutos capilares alveolares. El examen del esputo y del líquido de lavado broncoalveolar puede revelar macrófagos alveolares cargados de hemosiderina (siderófagos), y la biopsia pulmonar muestra numerosos siderófagos en los alvéolos. La hemorragia alveolar se caracteriza por hemoptisis, dificultad respiratoria, infiltrados alveolares en la radiografía de tórax y diversos grados de anemia. Tras un episodio hemorrágico, los macrófagos alveolares convierten el hierro de la hemoglobina en hemosiderina en un plazo de 36-72h.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Brown_induration</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Idiopathic_pulmonary_haemosiderosis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://erj.ersjournals.com/content/24/1/162.full</oboInOwl:hasDbXref>
    </owl:Axiom>
    


