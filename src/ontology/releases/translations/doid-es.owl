    <!-- http://purl.obolibrary.org/obo/DOID_10321 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10316"/>
        <obo:IAO_0000115 xml:lang="en">A pneumoconiosis that is characterized by the formation of fine dense lesions in the lung parenchyma, caused by long standing exposure to barium dust. The lesions do not affect the lung function and disappear without treatment after the exposure to barium dust stops.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8371</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C537080</oboInOwl:hasDbXref>
