        <oboInOwl:hasDbXref>UMLS_CUI:C0043119</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Werner</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">progeria del adulto</oboInOwl:hasExactSynonym>
