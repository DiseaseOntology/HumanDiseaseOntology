    <!-- http://purl.obolibrary.org/obo/DOID_0090122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_15"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del aparato reproductor caracterizada por un aumento de la aromatización extraglandular de los esteroides que provoca precocidad heterosexual en los varones y precocidad isosexual en las mujeres, y que presenta herencia autosómica dominante por fusión del gen de la aromatasa (CYP19A1) con varias parejas, provocada por translocaciones y que da lugar a una ganancia de función del gen CYP19A1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12949</oboInOwl:hasDbXref>
