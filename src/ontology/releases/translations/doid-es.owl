                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000435"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La neurosífilis terciaria que provoca una degeneración lenta de las células nerviosas y las fibras nerviosas que llevan la información sensorial al cerebro. La infección tiene como síntoma un dolor intenso y punzante en la espalda y las piernas que se repite irregularmente. Tiene como síntoma la ataxia de la marcha, la hiperestesia, la parestesia, la pérdida de sensibilidad de la vejiga que conduce a la retención de orina y la disfunción eréctil.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A52.11</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:094.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C35057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266134000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0039223</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Esclerosis espinal posterior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Tabes dorsal - neurosífilis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10027</oboInOwl:id>
