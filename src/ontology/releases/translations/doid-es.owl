                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000882"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Neumonía bacteriana por Klebsiella pneumoniae. Los pacientes con neumonía por Klebsiella tienden a toser un esputo característico que se dice que se parece a la gelatina de grosella roja. La neumonía por Klebsiella suele afectar a personas con enfermedades subyacentes, como alcoholismo, diabetes y enfermedad pulmonar crónica. Los síntomas incluyen fiebre alta, rigidez y dolor pleurítico, y hemoptisis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:J15.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:482.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007710</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Neumonía por Klebsiella pneumoniae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neumonía por Klebsiella pneumoniae (trastorno)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13272</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_IEDB_slim"/>
