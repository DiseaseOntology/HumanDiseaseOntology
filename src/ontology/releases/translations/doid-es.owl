        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_77"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
