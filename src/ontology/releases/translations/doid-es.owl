    <!-- http://purl.obolibrary.org/obo/DOID_0080574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050570"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A congenital disorder of glycosylation I that is characterized by neurologic abnormalities (global developmental delay in language, social skills and fine and gross motor development, intellectual disability, hypotonia, microcephaly, seizures/epilepsy), facial dysmorphism (deep set eyes, large ears, hypoplastic vermillion of upper lip, large mouth with widely spaced teeth), feeding problems often due to chewing difficulties and aversion to food with certain textures, failure to thrive, gastrointestinal abnormalities (reflux or vomiting) and strabismus and has_material_basis_in hemizygous mutation in the SSR4 gene on chromosome Xq28.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12405</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:300934</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:370927</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080574</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">trastorno congénito de la glicosilación Iy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080574"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A congenital disorder of glycosylation I that is characterized by neurologic abnormalities (global developmental delay in language, social skills and fine and gross motor development, intellectual disability, hypotonia, microcephaly, seizures/epilepsy), facial dysmorphism (deep set eyes, large ears, hypoplastic vermillion of upper lip, large mouth with widely spaced teeth), feeding problems often due to chewing difficulties and aversion to food with certain textures, failure to thrive, gastrointestinal abnormalities (reflux or vomiting) and strabismus and has_material_basis_in hemizygous mutation in the SSR4 gene on chromosome Xq28.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/26264460</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080575 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por laxitud, dislocaciones y contracturas de las articulaciones, baja estatura, deformidades de los pies (p.ej. pies zambos), puntas anchas de dedos de manos y pies, cuello corto, rasgos faciales dismórficos (hipertelorismo, fisuras palpebrales oblicuas, nariz respingona con narinas antevertidas, paladar alto arqueado) y diversas malformaciones cardiacas y que presenta una mutación homocigota en el gen B3GAT3 del cromosoma 11q12.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:245600</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:284139</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080575</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de Larsen tipo B3GAT3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080575"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que se caracteriza por laxitud, dislocaciones y contracturas de las articulaciones, baja estatura, deformidades de los pies (p.ej. pies zambos), puntas anchas de dedos de manos y pies, cuello corto, rasgos faciales dismórficos (hipertelorismo, fisuras palpebrales oblicuas, nariz respingona con narinas antevertidas, paladar alto arqueado) y diversas malformaciones cardiacas y que presenta una mutación homocigota en el gen B3GAT3 del cromosoma 11q12.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/articles/PMC4654953/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/25893793</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080576">
