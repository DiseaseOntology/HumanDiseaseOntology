            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La enfermedad infecciosa vírica que provoca una infección localizada en la boca y tiene base material en el coxsackievirus humano A16, el enterovirus humano 71, el coxsackievirus del grupo B o los echovirus, que se transmiten por ingestión de alimentos contaminados con heces. Se transmiten por contacto con secreciones faríngeas o se transmiten por gotitas de secreciones oronasales. La infección cursa con fiebre sintomática, dolor de garganta sintomático y lesiones sintomáticas en la zona posterior de la boca, sobre todo en el paladar blando o los pilares amigdalinos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B08.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:074.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D006557</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:154358007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0019338</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Faringitis vesicular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10883</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">herpangina</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_10883"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa vírica que provoca una infección localizada en la boca y tiene base material en el coxsackievirus humano A16, el enterovirus humano 71, el coxsackievirus del grupo B o los echovirus, que se transmiten por ingestión de alimentos contaminados con heces. Se transmiten por contacto con secreciones faríngeas o se transmiten por gotitas de secreciones oronasales. La infección cursa con fiebre sintomática, dolor de garganta sintomático y lesiones sintomáticas en la zona posterior de la boca, sobre todo en el paladar blando o los pilares amigdalinos.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
