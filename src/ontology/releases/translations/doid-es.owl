    <!-- http://purl.obolibrary.org/obo/DOID_13473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13474"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000321"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_11782"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Pterigión periférico progresivo que se caracteriza por la salida progresiva carnosa de crecimiento conjuntival que ha crecido hasta implicar el eje visual y tiene_síntoma protuberancias carnosas en la superficie del ojo, sensación de cuerpo extraño, disminución de la visión y astigmatismo. Los pterigiones centrales son más frecuentes en personas propensas a sufrir lesiones de la superficie ocular, como las que viven en climas soleados, cálidos y secos. Los pterigiones centrales progresan a partir de la pinguécula.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H11.02</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:372.43</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:193882008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0155156</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13473</oboInOwl:id>
        <rdfs:label xml:lang="es">pterigión central</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Pterigión periférico progresivo que se caracteriza por la salida progresiva carnosa de crecimiento conjuntival que ha crecido hasta implicar el eje visual y tiene_síntoma protuberancias carnosas en la superficie del ojo, sensación de cuerpo extraño, disminución de la visión y astigmatismo. Los pterigiones centrales son más frecuentes en personas propensas a sufrir lesiones de la superficie ocular, como las que viven en climas soleados, cálidos y secos. Los pterigiones centrales progresan a partir de la pinguécula.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.merckmanuals.com/professional/eye-disorders/conjunctival-and-scleral-disorders/pinguecula-and-pterygium</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5340105/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10526"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000321"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Pterigión conjuntival que se caracteriza por la progresiva (en oposición a quiescente) protuberancia carnosa de crecimiento conjuntival y tiene síntoma de protuberancias carnosas en la superficie del ojo, sensación de cuerpo extraño, disminución de la visión, y el astigmatismo. Los pterigiones periféricos progresivos son más frecuentes en personas propensas a sufrir lesiones de la superficie ocular, como las que viven en climas soleados, calurosos y secos. Los pterigiones periféricos progresivos evolucionan a partir de una pinguécula.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:372.42</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:193881001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0155155</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13474</oboInOwl:id>
        <rdfs:label xml:lang="es">pterigión periférico progresivo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Pterigión conjuntival que se caracteriza por la progresiva (en oposición a quiescente) protuberancia carnosa de crecimiento conjuntival y tiene síntoma de protuberancias carnosas en la superficie del ojo, sensación de cuerpo extraño, disminución de la visión, y el astigmatismo. Los pterigiones periféricos progresivos son más frecuentes en personas propensas a sufrir lesiones de la superficie ocular, como las que viven en climas soleados, calurosos y secos. Los pterigiones periféricos progresivos evolucionan a partir de una pinguécula.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.merckmanuals.com/professional/eye-disorders/conjunctival-and-scleral-disorders/pinguecula-and-pterygium</oboInOwl:hasDbXref>
