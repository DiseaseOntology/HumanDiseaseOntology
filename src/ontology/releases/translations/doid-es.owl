        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2841"/>
        <obo:IAO_0000115 xml:lang="en">An asthma that is characterized by severe and sudden onset of increasing wheezing, airways closing, smooth muscle contraction, mucus plugging and lower airway edema that may be reversible upon treatment.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080810</oboInOwl:id>
