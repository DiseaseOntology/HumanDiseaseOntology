    <!-- http://purl.obolibrary.org/obo/DOID_0060915 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060913"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome autoinflamatorio asociado al proteasoma que se caracteriza por la aparición de paniculitis y lesiones cutáneas eritematosas en la primera infancia con rasgos variables de linfadenopatía, miositis, retraso en el desarrollo motor y del habla y rasgos autoinmunes y que tiene_como_base una mutación heterocigota compuesta en el gen PSMG2 del cromosoma 18p11.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:619183</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
