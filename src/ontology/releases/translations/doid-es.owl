        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">siderosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_10328"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumoconiosis se caracteriza por la deposición de un exceso de hierro en el tejido corporal como consecuencia de la inhalación del hierro presente en el polvo minero o en los humos de soldadura.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Siderosis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_10329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10316"/>
