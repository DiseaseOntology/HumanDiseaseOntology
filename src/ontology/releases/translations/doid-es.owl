    <!-- http://purl.obolibrary.org/obo/DOID_14418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_883"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección parasitaria por las larvas del nematodo Dracunculus medinensis, que se transmiten al ser humano al beber agua que contiene copépodos infectados con las larvas. La hembra, que contiene las larvas, excava en los tejidos conjuntivos más profundos o adyacentes a los huesos largos o las articulaciones de las extremidades. El gusano emerge como un filamento blanquecino en el centro de una úlcera dolorosa, acompañada de inflamación y, con frecuencia, de una infección bacteriana secundaria.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6286</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B72</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:125.7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004320</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84677</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:48874008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0013100</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Dracontiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Dracunculus medinensis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14418</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">dracunculosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14418"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección parasitaria por las larvas del nematodo Dracunculus medinensis, que se transmiten al ser humano al beber agua que contiene copépodos infectados con las larvas. La hembra, que contiene las larvas, excava en los tejidos conjuntivos más profundos o adyacentes a los huesos largos o las articulaciones de las extremidades. El gusano emerge como un filamento blanquecino en el centro de una úlcera dolorosa, acompañada de inflamación y, con frecuencia, de una infección bacteriana secundaria.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Dracunculiasis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Dracunculiasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_14419 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14419">
        <obo:IAO_0000115 xml:lang="en">A mansonelliasis that involves parasitic infection by the nematode Mansonella ozzardi, which resides in the subcutaneous tissues causing arthralgias, headaches, fever, pulmonary symptoms, adenopathy, hepatomegaly, and pruritus. Both midges and blackflies transmit the disease.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14419</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete Mansonella ozzardi infectious disease</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14419"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A mansonelliasis that involves parasitic infection by the nematode Mansonella ozzardi, which resides in the subcutaneous tissues causing arthralgias, headaches, fever, pulmonary symptoms, adenopathy, hepatomegaly, and pruritus. Both midges and blackflies transmit the disease.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Filariasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


