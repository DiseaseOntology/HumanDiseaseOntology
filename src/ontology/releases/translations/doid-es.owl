        <oboInOwl:hasDbXref>UMLS_CUI:C0265257</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Acrodisostosis postaxial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Disostosis acrofacial tipo Genee-Wiedmann</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Disostosis mandibulfacial con anomalías postaxiales de las extremidades.</oboInOwl:hasExactSynonym>
