        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000596"/>
        <obo:IAO_0000115>A convulsion that is characterized by occurring in young children between six months and five years of age and which is triggered by fever.</obo:IAO_0000115>
