        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:187125007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0015652</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Fasciola</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Fasciola hepatica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
