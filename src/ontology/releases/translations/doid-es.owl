    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081239"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del carbunco que se caracteriza por la infección en el lugar de la inyección o en la profundidad de la piel o el músculo donde se inyectó la droga y que está causada por heroína contaminada con esporas de carbunco.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/29533547/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.cdc.gov/anthrax/basics/types/index.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


