        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Glutaric_acidemia_type_2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/12815589</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/22580358</oboInOwl:hasDbXref>
    </owl:Axiom>
    


