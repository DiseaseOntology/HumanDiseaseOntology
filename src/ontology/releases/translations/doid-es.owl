    <!-- http://purl.obolibrary.org/obo/DOID_11336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050338"/>
        <obo:IAO_0000115 xml:lang="es">La enfermedad infecciosa bacteriana primaria que consiste en la inflamación de la mucosa que recubre la cavidad nasal, la faringe, la laringe, la tráquea y los bronquios y se caracteriza por la formación de granulomas, induración densa de los tejidos y deformidad nodular causada por Klebsiella rhinoscleromatis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:040.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012226</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:72409005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0035468</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11336</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-negative_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">rinoescleroma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11336"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa bacteriana primaria que consiste en la inflamación de la mucosa que recubre la cavidad nasal, la faringe, la laringe, la tráquea y los bronquios y se caracteriza por la formación de granulomas, induración densa de los tejidos y deformidad nodular causada por Klebsiella rhinoscleromatis.</owl:annotatedTarget>
