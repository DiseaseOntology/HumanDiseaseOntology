    <!-- http://purl.obolibrary.org/obo/DOID_14515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060388"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome de deleción cromosómica que resulta_en un síndrome genético raro en el que los niños afectados están predispuestos a desarrollar tumor de Wilms, aniridia (ausencia de la parte coloreada del ojo, el iris), anomalías genitourinarias y retraso mental. Esta enfermedad es el resultado de una deleción en el cromosoma 11 que provoca la pérdida de varios genes. Como tal, es uno de los ejemplos mejor estudiados de una afección causada por la pérdida de genes vecinos (contiguos).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:5528</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D017624</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:194072</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3718</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:715215007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0206115</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de monosomía parcial 11p</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Tumor de Wilms-Aniridia-Anomalías genitourinarias-Síndrome de retraso mental</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de deleción del cromosoma 11p13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14515</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Síndrome WAGR</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14515"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome de deleción cromosómica que resulta_en un síndrome genético raro en el que los niños afectados están predispuestos a desarrollar tumor de Wilms, aniridia (ausencia de la parte coloreada del ojo, el iris), anomalías genitourinarias y retraso mental. Esta enfermedad es el resultado de una deleción en el cromosoma 11 que provoca la pérdida de varios genes. Como tal, es uno de los ejemplos mejor estudiados de una afección causada por la pérdida de genes vecinos (contiguos).</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/WAGR_syndrome</oboInOwl:hasDbXref>
    </owl:Axiom>
    


