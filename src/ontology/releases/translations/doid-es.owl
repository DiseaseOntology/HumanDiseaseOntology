                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000538"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A tick infestation that is characterized by an acute, ascending, flaccid motor paralysis, which is caused by the introduction of a neurotoxin into humans during attachment and feeding by the females of several tick species such as Dermacentor andersoni, Dermacentor variabilis, Amblyomma americanum, Amblyomma maculatum, Ixodes scapularis, Ixodes pacificus, Ixodes holocyclus, Rhipicephalus sanguineus and Otobius megnini. The symptoms include local inflammation, edema and hemorrhage.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7771</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013985</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:74225001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0040197</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11285</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">parálisis por garrapatas</rdfs:label>
        <skos:exactMatch>MESH:D013985</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11285"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A tick infestation that is characterized by an acute, ascending, flaccid motor paralysis, which is caused by the introduction of a neurotoxin into humans during attachment and feeding by the females of several tick species such as Dermacentor andersoni, Dermacentor variabilis, Amblyomma americanum, Amblyomma maculatum, Ixodes scapularis, Ixodes pacificus, Ixodes holocyclus, Rhipicephalus sanguineus and Otobius megnini. The symptoms include local inflammation, edema and hemorrhage.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
