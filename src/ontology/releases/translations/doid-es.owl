        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000601</oboInOwl:id>
        <rdfs:label>hyperventilation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A respiratory abnormality that is characterized by excessive ventilation characterized by excessive rate and depth of respiration leading to abnormal loss of carbon dioxide from the blood.</owl:annotatedTarget>
