        <oboInOwl:hasDbXref>UMLS_CUI:C1844696</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Andre</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome faciopalatoóseo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome oto-palato-digital tipo 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome oto-palato-digital tipo II</oboInOwl:hasExactSynonym>
