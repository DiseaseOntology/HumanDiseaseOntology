    <!-- http://purl.obolibrary.org/obo/DOID_13357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080001"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2557"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001994"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0002446"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A chondromalacia that is characterized by well-localized pain when the patella is grated against the femoral condyles or when the knee is actively extended with the patella manually displaced distally. This occurs when the posterior articular surface of the patella starts losing its density when in a healthy state and becomes softer with subsequent tearing, fissuring, and erosion of the hyaline cartilage.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:M22.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:717.7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D046789</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:168900</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:156521009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008475</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">reblandecimiento del cartílago articular de la rótula</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13357</oboInOwl:id>
        <rdfs:label xml:lang="es">condromalacia rotuliana</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A chondromalacia that is characterized by well-localized pain when the patella is grated against the femoral condyles or when the knee is actively extended with the patella manually displaced distally. This occurs when the posterior articular surface of the patella starts losing its density when in a healthy state and becomes softer with subsequent tearing, fissuring, and erosion of the hyaline cartilage.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007646"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK459195</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13359 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_854"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del colágeno que se caracteriza por articulaciones extremadamente flexibles, piel elástica y hematomas excesivos causados por un defecto hereditario en la síntesis de colágeno, lo que provoca marcadas dificultades de cicatrización. El EDS tiene cinco signos cardinales, que pueden estar presentes en algún grado en todos los subtipos. Estos cinco signos cardinales son la fragilidad cutánea, la fragilidad de los vasos sanguíneos, la hiperelasticidad cutánea, la hipermovilidad articular y los nódulos subcutáneos característicos.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:14696</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GARD:6322</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:Q79.6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:756.83</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004535</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS130000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34568</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:268352002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0013720</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">piel elástica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13359</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome de Ehlers-Danlos</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13359"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del colágeno que se caracteriza por articulaciones extremadamente flexibles, piel elástica y hematomas excesivos causados por un defecto hereditario en la síntesis de colágeno, lo que provoca marcadas dificultades de cicatrización. El EDS tiene cinco signos cardinales, que pueden estar presentes en algún grado en todos los subtipos. Estos cinco signos cardinales son la fragilidad cutánea, la fragilidad de los vasos sanguíneos, la hiperelasticidad cutánea, la hipermovilidad articular y los nódulos subcutáneos característicos.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
