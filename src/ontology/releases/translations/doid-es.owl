    <!-- http://purl.obolibrary.org/obo/SYMP_0020042 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000239"/>
        <obo:IAO_0000115>A cornea symptom that is characterized by scarring (an opacity or irregularity in the cornea) of the cornea, from trauma; abrasion; bacterial, fungal, viral, or parasitic infection; or disease, and can result in impaired vision, or even blindness.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020042</oboInOwl:id>
        <rdfs:label>corneal scarring</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020042"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cornea symptom that is characterized by scarring (an opacity or irregularity in the cornea) of the cornea, from trauma; abrasion; bacterial, fungal, viral, or parasitic infection; or disease, and can result in impaired vision, or even blindness.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://drstuartterry.com/eye-conditions/corneal-scarring/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.neohioeyes.com/cornea-center/corneal-scar/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0020043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000486"/>
        <obo:IAO_0000115>A urinary system symptom that is characterized by an elevation in the concentration of the the pigments from foods, dyes, and medications in urine. The dilution of these pigment is dependent on the amount of water intake and severe dehydration can lead to a dark color.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020043</oboInOwl:id>
        <rdfs:label>dark urine</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A urinary system symptom that is characterized by an elevation in the concentration of the the pigments from foods, dyes, and medications in urine. The dilution of these pigment is dependent on the amount of water intake and severe dehydration can lead to a dark color.</owl:annotatedTarget>
