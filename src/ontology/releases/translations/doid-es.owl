    <!-- http://purl.obolibrary.org/obo/DOID_13550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1686"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000321"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_9282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Glaucoma caracterizado por el cierre del ángulo de la cámara anterior, de forma que se bloquea el flujo acuoso y la presión intraocular se eleva de forma inadecuada, lo que provoca daños en el nervio óptico y pérdida del campo visual. El glaucoma de ángulo cerrado presenta como síntomas pérdida progresiva de la visión periférica, disminución de la visión y dolor, enrojecimiento y cefalea en los casos agudos. El glaucoma de ángulo cerrado puede estar causado por un ángulo anatómicamente estrecho, una lesión de la malla trabecular y lesiones de la cámara anterior, como neovascularización y uveítis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D015812</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34639</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:270882001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0017605</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">ACG - Glaucoma de ángulo cerrado</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Glaucoma de hendidura estrecha</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Glaucoma de ángulo cerrado</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">glaucoma primario de ángulo abierto con ángulos estrechos</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13550</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">glaucoma de ángulo cerrado</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13550"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Glaucoma caracterizado por el cierre del ángulo de la cámara anterior, de forma que se bloquea el flujo acuoso y la presión intraocular se eleva de forma inadecuada, lo que provoca daños en el nervio óptico y pérdida del campo visual. El glaucoma de ángulo cerrado presenta como síntomas pérdida progresiva de la visión periférica, disminución de la visión y dolor, enrojecimiento y cefalea en los casos agudos. El glaucoma de ángulo cerrado puede estar causado por un ángulo anatómicamente estrecho, una lesión de la malla trabecular y lesiones de la cámara anterior, como neovascularización y uveítis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Glaucoma</oboInOwl:hasDbXref>
