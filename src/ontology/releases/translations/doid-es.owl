    <!-- http://purl.obolibrary.org/obo/DOID_0081307 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060704"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome linfoproliferativo que se caracteriza por la sobreproducción (proliferación) de glóbulos blancos llamados linfocitos. Las células anormales se infiltran y acumulan (forman lesiones o nódulos) en los tejidos. Las lesiones o nódulos dañan o destruyen los vasos sanguíneos dentro de estos tejidos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:C83.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICDO:9766/1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008230</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C7930</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:60337005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024307</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081307</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Granulomatosis linfomatoide</rdfs:label>
    </owl:Class>
