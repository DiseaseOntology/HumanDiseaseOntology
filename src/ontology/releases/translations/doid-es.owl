        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">insuficiencia hepática infantil transitoria</rdfs:label>
    </owl:Class>
