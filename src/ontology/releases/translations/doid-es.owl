        <owl:annotatedTarget>A skin and integumentary tissue symptom that is characterized by an inflammation of the mammary gland or udder and usually caused by infection.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=mastitis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


