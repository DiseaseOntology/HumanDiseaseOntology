    <!-- http://purl.obolibrary.org/obo/DOID_0080530 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_12318"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una distrofia corneal granular que se caracteriza por erosiones recurrentes y opacificación gris parecida a migas localizada en la córnea, depósitos proteináceos parecidos a caramelos de roca en el estroma anterior y el subepitelio, y pérdida progresiva de la visión más adelante en la vida a medida que los depósitos se desplazan hacia la visión central, y que presenta herencia autosómica dominante de una mutación heterocigota del gen inducido por el factor de crecimiento transformante beta localizado en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías conducen a un aumento de la deposición de proteínas y a la alteración de la superficie corneal.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:121900</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia corneal, Groenouw tipo I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080530</oboInOwl:id>
        <rdfs:label xml:lang="es">distrofia corneal granular 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080530"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distrofia corneal granular que se caracteriza por erosiones recurrentes y opacificación gris parecida a migas localizada en la córnea, depósitos proteináceos parecidos a caramelos de roca en el estroma anterior y el subepitelio, y pérdida progresiva de la visión más adelante en la vida a medida que los depósitos se desplazan hacia la visión central, y que presenta herencia autosómica dominante de una mutación heterocigota del gen inducido por el factor de crecimiento transformante beta localizado en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías conducen a un aumento de la deposición de proteínas y a la alteración de la superficie corneal.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/8136834/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


