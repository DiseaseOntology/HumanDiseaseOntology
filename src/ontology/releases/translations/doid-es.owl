                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019153"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020055"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del carbunco que provoca una infección localizada en los ganglios linfáticos pulmonares provocada por la inhalación de las esporas de la bacteria Bacillus anthracis. Los primeros síntomas del carbunco por inhalación son como los del resfriado o la gripe y pueden incluir dolor de garganta, fiebre leve y dolores musculares. Los síntomas posteriores incluyen tos, molestias en el pecho, dificultad para respirar, cansancio y dolores musculares.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C571912</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">ántrax pulmonar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">ántrax respiratorio</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050160</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">carbunco por inhalación</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del carbunco que provoca una infección localizada en los ganglios linfáticos pulmonares provocada por la inhalación de las esporas de la bacteria Bacillus anthracis. Los primeros síntomas del carbunco por inhalación son como los del resfriado o la gripe y pueden incluir dolor de garganta, fiebre leve y dolores musculares. Los síntomas posteriores incluyen tos, molestias en el pecho, dificultad para respirar, cansancio y dolores musculares.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007640"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
