    <!-- http://purl.obolibrary.org/obo/DOID_8295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_7894"/>
        <obo:IAO_0000115 xml:lang="es">Infestación por ácaros que es una infección cutánea ectoparásita contagiosa causada por el ácaro del prurito humano Sarcoptes scabiei tipo hominis, que penetra en la capa superior de la piel pero nunca por debajo del estrato córneo causando un picor intenso y una erupción que se encuentra en las manos, los pliegues de la muñeca, el codo o la rodilla, el pene, el pecho y los omóplatos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B86</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:133.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012532</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34998</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266224002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0036262</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infestación por Sarcoptes scabiei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infestación por Sarcoptes scabiei var hominis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8295</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">sarna</rdfs:label>
        <skos:exactMatch>MESH:D012532</skos:exactMatch>
    </owl:Class>
