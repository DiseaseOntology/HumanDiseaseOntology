        <oboInOwl:hasExactSynonym xml:lang="es">Malformaciones capilares congénitas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Múltiples manchas familiares en vino de Oporto</oboInOwl:hasExactSynonym>
