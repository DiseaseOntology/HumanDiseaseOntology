        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080600"/>
        <obo:IAO_0000115 xml:lang="es">Un COVID-19 que se caracteriza por los criterios de síndrome de dificultad respiratoria aguda (SDRA), sepsis, shock séptico u otras condiciones que normalmente requerirían la provisión de terapias de mantenimiento de la vida como la ventilación mecánica (invasiva o no invasiva) o terapia vasopresora.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081012</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">COVID-19 crítico</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081012"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un COVID-19 que se caracteriza por los criterios de síndrome de dificultad respiratoria aguda (SDRA), sepsis, shock séptico u otras condiciones que normalmente requerirían la provisión de terapias de mantenimiento de la vida como la ventilación mecánica (invasiva o no invasiva) o terapia vasopresora.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.who.int/publications/i/item/WHO-2019-nCoV-clinical-2021-1</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080600"/>
        <obo:IAO_0000115 xml:lang="es">Covid-19 que se caracteriza por cualquiera de los siguientes síntomas: (1) Saturación de oxígeno &lt; 90% en aire ambiente, (2) Frecuencia respiratoria &gt; 30 respiraciones/min en adultos y niños &gt; 5 años, 60 respiraciones/min en niños &lt; 2 meses, 50 en niños de 2 a 11 meses, y 40 en niños de 1 a 5 años, o (3) signos de dificultad respiratoria grave (uso de músculos accesorios, incapacidad para completar frases completas y, en niños, contracción muy grave de la pared torácica, gruñidos, cianosis central o presencia de cualquier otro signo general de peligro.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081013</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">COVID-19 grave</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Covid-19 que se caracteriza por cualquiera de los siguientes síntomas: (1) Saturación de oxígeno &lt; 90% en aire ambiente, (2) Frecuencia respiratoria &gt; 30 respiraciones/min en adultos y niños &gt; 5 años, 60 respiraciones/min en niños &lt; 2 meses, 50 en niños de 2 a 11 meses, y 40 en niños de 1 a 5 años, o (3) signos de dificultad respiratoria grave (uso de músculos accesorios, incapacidad para completar frases completas y, en niños, contracción muy grave de la pared torácica, gruñidos, cianosis central o presencia de cualquier otro signo general de peligro.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.who.int/publications/i/item/WHO-2019-nCoV-clinical-2021-1</oboInOwl:hasDbXref>
    </owl:Axiom>
    


