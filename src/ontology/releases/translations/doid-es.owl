        <oboInOwl:hasDbXref>NCI:C82865</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:79468000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0085106</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">pénfigo benigno familiar</oboInOwl:hasExactSynonym>
