        <obo:IAO_0000115 xml:lang="es">Equinococosis causada por larvas de Echinococcus granulosus. La afectación hepática puede producir dolor abdominal, una masa en la zona hepática y obstrucción de las vías biliares. La afectación pulmonar puede producir dolor torácico, tos y hemoptisis. La ruptura de los quistes produce fiebre, urticaria, eosinofilia y shock anafiláctico, así como diseminación de los quistes. El cerebro, los huesos y el corazón también pueden infectarse.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:13256</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:13708</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:14154</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:1493</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:B67.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:122.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:75006000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0152068</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Echinococcus granulosus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección pulmonar por Echinococcus granulosus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">echinococcus granulosus enfermedad infecciosa del hígado</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad hidatídica unilocular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad infecciosa por echinococcus granulosus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">equinococosis unilocular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
