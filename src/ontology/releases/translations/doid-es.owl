        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020040"/>
        <obo:IAO_0000115>A hair symptom that is characterized by significant falling out of hair, which may be a result of stress, high fever, and other factors.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020044</oboInOwl:id>
