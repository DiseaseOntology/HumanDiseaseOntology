    <!-- http://purl.obolibrary.org/obo/DOID_1935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
