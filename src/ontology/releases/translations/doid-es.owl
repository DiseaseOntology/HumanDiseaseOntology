    <!-- http://purl.obolibrary.org/obo/DOID_11165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11166"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
