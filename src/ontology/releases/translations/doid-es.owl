        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020012"/>
        <obo:IAO_0000115>A weight symptom that is characterized by an infant weighing 5.5 pounds (2500 grams) or less at birth.  Low birth weight may occur with premature birth, or due to smoking cigarettes, secondhand tobacco smoke exposure, drinking alcohol, and taking certain drugs during pregnancy.</obo:IAO_0000115>
