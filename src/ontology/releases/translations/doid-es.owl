    <!-- http://purl.obolibrary.org/obo/DOID_0050147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9463"/>
        <obo:IAO_0000115 xml:lang="es">Una otitis externa que es una enfermedad del oído producida por el crecimiento de hongos en el conducto auditivo externo. Se caracteriza por inflamación, prurito, descamación y graves molestias. Los hongos más comunes son el Aspergillus niger y la Candida albicans.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D059249</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">oído de Singapur</oboInOwl:hasExactSynonym>
