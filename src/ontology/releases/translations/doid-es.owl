    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050262">
        <obo:IAO_0000115 xml:lang="en">A parasitic helminthiasis infectious disease that involves infection caused by parasitic worms, which are bilaterian, unsegmented, soft-bodied invertebrate animals with no body cavity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050262</oboInOwl:id>
