        <oboInOwl:id>DOID:0070470</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de duplicación del cromosoma 1p36.33</rdfs:label>
        <skos:exactMatch>MIM:618815</skos:exactMatch>
        <skos:exactMatch>ORDO:656279</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C5394150</skos:exactMatch>
    </owl:Class>
