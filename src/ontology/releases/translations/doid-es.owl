    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10066">
        <obo:IAO_0000115 xml:lang="en">A tertiary neurosyphilis that is caused due to syphilis, which occurs suddenly and produces tinnitus and deafness when the cochlear branch is affected whereas vertigo, disturbances of equilibrium, spontaneous nystagmus and vomiting when the vestibular branch suffers. A combination of these symptoms are seen when both the branches are involved.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10066</oboInOwl:id>
