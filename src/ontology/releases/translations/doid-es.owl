    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050763"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que se caracteriza por contracturas articulares congénitas, disfunción tubular renal, colestasis, grave retraso del crecimiento, ictiosis y un defecto en la biogénesis de los gránulos alfa de las plaquetas y que tiene_como_base la mutación homocigota o heterocigota compuesta en el gen VPS33B o en la mutación homocigota o heterocigota compuesta en el gen VIPAR del cromosoma 14q24.3.</owl:annotatedTarget>
