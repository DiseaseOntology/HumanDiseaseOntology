    <!-- http://purl.obolibrary.org/obo/DOID_0111730 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0111728"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
