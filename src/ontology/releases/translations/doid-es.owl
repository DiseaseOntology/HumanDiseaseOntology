        <oboInOwl:hasExactSynonym xml:lang="es">Agarre del diablo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Epidemia, miositis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Mialgia epidémica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Pleuresía epidémica</oboInOwl:hasExactSynonym>
