                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome que tiene_como_base una mutación heterocigota en el dominio tirosina quinasa del gen FGFR2 en el cromosoma 10q26 y que se caracteriza por la herencia autosómica dominante de anomalías que afectan a las glándulas y conductos lagrimales y salivales, las orejas, los dientes y los dedos de manos y pies.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:149730</oboInOwl:hasDbXref>
