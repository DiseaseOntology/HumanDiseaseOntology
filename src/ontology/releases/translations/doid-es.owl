    <!-- http://purl.obolibrary.org/obo/DOID_0111278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El síndrome se caracteriza por histiocitosis, hiperpigmentación, hipertricosis, hepatoesplenomegalia, anomalías cardiacas, pérdida de audición, hipogonadismo y estatura reducida y tiene_base_material_en homocigota o heterocigota compuesta en la mutación SLC29A3 en 10q22.1. Este síndrome comprende características de 4 trastornos histiocíticos que antes se consideraban distintos: histiocitosis de Faisalabad, histiocitosis sinusal con linfadenopatía masiva, síndrome H e hipertricosis pigmentada con síndrome de diabetes mellitus insulinodependiente.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7588</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICDO:9749/3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:602782</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C36075</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de Rosai-Dorfman</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad familiar de Rosai-Dorfman</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Hiperpigmentación cutánea con hipertricosis, hepatoesplenomegalia, anomalías cardíacas e hipogonadismo con o sin pérdida auditiva</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Hipertricosis pigmentada con diabetes mellitus insulinodependiente</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Histiocitosis con contracturas articulares y sordera neurosensorial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Histiocitosis de Faisalabad</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Histiocitosis sinusal y linfadenopatía masiva</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Histiocitosis y linfadenopatía con o sin características cutáneas, cardíacas y/o endocrinas, contracturas articulares y/o sordera</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome h</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
