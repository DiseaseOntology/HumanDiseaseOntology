    <!-- http://purl.obolibrary.org/obo/DOID_0081388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9255"/>
        <obo:IAO_0000115 xml:lang="es">Demencia frontotemporal que se caracteriza por la aparición progresiva de trastornos del lenguaje y el deterioro gradual de estas capacidades a lo largo del tiempo, asociados a la atrofia de la red del lenguaje del cerebro, incluidas las regiones frontal, temporal y parietal del hemisferio izquierdo. Está causada por una pérdida de tejido (atrofia) en la zona del cerebro encargada de producir el lenguaje.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:95432</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081388</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">afasia primaria progresiva</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081388"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Demencia frontotemporal que se caracteriza por la aparición progresiva de trastornos del lenguaje y el deterioro gradual de estas capacidades a lo largo del tiempo, asociados a la atrofia de la red del lenguaje del cerebro, incluidas las regiones frontal, temporal y parietal del hemisferio izquierdo. Está causada por una pérdida de tejido (atrofia) en la zona del cerebro encargada de producir el lenguaje.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/21325651/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/29392464/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC6993834/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081388"/>
        <obo:IAO_0000115 xml:lang="es">Afasia progresiva primaria que se caracteriza por alteraciones del lenguaje, incluida la dificultad para producir o comprender el habla. Es un tipo de afasia progresiva primaria. Los individuos afectados tienen un habla lenta y vacilante debido a la dificultad para recuperar las palabras, nombres o números correctos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10791</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:250831</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Afasia progresiva primaria logopénica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">variante logopénica PPA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081389</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Afasia progresiva logopénica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081389"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Afasia progresiva primaria que se caracteriza por alteraciones del lenguaje, incluida la dificultad para producir o comprender el habla. Es un tipo de afasia progresiva primaria. Los individuos afectados tienen un habla lenta y vacilante debido a la dificultad para recuperar las palabras, nombres o números correctos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/21325651/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081388"/>
