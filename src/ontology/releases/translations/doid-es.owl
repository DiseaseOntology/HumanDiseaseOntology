        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070349</oboInOwl:id>
        <rdfs:label xml:lang="es">atrofia muscular espinal con predominio de las extremidades inferiores 2A</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070349"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una atrofia muscular espinal con predominio en las extremidades inferiores que se caracteriza por la aparición en la infancia temprana de debilidad muscular y atrofia que afecta predominantemente a los músculos proximales y distales de las extremidades inferiores, aunque algunos pacientes pueden mostrar afectación de las extremidades superiores y que tiene_como_base una mutación heterocigota en el gen BICD2 del cromosoma 9q22.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/23664120/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


