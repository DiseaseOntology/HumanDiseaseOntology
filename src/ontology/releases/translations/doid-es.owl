        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">displasia de Greenberg</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111588"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El trastorno metabólico hereditario se caracteriza por un defecto en la biosíntesis del colesterol que provoca hidropesía fetal, acortamiento grave de todos los huesos largos con aspecto radiográfico apolillado, platispondilia, desorganización de la calcificación condroósea y centros de osificación ectópicos y tiene_base_material_en una mutación homocigota o heterocigota compuesta en LBR en la cromosoma 1q42.12.</owl:annotatedTarget>
