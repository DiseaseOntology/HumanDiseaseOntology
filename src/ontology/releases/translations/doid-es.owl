        <oboInOwl:hasExactSynonym xml:lang="es">Angina variante de Prinzmetal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111151</oboInOwl:id>
        <rdfs:label xml:lang="es">angina de Prinzmetal</rdfs:label>
    </owl:Class>
