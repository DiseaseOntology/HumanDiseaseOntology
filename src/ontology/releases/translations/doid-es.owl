    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050836"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Distonía focal que se caracteriza por parkinsonismo que se acompaña frecuentemente de distonía focal y progresa a distonía generalizada que presenta herencia autosómica recesiva ligada al cromosoma X de inserción de retrotransposón SVA en el intrón del gen del factor 1 asociado a la proteína de unión a TATA-box (TAF1) en el cromosoma Xq13.1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10533</oboInOwl:hasDbXref>
