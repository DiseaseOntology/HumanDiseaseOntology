    <!-- http://purl.obolibrary.org/obo/SYMP_0000546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000457"/>
