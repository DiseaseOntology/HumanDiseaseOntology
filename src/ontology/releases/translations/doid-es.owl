    <!-- http://purl.obolibrary.org/obo/DOID_0112204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0112204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0112202"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
