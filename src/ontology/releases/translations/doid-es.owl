    <!-- http://purl.obolibrary.org/obo/DOID_0081076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_12603"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000092"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019142"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Leucemia aguda derivada de los precursores de las células dendríticas plasmocitoides, con una alta frecuencia de afectación cutánea y de la médula ósea y diseminación leucémica. Las lesiones cutáneas que aparecen en brazos, piernas, cara y cuello son el síntoma más frecuente de la BPDCN. Otros síntomas son recuentos bajos de células sanguíneas sanas e inflamación de los ganglios linfáticos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C7203</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Leucemia agranular de células asesinas naturales CD4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Leucemia/linfoma blastico natural killer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Linfoma blastico de células NK</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neoplasia/Tumor hematodérmico CD4+ CD56+ agranular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">leucemia/linfoma de células natural killer (NK)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081076</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">neoplasia blástica de células dendríticas plasmocitoides</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Leucemia aguda derivada de los precursores de las células dendríticas plasmocitoides, con una alta frecuencia de afectación cutánea y de la médula ósea y diseminación leucémica. Las lesiones cutáneas que aparecen en brazos, piernas, cara y cuello son el síntoma más frecuente de la BPDCN. Otros síntomas son recuentos bajos de células sanguíneas sanas e inflamación de los ganglios linfáticos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/30350260/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/31972688/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.lls.org/leukemia/blastic-plasmacytoid-dendritic-cell-neoplasm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2121"/>
