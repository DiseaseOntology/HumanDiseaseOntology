        <oboInOwl:hasDbXref>ICD10CM:J63.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C197968</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155591007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0037061</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Siderosis pulmonar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
