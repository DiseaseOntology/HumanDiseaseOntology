            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Miopatía caracterizada por facies distintiva, ptosis, fisuras palpebrales inclinadas hacia abajo, ojos muy separados, pliegues epicánticos, orejas de implantación baja, hipoplasia malar, micrognatia, paladar de arco alto, clinodactilia, pliegue palmar único, pectus excavatum, alas de las escápulas, lordosis lumbar y escoliosis torácica leve. Se han encontrado variantes patogénicas en RYR1 en algunos individuos con síndrome de King-Denborough.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8433</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C536883</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:619542</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:99741</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080990</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de King Denborough</rdfs:label>
        <skos:exactMatch>MESH:C536883</skos:exactMatch>
        <skos:exactMatch>MIM:619542</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080990"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miopatía caracterizada por facies distintiva, ptosis, fisuras palpebrales inclinadas hacia abajo, ojos muy separados, pliegues epicánticos, orejas de implantación baja, hipoplasia malar, micrognatia, paladar de arco alto, clinodactilia, pliegue palmar único, pectus excavatum, alas de las escápulas, lordosis lumbar y escoliosis torácica leve. Se han encontrado variantes patogénicas en RYR1 en algunos individuos con síndrome de King-Denborough.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK1146/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080991 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081337"/>
        <obo:IAO_0000115 xml:lang="es">Miopatía congénita que se caracteriza por múltiples áreas de actividad oxidativa mitocondrial reducida que discurren a lo largo de una extensión limitada del eje longitudinal de la fibra muscular, los denominados &apos;minicores&apos; y que presenta una mutación homocigota o heterocigota compuesta en el gen RYR1 del cromosoma 19q13. La enfermedad multiminocore se clasifica a grandes rasgos en cuatro grupos: forma clásica, forma moderada con afectación de las manos, forma prenatal con artrogriposis múltiple congénita y forma oftalmoplegica.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10316</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:255320</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:598</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad multiminicore</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080991</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">miopatía congénita 1B</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080991"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miopatía congénita que se caracteriza por múltiples áreas de actividad oxidativa mitocondrial reducida que discurren a lo largo de una extensión limitada del eje longitudinal de la fibra muscular, los denominados &apos;minicores&apos; y que presenta una mutación homocigota o heterocigota compuesta en el gen RYR1 del cromosoma 19q13. La enfermedad multiminocore se clasifica a grandes rasgos en cuatro grupos: forma clásica, forma moderada con afectación de las manos, forma prenatal con artrogriposis múltiple congénita y forma oftalmoplegica.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/11731287/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_423"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000689"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Miopatía caracterizada por degradación muscular (rabdomiólisis), dolor muscular relacionado con el calor y el esfuerzo (mialgia) y síntomas de calambres, dolor muscular intenso, elevación súbita y posterior descenso de los niveles séricos de creatina fosfoquinasa y productos de degradación muscular en la orina (mioglobinuria). Asociada a variaciones de RYR1. La rabdomiólisis se asocia a una serie de desencadenantes externos, como el ejercicio extenuante más allá del límite de la fatiga, el estrés térmico, el abuso de drogas ilícitas o alcohol, el uso de suplementos o ciertos medicamentos, una enfermedad vírica reciente o un traumatismo muscular.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080992</oboInOwl:id>
        <rdfs:label xml:lang="es">Síndrome rabdomiólisis-mialgia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miopatía caracterizada por degradación muscular (rabdomiólisis), dolor muscular relacionado con el calor y el esfuerzo (mialgia) y síntomas de calambres, dolor muscular intenso, elevación súbita y posterior descenso de los niveles séricos de creatina fosfoquinasa y productos de degradación muscular en la orina (mioglobinuria). Asociada a variaciones de RYR1. La rabdomiólisis se asocia a una serie de desencadenantes externos, como el ejercicio extenuante más allá del límite de la fatiga, el estrés térmico, el abuso de drogas ilícitas o alcohol, el uso de suplementos o ciertos medicamentos, una enfermedad vírica reciente o un traumatismo muscular.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5791790/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7667763/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


