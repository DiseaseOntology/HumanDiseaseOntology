    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12570"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A phacogenic glaucoma that is characterized by acute onset of open-angle glaucoma secondary to a leaking mature or hypermature cataract and has_symptom chronic progressive vision loss with acute onset of pain, redness, and blurry vision. Phacolytic glaucomas are caused by direct obstruction of aqueous outflow pathways from leaking cataractous lens proteins.</owl:annotatedTarget>
