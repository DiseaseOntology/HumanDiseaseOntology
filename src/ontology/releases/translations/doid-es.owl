            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Osteosarcoma óseo que se caracteriza por la presencia de matriz extracelular osteoide y que surge de la porción medular del hueso. Afecta a los huesos largos y, con mayor frecuencia, al fémur distal, la tibia proximal y el húmero proximal. La presentación clínica más frecuente es dolor con o sin masa palpable.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:3378</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICDO:9195/3</oboInOwl:hasDbXref>
