        <oboInOwl:hasDbXref>UMLS_CUI:C0018572</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Estomatitis vesicular y exantema</oboInOwl:hasExactSynonym>
