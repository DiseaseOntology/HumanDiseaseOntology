        <oboInOwl:id>DOID:0050604</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">displasia acrocapitofemoral</rdfs:label>
