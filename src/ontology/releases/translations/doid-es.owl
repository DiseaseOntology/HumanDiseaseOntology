    <!-- http://purl.obolibrary.org/obo/DOID_0050665 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050696"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002200"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0012759"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0410280"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0007001"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30879"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Trastorno del espectro alcohólico fetal que provoca graves defectos mentales y físicos que pueden desarrollarse en un niño cuando la madre bebe alcohol durante el embarazo. Las características de presentación incluyen dismorfología craneofacial (microcefalia, surco nasolabial liso, labio superior fino, aberturas oculares pequeñas), deficiencia de crecimiento pre y postnatal y disfunción del sistema nervioso central.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q86.0</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050665</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome de alcoholismo fetal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050665"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Trastorno del espectro alcohólico fetal que provoca graves defectos mentales y físicos que pueden desarrollarse en un niño cuando la madre bebe alcohol durante el embarazo. Las características de presentación incluyen dismorfología craneofacial (microcefalia, surco nasolabial liso, labio superior fino, aberturas oculares pequeñas), deficiencia de crecimiento pre y postnatal y disfunción del sistema nervioso central.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Fetal_alcohol_syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.cdc.gov/ncbddd/fasd/facts.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


