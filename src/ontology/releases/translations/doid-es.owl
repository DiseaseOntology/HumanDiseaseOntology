            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000097"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por niveles elevados de triptasa en sangre y que presenta copias hereditarias adicionales del gen de la triptasa alfa (TPSAB1), afectando a múltiples sistemas orgánicos, incluidos la piel y los tejidos conectivos, y los sistemas gastrointestinal y cardiovascular.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:13193</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
