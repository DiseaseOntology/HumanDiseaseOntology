    <!-- http://purl.obolibrary.org/obo/DOID_0081045 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081045">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081044"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una displasia frontonasal que se caracteriza por hipertelorismo, puente nasal ancho, columela ancha, surco nasolabial ensanchado, narinas estrechas muy separadas, escaso desarrollo de la punta nasal, muesca en la línea media del alvéolo superior, hinchazón de la base de la columela y una línea de implantación del pelo baja, y que presenta una mutación homocigota en el gen homeobox-3 tipo aristaless (ALX3) en el cromosoma 1p13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:136760</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081045</oboInOwl:id>
        <rdfs:label xml:lang="es">displasia frontonasal 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081045"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una displasia frontonasal que se caracteriza por hipertelorismo, puente nasal ancho, columela ancha, surco nasolabial ensanchado, narinas estrechas muy separadas, escaso desarrollo de la punta nasal, muesca en la línea media del alvéolo superior, hinchazón de la base de la columela y una línea de implantación del pelo baja, y que presenta una mutación homocigota en el gen homeobox-3 tipo aristaless (ALX3) en el cromosoma 1p13.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/19409524/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


