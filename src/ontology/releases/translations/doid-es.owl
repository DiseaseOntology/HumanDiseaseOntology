        <oboInOwl:hasDbXref>UMLS_CUI:C0878684</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Aarskog-Ose-Pande</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de anomalía de Rieger-lipodistrofia parcial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de lipodistrofia-anomalía de Rieger-diabetes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111454</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome SHORT</rdfs:label>
    </owl:Class>
