    <!-- http://purl.obolibrary.org/obo/DOID_0080957 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1387"/>
        <obo:IAO_0000115 xml:lang="es">Hipolipoproteinemia que se caracteriza por niveles bajos de lipoproteínas de alta densidad en la sangre y que presenta una mutación heterocigota en el gen ABC1 del cromosoma 9q31, que también es el lugar de las mutaciones que causan la enfermedad de Tánger.</obo:IAO_0000115>
