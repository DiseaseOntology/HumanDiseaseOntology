    <!-- http://purl.obolibrary.org/obo/DOID_551 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002451"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Neumonía que es una inflamación aguda de los pulmones inducida por la inhalación de humos metálicos o gases y vapores tóxicos. Es un evento sanitario centinela (ocupacional) asociado a la exposición al amoníaco (industrias de refrigeración, fertilizantes y refino de petróleo), cloro (industrias de álcalis y lejía), óxidos de nitrógeno (rellenadores de silos, soldadores por arco e industria del ácido nítrico), dióxido de azufre (industrias papelera, de refrigeración y refino de petróleo), cadmio (procesadores y fundiciones de cadmio), anhídrido trimelítico (plásticos y síntesis química orgánica) y pentóxido de vanadio (caldereros). Los dos tipos de agentes pulmonares son centrales y periféricos. Los agentes pulmonares centrales, por ejemplo el amoníaco, son irritantes hidrosolubles que lesionan las vías respiratorias superiores. Los agentes pulmonares periféricos, por ejemplo, el fosgeno, el NOx y el PFIB, son irritantes ligeramente solubles en agua que lesionan las membranas alveolocapilares. El cloro tiene efectos tanto centrales como periféricos.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:549</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:550</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:553</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:554</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD9CM:506.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0041881</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">edema pulmonar químico agudo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:551</oboInOwl:id>
        <rdfs:label xml:lang="es">neumonitis tóxica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_551"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonía que es una inflamación aguda de los pulmones inducida por la inhalación de humos metálicos o gases y vapores tóxicos. Es un evento sanitario centinela (ocupacional) asociado a la exposición al amoníaco (industrias de refrigeración, fertilizantes y refino de petróleo), cloro (industrias de álcalis y lejía), óxidos de nitrógeno (rellenadores de silos, soldadores por arco e industria del ácido nítrico), dióxido de azufre (industrias papelera, de refrigeración y refino de petróleo), cadmio (procesadores y fundiciones de cadmio), anhídrido trimelítico (plásticos y síntesis química orgánica) y pentóxido de vanadio (caldereros). Los dos tipos de agentes pulmonares son centrales y periféricos. Los agentes pulmonares centrales, por ejemplo el amoníaco, son irritantes hidrosolubles que lesionan las vías respiratorias superiores. Los agentes pulmonares periféricos, por ejemplo, el fosgeno, el NOx y el PFIB, son irritantes ligeramente solubles en agua que lesionan las membranas alveolocapilares. El cloro tiene efectos tanto centrales como periféricos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://hazmap.nlm.nih.gov/category-details?id=306&amp;table=tbldiseases</oboInOwl:hasDbXref>
    </owl:Axiom>
    


