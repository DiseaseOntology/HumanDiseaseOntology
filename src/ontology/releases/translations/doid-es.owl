        <skos:exactMatch>MIM:614557</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080735"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome de Ehlers-Danlos que se caracteriza por hipotonía muscular grave al nacer, escoliosis progresiva, hipermovilidad articular, piel hiperelástica, miopatía, hipoacusia neurosensorial y excreción normal de piridinolina en la orina y que presenta una mutación homocigota o heterocigota compuesta en el gen FKBP14 del cromosoma 7p15.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/28306229/</oboInOwl:hasDbXref>
