    <!-- http://purl.obolibrary.org/obo/DOID_0081315 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060103"/>
        <obo:IAO_0000115 xml:lang="es">Tumor embrionario del sistema nervioso central que se caracteriza por la presencia de células uniformes ovales o fusiformes con núcleos redondos u ovales, formación de pseudorosetas y duplicación interna en tándem heterocigota en el exón 15 del gen BCOR.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9500/3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C186556</oboInOwl:hasDbXref>
