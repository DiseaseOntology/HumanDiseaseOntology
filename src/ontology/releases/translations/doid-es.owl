    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_10459"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad de las vías respiratorias superiores que consiste en la inflamación de las membranas mucosas de la nariz, la garganta, los ojos y las trompas de Eustaquio con secreción acuosa y luego purulenta. Se trata de una enfermedad contagiosa aguda causada por rinovirus, virus de la parainfluenza humana, virus sincitial respiratorio humano, virus de la gripe, adenovirus, enterovirus o metapneumovirus.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007640"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
