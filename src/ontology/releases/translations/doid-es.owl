        <oboInOwl:hasDbXref>MIM:300400</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C4682</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:203592006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1279481</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de la cadena gamma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">hipoplasia epitelial tímica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060013</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">inmunodeficiencia combinada grave ligada al cromosoma X</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060013"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una inmunodeficiencia combinada grave que es una inmunodeficiencia combinada grave ligada al cromosoma X que tiene_como_base mutaciones en los genes que codifican las proteínas comunes de la cadena gamma compartidas por los receptores de interleucina (IL-2,4,7,9,16 y21) que dan como resultado una cadena gamma no funcional, una señalización de interleucina defectuosa, células T y NK mínimas o ascendentes y células B no funcionales.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
