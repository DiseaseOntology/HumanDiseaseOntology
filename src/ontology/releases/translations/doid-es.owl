    <!-- http://purl.obolibrary.org/obo/DOID_14365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9252"/>
        <obo:IAO_0000115 xml:lang="es">Trastorno metabólico de los aminoácidos que implica proteínas defectuosas denominadas transportadores de carnitina, que introducen carnitina en las células e impiden su salida del organismo evitando que éste no pueda utilizar las grasas como fuente de energía.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:1668</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:E71.41</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:277.81</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C536778</oboInOwl:hasDbXref>
