    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080713">
        <obo:IAO_0000115 xml:lang="en">A syndrome that has_material_basis_in an extra copy of the MECP2 gene in each cell, occurs almost exclusively in males and that is characterized by delayed development of motor skills such as sitting and walking.</obo:IAO_0000115>
