        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A Charcot-Marie-Tooth disease type 1 characterized by delayed motor development in the first years of life associated with gait abnormalities, sensory ataxia, hyporeflexia, and distal sensory impairment due to a sensorimotor peripheral neuropathy that mainly affects the lower limbs that has_material_basis_in heterozygous mutation in the POLR3B gene on chromosome 12q23. This disease is progressive.</owl:annotatedTarget>
