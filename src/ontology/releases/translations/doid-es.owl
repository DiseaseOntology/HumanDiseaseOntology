        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:14168008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0034494</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
