    <!-- http://purl.obolibrary.org/obo/DOID_0090125 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090125">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0112313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de los vasos sanguíneos cerebrales pequeños que se caracteriza por la fragilidad de los vasos sanguíneos pequeños del cerebro, leucoencefalopatía, mayor riesgo de accidente cerebrovascular, convulsiones y migraña y, en algunos casos, anomalía de Axenfeld-Riegar que presenta herencia autosómica dominante de una mutación heterocigota en el gen de la cadena alfa 1 del colágeno tipo IV (COL4A1) en el cromosoma 13q34.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:175780</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:36383</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad cerebral de pequeños vasos relacionada con COL4A1 con hemorragia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Leucoencefalopatía vascular familiar relacionada con COL4A1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Tortuosidad arteriolar retiniana relacionada con COL4A1-Hemiparesia infantil-Síndrome de leucoencefalopatía autosómica dominante</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad de pequeños vasos cerebrales con anomalía de Axenfeld-Riegar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad de pequeños vasos cerebrales con o sin anomalías oculares</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">hemiparesia infantil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">leucoencefalopatía con anomalía de Axenfeld-Riegar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">tortuosidad arteriolar retiniana autosómica dominante, hemiparesia infantil y leucencefalopatía</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0090125</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">enfermedad de los vasos sanguíneos cerebrales pequeños 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0090125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad de los vasos sanguíneos cerebrales pequeños que se caracteriza por la fragilidad de los vasos sanguíneos pequeños del cerebro, leucoencefalopatía, mayor riesgo de accidente cerebrovascular, convulsiones y migraña y, en algunos casos, anomalía de Axenfeld-Riegar que presenta herencia autosómica dominante de una mutación heterocigota en el gen de la cadena alfa 1 del colágeno tipo IV (COL4A1) en el cromosoma 13q34.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/col4a1-related-brain-small-vessel-disease</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/familial-porencephaly</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/175780</oboInOwl:hasDbXref>
    </owl:Axiom>
    


