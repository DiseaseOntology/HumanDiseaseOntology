    <!-- http://purl.obolibrary.org/obo/DOID_0090141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0090139"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una deficiencia de cortisona reductasa que se caracteriza por la incapacidad de regenerar el cortisol a través de la enzima 11-beta-hidroxiesteroide deshidrogenasa que requiere la regeneración de NADPH por la hexosa-6-fosfato deshidrogenasa, lo que resulta en hiperandrogenismo suprarrenal mediado por ACTH. Tiene material base en autosómico Herencia recesiva de mutación homocigótica o heterocigótica compuesta en el gen de la hexosa-6-fosfato deshidrogenasa (H6PD) en el cromosoma 1p36.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:604931</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C131849</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
