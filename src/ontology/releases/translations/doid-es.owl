    <!-- http://purl.obolibrary.org/obo/DOID_0070339 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000338"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_1059"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Un síndrome con una malformación cerebelosa como rasgo principal caracterizado por hipoplasia cerebelosa, cambios pigmentarios retinianos bilaterales, discapacidad intelectual que puede ir de leve a moderada y un retraso pronunciado en el desarrollo del lenguaje. Se presenta con un retraso temprano del desarrollo, deficiencia visual central y periférica no progresiva o cambios retinianos asintomáticos, hipotonía, ataxia no progresiva y nistagmo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:213000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:2246</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070339</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">hipoplasia/atrofia cerebelosa, epilepsia y retraso global del desarrollo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070339"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un síndrome con una malformación cerebelosa como rasgo principal caracterizado por hipoplasia cerebelosa, cambios pigmentarios retinianos bilaterales, discapacidad intelectual que puede ir de leve a moderada y un retraso pronunciado en el desarrollo del lenguaje. Se presenta con un retraso temprano del desarrollo, deficiencia visual central y periférica no progresiva o cambios retinianos asintomáticos, hipotonía, ataxia no progresiva y nistagmo.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/31785787/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


