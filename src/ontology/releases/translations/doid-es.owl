        <oboInOwl:hasDbXref>url:http://dermatology.cdlib.org/113/case_reports/actinomycosis/fazeli.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Cutaneous_actinomycosis</oboInOwl:hasDbXref>
