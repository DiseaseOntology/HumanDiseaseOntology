        <obo:IAO_0000115 xml:lang="es">El bloqueo cardiaco familiar progresivo se caracteriza por la herencia autosómica dominante de un bloqueo cardiaco que tiende a desarrollarse a lo largo de las líneas de una bradicardia sinusal con un hemibloqueo posterior izquierdo, que se presenta clínicamente como episodios sincopales, convulsiones de Stokes-Adams o muerte súbita cuando sobreviene un bloqueo cardiaco completo y tiene_base_material_en una variación en la región cromosómica 1q32.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C564202</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:140400</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111075</oboInOwl:id>
        <rdfs:label xml:lang="es">bloqueo cardiaco familiar progresivo tipo II</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El bloqueo cardiaco familiar progresivo se caracteriza por la herencia autosómica dominante de un bloqueo cardiaco que tiende a desarrollarse a lo largo de las líneas de una bradicardia sinusal con un hemibloqueo posterior izquierdo, que se presenta clínicamente como episodios sincopales, convulsiones de Stokes-Adams o muerte súbita cuando sobreviene un bloqueo cardiaco completo y tiene_base_material_en una variación en la región cromosómica 1q32.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/16086176</oboInOwl:hasDbXref>
