    <!-- http://purl.obolibrary.org/obo/DOID_12900 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12900">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_417"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000260"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una enfermedad autoinmune que se caracteriza por el agrandamiento crónico de las glándulas de la cabeza y el cuello, tiene síntoma bultos de la cara y el cuello, ojos secos, boca seca, y fiebre intermitente, y con frecuencia se asocia con un trastorno autoinmune subyacente, malignidad hematológica, infección por tuberculosis, o infección por sífilis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7043</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:K11.8</oboInOwl:hasDbXref>
