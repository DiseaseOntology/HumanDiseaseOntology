                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000493"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000716"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de las vías respiratorias superiores que implica inflamación, dolor e hinchazón del tejido adenoideo debido a la infección por bacterias y virus. Se da sobre todo en niños y puede ser secundaria a una alergia, una infección de nariz o garganta y una obstrucción de la trompa de Eustaquio. La infección presenta entre sus síntomas dolor, enrojecimiento, hinchazón y dificultad para tragar.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:13750</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J35.02</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:474.01</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:195794009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0396023</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">adenoiditis crónica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050145</oboInOwl:id>
        <rdfs:label xml:lang="es">adenoiditis</rdfs:label>
    </owl:Class>
