        <owl:annotatedTarget>Rigidity hypokinesia a type of hypokinesia described as the increase in muscle tension when moved by an outside force.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Hypokinesia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000860 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000858"/>
        <obo:IAO_0000115>Postural instability hypokinesia is a hypokinesia described as a loss of ability to maintain an upright posture.</obo:IAO_0000115>
