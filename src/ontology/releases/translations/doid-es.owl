            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una deficiencia de cortisona reductasa que se caracteriza por una falla en la regeneración del cortisol a través de la enzima 11-beta-hidroxiesteroide deshidrogenasa, lo que resulta en hiperandrogenismo suprarrenal mediado por ACTH, y tiene material base en herencia autosómica dominante de mutación heterocigótica en el gen 11-beta -Gen de la hidroxiesteroide deshidrogenasa tipo I (HSD11B1) en el cromosoma 1q32.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:614662</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C131084</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0090140</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">deficiencia de cortisona reductasa 2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0090140"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una deficiencia de cortisona reductasa que se caracteriza por una falla en la regeneración del cortisol a través de la enzima 11-beta-hidroxiesteroide deshidrogenasa, lo que resulta en hiperandrogenismo suprarrenal mediado por ACTH, y tiene material base en herencia autosómica dominante de mutación heterocigótica en el gen 11-beta -Gen de la hidroxiesteroide deshidrogenasa tipo I (HSD11B1) en el cromosoma 1q32.</owl:annotatedTarget>
