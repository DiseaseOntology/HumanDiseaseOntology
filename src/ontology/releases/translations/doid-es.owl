    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2348"/>
        <obo:IAO_0000115 xml:lang="en">An arteriosclerotic cardiovascular disease that is characterized by the build-up of fatty material and calcium deposition in the arterial wall resulting in partial or complete occlusion of the arterial lumen. Disease is located within the tunica intima of large and small arteries.</obo:IAO_0000115>
