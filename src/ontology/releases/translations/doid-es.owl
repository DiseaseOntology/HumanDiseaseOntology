    <!-- http://purl.obolibrary.org/obo/DOID_3083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2320"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad pulmonar obstructiva que es un trastorno crónico y progresivo de las vías respiratorias pequeñas de los pulmones y que se caracteriza por una obstrucción irreversible del flujo aéreo, identificada normalmente por reducciones de los índices espirométricos cuantitativos, el volumen espiratorio forzado inducido a 1 segundo (FEV1) y la relación entre el FEV1 y la capacidad vital forzada (menos de 0,7 es diagnóstico de EPOC). El volumen pulmonar aumenta y puede producirse hipertensión pulmonar. Los cambios patológicos provocan la interrupción del flujo de aire en las vías respiratorias bronquiales. Los signos y síntomas incluyen dificultad para respirar, sibilancias, tos productiva y opresión torácica. La EPOC es una consecuencia (un resultado final) de la bronquitis crónica, el enfisema o ambos.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:11500</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:6144</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>EFO:0000341</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:J44.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D029424</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:606963</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3199</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:13645005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024117</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">EPOC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">FRÍO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad obstructiva crónica de las vías respiratorias</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad pulmonar obstructiva crónica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3083</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_RAD_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">enfermedad pulmonar obstructiva crónica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3083"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad pulmonar obstructiva que es un trastorno crónico y progresivo de las vías respiratorias pequeñas de los pulmones y que se caracteriza por una obstrucción irreversible del flujo aéreo, identificada normalmente por reducciones de los índices espirométricos cuantitativos, el volumen espiratorio forzado inducido a 1 segundo (FEV1) y la relación entre el FEV1 y la capacidad vital forzada (menos de 0,7 es diagnóstico de EPOC). El volumen pulmonar aumenta y puede producirse hipertensión pulmonar. Los cambios patológicos provocan la interrupción del flujo de aire en las vías respiratorias bronquiales. Los signos y síntomas incluyen dificultad para respirar, sibilancias, tos productiva y opresión torácica. La EPOC es una consecuencia (un resultado final) de la bronquitis crónica, el enfisema o ambos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/28513453/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/32745458/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/32800196/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.nhlbi.nih.gov/health/copd</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3083"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="es">EPOC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3083"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="es">FRÍO</owl:annotatedTarget>
