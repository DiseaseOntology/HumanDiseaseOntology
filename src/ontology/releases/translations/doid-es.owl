        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de AID</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de citidina desaminasa inducida por activación</oboInOwl:hasExactSynonym>
