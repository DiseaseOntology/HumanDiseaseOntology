    <!-- http://purl.obolibrary.org/obo/DOID_0060402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
