        <oboInOwl:hasDbXref>ORDO:231393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:718196002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1839161</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Citopenia ligada al cromosoma X relacionada con GATA1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Sindrome de talasemia beta-trombocitopenia ligado al cromosoma X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Trombocitopenia, disfunción plaquetaria, hemólisis y síntesis desequilibrada de globina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
