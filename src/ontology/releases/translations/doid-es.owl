        <oboInOwl:hasExactSynonym xml:lang="es">glucogenosis cardiaca congénita no lisosómica mortal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">miocardiopatía hipertrófica congénita mortal debida a glucogenosis</oboInOwl:hasExactSynonym>
