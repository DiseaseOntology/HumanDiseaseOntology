        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:186413007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0017105</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por bacilo gaseoso</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9159</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">gangrena gaseosa</rdfs:label>
    </owl:Class>
