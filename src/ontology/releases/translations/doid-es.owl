    <!-- http://purl.obolibrary.org/obo/DOID_0050010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050010">
        <obo:IAO_0000115 xml:lang="en">A mansonelliasis that involves parasitic infection by the nematode Mansonella perstans, which resides in body cavities and the surrounding tissues causing angioedema, pruritus, fever, headaches, arthralgias, and neurologic manifestations. Midges transmit the disease.</obo:IAO_0000115>
