        <oboInOwl:hasDbXref>UMLS_CUI:C0006542</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Asma de Stripper</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de los consumidores de lino</oboInOwl:hasExactSynonym>
