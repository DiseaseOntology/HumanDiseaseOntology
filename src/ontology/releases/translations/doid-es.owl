                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000604"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección del intestino por el nematodo Ascaris lumbricoides. Las larvas que migran a través de los pulmones provocan tos, sibilancias y hemoptisis. La obstrucción intestinal o biliar provoca dolor abdominal tipo cólico, náuseas y vómitos. Cuando las larvas llegan a la circulación portal se observa peritonitis, agrandamiento del hígado o el bazo, toxicidad y neumonía.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B77</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:127.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D001196</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C128392</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:2435008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0003950</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">Infección por Ascaris lumbricoides</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:456</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">ascariasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección del intestino por el nematodo Ascaris lumbricoides. Las larvas que migran a través de los pulmones provocan tos, sibilancias y hemoptisis. La obstrucción intestinal o biliar provoca dolor abdominal tipo cólico, náuseas y vómitos. Cuando las larvas llegan a la circulación portal se observa peritonitis, agrandamiento del hígado o el bazo, toxicidad y neumonía.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
