            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una inmunodeficiencia combinada grave que tiene_como_base mutaciones autosómicas recesivas en el gen que codifica los precursores de la cadena de glicoproteína de superficie de las células T CD3epsilon. Los pacientes con deficiencia de CD3epsilon presentan un defecto grave en la expresión del complejo CD3 del receptor de células T.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060017</oboInOwl:id>
        <rdfs:label xml:lang="es">deficiencia de CD3epsilon</rdfs:label>
    </owl:Class>
    <owl:Axiom>
