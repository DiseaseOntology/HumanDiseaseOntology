                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El botulismo que consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA, B, E y F), que se transmiten por la ingestión de alimentos contaminados con toxinas preformadas, tiene_como_base el Clostridium botulinum A, tiene_como_base el Clostridium botulinum B, tiene_como_base el Clostridium botulinum E y tiene_como_base el Clostridium botulinum F. La presenta entre sus síntomas visión borrosa, diplopía, disartria, disfonía, disfagia y parálisis muscular descendente.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050352</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#GOLD"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">botulismo alimentario</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050352"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El botulismo que consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA, B, E y F), que se transmiten por la ingestión de alimentos contaminados con toxinas preformadas, tiene_como_base el Clostridium botulinum A, tiene_como_base el Clostridium botulinum B, tiene_como_base el Clostridium botulinum E y tiene_como_base el Clostridium botulinum F. La presenta entre sus síntomas visión borrosa, diplopía, disartria, disfonía, disfagia y parálisis muscular descendente.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.southernnevadahealthdistrict.org/Health-Topics/foodborne-botulism/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050353 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11976"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002451"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Botulismo que consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA, B, E y F), tiene_como_base el Clostridium botulinum A, tiene_como_base el Clostridium botulinum B, tiene_como_base el Clostridium botulinum E y tiene_como_base el Clostridium botulinum F, que se transmite por contacto de esporas con las heridas abiertas, que luego se reproducen en un medio anaeróbico para producir toxinas.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050353</oboInOwl:id>
