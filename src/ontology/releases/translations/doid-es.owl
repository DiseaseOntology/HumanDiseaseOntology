    <!-- http://purl.obolibrary.org/obo/DOID_0080736 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13359"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome de Ehlers-Danlos que se caracteriza por dismorfismo craneofacial distintivo, contracturas congénitas de pulgares y dedos, pies zambos, cifoescoliosis grave, hipotonía muscular, piel fina hiperextensible con facilidad para las contusiones y cicatrices atróficas, palmas arrugadas, hipermovilidad articular y afectación ocular, y que presenta una mutación homocigota o heterocigota compuesta en el gen CHST14 del cromosoma 15q14.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:601776</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080736</oboInOwl:id>
        <rdfs:label xml:lang="es">Síndrome de Ehlers-Danlos musculocontractural tipo 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080736"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome de Ehlers-Danlos que se caracteriza por dismorfismo craneofacial distintivo, contracturas congénitas de pulgares y dedos, pies zambos, cifoescoliosis grave, hipotonía muscular, piel fina hiperextensible con facilidad para las contusiones y cicatrices atróficas, palmas arrugadas, hipermovilidad articular y afectación ocular, y que presenta una mutación homocigota o heterocigota compuesta en el gen CHST14 del cromosoma 15q14.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/28306229/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080737 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13359"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000094"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An Ehlers-Danlos syndrome that is characterized by progressive multisystem fragility-related manifestations, including joint dislocations and deformities; skin hyperextensibility, bruisability, and fragility, with recurrent large subcutaneous hematomas; cardiac valvular, respiratory, gastrointestinal, and ophthalmologic complications; and myopathy, featuring muscle hypoplasia, muscle weakness, and an abnormal muscle fiber pattern in histology in adulthood, resulting in gross motor developmental delay and that has_material_basis_in homozygous mutation in the DSE gene on chromosome 6q22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:615539</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080737</oboInOwl:id>
        <rdfs:label xml:lang="es">Síndrome de Ehlers-Danlos musculocontractural tipo 2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080737"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An Ehlers-Danlos syndrome that is characterized by progressive multisystem fragility-related manifestations, including joint dislocations and deformities; skin hyperextensibility, bruisability, and fragility, with recurrent large subcutaneous hematomas; cardiac valvular, respiratory, gastrointestinal, and ophthalmologic complications; and myopathy, featuring muscle hypoplasia, muscle weakness, and an abnormal muscle fiber pattern in histology in adulthood, resulting in gross motor developmental delay and that has_material_basis_in homozygous mutation in the DSE gene on chromosome 6q22.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/28306229/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080738 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13359"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An Ehlers-Danlos syndrome that is characterized by short stature, developmental anomalies of the forearm bones and elbow, and bowing of extremities, in addition to the classic stigmata of Ehlers-Danlos syndrome, including joint laxity, skin hyperextensibility, and poor wound healing and that has_material_basis_in homozygous or compound heterozygous mutation in the B4GALT7 gene on chromosome 5q35.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:130070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:75496</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:720861000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C4552003</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080738</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de Ehlers-Danlos espondilodisplásico tipo 1</rdfs:label>
        <skos:exactMatch>ORDO:75496</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C4552003</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080738"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An Ehlers-Danlos syndrome that is characterized by short stature, developmental anomalies of the forearm bones and elbow, and bowing of extremities, in addition to the classic stigmata of Ehlers-Danlos syndrome, including joint laxity, skin hyperextensibility, and poor wound healing and that has_material_basis_in homozygous or compound heterozygous mutation in the B4GALT7 gene on chromosome 5q35.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/23956117/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080739 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080739">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13359"/>
        <obo:IAO_0000115 xml:lang="es">Un síndrome de Ehlers-Danlos que presenta una mutación homocigota en el gen transportador de zinc SLC39A13 en el cromosoma 11p11 y que se caracteriza por baja estatura, piel hiperelástica y articulaciones hipermóviles, ojos protuberantes con escleróticas azuladas, palmas de las manos finamente arrugadas y rasgos radiológicos característicos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:612350</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080739</oboInOwl:id>
        <rdfs:label xml:lang="es">Síndrome de Ehlers-Danlos espondilodisplásico tipo 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un síndrome de Ehlers-Danlos que presenta una mutación homocigota en el gen transportador de zinc SLC39A13 en el cromosoma 11p11 y que se caracteriza por baja estatura, piel hiperelástica y articulaciones hipermóviles, ojos protuberantes con escleróticas azuladas, palmas de las manos finamente arrugadas y rasgos radiológicos característicos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/18513683/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080740 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060068"/>
        <obo:IAO_0000115 xml:lang="en">A nonbacterial thrombotic endocarditis that is characterized by Libman-Sacks vegetations, is common in patients with systemic lupus erythematosus and is commonly complicated with embolic cerebrovascular disease.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:M32.11</oboInOwl:hasDbXref>
