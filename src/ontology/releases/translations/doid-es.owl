        <oboInOwl:hasDbXref>UMLS_CUI:C0009207</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Neill-Dingwall</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
