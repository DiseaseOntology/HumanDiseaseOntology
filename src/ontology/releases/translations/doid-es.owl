    <!-- http://purl.obolibrary.org/obo/DOID_5812 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_5812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_627"/>
        <obo:IAO_0000115 xml:lang="es">Inmunodeficiencia combinada grave que se caracteriza por la deficiencia de moléculas MHC de clase II que provoca la falta de protección inmunitaria contra bacterias, virus y hongos y, por lo tanto, causa la muerte precoz en la infancia, y tiene base material en herencia autosómica recesiva de mutación en los genes CIITA, RFX5, RFXANK y RFXAP.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:D81.6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D016511</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:209920</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3895</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:71904008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0242583</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de linfocitos desnudos tipo II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:5812</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">deficiencia de MHC clase II</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_5812"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Inmunodeficiencia combinada grave que se caracteriza por la deficiencia de moléculas MHC de clase II que provoca la falta de protección inmunitaria contra bacterias, virus y hongos y, por lo tanto, causa la muerte precoz en la infancia, y tiene base material en herencia autosómica recesiva de mutación en los genes CIITA, RFX5, RFXANK y RFXAP.</owl:annotatedTarget>
