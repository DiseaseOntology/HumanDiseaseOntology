            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Es una tricomoniasis causada por un parásito protozoario unicelular Trichomonas tenax, que se transmite a través de gotitas orales, por los besos o en fómites como los cubiertos. Trichomonas tenax causa periodonitis y tricomoniasis broncopulmonar por aspiración desde la orofaringe.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050270</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_IEDB_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">Tricomoniasis por Trichomonas tenax</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050270"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Es una tricomoniasis causada por un parásito protozoario unicelular Trichomonas tenax, que se transmite a través de gotitas orales, por los besos o en fómites como los cubiertos. Trichomonas tenax causa periodonitis y tricomoniasis broncopulmonar por aspiración desde la orofaringe.</owl:annotatedTarget>
