        <owl:annotatedTarget xml:lang="en">A familial episodic pain syndrome characterized by adult-onset of paroxysmal pain mainly affecting the distal lower extremities that has_material_basis_in heterozygous mutation in the SCN10A gene on chromosome 3p22.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
