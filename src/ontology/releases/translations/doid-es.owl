    <!-- http://purl.obolibrary.org/obo/DOID_2378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2377"/>
        <obo:IAO_0000115 xml:lang="es">Esclerosis múltiple que se caracteriza por recaídas (ataques de reagudización de los síntomas) seguidos de remisiones (periodos de recuperación). Los síntomas pueden variar de leves a graves, y las recaídas y remisiones pueden durar días o meses. Más del 80% de las personas que padecen EM comienzan con ciclos de recaída-remisión.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0003929</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G35.A</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D020529</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C165675</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:426373005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0751967</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">EM recurrente-remitente</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2378</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">esclerosis múltiple remitente-recurrente</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2378"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Esclerosis múltiple que se caracteriza por recaídas (ataques de reagudización de los síntomas) seguidos de remisiones (periodos de recuperación). Los síntomas pueden variar de leves a graves, y las recaídas y remisiones pueden durar días o meses. Más del 80% de las personas que padecen EM comienzan con ciclos de recaída-remisión.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.mayoclinic.org/multiple-sclerosis/types.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


