    <!-- http://purl.obolibrary.org/obo/DOID_0060439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9252"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SO_0001537"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Trastorno metabólico de los aminoácidos caracterizado por la incapacidad del organismo para descomponer eficazmente la lisina, la arginina y la ornitina y por una hiperdiaminoaciduria renal, especialmente lisinuria, y por una formación alterada de urea con hiperamonemia después de la ingestión de proteínas que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen transportador de aminoácidos SLC7A7 en el cromosoma 14q11.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-13T15:04:00Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>GARD:3335</oboInOwl:hasDbXref>
