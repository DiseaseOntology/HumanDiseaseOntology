    <!-- http://purl.obolibrary.org/obo/DOID_0060822 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060822">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060309"/>
        <obo:IAO_0000115 xml:lang="en">A syndromic X-linked intellectual disability characterized by intellectual deficit, muscle wasting, short stature, hypogonadism, and abnormal gait, with variable occurrence of prominent lower lip, kyphosis, joint hyperextensibility, tremor, decreased fine motor coordination and impaired speech that has_material_basis_in mutation in the CUL4B gene on chromosome Xq24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:13244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:Q87.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:300354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:85293</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">retraso mental ligado al X con talla baja</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">retraso mental ligado al X con talla baja, hipogonadismo y marcha anormal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060822</oboInOwl:id>
