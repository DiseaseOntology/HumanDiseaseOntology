        <oboInOwl:hasDbXref>UMLS_CUI:C0005742</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:348</oboInOwl:id>
        <rdfs:label xml:lang="es">blefarocalasia</rdfs:label>
    </owl:Class>
