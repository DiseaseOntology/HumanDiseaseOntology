        <oboInOwl:hasDbXref>NCI:C84604</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:186343005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0085568</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">úlcera de Bairnsdale</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">úlcera de Daintree</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">úlcera de Mossman</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">úlcera de Searl</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">úlcera de Searle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050456</oboInOwl:id>
