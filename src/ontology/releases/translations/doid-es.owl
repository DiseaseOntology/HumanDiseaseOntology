        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">síndrome pulmonar por hantavirus</rdfs:label>
        <skos:broadMatch>ICD9CM:079.81</skos:broadMatch>
        <skos:broadMatch>ICD9CM:480.8</skos:broadMatch>
        <skos:exactMatch>GARD:69</skos:exactMatch>
