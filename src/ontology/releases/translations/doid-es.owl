        <oboInOwl:id>DOID:0050147</oboInOwl:id>
        <rdfs:label xml:lang="es">otomicosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050147"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una otitis externa que es una enfermedad del oído producida por el crecimiento de hongos en el conducto auditivo externo. Se caracteriza por inflamación, prurito, descamación y graves molestias. Los hongos más comunes son el Aspergillus niger y la Candida albicans.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Otomycosis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.merriam-webster.com/medical/otomycosis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_974"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de las vías respiratorias superiores que involucra la inflamación de la laringe y la tráquea, a menudo causada por una infección vírica. La infección puede cerrar la tráquea.</obo:IAO_0000115>
