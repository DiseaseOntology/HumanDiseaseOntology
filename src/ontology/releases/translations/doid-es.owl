        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000492"/>
        <obo:IAO_0000115>A urinary incontinence that is characterized by an involuntary leakage of urine from the bladder accompanying physical activity (as in laughing, coughing, sneezing, or physical exercise) which places increased pressure on the abdomen.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000853</oboInOwl:id>
