        <oboInOwl:hasExactSynonym xml:lang="es">Demencia presenil con Ataxia espástica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070029</oboInOwl:id>
