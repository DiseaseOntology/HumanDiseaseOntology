    <!-- http://purl.obolibrary.org/obo/DOID_2810 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2810">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_850"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000521"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000709"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019142"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad pulmonar que se define como un colapso recurrente o crónico del lóbulo medio derecho, lóbulo superior derecho o língula pulmonar. Está causada por un tumor endobronquial, infecciones granulomatosas, linfadenopatías, cuerpos extraños, nódulos silícicos endobronquiales, mucosidad inspirada asociada a la fibrosis quística o inflamación como consecuencia de una infección.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D008878</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:28295001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0026069</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2810</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome del lóbulo medio</rdfs:label>
        <skos:exactMatch>MESH:D008878</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
