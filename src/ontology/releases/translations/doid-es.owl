        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060345"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una bartonelosis que tiene_como_base la Bartonella henselae o tiene_como_base la Bartonella quintana. La enfermedad se caracteriza por la proliferación de vasos sanguíneos, lo que hace que formen masas similares a tumores en la piel y otros órganos.</owl:annotatedTarget>
