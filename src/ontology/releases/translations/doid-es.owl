        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Schimmelpenning-Feuerstein-Mims</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome del nevo organoide</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome del nevo sebáceo</oboInOwl:hasExactSynonym>
