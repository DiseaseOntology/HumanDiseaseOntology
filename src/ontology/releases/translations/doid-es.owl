            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A carbohydrate metabolic disorder that is characterized by global developmental delay, hypotonia, abnormal involuntary movements, and alacrima or poor tear production and that has_material_basis_in homozygous or compound heterozygous mutation in the NGLY1 gene on chromosome 3p24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:E77.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C000626124</oboInOwl:hasDbXref>
