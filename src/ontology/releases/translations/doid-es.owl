        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">toxoplasmosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9965"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Coccidiosis que tiene base material en en el protozoo Toxoplasma gondii. El parásito afecta a la mayoría de los géneros de animales de sangre caliente, incluido el hombre, pero el host principal es la familia de los félidos (gatos). Los animales se infectan al comer carne infectada, por ingestión de heces de un gato que a su vez ha sido infectado recientemente, o por transmisión de la madre al feto. Los síntomas incluyen linfadenopatía cervical o axilar bilateral no sensible, fiebre, malestar, mialgias, hepatoesplenomegalia, anemia y leucopenia.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Toxoplasmosis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


