    <!-- http://purl.obolibrary.org/obo/DOID_10328 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10316"/>
        <obo:IAO_0000115 xml:lang="es">Neumoconiosis se caracteriza por la deposición de un exceso de hierro en el tejido corporal como consecuencia de la inhalación del hierro presente en el polvo minero o en los humos de soldadura.</obo:IAO_0000115>
