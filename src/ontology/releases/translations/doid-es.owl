    <!-- http://purl.obolibrary.org/obo/DOID_4439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2994"/>
