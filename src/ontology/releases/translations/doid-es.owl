    <!-- http://purl.obolibrary.org/obo/DOID_0081034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080699"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003623"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Deficiencia de glutatión sintetasa que se caracteriza por excreción urinaria masiva de 5-oxoprolina, acidosis metabólica, anemia hemolítica y daños en el sistema nervioso central y que presenta una mutación homocigota o heterocigota compuesta en el gen que codifica la glutatión sintetasa (GSS) en el cromosoma 20q11. El defecto metabólico provoca una disminución de los niveles de glutatión celular, que sobreestimula la síntesis de gamma-glutamilcisteína y su posterior conversión a 5-oxoprolina.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:266130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:32</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081034</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Deficiencia de glutatión sintetasa con 5-oxoprolinuria</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081034"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Deficiencia de glutatión sintetasa que se caracteriza por excreción urinaria masiva de 5-oxoprolina, acidosis metabólica, anemia hemolítica y daños en el sistema nervioso central y que presenta una mutación homocigota o heterocigota compuesta en el gen que codifica la glutatión sintetasa (GSS) en el cromosoma 20q11. El defecto metabólico provoca una disminución de los niveles de glutatión celular, que sobreestimula la síntesis de gamma-glutamilcisteína y su posterior conversión a 5-oxoprolina.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/15990954/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


