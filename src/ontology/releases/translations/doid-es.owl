    <!-- http://purl.obolibrary.org/obo/DOID_0080958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1387"/>
        <obo:IAO_0000115 xml:lang="es">Hipolipoproteinemia que se caracteriza por una producción disfuncional de apoA-I, lo que da lugar a niveles indetectables de apoA-I en suero y a niveles marcadamente bajos de colesterol de lipoproteínas de alta densidad en suero, es generalmente un trastorno autosómico recesivo asociado con aterosclerosis extensa, xantomas y opacidades corneales, y que presenta una mutación homocigota, heterocigota compuesta o heterocigota en el gen APOA1 del cromosoma 11q23.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:758</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:618463</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:425</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de apolipoproteína A-I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080958</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">hipoalfalipoproteinemia primaria 2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080958"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Hipolipoproteinemia que se caracteriza por una producción disfuncional de apoA-I, lo que da lugar a niveles indetectables de apoA-I en suero y a niveles marcadamente bajos de colesterol de lipoproteínas de alta densidad en suero, es generalmente un trastorno autosómico recesivo asociado con aterosclerosis extensa, xantomas y opacidades corneales, y que presenta una mutación homocigota, heterocigota compuesta o heterocigota en el gen APOA1 del cromosoma 11q23.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/29396262/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


