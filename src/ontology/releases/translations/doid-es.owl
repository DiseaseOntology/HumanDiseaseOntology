        <owl:annotatedTarget>Active hyperemia is a hyperemia occurring due to the dilation of arteriolar smooth muscle to increase blood flow in response to an increase in metabolism.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Hyperemia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000299"/>
        <obo:IAO_0000115>Functional hyperemia is a hyperemia occurring due to an increase in blood flow to a tissue due to the presence of metabolites and a change in general conditions.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000843</oboInOwl:id>
