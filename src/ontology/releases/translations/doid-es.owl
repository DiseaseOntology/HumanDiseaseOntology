        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Prostration is a general symptom characterized by complete physical or mental exhaustion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=prostration</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000587"/>
        <obo:IAO_0000115>An abnormal chest sound that is characterized by the clicking, rattling, or crackling noises heard on auscultation of (listening to) the lung with a stethoscope during inhalation. The sounds are caused by the &apos;popping open&apos; of small airways and alveoli collapsed by fluid, exudate, or lack of aeration during expiration. The word &apos;rales&apos; derives from the French word rale meaning &apos;rattle&apos;. Rales can be heard in patients with pneumonia, atelectasis, pulmonary fibrosis, acute bronchitis, or bronchiectasis. Pulmonary edema secondary to left-sided congestive heart failure can also cause rales.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>crackles</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>crepitations</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000118</oboInOwl:id>
        <rdfs:label>rales</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000118"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An abnormal chest sound that is characterized by the clicking, rattling, or crackling noises heard on auscultation of (listening to) the lung with a stethoscope during inhalation. The sounds are caused by the &apos;popping open&apos; of small airways and alveoli collapsed by fluid, exudate, or lack of aeration during expiration. The word &apos;rales&apos; derives from the French word rale meaning &apos;rattle&apos;. Rales can be heard in patients with pneumonia, atelectasis, pulmonary fibrosis, acute bronchitis, or bronchiectasis. Pulmonary edema secondary to left-sided congestive heart failure can also cause rales.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Rales</oboInOwl:hasDbXref>
    </owl:Axiom>
    


