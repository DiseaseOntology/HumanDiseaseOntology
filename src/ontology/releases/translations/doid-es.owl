            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An autosomal recessive congenital ichthyosis characterized by ichthyosis, hypotrichosis, photophobia, corneal opacity, pingueculum, blepharitis, marked acanthosis, otrhohyperkeratosis and hyperkeratosis that has_material_basis_in homozygous mutation in the ST14 gene on chromosome 11q24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q80.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:602400</oboInOwl:hasDbXref>
