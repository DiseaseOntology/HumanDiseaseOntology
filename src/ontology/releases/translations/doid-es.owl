    <!-- http://purl.obolibrary.org/obo/DOID_5501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_5501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5502"/>
