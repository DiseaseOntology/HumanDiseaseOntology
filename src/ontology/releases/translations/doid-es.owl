    <!-- http://purl.obolibrary.org/obo/DOID_0070307 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
