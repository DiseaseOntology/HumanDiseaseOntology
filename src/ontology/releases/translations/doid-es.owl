    <!-- http://purl.obolibrary.org/obo/DOID_3479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3479">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DOID_162"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
