            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa bacteriana primaria que es una infección de transmisión sexual localizada en la piel de los genitales, tiene base material en Haemophilus ducreyi, que se transmite por contacto sexual. La infección tiene síntoma de úlceras dolorosas y suaves.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9522</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A57</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:099.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002602</oboInOwl:hasDbXref>
