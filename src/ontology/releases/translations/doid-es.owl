    <!-- http://purl.obolibrary.org/obo/DOID_4804 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4804">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in infection in sheep and goats, has_material_basis_in Border disease virus, which is transmitted_by congenital method. The infection has_symptom abortion, has_symptom stillbirth, has_symptom hairy fleece in lambs, and has_symptom abnormal body conformation.</obo:IAO_0000115>
