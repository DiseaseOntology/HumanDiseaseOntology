    <!-- http://purl.obolibrary.org/obo/DOID_0061235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0061235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
