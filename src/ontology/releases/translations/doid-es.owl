    <!-- http://purl.obolibrary.org/obo/DOID_14784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1289"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad neurodegenerativa que se caracteriza por ataxia cerebelosa progresiva, que provoca torpeza en los movimientos corporales, desviación de la línea media al caminar, postura amplia y caídas sin signos de parálisis o debilidad y tiene base material en expansión de las repeticiones de tripletes CAG (glutamina) que provoca la degeneración de la neurona en el cerebelo, la protuberancia y las olivas inferiores.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:12708</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>MESH:D009849</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84947</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:67761004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0028968</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">SÍNDROME WADIA-SWAMI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Dejerine-Thomas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Thomas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
