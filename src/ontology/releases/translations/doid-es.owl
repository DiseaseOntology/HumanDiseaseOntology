            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A developmental and epileptic encephalopathy characterized by progressive development of seizures starting in infancy, developmental delay, axial hypotonia, spasticity of the limbs, clonus, and cortical atrophy that has_material_basis_in homozygous or compound heterozygous mutation in the TRAK1 gene on chromosome 3p22.1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:618201</oboInOwl:hasDbXref>
