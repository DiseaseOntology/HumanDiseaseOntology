        <oboInOwl:hasExactSynonym xml:lang="es">ginecomastia prepuberal hereditaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">hiperestrogenismo familiar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
