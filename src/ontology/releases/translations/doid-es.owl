    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070469"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Trastorno del desarrollo intelectual autosómico dominante caracterizado por un retraso global del desarrollo, un desarrollo intelectual deficiente con habla y lenguaje pobres o ausentes, rasgos faciales dismórficos y anomalías del cuerpo calloso que tiene_como_base una mutación heterocigota en el gen SUPT16H del cromosoma 14q11.2.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
