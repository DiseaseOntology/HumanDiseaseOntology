    <!-- http://purl.obolibrary.org/obo/DOID_0060052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060052">
        <obo:IAO_0000115 xml:lang="en">A physical disorder that is the result of structural, biochemical or electrical abnormalities in the brain or spinal cord, or in the nerves leading to or from them, can result in symptoms such as paralysis, muscle weakness, poor coordination, loss of sensation, seizures, confusion, pain and altered levels of consciousness.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060052</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete neurological disorder</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060052"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A physical disorder that is the result of structural, biochemical or electrical abnormalities in the brain or spinal cord, or in the nerves leading to or from them, can result in symptoms such as paralysis, muscle weakness, poor coordination, loss of sensation, seizures, confusion, pain and altered levels of consciousness.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ls:IEDB</oboInOwl:hasDbXref>
    </owl:Axiom>
    


