        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_IEDB_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">trichomonas vaginalis tricomoniasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050269"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una tricomoniasis que implica la infección del tracto urogenital, tiene_como_base el Trichomonas vaginalis, que se transmite por contacto sexual. Los síntomas incluyen la inflamación del cuello uterino, la uretra y la vagina, que producen picazón o sensación de quemazón, y flujo vaginal amarillo verdoso, con picor, espumoso y maloliente.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Trichomoniasis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


