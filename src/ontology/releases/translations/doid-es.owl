        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de PGHS1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de ciclooxigenasa 1 plaquetaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de prostaglandina-endoperóxido sintasa 1 plaquetaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111058</oboInOwl:id>
        <rdfs:label xml:lang="es">trastorno hemorrágico de tipo plaquetario 12</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad de las plaquetas sanguíneas se caracteriza por una herencia autosómica dominante de hemorragia levemente aumentada, defecto de agregación plaquetaria y alteración de la conversión de ácido araquidónico en tromboxano A2 en las plaquetas debido a una deficiencia en la actividad PTGS1.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/8562397</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0111059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2217"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El síndrome de Bernard-Soulier se caracteriza por la herencia autosómica dominante de tendencia hemorrágica de leve a moderada, trombocitopenia y un aumento del tamaño medio de las plaquetas y tiene_base_material_en mutaciones heterocigóticas en el gen GP1BA del cromosoma 17p.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:153670</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
