            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A pneumoconiosis that is characterized by hypersensitive reaction to inhaled dust during the initial processing of cotton, flax, or hemp, and has symptoms of chest tightness, cough and wheezing.</obo:IAO_0000115>
