    <!-- http://purl.obolibrary.org/obo/DOID_0050755 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050950"/>
        <obo:IAO_0000115 xml:lang="es">Una ataxia cerebelosa autosómica recesiva que se caracteriza por la aparición de ataxia entre los tres y los treinta años que incluye neuropatía sensoriomotora axonal, atrofia cerebelosa y alfa-fetoproteína elevada que tiene_como_base mutación homocigota o heterocigota compuesta en el gen SETX del cromosoma 9q34.13. La apraxia oculomotora es frecuente, pero no universal.</obo:IAO_0000115>
        <oboInOwl:creation_date>2013-01-16T01:07:02Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>GARD:12860</oboInOwl:hasDbXref>
