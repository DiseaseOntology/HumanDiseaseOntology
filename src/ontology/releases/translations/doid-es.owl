    <!-- http://purl.obolibrary.org/obo/DOID_11079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4110"/>
        <obo:IAO_0000115 xml:lang="es">La enfermedad infecciosa ectoparasitaria que consiste en la infestación parasitaria por miembros de la subclase Hirudinea. Las sanguijuelas permanecen adheridas a sus huéspedes y se alimentan de sangre hasta que se sacian, momento en el que se desprenden para hacer la digestión. Mientras se alimentan, liberan un anestésico y utilizan una combinación de mucosidad y succión para permanecer adheridas y segregar una enzima anticoagulante, la hirudina, en el torrente sanguíneo del huésped.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B88.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:134.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:154423006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0019575</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Hirudiniasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Sanguijuelas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11079</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">infestación por sanguijuelas</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa ectoparasitaria que consiste en la infestación parasitaria por miembros de la subclase Hirudinea. Las sanguijuelas permanecen adheridas a sus huéspedes y se alimentan de sangre hasta que se sacian, momento en el que se desprenden para hacer la digestión. Mientras se alimentan, liberan un anestésico y utilizan una combinación de mucosidad y succión para permanecer adheridas y segregar una enzima anticoagulante, la hirudina, en el torrente sanguíneo del huésped.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Leech</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.plosone.org/article/info:doi/10.1371/journal.pone.0010057</oboInOwl:hasDbXref>
    </owl:Axiom>
    


