        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:4639008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0017589</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Pseudomonas mallei</oboInOwl:hasExactSynonym>
