        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A trypanosomiasis that involves infection of cattle caused by Trypanosoma vivax, which is transmitted by tsetse flies. The symptoms include fever, anemia, abortion, loss of appetite, lethargy, and progressive weight loss.</owl:annotatedTarget>
