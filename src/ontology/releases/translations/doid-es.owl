        <oboInOwl:hasExactSynonym xml:lang="es">hipoparatiroidismo con talla baja, retraso mental y convulsiones</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de Sanjad-Sakati</oboInOwl:hasExactSynonym>
