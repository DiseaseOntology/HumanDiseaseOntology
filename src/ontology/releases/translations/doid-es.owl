    <!-- http://purl.obolibrary.org/obo/DOID_4624 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por una distribución asimétrica de los tumores cartilaginosos, que puede provocar deformidades esqueléticas y discrepancia en la longitud de las extremidades. Esta enfermedad afecta principalmente a los huesos largos y al cartílago de las articulaciones de brazos y piernas, concretamente a la zona donde se unen el eje y la cabeza de un hueso largo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7251</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:Q78.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004687</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:166000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3213</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:296</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:46041001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024454</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">ENCONDROMATOSIS MÚLTIPLE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Encondromatosis con hemangiomas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Kast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4624</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">enfermedad de Ollier</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4624"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que se caracteriza por una distribución asimétrica de los tumores cartilaginosos, que puede provocar deformidades esqueléticas y discrepancia en la longitud de las extremidades. Esta enfermedad afecta principalmente a los huesos largos y al cartílago de las articulaciones de brazos y piernas, concretamente a la zona donde se unen el eje y la cabeza de un hueso largo.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Ollier_disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


