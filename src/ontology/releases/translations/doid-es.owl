        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad del hueso fantasma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">osteólisis esencial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">osteólisis masiva</oboInOwl:hasExactSynonym>
