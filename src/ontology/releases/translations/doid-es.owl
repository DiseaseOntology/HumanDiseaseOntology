    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_381"/>
        <obo:IAO_0000115 xml:lang="es">Artropatía en la que hay rigidez de una articulación, consecuencia de una lesión o enfermedad. La rigidez puede ser total o parcial y puede deberse a la inflamación de las estructuras tendinosas o musculares externas a la articulación o de los tejidos de la propia articulación.</obo:IAO_0000115>
