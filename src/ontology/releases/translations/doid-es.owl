    <!-- http://purl.obolibrary.org/obo/DOID_0070470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060429"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome de duplicación cromosómica caracterizado por cardiomiopatía, opacidad corneal o cataratas, hiperlactacidemia y muerte perinatal que tiene_como_base una duplicación heterocigota dentro del grupo de genes ATAD3, incluyendo los genes ATAD3A, ATAD3B y ATAD3C, en el cromosoma 1p36.33 que da lugar a la fusión de los genes ATAD3A/ATAD3C. También son frecuentes la hipotonía, la encefalopatía, las convulsiones y las anomalías de la sustancia blanca.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:618815</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:656279</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C5394150</oboInOwl:hasDbXref>
