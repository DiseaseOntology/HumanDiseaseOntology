    <!-- http://purl.obolibrary.org/obo/DOID_0080982 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060309"/>
        <obo:IAO_0000115 xml:lang="en">A syndromic X-linked intellectual disability that is characterized primarily by severely impaired intellectual development, dysmorphic facies, and a highly skewed X-inactivation pattern in carrier women and that has_material_basis_in mutation in the ATRX gene on chromosome Xq13. This now comprises several syndromes previously reported separately, including Carpenter-Waziri syndrome, Holmes-Gang syndrome, and Smith-Fineman-Myers syndrome.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:309580</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:73220</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080982</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de discapacidad intelectual ligado al cromosoma X-facies hipotónica 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080982"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A syndromic X-linked intellectual disability that is characterized primarily by severely impaired intellectual development, dysmorphic facies, and a highly skewed X-inactivation pattern in carrier women and that has_material_basis_in mutation in the ATRX gene on chromosome Xq13. This now comprises several syndromes previously reported separately, including Carpenter-Waziri syndrome, Holmes-Gang syndrome, and Smith-Fineman-Myers syndrome.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/15508018/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080984 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080984">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060309"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Discapacidad intelectual sindrómica ligada al cromosoma X que se caracteriza por un deterioro del desarrollo intelectual de leve a moderado, asociado a dificultades de aprendizaje, déficit de comunicación, problemas de atención, hiperactividad y comportamiento autista, y que presenta una alteración del gen FMR2 (AFF2), ya sea por expansión de una repetición CCG en la región no traducida 5-prime o por deleción.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:2378</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:309548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:100973</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome XE frágil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">sitio frágil en el cromosoma Xq28</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080984</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Trastorno del desarrollo intelectual ligado al cromosoma X 109</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080984"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Discapacidad intelectual sindrómica ligada al cromosoma X que se caracteriza por un deterioro del desarrollo intelectual de leve a moderado, asociado a dificultades de aprendizaje, déficit de comunicación, problemas de atención, hiperactividad y comportamiento autista, y que presenta una alteración del gen FMR2 (AFF2), ya sea por expansión de una repetición CCG en la región no traducida 5-prime o por deleción.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/21739600/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080985 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060309"/>
