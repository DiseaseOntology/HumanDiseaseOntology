            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000613"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del sistema gastrointestinal que consiste en la inflamación del peritoneo como consecuencia de la perforación del tracto gastrointestinal, que produce una inflamación química inmediata seguida en breve por la infección de organismos intestinales. La peritonitis también puede ser consecuencia de apendicitis, diverticulitis, obstrucción intestinal estranguladora, pancreatitis, enfermedad inflamatoria pélvica, isquemia mesentérica, sangre intraperitoneal, bario o derivaciones peritoneo-sistémicas, drenajes y catéteres de diálisis en la cavidad peritoneal. Los síntomas incluyen dolor y sensibilidad abdominal, fiebre, líquido en el abdomen, náuseas, vómitos y escasa producción de orina.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:8694</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:8863</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9233</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD9CM:567.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:197183001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0029823</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Mesenteritis retráctil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">mesenteritis esclerosante</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">peritonitis aguda generalizada</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">peritonitis bacteriana primaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8283</oboInOwl:id>
        <rdfs:label xml:lang="es">peritonitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del sistema gastrointestinal que consiste en la inflamación del peritoneo como consecuencia de la perforación del tracto gastrointestinal, que produce una inflamación química inmediata seguida en breve por la infección de organismos intestinales. La peritonitis también puede ser consecuencia de apendicitis, diverticulitis, obstrucción intestinal estranguladora, pancreatitis, enfermedad inflamatoria pélvica, isquemia mesentérica, sangre intraperitoneal, bario o derivaciones peritoneo-sistémicas, drenajes y catéteres de diálisis en la cavidad peritoneal. Los síntomas incluyen dolor y sensibilidad abdominal, fiebre, líquido en el abdomen, náuseas, vómitos y escasa producción de orina.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007640"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmpe/sec02/ch011/ch011b.html#sec02-ch011-ch011b-402</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.nlm.nih.gov/medlineplus/ency/article/001335.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


