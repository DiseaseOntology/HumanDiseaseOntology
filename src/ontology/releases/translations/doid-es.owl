    <!-- http://purl.obolibrary.org/obo/DOID_0070308 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_66"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019161"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del tejido muscular caracterizada por contracciones eléctricamente silenciosas de los músculos esqueléticos en respuesta a estímulos mecánicos que tiene_como_base una mutación en el gen localizado en 1q41 en el extremo distal del brazo largo del cromosoma 1, tiene_como_síntoma movimiento característico de balanceo lateral del músculo, tiene_como_síntoma calambres musculares, tiene_como_síntoma dolor muscular, tiene_como_síntoma rigidez muscular durante o después del ejercicio.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C535686</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:600332</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070308</oboInOwl:id>
        <rdfs:label xml:lang="es">enfermedad del músculo ondulado 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070308"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del tejido muscular caracterizada por contracciones eléctricamente silenciosas de los músculos esqueléticos en respuesta a estímulos mecánicos que tiene_como_base una mutación en el gen localizado en 1q41 en el extremo distal del brazo largo del cromosoma 1, tiene_como_síntoma movimiento característico de balanceo lateral del músculo, tiene_como_síntoma calambres musculares, tiene_como_síntoma dolor muscular, tiene_como_síntoma rigidez muscular durante o después del ejercicio.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3697883/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


