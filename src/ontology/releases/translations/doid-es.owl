        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Rogers</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">anemia megaloblástica sensible a la tiamina con diabetes mellitus y sordera neurosensorial</oboInOwl:hasExactSynonym>
