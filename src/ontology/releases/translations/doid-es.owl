        <oboInOwl:hasDbXref>NCI:C84602</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:154296006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0006309</oboInOwl:hasDbXref>
