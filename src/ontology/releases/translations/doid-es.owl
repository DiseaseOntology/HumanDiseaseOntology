        <oboInOwl:hasDbXref>NCI:C119678</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:298</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de depleción del ADN mitocondrial 1 (tipo MNGIE)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de encefalopatía neurogastrointestinal mitocondrial, relacionado con TYMP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
