                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002200"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001999"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Discapacidad intelectual sindrómica ligada al cromosoma X que se caracteriza por una estatura alta y marfanoide, dismorfismo facial distintivo y problemas de comportamiento y que presenta mutación autosómica recesiva en el gen MED12 del cromosoma Xq13. El síndrome de Opitz-Kaveggia es un trastorno alélico con un fenotipo superpuesto.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:3307</oboInOwl:hasDbXref>
