    <!-- http://purl.obolibrary.org/obo/DOID_0060837 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
