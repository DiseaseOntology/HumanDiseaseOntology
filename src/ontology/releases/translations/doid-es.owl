    <!-- http://purl.obolibrary.org/obo/DOID_0111243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2256"/>
        <obo:IAO_0000115 xml:lang="es">La osteocondrodisplasia se caracteriza por la herencia autosómica dominante de estatura baja grave, manos y pies cortos, limitaciones articulares, anomalías faciales leves, engrosamiento de la piel y anomalías óseas que incluyen retraso de la edad ósea, epífisis en forma de cono, huesos tubulares largos acortados y cuerpos vertebrales ovoides y tiene_base_material_en una mutación heterocigota en FBN1 en 15q21.1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C535662</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:102370</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:969</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:254090007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0265287</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia esquelética acromítrica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111243</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">displasia acromícrica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111243"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La osteocondrodisplasia se caracteriza por la herencia autosómica dominante de estatura baja grave, manos y pies cortos, limitaciones articulares, anomalías faciales leves, engrosamiento de la piel y anomalías óseas que incluyen retraso de la edad ósea, epífisis en forma de cono, huesos tubulares largos acortados y cuerpos vertebrales ovoides y tiene_base_material_en una mutación heterocigota en FBN1 en 15q21.1.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/21683322</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/3728563</oboInOwl:hasDbXref>
    </owl:Axiom>
    


