        <oboInOwl:hasDbXref>UMLS_CUI:C0029805</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">atrofia difusa primaria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad de Herxheimer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060344</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#GOLD"/>
        <rdfs:label xml:lang="es">acrodermatitis crónica atrofiante</rdfs:label>
    </owl:Class>
