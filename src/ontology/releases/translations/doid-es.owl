    <!-- http://purl.obolibrary.org/obo/DOID_10324 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10316"/>
        <obo:IAO_0000115 xml:lang="en">A pneumoconiosis that is characterized by fibrosis of the lung parenchyma caused by inhalation of carbon and silica dust. It manifests as shortness of breath and induces fibrous nodule formation in the lung.</obo:IAO_0000115>
