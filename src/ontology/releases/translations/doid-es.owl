    <!-- http://purl.obolibrary.org/obo/DOID_0080354 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060388"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome de deleción cromosómica que presenta una deleción, translocación, formación de cromosomas en anillo u otro cambio estructural del extremo terminal del cromosoma 22 en la región 22q13 o una mutación del gen SHANK3 causante de la enfermedad y que se caracteriza por hipotonía neonatal, ausencia o retraso grave del habla, retraso global del desarrollo y rasgos faciales dismórficos menores. La mayoría de los casos de síndrome de deleción 22q13.3 no se heredan, con un 20% de casos (autosómicos dominantes) heredados de uno de los progenitores. La deleción se produce con mayor frecuencia como un acontecimiento aleatorio durante la formación de las células reproductoras (óvulos o espermatozoides) o en el desarrollo fetal temprano.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:606232</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:48652</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de deleción 22q13.3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de monosomía 22q13</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080354</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de Phelan-McDermid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080354"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome de deleción cromosómica que presenta una deleción, translocación, formación de cromosomas en anillo u otro cambio estructural del extremo terminal del cromosoma 22 en la región 22q13 o una mutación del gen SHANK3 causante de la enfermedad y que se caracteriza por hipotonía neonatal, ausencia o retraso grave del habla, retraso global del desarrollo y rasgos faciales dismórficos menores. La mayoría de los casos de síndrome de deleción 22q13.3 no se heredan, con un 20% de casos (autosómicos dominantes) heredados de uno de los progenitores. La deleción se produce con mayor frecuencia como un acontecimiento aleatorio durante la formación de las células reproductoras (óvulos o espermatozoides) o en el desarrollo fetal temprano.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007646"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/22q13_deletion_syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/22q133-deletion-syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK1198/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/29719671</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/29896732</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/30089781</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.orpha.net/consor/cgi-bin/OC_Exp.php?lng=EN&amp;Expert=48652</oboInOwl:hasDbXref>
    </owl:Axiom>
    


