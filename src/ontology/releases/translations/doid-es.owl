    <!-- http://purl.obolibrary.org/obo/DOID_678 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_480"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del movimiento que se caracteriza por problemas graves y progresivos en el control de la marcha y el equilibrio, junto con complejos movimientos oculares y problemas de pensamiento. Implica el deterioro gradual y la muerte de volúmenes específicos del cerebro.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7471</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G23.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013494</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:601104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:609454</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:610898</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C85028</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:683</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:192975003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0038868</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Steele-Richardson-Olszewski</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">oftalmoplejia supranuclear progresiva</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:678</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">parálisis supranuclear progresiva</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
