        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK1419/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060429"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome de duplicación cromosómica que se caracteriza por retraso motor, del habla y del lenguaje, problemas de comportamiento, discapacidad intelectual, bajo tono muscular (hipotonía), aumento del perímetro cefálico (macrocefalia), dismorfismo facial, convulsiones, anomalías cerebrales y defectos cardíacos como el agrandamiento del vaso sanguíneo que transporta la sangre del corazón al resto del cuerpo (dilatación aórtica) y que presenta una copia extra de una región del brazo largo del cromosoma 7.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12076</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:609757</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:96121</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de duplicación de la región de William-Beuren</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de microduplicación 7q11.23</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de duplicación del cromosoma 7q11.23</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080926</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">7q11. 23 síndrome de duplicación</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080926"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome de duplicación cromosómica que se caracteriza por retraso motor, del habla y del lenguaje, problemas de comportamiento, discapacidad intelectual, bajo tono muscular (hipotonía), aumento del perímetro cefálico (macrocefalia), dismorfismo facial, convulsiones, anomalías cerebrales y defectos cardíacos como el agrandamiento del vaso sanguíneo que transporta la sangre del corazón al resto del cuerpo (dilatación aórtica) y que presenta una copia extra de una región del brazo largo del cromosoma 7.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://medlineplus.gov/genetics/condition/7q1123-duplication-syndrome/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK327268/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


