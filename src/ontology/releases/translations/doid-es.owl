            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome de displasia ectodérmica que se caracteriza por signos de displasia ectodérmica (pelo escaso, dientes anormales o ausentes, disminución o ausencia de sudoración), rasgos faciales típicos (frente prominente, arrugas bajo los ojos, hiperpigmentación periorbitaria característica) e inmunodeficiencia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9936</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS300291</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia ectodérmica anhidrótica con inmunodeficiencia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia ectodérmica hipohidrótica con inmunodeficiencia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081077</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">displasia ectodérmica e inmunodeficiencia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081077"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome de displasia ectodérmica que se caracteriza por signos de displasia ectodérmica (pelo escaso, dientes anormales o ausentes, disminución o ausencia de sudoración), rasgos faciales típicos (frente prominente, arrugas bajo los ojos, hiperpigmentación periorbitaria característica) e inmunodeficiencia.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://medlineplus.gov/genetics/condition/anhidrotic-ectodermal-dysplasia-with-immune-deficiency/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/27477329/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/34815879/</oboInOwl:hasDbXref>
