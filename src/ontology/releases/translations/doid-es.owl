    <!-- http://purl.obolibrary.org/obo/DOID_0070536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060307"/>
