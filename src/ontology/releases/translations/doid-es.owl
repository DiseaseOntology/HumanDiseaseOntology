    <!-- http://purl.obolibrary.org/obo/DOID_0050250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5614"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_883"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000970"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección parasitaria de los ojos por especies de Philophthalmus. La filoftalmiasis ocular externa se manifiesta como conjuntivitis folicular y queratitis superficial. La filoftalmiasis ocular subconjuntival consiste en un edema leve con una reacción celular mínima.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050250</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">filoftalmiasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección parasitaria de los ojos por especies de Philophthalmus. La filoftalmiasis ocular externa se manifiesta como conjuntivitis folicular y queratitis superficial. La filoftalmiasis ocular subconjuntival consiste en un edema leve con una reacción celular mínima.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Philophthalmiasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_331"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_883"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000014"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001017"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección por metacestodos en estado larvario (coenurus) de Taenia multiceps o Taenia serialis. Los coenuri en la piel o el tejido subcutáneo se presentan como nódulos indoloros, que se manifiestan en el tronco, la esclerótica, la subconjuntiva, el cuello, los hombros, la cabeza y las extremidades. El coenuri en el sistema nervioso central puede provocar dolor de cabeza, fiebre, vómitos, parálisis nerviosas, epilepsia jacksoniana, paquimeningitis, hidrocefalia obstructiva o comunicante y arteritis intracraneal con hemiparesia transitoria. Los coenuri oculares provocan infecciones tanto intraoculares como orbitarias.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050251</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">coenurosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa parasitaria helmintiásica que consiste en la infección por metacestodos en estado larvario (coenurus) de Taenia multiceps o Taenia serialis. Los coenuri en la piel o el tejido subcutáneo se presentan como nódulos indoloros, que se manifiestan en el tronco, la esclerótica, la subconjuntiva, el cuello, los hombros, la cabeza y las extremidades. El coenuri en el sistema nervioso central puede provocar dolor de cabeza, fiebre, vómitos, parálisis nerviosas, epilepsia jacksoniana, paquimeningitis, hidrocefalia obstructiva o comunicante y arteritis intracraneal con hemiparesia transitoria. Los coenuri oculares provocan infecciones tanto intraoculares como orbitarias.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Coenurosis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.cdc.gov/dpdx/coenurosis/index.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


