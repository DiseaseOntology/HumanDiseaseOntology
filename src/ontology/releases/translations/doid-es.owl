        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:750009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0036329</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0036330</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0276932</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad infecciosa por Schistosoma mansoni</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">fiebre de Katayama</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">infección por Schistosoma japonicum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050597</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">esquistosomiasis intestinal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050597"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Se trata de una infección parasitaria del intestino causada por Schistosoma mansoni, Schistosoma intercalatum o Schistosomiasis japonicum. Los síntomas incluyen fiebre, tos, dolor abdominal, diarrea, hepatoesplenomegalia, poliposis colónica con diarrea sanguinolenta y eosinofilia.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Schistosomiasis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


