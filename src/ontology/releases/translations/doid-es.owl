        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Un tifus que tiene_como_base la bacteria Rickettsia prowazekii, que se transmite por el piojo del cuerpo humano (Pediculus humanus corporis). La infección tiene_como_síntoma fiebre alta, tiene_como_síntoma tos, tiene_como_síntoma erupción cutánea, tiene_como_síntoma fuertes dolores musculares, tiene_como_síntoma escalofríos, tiene_como_síntoma bajada de presión arterial, tiene_como_síntoma estupor, tiene_como_síntoma sensibilidad a la luz y tiene_como_síntoma delirio.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="es">tifus selvático</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050480</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-negative_bacterial_infectious_disease"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">tifus epidémico</rdfs:label>
    </owl:Class>
