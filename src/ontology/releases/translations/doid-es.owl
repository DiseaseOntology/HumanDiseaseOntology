    <!-- http://purl.obolibrary.org/obo/DOID_10978 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10978">
        <obo:IAO_0000115 xml:lang="en">A nonparalytic poliomyelitis that results_in destruction located_in motor neurons, has_material_basis_in Human poliovirus 3, which is transmitted_by ingestion of food or water contaminated with feces, or transmitted_by direct contact with the oral secretions. The infection has_symptom fever, has_symptom sore throat, has_symptom headache, has_symptom vomiting, has_symptom fatigue, has_symptom neck stiffness, and has_symptom muscle spasms.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10978</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete poliovirus type III nonparalytic poliomyelitis</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_10978"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
