    <!-- http://purl.obolibrary.org/obo/DOID_0060730 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060730">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050835"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una distomía generalizada caracterizada por la herencia autosómica dominante de la distonía que suele presentarse inicialmente como focal, típicamente en las extremidades, pero a menudo se generaliza con la edad que tiene_como_base una mutación heterocigota en el gen TOR1A en el cromosoma 9q34.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:G24.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:128100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:256</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060730</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">distonía de torsión 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060730"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distomía generalizada caracterizada por la herencia autosómica dominante de la distonía que suele presentarse inicialmente como focal, típicamente en las extremidades, pero a menudo se generaliza con la edad que tiene_como_base una mutación heterocigota en el gen TOR1A en el cromosoma 9q34.</owl:annotatedTarget>
