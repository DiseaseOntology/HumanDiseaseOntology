    <!-- http://purl.obolibrary.org/obo/DOID_13641 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_12571"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_240"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001769"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_5723"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_9282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Glaucoma facogénico que se caracteriza por glaucoma de ángulo abierto relacionado con la deposición de material fibrilar extracelular en las estructuras del segmento anterior, que bloquea el flujo de salida del líquido acuoso, eleva la presión intraocular y conduce a una eventual atrofia del nervio óptico y pérdida del campo visual. El síndrome de exfoliación tiene_síntoma disminución progresiva de la visión, especialmente de la visión periférica. El síndrome de exfoliación está causado por la deposición de material fibrilar relacionado con la edad en las estructuras del segmento anterior.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0004235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:365.52</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D017889</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:177650</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C129025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:111514006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0206368</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Glaucoma por pseudoexfoliación</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de pseudoexfoliación</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13641</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome de exfoliación</rdfs:label>
        <skos:exactMatch>MESH:D017889</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13641"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Glaucoma facogénico que se caracteriza por glaucoma de ángulo abierto relacionado con la deposición de material fibrilar extracelular en las estructuras del segmento anterior, que bloquea el flujo de salida del líquido acuoso, eleva la presión intraocular y conduce a una eventual atrofia del nervio óptico y pérdida del campo visual. El síndrome de exfoliación tiene_síntoma disminución progresiva de la visión, especialmente de la visión periférica. El síndrome de exfoliación está causado por la deposición de material fibrilar relacionado con la edad en las estructuras del segmento anterior.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4157521/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


