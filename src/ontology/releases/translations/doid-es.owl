        <oboInOwl:hasDbXref>UMLS_CUI:C0014053</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">encefalitis de California</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">encefalitis por el virus de California</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">infección neuroinvasiva por el virus de la encefalitis de California</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050118</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">encefalitis de La Crosse</rdfs:label>
    </owl:Class>
