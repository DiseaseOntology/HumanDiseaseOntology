    <!-- http://purl.obolibrary.org/obo/DOID_0060021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_628"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002200"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001510"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una inmunodeficiencia combinada de células T y células B que tiene_como_base una mutación en el gen LIG4, una ADN ligasa, que codifica una proteína esencial para la recombinación V(D)J y la reparación de la rotura de doble cadena (DSB) del ADN mediante la unión de extremos no homólogos (NHEJ). Los pacientes presentan inmunodeficiencia y retraso en el desarrollo y el crecimiento.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:606593</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome LIG4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060021</oboInOwl:id>
        <rdfs:label xml:lang="es">Deficiencia de ADN ligasa IV</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una inmunodeficiencia combinada de células T y células B que tiene_como_base una mutación en el gen LIG4, una ADN ligasa, que codifica una proteína esencial para la recombinación V(D)J y la reparación de la rotura de doble cadena (DSB) del ADN mediante la unión de extremos no homólogos (NHEJ). Los pacientes presentan inmunodeficiencia y retraso en el desarrollo y el crecimiento.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
