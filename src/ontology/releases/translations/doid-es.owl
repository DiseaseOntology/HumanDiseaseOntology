    <!-- http://purl.obolibrary.org/obo/DOID_12926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11080"/>
        <obo:IAO_0000115 xml:lang="es">Miasis que consiste en la infestación parasitaria por moscas del género Hypoderma, en el ganado vacuno y los ciervos, y por Dermatobia hominis en los seres humanos. Las larvas de la mosca de los bots, Dermatobia hominis, se alimentan en una cavidad subdérmica y provocan inflamaciones cutáneas en el cuerpo o el cuero cabelludo que pueden producir secreciones y ser dolorosas.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:2883</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0020607</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12926</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">hipodermosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12926"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miasis que consiste en la infestación parasitaria por moscas del género Hypoderma, en el ganado vacuno y los ciervos, y por Dermatobia hominis en los seres humanos. Las larvas de la mosca de los bots, Dermatobia hominis, se alimentan en una cavidad subdérmica y provocan inflamaciones cutáneas en el cuerpo o el cuero cabelludo que pueden producir secreciones y ser dolorosas.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Dermatobia_hominis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Hypodermyiasis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Myiasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_12927 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11080"/>
        <obo:IAO_0000115 xml:lang="es">Miasis que consiste en la infestación parasitaria de larvas de Cochliomyia hominivorax o Chrysomya bezziana, que se alimentan de los tejidos vivos de animales de sangre caliente. En la infestación por Cochliomyia, las larvas migran de la subdermis a otros tejidos del cuerpo, causando daños extremos en el proceso. Las larvas de Chrysomya bezziana se alimentan y pueden causar daños permanentes en los tejidos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D012610</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0036465</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12927</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">enfermedad infecciosa del gusano barrenador</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12927"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miasis que consiste en la infestación parasitaria de larvas de Cochliomyia hominivorax o Chrysomya bezziana, que se alimentan de los tejidos vivos de animales de sangre caliente. En la infestación por Cochliomyia, las larvas migran de la subdermis a otros tejidos del cuerpo, causando daños extremos en el proceso. Las larvas de Chrysomya bezziana se alimentan y pueden causar daños permanentes en los tejidos.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Chrysomya_bezziana</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Myiasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


