    <!-- http://purl.obolibrary.org/obo/DOID_3265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3262"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002200"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0032252"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una disfunción bactericida de los fagocitos caracterizada por una incapacidad para resistir enfermedades infecciosas repetidas y una tendencia a desarrollar una inflamación crónica. Pueden producirse infecciones fúngicas y bacterianas recurrentes potencialmente mortales que afectan a la piel, los pulmones, el hígado, los ganglios linfáticos y los huesos, junto con zonas hinchadas de tejidos inflamados conocidas como granulomas que pueden estar ampliamente distribuidos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:D71.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D006105</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS306400</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C26788</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:379</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:11210002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0018203</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Disfagocitosis congénita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Bridges-Good</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Quie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3265</oboInOwl:id>
