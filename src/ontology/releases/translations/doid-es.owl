        <oboInOwl:hasDbXref>ORDO:231237</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2026_03_01:16360009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0271985</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
