        <oboInOwl:hasDbXref>UMLS_CUI:C0751583</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">encefalitis por fiebre del Nilo Occidental</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">fiebre del Nilo Occidental con encefalitis</oboInOwl:hasExactSynonym>
