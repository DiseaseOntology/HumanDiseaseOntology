    <!-- http://purl.obolibrary.org/obo/DOID_0081301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
