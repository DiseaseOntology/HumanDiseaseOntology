        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonía intersticial idiopática caracterizada por una inflamación y cicatrización pulmonar que obstruye las pequeñas vías respiratorias y los sacos de aire de los pulmones (alvéolos). Una enfermedad parecida a la gripe, con tos, fiebre, sensación de enfermedad (malestar), fatiga y pérdida de peso, anuncia su aparición en alrededor del 50% de las personas. Presencia frecuente de sonidos crepitantes (llamados crepitaciones de velcro) cuando el médico escucha con un estetoscopio.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmhe/sec04/ch050/ch050b.html?qt=idiopathic%20interstitial%20pneumonia&amp;alt=sh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/11790668</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2797"/>
        <obo:IAO_0000115 xml:lang="es">Neumonía intersticial idiopática que se caracteriza por la acumulación de macrófagos alveolares bronquiolocéntricos en los espacios alveolares y la inflamación intersticial e implica una fibrosis bronquiolar leve e inflamación crónica.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:2796</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J84.117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:516.37</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C562470</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:263000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C35288</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:8549006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0238378</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">bronquiolitis respiratoria asociada a enfermedad pulmonar intersticial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">neumonitis intersticial descamativa familiar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050158</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">neumonía intersticial descamativa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050158"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neumonía intersticial idiopática que se caracteriza por la acumulación de macrófagos alveolares bronquiolocéntricos en los espacios alveolares y la inflamación intersticial e implica una fibrosis bronquiolar leve e inflamación crónica.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
