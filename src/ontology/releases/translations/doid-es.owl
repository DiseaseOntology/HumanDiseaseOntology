    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060051"/>
