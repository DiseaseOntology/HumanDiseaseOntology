        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">verruga común</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa vírica que produce una infección localizada en la piel y tiene base material en el virus del papiloma humano (tipos 2 y 4). Esta infección se caracteriza por una verruga elevada con superficie rugosa, más común en las manos, pero puede crecer en cualquier parte del cuerpo.</owl:annotatedTarget>
