        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.cdc.gov/vaccines/pubs/pinkbook/downloads/polio.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


