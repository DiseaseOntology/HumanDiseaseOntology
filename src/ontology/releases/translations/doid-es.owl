                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000682"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000955"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa producida por protozoos parásitos que provoca la infección del cerebro causada por Acanthamoeba o Balamuthia mandrillaris. Los síntomas incluyen dolores de cabeza, alteración del estado mental y déficit neurológico focal, que progresa durante varias semanas hasta la muerte.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12651</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">encefalitis amebiana granulomatosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">encefalitis granulomatosa por Acanthamoeba</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">encefalitis por Acanthamoeba</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050246</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">encefalitis amebiana granulomatosa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050246"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa producida por protozoos parásitos que provoca la infección del cerebro causada por Acanthamoeba o Balamuthia mandrillaris. Los síntomas incluyen dolores de cabeza, alteración del estado mental y déficit neurológico focal, que progresa durante varias semanas hasta la muerte.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/FreeLivingAmebic.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050247">
        <obo:IAO_0000115 xml:lang="en">A parasitic infectious disease that involves infection caused by parasitic members of the taxon stramenopiles, in which the flagellate cells possess two different shaped flagella. This taxon contains both unicellular and multicellular organisms.</obo:IAO_0000115>
