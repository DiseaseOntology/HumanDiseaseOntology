                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una fibrocondrogénesis que se caracteriza por un tercio medio facial plano con una nariz pequeña y narinas antevertidas, acortamiento significativo de todos los segmentos de las extremidades pero manos y pies relativamente normales, y un tórax pequeño en forma de campana con un abdomen protuberante y que presenta una mutación heterocigota compuesta en el gen COL11A1 en el cromosoma 1p21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:228520</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080672</oboInOwl:id>
        <rdfs:label xml:lang="es">fibrocondrogénesis 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080672"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una fibrocondrogénesis que se caracteriza por un tercio medio facial plano con una nariz pequeña y narinas antevertidas, acortamiento significativo de todos los segmentos de las extremidades pero manos y pies relativamente normales, y un tórax pequeño en forma de campana con un abdomen protuberante y que presenta una mutación heterocigota compuesta en el gen COL11A1 en el cromosoma 1p21.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/21035103/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


