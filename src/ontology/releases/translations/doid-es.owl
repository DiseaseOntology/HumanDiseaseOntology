        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:736686006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0007939</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">chancro sifilítico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4166</oboInOwl:id>
