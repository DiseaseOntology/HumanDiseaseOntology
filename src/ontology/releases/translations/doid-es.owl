        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de epidermólisis bullosa juntural-atresia pilórica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
