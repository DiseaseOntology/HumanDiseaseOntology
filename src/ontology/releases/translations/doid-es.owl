    <!-- http://purl.obolibrary.org/obo/DOID_0070343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2367"/>
        <obo:IAO_0000115 xml:lang="es">Una distrofia neuroaxonal que tiene_como_base mutaciones heterocigóticas en CSF1R y causa una leucoencefalopatía de aparición adulta con esferoides axonales y glía pigmentada, caracterizada por un deterioro cognitivo y motor progresivo y convulsiones en la cuarta a quinta década de la vida.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:600329</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">osteoporosis y distrofia neuroaxonal infantil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070343</oboInOwl:id>
        <rdfs:label xml:lang="es">malformación cerebral relacionada con el CSF1R y osteopetrosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070343"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distrofia neuroaxonal que tiene_como_base mutaciones heterocigóticas en CSF1R y causa una leucoencefalopatía de aparición adulta con esferoides axonales y glía pigmentada, caracterizada por un deterioro cognitivo y motor progresivo y convulsiones en la cuarta a quinta década de la vida.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/articles/PMC6506793/</oboInOwl:hasDbXref>
