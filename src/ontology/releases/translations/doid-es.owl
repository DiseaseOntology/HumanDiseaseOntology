            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A myotonia congenita that is characterized by muscle stiffness and an inability of the muscle to relax after voluntary contraction and that has_material_basis_in homozygous or compound heterozygous mutation in the gene encoding skeletal muscle chloride channel-1 (CLCN1) on chromosome 7q34.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:255300</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:255700</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081335</oboInOwl:id>
        <rdfs:label xml:lang="es">enfermedad de Becker</rdfs:label>
        <skos:exactMatch>MIM:255700</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
