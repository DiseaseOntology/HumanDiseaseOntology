    <!-- http://purl.obolibrary.org/obo/DOID_0050976 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1441"/>
        <obo:IAO_0000115 xml:lang="en">An autosomal dominant cerebellar ataxia that is characterized by general cerebellar dysfunction manifest as gait disturbances, ataxia, tremor, dysarthria, and gaze-evoked nystagmus and has_material_basis_in heterozygous mutation in the FGF14 gene on chromosome 13q33. Some patients have heterozygous deletions of chromosome 13q33 affecting the FGF14 and ITGBL1 genes, which may thus be considered a contiguous gene deletion syndrome.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-06T16:11:07Z</oboInOwl:creation_date>
        <oboInOwl:hasAlternativeId>DOID:0111794</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GARD:9603</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:193003</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">nistagmo congénito 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">nistagmo congénito autosómico dominante 4</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">trastorno vestibulocerebeloso con signos oculares predominantes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050976</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">spinocerebellar ataxia 27A</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050976"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An autosomal dominant cerebellar ataxia that is characterized by general cerebellar dysfunction manifest as gait disturbances, ataxia, tremor, dysarthria, and gaze-evoked nystagmus and has_material_basis_in heterozygous mutation in the FGF14 gene on chromosome 13q33. Some patients have heterozygous deletions of chromosome 13q33 affecting the FGF14 and ITGBL1 genes, which may thus be considered a contiguous gene deletion syndrome.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/32162847/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


