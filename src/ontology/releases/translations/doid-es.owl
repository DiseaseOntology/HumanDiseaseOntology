        <oboInOwl:hasExactSynonym xml:lang="es">Susceptibilidad a la displasia renal quística</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111682</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">cystic renal dysplasia</rdfs:label>
    </owl:Class>
