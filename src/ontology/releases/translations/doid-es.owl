    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060708 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060704"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome linfoproliferativo caracterizado por herencia autosómica recesiva, viremia sintomática persistente asociada al virus de Epstein-Barr, hipogammaglobulinemia y alteración de la función específica de los anticuerpos y que tiene_como_base una mutación homocigota en el gen CD27 del cromosoma 12p13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:D47.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:615122</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de CD27</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060708</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome linfoproliferativo 2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060708"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome linfoproliferativo caracterizado por herencia autosómica recesiva, viremia sintomática persistente asociada al virus de Epstein-Barr, hipogammaglobulinemia y alteración de la función específica de los anticuerpos y que tiene_como_base una mutación homocigota en el gen CD27 del cromosoma 12p13.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/22197273</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/22801960</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060710">
