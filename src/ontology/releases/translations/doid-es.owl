                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa helmintiásica parasitaria que resulta de una infección localizada en la mucosa intestinal con larvas de nematodos transmitida por ingestión de pescado de agua salada crudo o mal cocinado, tiene base material en Anisakis simplex o tiene base material en Pseudoterranova decipiens y tiene síntoma de dolor abdominal, tiene síntoma de náuseas y vómitos. La anisakiasis invasiva provoca la infección de epiplón, páncreas, hígado y pulmón.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:693</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B81.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:127.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D017129</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C128393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:442652006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0162576</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por larva de Anisakis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:7033</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">anisakiasis</rdfs:label>
        <skos:exactMatch>MESH:D017129</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_7033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa helmintiásica parasitaria que resulta de una infección localizada en la mucosa intestinal con larvas de nematodos transmitida por ingestión de pescado de agua salada crudo o mal cocinado, tiene base material en Anisakis simplex o tiene base material en Pseudoterranova decipiens y tiene síntoma de dolor abdominal, tiene síntoma de náuseas y vómitos. La anisakiasis invasiva provoca la infección de epiplón, páncreas, hígado y pulmón.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/DPDx/HTML/Anisakiasis.htm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmpe/sec14/ch182/ch182c.html?qt=Anisakiasis&amp;alt=sh</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/pmc/articles/PMC358121/pdf/cmr00053-0060.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


