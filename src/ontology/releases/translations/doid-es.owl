            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La enfermedad infecciosa bacteriana comensal se caracteriza por sepsis sistémica, lesiones ulcerosas o necróticas y abscesos multisistémicos causados por Fusobacterium necrophorum. La enfermedad suele presentarse primero como una amigdalitis o faringitis grave con fiebre alta y escalofríos junto con leucocitosis, dolor cervical e hinchazón del cuello.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6882</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:040.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D005674</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:52542005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0027537</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Necrobacilosis humana</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Sepsis postanginosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Lemierre</oboInOwl:hasExactSynonym>
