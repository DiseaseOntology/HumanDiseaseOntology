        <oboInOwl:hasDbXref>ICD10CM:A42</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:039.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000196</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34350</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:50508009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0001261</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Micetema actinomicótico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Micetoma actinomicótico del pie</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Pie maduro actinomicótico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">infección actinomicótica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">actinomicetoma</oboInOwl:hasRelatedSynonym>
