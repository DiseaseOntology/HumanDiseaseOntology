    <!-- http://purl.obolibrary.org/obo/DOID_8504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4223"/>
        <obo:IAO_0000115 xml:lang="es">La pioderma que consiste en tres formas de lesiones cutáneas presentan una costra gruesa, adherente, recurrente, de color amarillo sucio con un margen eritematoso (impétigo común o superficial) o lesiones que son superficiales, de paredes finas y bullosas como las que se encuentran en el impétigo bulloso. Las lesiones en el impétigo bulloso (estafilocócico), que siempre están causadas por S aureus son superficiales de paredes finas y bullosas.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:L01.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:684</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007169</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C99088</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:156319000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0021099</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8504</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">impétigo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8504"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La pioderma que consiste en tres formas de lesiones cutáneas presentan una costra gruesa, adherente, recurrente, de color amarillo sucio con un margen eritematoso (impétigo común o superficial) o lesiones que son superficiales, de paredes finas y bullosas como las que se encuentran en el impétigo bulloso. Las lesiones en el impétigo bulloso (estafilocócico), que siempre están causadas por S aureus son superficiales de paredes finas y bullosas.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.mayoclinic.org/diseases-conditions/impetigo/symptoms-causes/syc-20352352</oboInOwl:hasDbXref>
