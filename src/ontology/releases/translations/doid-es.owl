        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060340"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome asociado a mutaciones que codifican proteínas defectuosas, que dan lugar a una formación o función anormal de los cilios.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
