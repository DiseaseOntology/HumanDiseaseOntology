        <rdfs:label>has close match</rdfs:label>
    </owl:AnnotationProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.w3.org/2004/02/skos/core#closeMatch"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
