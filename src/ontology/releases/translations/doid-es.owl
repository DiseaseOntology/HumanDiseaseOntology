    <!-- http://purl.obolibrary.org/obo/DOID_4424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4330"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0011462"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Histiocitosis de células no-Langerhans se caracteriza por ser un bulto o protuberancia benigna en la piel causada por un conjunto de células denominadas histiocitos. Al principio pueden ser de color rojo, naranja o tostado, pero con el tiempo pueden volverse más amarillos. Estos bultos suelen aparecer en la cabeza, el cuello y el tronco.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9749/1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014972</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3451</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:71709009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0043324</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Naevoxantoendotelioma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Xantogranuloma juvenil eruptivo múltiple</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Xantoma neviforme</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4424</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">xantogranuloma juvenil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4424"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Histiocitosis de células no-Langerhans se caracteriza por ser un bulto o protuberancia benigna en la piel causada por un conjunto de células denominadas histiocitos. Al principio pueden ser de color rojo, naranja o tostado, pero con el tiempo pueden volverse más amarillos. Estos bultos suelen aparecer en la cabeza, el cuello y el tronco.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.nationwidechildrens.org/conditions/juvenile-xanthogranuloma</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK526103/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


