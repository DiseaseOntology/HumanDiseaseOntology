            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A mitochondrial DNA depletion syndrome that is characterized by severe intrauterine growth restriction, neonatal-onset hypoglycemia and liver dysfunction, mitochondrial DNA depletion in liver and skeletal muscle, and abnormal mitochondrial morphology observed in skeletal muscle and has_material_basis_in homozygous mutation in the TFAM gene on chromosome 10q21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617156</oboInOwl:hasDbXref>
