        <oboInOwl:hasDbXref>NCI:C84995</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:30369007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0030424</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de trematodo pulmonar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Paragonimus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por trematodo pulmonar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Paragonimiasis pulmonar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10699</oboInOwl:id>
