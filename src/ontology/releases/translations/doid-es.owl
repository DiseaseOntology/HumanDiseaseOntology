    <!-- http://purl.obolibrary.org/obo/DOID_9784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_883"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_6333"/>
            </owl:Restriction>
