    <!-- http://purl.obolibrary.org/obo/DOID_4644 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2730"/>
        <obo:IAO_0000115 xml:lang="es">Una epidermólisis bullosa que se caracteriza por la formación recurrente de ampollas a nivel de la epidermis secundarias a traumatismos menores, que pueden causar heridas limitadas, deshidratación, anomalías electrolíticas, infección grave, entre otros problemas, y que tiene_como_base una mutación en los genes KRT5, KRT14 o PLEC, que codifican las proteínas queratina y plectina que proporcionan resistencia en la piel.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10752</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:Q81.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D016110</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:601001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:615425</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS131760</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84692</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:304</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:205585003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0079298</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4644</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">epidermólisis ampollosa simple</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4644"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una epidermólisis bullosa que se caracteriza por la formación recurrente de ampollas a nivel de la epidermis secundarias a traumatismos menores, que pueden causar heridas limitadas, deshidratación, anomalías electrolíticas, infección grave, entre otros problemas, y que tiene_como_base una mutación en los genes KRT5, KRT14 o PLEC, que codifican las proteínas queratina y plectina que proporcionan resistencia en la piel.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/epidermolysis-bullosa-simplex#genes</oboInOwl:hasDbXref>
    </owl:Axiom>
    


