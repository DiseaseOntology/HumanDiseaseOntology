    <!-- http://purl.obolibrary.org/obo/DOID_13278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13278">
        <obo:IAO_0000115 xml:lang="en">A Salmonella infectious disease that is caused by Gram-negative bacteria of genus Salmonella which is rare in adults, although more common in children in the tropics. This infection is complicated by suppuration with lung abscess or empyema formation.</obo:IAO_0000115>
