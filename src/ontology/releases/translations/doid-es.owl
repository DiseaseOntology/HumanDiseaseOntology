                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La enfermedad de la retina se caracteriza por un patrón llamativo de lesiones difusas, blanco-amarillentas, parecidas a fleck, que se extienden hasta la periferia lejana de la retina pero sin déficits visuales o electrofisiológicos aparentes y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen PLA2G5 en el cromosoma 1p36.13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C565564</oboInOwl:hasDbXref>
