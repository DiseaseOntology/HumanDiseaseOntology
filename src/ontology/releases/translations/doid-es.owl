    <!-- http://purl.obolibrary.org/obo/DOID_0060301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_626"/>
        <obo:IAO_0000115 xml:lang="es">Una deficiencia del complemento que se caracteriza por la deficiencia de la subunidad alfa de la proteína 8 del complemento, que causa una mayor susceptibilidad a las infecciones bacterianas recurrentes, especialmente a la Neisseria meningitidis, y que tiene_como_base la herencia autosómica recesiva de la mutación en el gen C8A, que produce la subunidad alfa del componente 8 del complemento, importante en la formación de complejos de ataque de membrana.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-02-09T15:32:25Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>ICD10CM:D84.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:613790</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:169150</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060301</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">deficiencia del componente 8 del complemento de tipo I</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060301"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una deficiencia del complemento que se caracteriza por la deficiencia de la subunidad alfa de la proteína 8 del complemento, que causa una mayor susceptibilidad a las infecciones bacterianas recurrentes, especialmente a la Neisseria meningitidis, y que tiene_como_base la herencia autosómica recesiva de la mutación en el gen C8A, que produce la subunidad alfa del componente 8 del complemento, importante en la formación de complejos de ataque de membrana.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/complement-component-8-deficiency</oboInOwl:hasDbXref>
    </owl:Axiom>
    


