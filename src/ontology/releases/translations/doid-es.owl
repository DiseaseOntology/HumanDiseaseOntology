    <!-- http://purl.obolibrary.org/obo/DOID_5215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_5215">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in infection in cattle, has_material_basis_in Bovine ephemeral fever virus, which is transmitted_by Culex, transmitted_by Anopheles, and transmitted_by Culicoides arthropods. The infection has_symptom fever, has_symptom stiffness, has_symptom lameness, has_symptom nasal discharge, has_symptom ocular discharge, has_symptom depression, has_symptom cessation of rumination, and has_symptom constipation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:5215</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete ephemeral fever</rdfs:label>
