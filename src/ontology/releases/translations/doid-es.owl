    <!-- http://purl.obolibrary.org/obo/DOID_13762 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13762">
        <obo:IAO_0000115 xml:lang="en">A trypanosomiasis that involves infection of cattle caused by Trypanosoma vivax, which is transmitted by tsetse flies. The symptoms include fever, anemia, abortion, loss of appetite, lethargy, and progressive weight loss.</obo:IAO_0000115>
