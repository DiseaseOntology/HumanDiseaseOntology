    <!-- http://purl.obolibrary.org/obo/DOID_0060873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060870"/>
