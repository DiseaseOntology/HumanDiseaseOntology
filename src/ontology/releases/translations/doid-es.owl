        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000488"/>
        <obo:IAO_0000115>A skin and integumentary tissue symptom that is characterized by an inflammation of the mammary gland or udder and usually caused by infection.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>inflammation of mammary breast</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammitis</oboInOwl:hasExactSynonym>
