    <!-- http://purl.obolibrary.org/obo/DOID_0080988 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4959"/>
        <obo:IAO_0000115 xml:lang="es">Epidermólisis bullosa distrófica que se caracteriza por la aparición recurrente de ampollas y cicatrices, principalmente en la zona pretibial y que presenta una mutación heterocigota o heterocigota compuesta en el gen del colágeno de tipo VII (COL7A1) en el cromosoma 3p21. Las lesiones suelen presentar características liquenoides. La epidermólisis ampollosa pretibial es alélica con la epidermólisis ampollosa distrófica autosómica dominante y recesiva.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:2155</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:131850</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79410</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080988</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Epidermólisis bullosa distrófica pretibial</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080988"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Epidermólisis bullosa distrófica que se caracteriza por la aparición recurrente de ampollas y cicatrices, principalmente en la zona pretibial y que presenta una mutación heterocigota o heterocigota compuesta en el gen del colágeno de tipo VII (COL7A1) en el cromosoma 3p21. Las lesiones suelen presentar características liquenoides. La epidermólisis ampollosa pretibial es alélica con la epidermólisis ampollosa distrófica autosómica dominante y recesiva.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/7738360/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


