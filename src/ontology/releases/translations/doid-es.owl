        <oboInOwl:hasDbXref>UMLS_CUI:C0079588</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de esterilsulfatasa placentaria ligada al cromosoma X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Ictiosis ligada al cromosoma X con deficiencia de esterilsulfatasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Ictiosis recesiva ligada al cromosoma X</oboInOwl:hasExactSynonym>
