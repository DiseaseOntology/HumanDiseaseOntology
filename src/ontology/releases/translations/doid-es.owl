    <!-- http://purl.obolibrary.org/obo/SYMP_0000705 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000508"/>
        <obo:IAO_0000115>An aphasia that is characterized by damage to, or a developmental issues in, the anterior regions of the brain, including (but not limited to) the left inferior frontal region known as Broca&apos;s area. Sufferers of this form of aphasia exhibit the common problem of agrammatism. For them, speech is difficult to initiate, non-fluent, labored, and halting.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Broca&apos;s aphasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>agrammatic aphasia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000705</oboInOwl:id>
        <rdfs:label>expressive aphasia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An aphasia that is characterized by damage to, or a developmental issues in, the anterior regions of the brain, including (but not limited to) the left inferior frontal region known as Broca&apos;s area. Sufferers of this form of aphasia exhibit the common problem of agrammatism. For them, speech is difficult to initiate, non-fluent, labored, and halting.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Expressive_aphasia</oboInOwl:hasDbXref>
    </owl:Axiom>
    


