                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000613"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Otitis externa que implica la infección del tejido que rodea el cartílago del lóbulo de la oreja (pabellón auricular), el conducto auditivo externo o ambos. Puede estar causada por lesiones, quemaduras, picaduras de insectos, perforaciones auriculares o un forúnculo en el oído. El agente causal bacteriano común es Pseudomonas aeruginosa. Los síntomas incluyen enrojecimiento, dolor, fiebre, hinchazón del lóbulo de la oreja y acumulación de pus entre el cartílago y la capa de tejido conjuntivo que lo rodea.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H61.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:380.00</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155210008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0155389</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Pericondritis del pabellón auricular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Pericondritis y condritis del pabellón auricular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:222</oboInOwl:id>
        <rdfs:label xml:lang="es">pericondritis de la aurícula</rdfs:label>
    </owl:Class>
    <owl:Axiom>
