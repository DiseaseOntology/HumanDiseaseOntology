    <!-- http://purl.obolibrary.org/obo/DOID_0080684 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3070"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001000"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000125"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A histone mutated tumor that is characterized by loss of histone H3 p.K28me3 (K27me3) methylation and located throughout the midline structures of the central nervous system. Methylation loss may be due to p.K28M (K27M) mutation in one of the histone H3 isoforms (H3.1, H3.2, or H3.3), overexpression of EZHIP, or mutation of the EGFR gene.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:0026785</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:C71.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICDO:9385/3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C185368</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:723358</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C5669877</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">glioma pontino intrínseco difuso</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080684</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">diffuse midline glioma, H3 K27-altered</rdfs:label>
        <skos:broadMatch>ICD10CM:C71.9</skos:broadMatch>
        <skos:exactMatch>ICDO:9385/3</skos:exactMatch>
        <skos:exactMatch>NCI:C185368</skos:exactMatch>
        <skos:exactMatch>ORDO:723358</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C5669877</skos:exactMatch>
        <skos:narrowMatch>GARD:0026785</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A histone mutated tumor that is characterized by loss of histone H3 p.K28me3 (K27me3) methylation and located throughout the midline structures of the central nervous system. Methylation loss may be due to p.K28M (K27M) mutation in one of the histone H3 isoforms (H3.1, H3.2, or H3.3), overexpression of EZHIP, or mutation of the EGFR gene.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pmc.ncbi.nlm.nih.gov/articles/PMC8328013/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pmc.ncbi.nlm.nih.gov/articles/PMC9763979/</oboInOwl:hasDbXref>
