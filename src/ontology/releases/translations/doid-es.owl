    <!-- http://purl.obolibrary.org/obo/DOID_13521 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11338"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
