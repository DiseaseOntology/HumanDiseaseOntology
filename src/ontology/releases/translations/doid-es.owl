        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000488"/>
        <obo:IAO_0000115>A skin and integumentary tissue symptom that is characterized by a pus-filled pocket in the skin, similar to a pimple, but larger and deeper.  The pocket is filled with bacteria, white blood cells, and dead skin and typcally result from the bacteria Staphylococcus aureus prentrating the skin through a cut or hair follicle.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>cutaneous abscess</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dermal abscesses</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skin abscess</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>subcutaneous abscess</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000251</oboInOwl:id>
        <rdfs:label>dermal abscess</rdfs:label>
    </owl:Class>
