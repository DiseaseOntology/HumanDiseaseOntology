    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081350"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Miopatía congénita que se caracteriza por la aparición de síntomas de debilidad muscular en la primera infancia, incluso en el útero y la lactancia, y que presenta una mutación heterocigota o heterocigota compuesta en el gen CACNA1S del cromosoma 1q32.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/33060286/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/34763287/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


