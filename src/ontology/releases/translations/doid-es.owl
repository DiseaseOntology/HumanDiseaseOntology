    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4483"/>
        <obo:IAO_0000115 xml:lang="es">Rnitis que consiste en una inflamación de la nariz caracterizada por la atrofia de la mucosa nasal, incluidas las glándulas, los cornetes y los nervios que irrigan la nariz, causada por factores hereditarios, desequilibrios endocrinos, deficiencias nutricionales, infecciones bacterianas y problemas autoinmunitarios.</obo:IAO_0000115>
