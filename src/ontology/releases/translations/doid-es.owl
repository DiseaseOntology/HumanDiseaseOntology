    <!-- http://purl.obolibrary.org/obo/DOID_0050487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050486"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_104"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_2"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Exantema que se caracteriza por una erupción difusa, enrojecida, blanqueable, finamente papulosa, parecida al papel de lija, debida a una infección por estreptococos del grupo A y a la producción de una toxina eritrogénica.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050487</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">exantema bacteriano</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Exantema que se caracteriza por una erupción difusa, enrojecida, blanqueable, finamente papulosa, parecida al papel de lija, debida a una infección por estreptococos del grupo A y a la producción de una toxina eritrogénica.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Scarlet_fever#Rash</oboInOwl:hasDbXref>
    </owl:Axiom>
    


