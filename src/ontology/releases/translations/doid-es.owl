    <!-- http://purl.obolibrary.org/obo/DOID_0070439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0070438"/>
        <obo:IAO_0000115 xml:lang="es">Distrofia macular retiniana caracterizada por drusas limitadas, drusas confluentes de mayor tamaño o atrofia coriorretiniana grave de tipo colobomatoso en la región macular central presente al nacer y no progresiva que tiene_como_base una mutación heterocigota en un sitio de hipersensibilidad a la DNasa I en el cromosoma 6q16 contracorriente del gen PRDM13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9179</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C537835</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:136550</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C168999</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:75327</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:312925009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0730294</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia epitelial del pigmento central de la retina</oboInOwl:hasExactSynonym>
