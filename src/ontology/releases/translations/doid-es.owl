        <oboInOwl:hasDbXref>UMLS_CUI:C0155355</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Escleritis con afectación corneal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13861</oboInOwl:id>
        <rdfs:label xml:lang="es">escleroperiqueratitis</rdfs:label>
    </owl:Class>
