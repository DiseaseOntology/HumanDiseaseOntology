        <oboInOwl:hasExactSynonym xml:lang="es">crisis metabólicas encefalomiopáticas, recurrentes, con rabdomiólisis, arritmias cardíacas y neurodegeneración</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081386</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
