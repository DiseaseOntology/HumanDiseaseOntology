    <!-- http://purl.obolibrary.org/obo/DOID_0111767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
