        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-negative_bacterial_infectious_disease"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#tick-borne_infectious_disease"/>
        <rdfs:label xml:lang="es">ehrlichiosis</rdfs:label>
        <skos:exactMatch>MESH:D016873</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
