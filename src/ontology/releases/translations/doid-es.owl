    <!-- http://purl.obolibrary.org/obo/DOID_0060589 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome caracterizado por defectos esqueléticos, incluyendo la displasia cleidocraneal y las anomalías digitales, y una grave afectación neurológica con pérdida neuronal. Las vacuolas citoplasmáticas agrandadas se encuentran en las neuronas, el músculo y el cartílago. Suele ser letal en la infancia y tiene_como_base una mutación homocigota o heterocigota compuesta en el gen FIG4 del cromosoma 6q21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:331</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C536719</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:216340</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1857663</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">displasia cleidocraneal con micrognatia, pulgares ausentes y afalangia distal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de displasia cleidocraneal-micrognatia-pulgares ausentes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060589</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de Yunis-Varon</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome caracterizado por defectos esqueléticos, incluyendo la displasia cleidocraneal y las anomalías digitales, y una grave afectación neurológica con pérdida neuronal. Las vacuolas citoplasmáticas agrandadas se encuentran en las neuronas, el músculo y el cartílago. Suele ser letal en la infancia y tiene_como_base una mutación homocigota o heterocigota compuesta en el gen FIG4 del cromosoma 6q21.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/23623387</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060590 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060590">
