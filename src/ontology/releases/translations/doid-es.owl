    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080882"/>
        <obo:IAO_0000115 xml:lang="es">Un oligodendroglioma mutante IDH y 1p/19q-codificado que se caracteriza por ser un tumor de grado 3 asociado a un crecimiento más rápido. Los tumores de grado 3 parecen presentar anomalías en los cromosomas 9 o 10, junto con cantidades inusuales de factores de crecimiento y proteínas, que se cree que contribuyen al crecimiento más rápido de estos gliomas.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICDO:9451/3</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081282</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <rdfs:label xml:lang="es">oligodendroglioma, mutante IDH y 1p/19q-codificado, grado 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081282"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un oligodendroglioma mutante IDH y 1p/19q-codificado que se caracteriza por ser un tumor de grado 3 asociado a un crecimiento más rápido. Los tumores de grado 3 parecen presentar anomalías en los cromosomas 9 o 10, junto con cantidades inusuales de factores de crecimiento y proteínas, que se cree que contribuyen al crecimiento más rápido de estos gliomas.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.abta.org/tumor_types/oligodendroglioma/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.pathologyoutlines.com/topic/cnstumoroligodendrogliomaidhmutant.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


