        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:702347001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1857316</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">demencia presenil con quistes óseos</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">demencia progresiva con osteodisplasia poliquística lipomembranosa; enfermedad cerebro-hueso-grasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">osteodisplasia poliquística lipomembranosa con leucoencefalopatía esclerosante</oboInOwl:hasExactSynonym>
