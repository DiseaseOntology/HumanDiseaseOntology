        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/27554811/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080811 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080811">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080809"/>
