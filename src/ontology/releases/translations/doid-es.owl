    <!-- http://purl.obolibrary.org/obo/DOID_0081072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por un desarrollo anormal del cerebro y de las estructuras de la cara y el torso, incluyendo dismorfismo facial, déficit intelectual anomalías costovertebrales y retraso en el desarrollo de las habilidades del habla y el movimiento (motoras).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:1210</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS213980</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:1394</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia cerebro-facio-torácica</oboInOwl:hasExactSynonym>
