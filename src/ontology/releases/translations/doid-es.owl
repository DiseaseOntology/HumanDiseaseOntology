    <!-- http://purl.obolibrary.org/obo/DOID_0050331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
