    <!-- http://purl.obolibrary.org/obo/DOID_0050266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4110"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000092"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000432"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa ectoparasitaria inflamatoria de la piel causada por la infestación parasitaria de la pulga chigoe hembra, Tunga penetrans en animales y humanos. Los síntomas incluyen inflamación de la piel, dolor intenso, picazón y una lesión en el lugar de la infección que se caracteriza por un punto negro en el centro de una lesión roja inflamada, rodeada de un halo blanco.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D058285</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050266</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">tungiasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050266"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
