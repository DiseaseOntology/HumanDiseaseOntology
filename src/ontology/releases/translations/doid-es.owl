    <!-- http://purl.obolibrary.org/obo/DOID_1687 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1687">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1686"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000321"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000504"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_9282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Glaucoma caracterizado por el estrechamiento del ángulo de la cámara anterior secundario a la neovascularización a lo largo del iris y el ángulo iridocorneal, de forma que se bloquea el flujo de salida del líquido acuoso y la presión intraocular se eleva de forma inadecuada, lo que provoca daños en el nervio óptico y pérdida del campo visual. El glaucoma neovascular presenta como síntomas pérdida progresiva de la visión periférica, disminución de la visión y dolor, enrojecimiento y cefalea en los casos agudos. El glaucoma neovascular puede estar relacionado con una angiogénesis anormal con enfermedades isquémicas de la retina, inflamación, diabetes mellitus, neoplasia intraocular y enfermedades autoinmunes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H40.84</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D015355</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:232086000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0017609</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">glaucoma de ángulo cerrado secundario con rubeosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1687</oboInOwl:id>
        <rdfs:label xml:lang="es">glaucoma neovascular</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_1687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Glaucoma caracterizado por el estrechamiento del ángulo de la cámara anterior secundario a la neovascularización a lo largo del iris y el ángulo iridocorneal, de forma que se bloquea el flujo de salida del líquido acuoso y la presión intraocular se eleva de forma inadecuada, lo que provoca daños en el nervio óptico y pérdida del campo visual. El glaucoma neovascular presenta como síntomas pérdida progresiva de la visión periférica, disminución de la visión y dolor, enrojecimiento y cefalea en los casos agudos. El glaucoma neovascular puede estar relacionado con una angiogénesis anormal con enfermedades isquémicas de la retina, inflamación, diabetes mellitus, neoplasia intraocular y enfermedades autoinmunes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://journalretinavitreous.biomedcentral.com/articles/10.1186/s40942-016-0051-x</oboInOwl:hasDbXref>
    </owl:Axiom>
    


