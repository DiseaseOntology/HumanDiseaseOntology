    <!-- http://purl.obolibrary.org/obo/DOID_0111254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060159"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Acidemia orgánica se caracteriza por una alteración del metabolismo de la lisina, la hidroxilisina y el triptófano, El aumento de la excreción urinaria de ácido glutárico y una acumulación de ácido 3-hidroxiglutárico y glutárico, que provoca lesiones estriatales y un trastorno del movimiento disquinético distónico grave y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen GCDH del cromosoma 19p13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6522</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C536833</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:231670</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:25</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Aciduria glutárica 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Aciduria glutárica tipo I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de glutaril-coA deshidrogenasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de glutaril-coenzima A deshidrogenasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111254</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">acidemia glutárica I</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111254"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Acidemia orgánica se caracteriza por una alteración del metabolismo de la lisina, la hidroxilisina y el triptófano, El aumento de la excreción urinaria de ácido glutárico y una acumulación de ácido 3-hidroxiglutárico y glutárico, que provoca lesiones estriatales y un trastorno del movimiento disquinético distónico grave y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen GCDH del cromosoma 19p13.</owl:annotatedTarget>
