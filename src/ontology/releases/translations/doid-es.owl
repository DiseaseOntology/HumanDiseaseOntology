        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3744"/>
        <obo:IAO_0000115 xml:lang="es">Carcinoma cervical de células escamosas que se caracteriza por islas mal definidas de células escamosas indiferenciadas en un fondo intensamente infi ltrado por linfocitos. Las células tumorales tienen núcleos vesiculares uniformes con nucleolos prominentes y cantidades moderadas de citoplasma ligeramente eosinófilo. Los bordes celulares son indistintos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C40193</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1516418</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:7598</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">carcinoma cervical de tipo linfoepitelioma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_7598"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Carcinoma cervical de células escamosas que se caracteriza por islas mal definidas de células escamosas indiferenciadas en un fondo intensamente infi ltrado por linfocitos. Las células tumorales tienen núcleos vesiculares uniformes con nucleolos prominentes y cantidades moderadas de citoplasma ligeramente eosinófilo. Los bordes celulares son indistintos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/28217683</oboInOwl:hasDbXref>
    </owl:Axiom>
    


