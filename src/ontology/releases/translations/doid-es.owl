    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1510"/>
        <obo:IAO_0000115 xml:lang="en">A personality disorder that is characterized by a pervasive pattern of preoccupation with orderliness, perfectionism, and mental and interpersonal control at the expense of flexibility, openness, and efficiency.</obo:IAO_0000115>
