    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060015">
        <obo:IAO_0000115 xml:lang="en">A severe combined immunodeficiency that results from defective IL7R expression causes T-B+NK+ SCID. Loss of IL-7R function leads to the loss of an antiapoptotic signal, resulting in a loss of T-cell selection in thymus.</obo:IAO_0000115>
