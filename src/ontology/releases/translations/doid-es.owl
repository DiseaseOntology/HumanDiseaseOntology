        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de His-Werner</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Fiebre de Quintan</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Fiebre tibialgica</oboInOwl:hasExactSynonym>
