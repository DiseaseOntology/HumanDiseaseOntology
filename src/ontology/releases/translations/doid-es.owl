    <!-- http://purl.obolibrary.org/obo/DOID_14338 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14338">
        <obo:IAO_0000115 xml:lang="en">A Pseudomonas infectious disease that is caused by a Gram-negative bacterium Pseudomonas aeruginosa resulting in pulmonary edema. This bacterium releases immunogenic bacterial components that can gain access to airway epithelium and immune cells in the lung thus causing airway inflammation. P. aeruginosa is the common cause of hospital acquired and ventilator-associated pneumonias.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14338</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-negative_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="en">obsolete Pseudomonal pneumonia</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A Pseudomonas infectious disease that is caused by a Gram-negative bacterium Pseudomonas aeruginosa resulting in pulmonary edema. This bacterium releases immunogenic bacterial components that can gain access to airway epithelium and immune cells in the lung thus causing airway inflammation. P. aeruginosa is the common cause of hospital acquired and ventilator-associated pneumonias.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Pseudomonas_aeruginosa</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2425928/pdf/postmedj00237-0064.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


