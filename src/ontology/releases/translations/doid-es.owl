        <obo:IAO_0000115 xml:lang="es">Una inmunodeficiencia combinada grave que se caracteriza por la ausencia de células T pero un número normal de células B. La CD3D es esencial para el desarrollo de las células T.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060016</oboInOwl:id>
        <rdfs:label xml:lang="es">deficiencia de CD3delta</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una inmunodeficiencia combinada grave que se caracteriza por la ausencia de células T pero un número normal de células B. La CD3D es esencial para el desarrollo de las células T.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/15640687</oboInOwl:hasDbXref>
