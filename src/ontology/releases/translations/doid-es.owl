        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de discapacidad intelectual ligada al cromosoma X-microcefalia-malformación cortical-habitus delgado</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111898</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
