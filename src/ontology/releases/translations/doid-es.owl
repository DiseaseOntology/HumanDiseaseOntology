    <!-- http://purl.obolibrary.org/obo/DOID_0080691 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080690"/>
        <obo:IAO_0000115 xml:lang="es">Una RASopatía que se caracteriza por macrocefalia, frente alta, ojos muy separados o hipertelorismo, ptosis palpebral y orejas de implantación baja y rotadas posteriormente, pelo arrancable, escaso, fino y de crecimiento lento, frecuentes defectos cardíacos congénitos, piel pigmentada oscura con eczema o ictiosis, baja estatura y retraso del desarrollo.</obo:IAO_0000115>
