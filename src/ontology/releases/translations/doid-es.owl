        <oboInOwl:hasExactSynonym xml:lang="es">artrogriposis, disfunción renal y colestasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">artrogriposis-disfunción renal-colestasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de artrogriposis, disfunción renal y colestasis (ARC)</oboInOwl:hasExactSynonym>
