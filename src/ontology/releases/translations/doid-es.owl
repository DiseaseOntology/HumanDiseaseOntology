        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">neurocitoma extraventricular</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081314"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Cáncer del ventrículo cerebral que se caracteriza por la presencia de células neoplásicas uniformes y redondas con diferenciación neuronal, que surge del parénquima cerebral. A diferencia del neurocitoma central, no afecta a los ventrículos laterales.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/24357019/</oboInOwl:hasDbXref>
