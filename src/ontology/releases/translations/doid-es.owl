    <!-- http://purl.obolibrary.org/obo/DOID_0050289 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2473"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000132"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Micosis oportunista que consiste en una infección fúngica localizada o hematógenamente diseminada por Fusarium solani o Fusarium oxysporum. Se observan lesiones cutáneas en pacientes neutropénicos, y celulitis indolente o necrosis de tejidos blandos en pacientes inmunodeprimidos en el lugar del traumatismo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D060585</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050289</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">fusariosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050289"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Micosis oportunista que consiste en una infección fúngica localizada o hematógenamente diseminada por Fusarium solani o Fusarium oxysporum. Se observan lesiones cutáneas en pacientes neutropénicos, y celulitis indolente o necrosis de tejidos blandos en pacientes inmunodeprimidos en el lugar del traumatismo.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/14748803</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050290">
