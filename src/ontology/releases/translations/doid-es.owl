        <oboInOwl:hasDbXref>MIM:600118</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Microsíndrome 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0110716</oboInOwl:id>
