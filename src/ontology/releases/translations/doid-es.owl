        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad MAC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Mycobacterium avium</oboInOwl:hasExactSynonym>
