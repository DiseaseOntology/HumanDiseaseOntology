        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una eritroqueratodermia variable que se caracteriza por una piel normal al nacer, pero que desarrolla hiperpigmentación y descamación en zonas de fricción en la infancia, con progresión a hiperqueratosis ondulada casi confluente, queratodermia palmoplantar y eritema figurado transitorio, y que presenta una mutación heterocigota en el gen que codifica la conexina-43 (GJA1) en el cromosoma 6q22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617525</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080249</oboInOwl:id>
        <rdfs:label xml:lang="es">erythrokeratodermia variabilis et progressiva 3</rdfs:label>
    </owl:Class>
