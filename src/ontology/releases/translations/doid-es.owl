    <!-- http://purl.obolibrary.org/obo/DOID_13250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_77"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del sistema gastrointestinal descrita como la condición de tener frecuentes deposiciones líquidas o sueltas. La diarrea aguda es una causa común de muerte en los países en desarrollo y la segunda causa más frecuente de mortalidad infantil en todo el mundo. La pérdida de líquidos por la diarrea puede provocar una deshidratación grave, que es una de las causas de muerte en los enfermos de diarrea. Junto con el agua, los enfermos también pierden cantidades peligrosas de sales importantes, electrolitos y otros nutrientes. Existen al menos cuatro tipos de diarrea: diarrea secretora, diarrea osmótica, diarrea relacionada con la motilidad y diarrea inflamatoria.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:0050006</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD9CM:009.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004403</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:154268000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0013369</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">diarrea de presunto origen infeccioso</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:13250</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#GOLD"/>
        <rdfs:label xml:lang="es">diarrea</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del sistema gastrointestinal descrita como la condición de tener frecuentes deposiciones líquidas o sueltas. La diarrea aguda es una causa común de muerte en los países en desarrollo y la segunda causa más frecuente de mortalidad infantil en todo el mundo. La pérdida de líquidos por la diarrea puede provocar una deshidratación grave, que es una de las causas de muerte en los enfermos de diarrea. Junto con el agua, los enfermos también pierden cantidades peligrosas de sales importantes, electrolitos y otros nutrientes. Existen al menos cuatro tipos de diarrea: diarrea secretora, diarrea osmótica, diarrea relacionada con la motilidad y diarrea inflamatoria.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Diarrhea#Types_of_diarrhea</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13251">
        <obo:IAO_0000115 xml:lang="en">A Human immunodeficiency virus infectious disease that results_in infection characterized by chronic diarrhea lasting longer than 1 month, without an identified infectious cause after thorough evaluation, in an HIV-positive individual, has_material_basis_in Human immunodeficiency virus 1 or has_material_basis_in Human immunodeficiency virus 2. It is observed that HIV-infected individuals have histologic abnormalities of the gastrointestinal mucosa, malabsorption, and lymphocyte depletion causing diarrhea, increased gastrointestinal inflammation, increased intestinal permeability, and malabsorption of bile acid and vitamin B12.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13251</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="en">obsolete HIV enteropathy</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A Human immunodeficiency virus infectious disease that results_in infection characterized by chronic diarrhea lasting longer than 1 month, without an identified infectious cause after thorough evaluation, in an HIV-positive individual, has_material_basis_in Human immunodeficiency virus 1 or has_material_basis_in Human immunodeficiency virus 2. It is observed that HIV-infected individuals have histologic abnormalities of the gastrointestinal mucosa, malabsorption, and lymphocyte depletion causing diarrhea, increased gastrointestinal inflammation, increased intestinal permeability, and malabsorption of bile acid and vitamin B12.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2777614/pdf/nihms-156875.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


