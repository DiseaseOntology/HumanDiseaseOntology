        <rdfs:label xml:lang="en">STAD syndrome</rdfs:label>
        <skos:exactMatch>MIM:621495</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070699"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A syndrome characterized by a skeletal dysplasia consisting of advanced bone maturation, short and dysplastic bones, and disproportionate body measurements; facial dysmorphisms and dental anomalies; and neurodevelopmental delays ranging in severity from isolated fine motor delays to impaired intellectual development that has_material_basis_in heterozygous mutation in the PTBP1 gene on chromosome 19p13.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pmc.ncbi.nlm.nih.gov/articles/PMC12618068/#sd</oboInOwl:hasDbXref>
