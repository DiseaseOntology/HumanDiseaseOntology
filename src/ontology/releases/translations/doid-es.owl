        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de Alfi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de monosomía 9p</oboInOwl:hasExactSynonym>
