        <oboInOwl:hasExactSynonym xml:lang="es">Tos ferina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">WC - Tos ferina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">infección por bordetella</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1116</oboInOwl:id>
