        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000514"/>
        <obo:IAO_0000115>A respiratory system and chest symptom that is characterized by pain, pressure, tightness, or other discomfort originating in or radiating to the chest, which constitutes an important indicator of potentially serious cardiac or cardiovascular disorders.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
