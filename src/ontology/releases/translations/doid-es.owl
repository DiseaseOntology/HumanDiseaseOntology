    <!-- http://purl.obolibrary.org/obo/DOID_0081071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081065"/>
        <obo:IAO_0000115 xml:lang="es">Un linfoma difuso de células B grandes EZB que no expresa la firma de expresión génica de doble hit (DHITsig-) según el perfil de expresión génica. Estos casos suelen tener pocas translocaciones MYC o mutaciones DDX3X.</obo:IAO_0000115>
