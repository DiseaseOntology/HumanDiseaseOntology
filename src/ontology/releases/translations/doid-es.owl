    <!-- http://purl.obolibrary.org/obo/DOID_0050292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050136"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4751"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una micosis sistémica que resulta_en una infección que que se_ubica_en el cuerpo humano, tiene_como_base hongos, que puede superar las defensas fisiológicas y celulares del huésped humano normal. Los patógenos primarios profundos suelen acceder al huésped a través de las vías respiratorias.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050292</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">micosis sistémica primaria</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050292"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una micosis sistémica que resulta_en una infección que que se_ubica_en el cuerpo humano, tiene_como_base hongos, que puede superar las defensas fisiológicas y celulares del huésped humano normal. Los patógenos primarios profundos suelen acceder al huésped a través de las vías respiratorias.</owl:annotatedTarget>
