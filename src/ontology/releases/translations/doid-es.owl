                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Displasia espondiloepimetafisaria que se caracteriza por retraso grave del desarrollo de aparición infantil y displasia esquelética, incluida estatura baja, osificación carpiana prematura, platispondilia, estrías metafisarias longitudinales y epífisis pequeñas y que presenta una mutación homocigota o heterocigota compuesta en el gen NANS del cromosoma 9q22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10057</oboInOwl:hasDbXref>
