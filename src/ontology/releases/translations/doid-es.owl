        <rdfs:label xml:lang="es">enfermedad de inclusión intranuclear neuronal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081294"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad neurodegenerativa que se caracteriza por una amplia gama de manifestaciones clínicas, incluidos síntomas piramidales y extrapiramidales, ataxia cerebelosa, deterioro cognitivo y demencia, neuropatía periférica y disfunción autonómica, y que presenta una expansión de repetición heterocigota (CGG) en la región no traducida 5-prime del gen NOTCH2NLC en el cromosoma 1q21.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/27797808/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


