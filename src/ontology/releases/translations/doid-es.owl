                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000369"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A syndrome characterized by distinctive facial features including hypertelorism, large eyelid openings, ptosis, high-arched eyebrows, a broad nasal bridge and tip of the nose, a long space between the nose and the upper lip, full cheeks and a pointed chin; structural abnormalities of the brain might also be present.</obo:IAO_0000115>
