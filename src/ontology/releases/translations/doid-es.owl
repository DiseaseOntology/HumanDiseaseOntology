        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa bacteriana primaria que tiene como material base la Borrelia miyamotoi, transmitida por la garrapata de pata negra (Ixodes scapularis), la garrapata de pata negra occidental (Ixodes pacificus), la garrapata de la taiga (Ixodes persulcatus) o la garrapata del ricino (Ixodes ricinus). La infección presenta síntomas como fiebre, cefalea, escalofríos, dolores musculares, dolores articulares, astenia, fatiga y náuseas, y raramente recae.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:713014002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C4076531</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">fiebre recurrente transmitida por garrapatas</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070527</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">Enfermedad por Borrelia miyamotoi</rdfs:label>
        <skos:exactMatch>SNOMEDCT_US_2023_03_01:713014002</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C4076531</skos:exactMatch>
    </owl:Class>
