    <!-- http://purl.obolibrary.org/obo/DOID_0111782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080006"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del desarrollo óseo caracterizada por anomalías faciales típicas y una displasia ósea generalizada con cambios osteodisplásicos con displasia esquelética que se desarrolla como combinaciones y grados variables de subtubulación de los huesos largos, irregularidad cortical y campomelia. La mayoría de los subtipos, pero no todos, están asociados a mutaciones en FLNA en el cromosoma Xq28.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ORDO:364541</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Trastorno del espectro OPD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111782</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">trastorno del espectro del síndrome otopalatodigital</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111782"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del desarrollo óseo caracterizada por anomalías faciales típicas y una displasia ósea generalizada con cambios osteodisplásicos con displasia esquelética que se desarrolla como combinaciones y grados variables de subtubulación de los huesos largos, irregularidad cortical y campomelia. La mayoría de los subtipos, pero no todos, están asociados a mutaciones en FLNA en el cromosoma Xq28.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
