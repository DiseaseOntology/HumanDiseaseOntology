    <!-- http://purl.obolibrary.org/obo/DOID_10887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002451"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La lepra que da lugar a lesiones cutáneas tempranas que consisten en máculas pálidas que son pequeñas, difusas y simétricas. Esta forma de lepra se caracteriza por hipoestesia en las superficies extensoras de las extremidades distales, alopecia que afecta a los aspectos laterales de las cejas, deformidad en nariz de silla de montar y lepromas orales.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:A30.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:030.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D015440</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:21560005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0023348</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Lepra tipo L</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10887</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">lepra lepromatosa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_10887"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La lepra que da lugar a lesiones cutáneas tempranas que consisten en máculas pálidas que son pequeñas, difusas y simétricas. Esta forma de lepra se caracteriza por hipoestesia en las superficies extensoras de las extremidades distales, alopecia que afecta a los aspectos laterales de las cejas, deformidad en nariz de silla de montar y lepromas orales.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.amjmed.com/article/S0002-9343(17)30612-5/fulltext</oboInOwl:hasDbXref>
    </owl:Axiom>
    


