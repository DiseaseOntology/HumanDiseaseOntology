    <!-- http://purl.obolibrary.org/obo/DOID_0111731 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111731">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0111728"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El síndrome de dolor episódico familiar se caracteriza por la aparición en la primera infancia de dolor episódico intenso que afecta principalmente a las extremidades inferiores distales, pero a veces también a las extremidades superiores, con ciclos de dolor que duran varios días y se exacerba con la fatiga y tiene_base_material_en una mutación heterocigota en el gen SCN11A en el cromosoma 3p22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:615552</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C125390</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:391392</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111731</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome de dolor episódico familiar 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111731"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El síndrome de dolor episódico familiar se caracteriza por la aparición en la primera infancia de dolor episódico intenso que afecta principalmente a las extremidades inferiores distales, pero a veces también a las extremidades superiores, con ciclos de dolor que duran varios días y se exacerba con la fatiga y tiene_base_material_en una mutación heterocigota en el gen SCN11A en el cromosoma 3p22.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/24207120</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0111732 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111732">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080006"/>
