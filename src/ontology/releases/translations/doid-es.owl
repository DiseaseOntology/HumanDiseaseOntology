    <!-- http://purl.obolibrary.org/obo/DOID_0111272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
