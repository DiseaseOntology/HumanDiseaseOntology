        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A tertiary neurosyphilis that is caused due to syphilis, which occurs suddenly and produces tinnitus and deafness when the cochlear branch is affected whereas vertigo, disturbances of equilibrium, spontaneous nystagmus and vomiting when the vestibular branch suffers. A combination of these symptoms are seen when both the branches are involved.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://archotol.ama-assn.org/cgi/content/summary/40/4/261</oboInOwl:hasDbXref>
