        <rdfs:label>skin peeling</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0020049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000473"/>
        <obo:IAO_0000115>A nutrition, metabolism, and development symptom that is characterized by the delay in development child&apos;s cognitive, emotional, motor, and social capacities from the beginning of life throughout fetal and neonatal periods, infancy, childhood, and adolescence.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020049</oboInOwl:id>
        <rdfs:label>delayed psychomotor development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020049"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nutrition, metabolism, and development symptom that is characterized by the delay in development child&apos;s cognitive, emotional, motor, and social capacities from the beginning of life throughout fetal and neonatal periods, infancy, childhood, and adolescence.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/23622146/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.webmd.com/parenting/baby/recognizing-developmental-delays-birth-age-2</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0020050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019163"/>
        <obo:IAO_0000115>An eye symptom that is characterized by a reduction in the saline fluid secreted by the lacrimal gland.</obo:IAO_0000115>
