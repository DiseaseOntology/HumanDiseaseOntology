        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_FlyBase_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">atrofia olivopontocerebelosa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14784"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad neurodegenerativa que se caracteriza por ataxia cerebelosa progresiva, que provoca torpeza en los movimientos corporales, desviación de la línea media al caminar, postura amplia y caídas sin signos de parálisis o debilidad y tiene base material en expansión de las repeticiones de tripletes CAG (glutamina) que provoca la degeneración de la neurona en el cerebelo, la protuberancia y las olivas inferiores.</owl:annotatedTarget>
