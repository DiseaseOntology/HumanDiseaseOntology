    <!-- http://purl.obolibrary.org/obo/DOID_9317 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_75"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del sistema linfático que se caracteriza por la inflamación de los canales linfáticos que se produce como consecuencia de una infección en un lugar distal al canal. Está causada por Streptococcus pyogenes (estreptococo del grupo A) o Staphylococcus aureus. La linfangitis también se denomina a veces envenenamiento de la sangre.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:I89.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:457.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008205</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34790</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:1415005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024225</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9317</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">linfangitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9317"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del sistema linfático que se caracteriza por la inflamación de los canales linfáticos que se produce como consecuencia de una infección en un lugar distal al canal. Está causada por Streptococcus pyogenes (estreptococo del grupo A) o Staphylococcus aureus. La linfangitis también se denomina a veces envenenamiento de la sangre.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
