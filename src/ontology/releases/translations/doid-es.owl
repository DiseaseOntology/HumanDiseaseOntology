    <!-- http://purl.obolibrary.org/obo/DOID_0050633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5614"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad ocular que se caracteriza por una reducción de la pigmentación del iris y el consiguiente deterioro de la agudeza visual sin afectar significativamente al color de la piel o el cabello y que tiene_como_base una mutación en el gen GPR143 que codifica segmentos de los melanosomas que almacenan melanina.</obo:IAO_0000115>
