                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019176"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020060"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Coccidiosis que tiene base material en en el protozoo Toxoplasma gondii. El parásito afecta a la mayoría de los géneros de animales de sangre caliente, incluido el hombre, pero el host principal es la familia de los félidos (gatos). Los animales se infectan al comer carne infectada, por ingestión de heces de un gato que a su vez ha sido infectado recientemente, o por transmisión de la madre al feto. Los síntomas incluyen linfadenopatía cervical o axilar bilateral no sensible, fiebre, malestar, mialgias, hepatoesplenomegalia, anemia y leucopenia.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:13334</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:13339</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:13344</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:B58</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014123</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3418</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266225001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0040558</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">toxoplasmosis diseminada</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9965</oboInOwl:id>
