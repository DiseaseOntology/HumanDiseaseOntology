                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An autonomic nervous system disease characterized by reduced responsiveness of the respiratory center to carbon dioxide, diminished pupillary light responses, and other symptoms related to defects in the autonomic nervous system and that has_material_basis_in most commonly heterozygous mutation in the PHOX2B gene on chromosome 4p13 and less frequently mutations in the RET, GDNF, EDN3, BDNF, or ASCL1 genes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8535</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G47.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C536209</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:209880</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:661</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Ondina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de hipoventilación alveolar central congénita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de hipoventilación congénita central</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
