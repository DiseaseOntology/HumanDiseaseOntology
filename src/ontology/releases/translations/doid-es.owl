    <!-- http://purl.obolibrary.org/obo/DOID_13060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1686"/>
        <obo:IAO_0000115 xml:lang="es">Glaucoma caracterizado por una presión intraocular elevada secundaria a un traumatismo ocular, que conduce a una atrofia glaucomatosa del nervio óptico y a una pérdida progresiva de la visión y tiene_síntoma disminución progresiva de la visión, defectos del campo visual y disminución de la visión periférica. El glaucoma traumático está causado por un traumatismo ocular que afecta al flujo acuoso, como un traumatismo que provoca inflamación o depósito de proteínas en la red trabecular, que modifica el ángulo de la cámara anterior o que causa inflamación crónica.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:365.65</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:68241007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0339594</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Glaucoma asociado a traumatismo ocular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13060</oboInOwl:id>
        <rdfs:label xml:lang="es">glaucoma traumático</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Glaucoma caracterizado por una presión intraocular elevada secundaria a un traumatismo ocular, que conduce a una atrofia glaucomatosa del nervio óptico y a una pérdida progresiva de la visión y tiene_síntoma disminución progresiva de la visión, defectos del campo visual y disminución de la visión periférica. El glaucoma traumático está causado por un traumatismo ocular que afecta al flujo acuoso, como un traumatismo que provoca inflamación o depósito de proteínas en la red trabecular, que modifica el ángulo de la cámara anterior o que causa inflamación crónica.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4741166/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


