    <!-- http://purl.obolibrary.org/obo/DOID_0060787 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060786"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una leucodistrofia hipomielinizante caracterizada por la herencia autosómica recesiva de nistagmo, retraso del desarrollo motor, ataxia, movimientos coreoatetósicos, disartria y espasticidad progresiva que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen GJC2 del cromosoma 1q42.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:E75.2</oboInOwl:hasDbXref>
