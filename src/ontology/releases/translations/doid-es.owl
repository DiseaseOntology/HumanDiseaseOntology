        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A skin and integumentary tissue symptom that is characterized by a pus-filled pocket in the skin, similar to a pimple, but larger and deeper.  The pocket is filled with bacteria, white blood cells, and dead skin and typcally result from the bacteria Staphylococcus aureus prentrating the skin through a cut or hair follicle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://jamanetwork.com/journals/jama/fullarticle/2677448</oboInOwl:hasDbXref>
    </owl:Axiom>
    


