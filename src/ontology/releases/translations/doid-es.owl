        <oboInOwl:id>DOID:0050096</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">tinea barbae</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050096"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una dermatofitosis que resulta_en una infección fúngica que afecta a la capa córnea de la epidermis de las zonas de barba que se_ubica_en la cara o en el cuello, tiene_como_base el Trichophyton mentagrophytes o tiene_como_base el Trichophyton verrucosum, que también afecta al pelo, y afecta a la uña y tiene_como_síntoma placas inflamatorias de aspecto querioniforme, y resulta_en la formación de pústulas perifoliculares superficiales no inflamatorias.</owl:annotatedTarget>
