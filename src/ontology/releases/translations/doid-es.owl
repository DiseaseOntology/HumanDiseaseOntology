                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003581"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Insuficiencia respiratoria que resulta de una lesión difusa del endotelio pulmonar (como en la sepsis, traumatismo torácico, transfusión masiva de sangre, aspiración del contenido gástrico o neumonía) y se caracteriza por edema pulmonar con una cantidad anormalmente alta de proteínas en el líquido edematoso y por respiración rápida difícil e hipoxemia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:5698</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:J80</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012128</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155627006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0035222</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Edema pulmonar no cardiogénico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Pulmón de choque</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">SDRA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de dificultad respiratoria aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11394</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Síndrome de dificultad respiratoria del adulto</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11394"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Insuficiencia respiratoria que resulta de una lesión difusa del endotelio pulmonar (como en la sepsis, traumatismo torácico, transfusión masiva de sangre, aspiración del contenido gástrico o neumonía) y se caracteriza por edema pulmonar con una cantidad anormalmente alta de proteínas en el líquido edematoso y por respiración rápida difícil e hipoxemia.</owl:annotatedTarget>
