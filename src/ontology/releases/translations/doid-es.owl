    <!-- http://purl.obolibrary.org/obo/DOID_4866 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050904"/>
        <obo:IAO_0000115 xml:lang="es">Carcinoma de glándula salival que se caracteriza por un patrón distintivo en el que nidos o cordones anormales de células epiteliales rodean y/o infiltran conductos o estructuras glandulares dentro del órgano afectado. Estas estructuras suelen estar rellenas de un material mucoso o contener membranas fibrosas anormales.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D003528</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C2970</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:11671000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0010606</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4866</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">carcinoma adenoide quístico de glándulas salivales</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4866"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Carcinoma de glándula salival que se caracteriza por un patrón distintivo en el que nidos o cordones anormales de células epiteliales rodean y/o infiltran conductos o estructuras glandulares dentro del órgano afectado. Estas estructuras suelen estar rellenas de un material mucoso o contener membranas fibrosas anormales.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://oralcancerfoundation.org/facts/rare/adenoid-cystic-carcinoma/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_4867 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4867">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2893"/>
        <obo:IAO_0000115 xml:lang="es">Carcinoma del cuello uterino que se caracteriza por su parecido con el carcinoma adenoide quístico de las glándulas salivales. Presenta patrones pseudoglandulares, cribiformes y tubulares que contienen material similar a la membrana basal. Citológicamente, los núcleos son angulosos e hipercromáticos, sin nucleolos prominentes.</obo:IAO_0000115>
