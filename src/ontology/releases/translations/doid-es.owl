    <!-- http://purl.obolibrary.org/obo/DOID_0070836 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050539"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf>
            <owl:Restriction>
