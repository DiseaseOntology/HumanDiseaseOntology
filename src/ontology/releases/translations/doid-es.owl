    <!-- http://purl.obolibrary.org/obo/DOID_1562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050135"/>
        <obo:IAO_0000115 xml:lang="es">Micosis subcutánea que es una infección fúngica subcutánea crónica, que se presenta como lesiones cutáneas nodulares o verrucoides, ulceradas o costrosas en zonas expuestas de la piel, causadas por Fonsecaea pedrosoi, Fonsecaea compacta, Cladophialophora carrionii o Phialophora verrucosa. El examen histológico revela células muriformes (con septaciones perpendiculares) o formas redondeadas de paredes gruesas y color oscuro (peniques de cobre) que son características de esta infección.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:1319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B43.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:117.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002862</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:187079000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008582</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Cromomicosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1562</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">cromoblastomicosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_1562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Micosis subcutánea que es una infección fúngica subcutánea crónica, que se presenta como lesiones cutáneas nodulares o verrucoides, ulceradas o costrosas en zonas expuestas de la piel, causadas por Fonsecaea pedrosoi, Fonsecaea compacta, Cladophialophora carrionii o Phialophora verrucosa. El examen histológico revela células muriformes (con septaciones perpendiculares) o formas redondeadas de paredes gruesas y color oscuro (peniques de cobre) que son características de esta infección.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007646"/>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/bookshelf/br.fcgi?book=mmed&amp;part=A4005</oboInOwl:hasDbXref>
    </owl:Axiom>
    


