    <!-- http://purl.obolibrary.org/obo/DOID_0081352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081337"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una miopatía congénita que presenta una mutación homocigota o heterocigota compuesta en el gen RYR3 del cromosoma 15q13 y que muestra una amplia variabilidad fenotípica. Algunos pacientes se presentan en la primera infancia con debilidad muscular proximal que afecta a las extremidades inferiores y superiores y provoca dificultades para correr y trepar, mientras que otros se presentan poco después del nacimiento con contracturas congénitas de las extremidades o distales.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:620310</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081352</oboInOwl:id>
        <rdfs:label xml:lang="es">miopatía congénita 20</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081352"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una miopatía congénita que presenta una mutación homocigota o heterocigota compuesta en el gen RYR3 del cromosoma 15q13 y que muestra una amplia variabilidad fenotípica. Algunos pacientes se presentan en la primera infancia con debilidad muscular proximal que afecta a las extremidades inferiores y superiores y provoca dificultades para correr y trepar, mientras que otros se presentan poco después del nacimiento con contracturas congénitas de las extremidades o distales.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/29498452/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/31230720/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


