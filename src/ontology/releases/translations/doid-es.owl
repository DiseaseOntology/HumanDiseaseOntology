            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Polimicrogiria que se caracteriza por una malformación bilateral del desarrollo cortical, centrada en los aspectos parasagital y mesial del córtex parietooccipital y que presenta una mutación homocigota en el gen FIG4 del cromosoma 6q21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10785</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:612691</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:208441</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">polimicrogiria temporooccipital bilateral</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080923</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">polimicrogiria parietooccipital parasagital bilateral</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080923"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Polimicrogiria que se caracteriza por una malformación bilateral del desarrollo cortical, centrada en los aspectos parasagital y mesial del córtex parietooccipital y que presenta una mutación homocigota en el gen FIG4 del cromosoma 6q21.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/10690985/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/9005867/</oboInOwl:hasDbXref>
