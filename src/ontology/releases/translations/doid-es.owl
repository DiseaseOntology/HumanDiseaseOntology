        <oboInOwl:hasExactSynonym xml:lang="es">Inmunodeficiencia combinada con susceptibilidad a infecciones por micobacterias, virus y hongos</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Monocitopenia con susceptibilidad a infecciones</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de deficiencia de monocitos B, células asesinas naturales y células dendríticas</oboInOwl:hasExactSynonym>
