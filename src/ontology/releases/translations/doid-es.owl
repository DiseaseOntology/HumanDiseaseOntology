        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:700060008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0027832</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurinoma acústico bilateral</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurofibromatosis 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurofibromatosis acústica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurofibromatosis acústica bilateral</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurofibromatosis central</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurofibromatosis tipo II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neuromas acústicos familiares</oboInOwl:hasExactSynonym>
