    <!-- http://purl.obolibrary.org/obo/DOID_12858 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1289"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad neurodegenerativa que tiene material basis en la herencia autosómica dominante y se caracteriza por movimientos coreaticos no deseados, alteraciones conductuales y psiquiátricas y demencia y tiene material base material en la expansión de las repeticiones de tripletes CAG (glutamina) dando lugar a una degeneración neuronal que afecta a la coordinación muscular, las capacidades cognitivas.</obo:IAO_0000115>
