            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A syndrome that is characterized by delayed psychomotor development, severe intellectual disability with poor or absent speech, and bradycardia and/or cardiac sinus arrhythmias and that has_material_basis_in homozygous or compound heterozygous mutation in the GNB5 gene on chromosome 15q21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617173</oboInOwl:hasDbXref>
