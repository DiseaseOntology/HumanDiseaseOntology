    <!-- http://purl.obolibrary.org/obo/DOID_0050763 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por contracturas articulares congénitas, disfunción tubular renal, colestasis, grave retraso del crecimiento, ictiosis y un defecto en la biogénesis de los gránulos alfa de las plaquetas y que tiene_como_base la mutación homocigota o heterocigota compuesta en el gen VPS33B o en la mutación homocigota o heterocigota compuesta en el gen VIPAR del cromosoma 14q24.3.</obo:IAO_0000115>
        <oboInOwl:creation_date>2013-01-17T12:46:38Z</oboInOwl:creation_date>
