    <!-- http://purl.obolibrary.org/obo/DOID_0060013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_627"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una inmunodeficiencia combinada grave que es una inmunodeficiencia combinada grave ligada al cromosoma X que tiene_como_base mutaciones en los genes que codifican las proteínas comunes de la cadena gamma compartidas por los receptores de interleucina (IL-2,4,7,9,16 y21) que dan como resultado una cadena gamma no funcional, una señalización de interleucina defectuosa, células T y NK mínimas o ascendentes y células B no funcionales.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:5811</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GARD:5618</oboInOwl:hasDbXref>
