    <!-- http://purl.obolibrary.org/obo/DOID_0081393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2537"/>
        <obo:IAO_0000115 xml:lang="es">Neuropatía inflamatoria y tóxica que se caracteriza por un conjunto de síntomas neuropsicológicos asociados a la exposición repetida a plaguicidas organofosforados, así como a agentes nerviosos. Los síntomas pueden aparecer semanas después de la exposición e incluyen debilidad muscular, ansiedad, depresión, psicosis, así como déficits cognitivos y de memoria.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="es">polineuropatía retardada inducida por organofosforados</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081393</oboInOwl:id>
        <rdfs:label xml:lang="es">Polineuropatía retardada inducida por organofosforados</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081393"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neuropatía inflamatoria y tóxica que se caracteriza por un conjunto de síntomas neuropsicológicos asociados a la exposición repetida a plaguicidas organofosforados, así como a agentes nerviosos. Los síntomas pueden aparecer semanas después de la exposición e incluyen debilidad muscular, ansiedad, depresión, psicosis, así como déficits cognitivos y de memoria.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.atsdr.cdc.gov/csem/cholinesterase-inhibitors/neuropathy.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/16042503</oboInOwl:hasDbXref>
    </owl:Axiom>
    


