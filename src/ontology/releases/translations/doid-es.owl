    <!-- http://purl.obolibrary.org/obo/DOID_0050339 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_104"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa bacteriana que resulta_en una infección por bacterias que forman parte de la flora humana normal cuando uno o más de los mecanismos de defensa diseñados para restringirlas de los tejidos internos, habitualmente estériles, se vulneran por accidente, de forma intencional (cirugía) o por un trastorno metabólico o infeccioso subyacente.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050339</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">enfermedad infecciosa bacteriana comensal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050339"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa bacteriana que resulta_en una infección por bacterias que forman parte de la flora humana normal cuando uno o más de los mecanismos de defensa diseñados para restringirlas de los tejidos internos, habitualmente estériles, se vulneran por accidente, de forma intencional (cirugía) o por un trastorno metabólico o infeccioso subyacente.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.microbiologyinpictures.com/introduction.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/24727150</oboInOwl:hasDbXref>
