    <!-- http://purl.obolibrary.org/obo/DOID_3743 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3744"/>
        <obo:IAO_0000115 xml:lang="es">Carcinoma cervical de células escamosas que se caracteriza por una superficie hiperqueratósica, ondulante y verrugosa e invade el estroma subyacente en forma de pegotes epiteliales bulbosos con un borde expandido, papilas anchas que carecen de núcleos fibrovasculares y ausencia de coilocitosis. No muestra más que una atipia nuclear mínima y no presenta crecimiento infiltrativo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C40190</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1516435</oboInOwl:hasDbXref>
