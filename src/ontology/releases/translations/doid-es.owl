        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_1495"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Equinococosis causada por larvas de Echinococcus granulosus. La afectación hepática puede producir dolor abdominal, una masa en la zona hepática y obstrucción de las vías biliares. La afectación pulmonar puede producir dolor torácico, tos y hemoptisis. La ruptura de los quistes produce fiebre, urticaria, eosinofilia y shock anafiláctico, así como diseminación de los quistes. El cerebro, los huesos y el corazón también pueden infectarse.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.who.int/mediacentre/factsheets/fs377/en/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


