        <owl:annotatedTarget xml:lang="es">La tripanosomiasis que resulta de la infección por Trypanosoma brucei y gambiense, que se transmite por la picadura de una mosca tsetsé infectada (Glossina spp). Los síntomas incluyen fiebre, dolor de cabeza, dolor en las articulaciones, picor, confusión, alteraciones sensoriales, mala coordinación y trastornos del sueño.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007640"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/African_trypanosomiasis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.nlm.nih.gov/medlineplus/ency/article/001362.htm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.who.int/mediacentre/factsheets/fs259/en/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


