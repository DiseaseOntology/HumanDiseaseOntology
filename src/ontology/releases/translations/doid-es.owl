    <!-- http://purl.obolibrary.org/obo/DOID_3651 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3651">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2978"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000124"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000465"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_3651"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Trastorno metabólico de los hidratos de carbono que se caracteriza por deficiencia de piruvato carboxilasa que causa disminución de la utilización de hidratos de carbono y acumulación tóxica de ácido láctico, posiblemente tiene síntoma de elevaciones periódicas de lactato, molestias gastrointestinales, tiene base material en la herencia autosómica recesiva de la mutación en el gen PC, que codifica la piruvato carboxilasa, una proteína crítica en el ciclo del ácido cítrico y en la gluconeogénesis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:E74.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D015324</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:266150</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C85040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:87694001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0034341</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de pirúvico carboxilasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3651</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">enfermedad por deficiencia de piruvato carboxilasa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3651"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Trastorno metabólico de los hidratos de carbono que se caracteriza por deficiencia de piruvato carboxilasa que causa disminución de la utilización de hidratos de carbono y acumulación tóxica de ácido láctico, posiblemente tiene síntoma de elevaciones periódicas de lactato, molestias gastrointestinales, tiene base material en la herencia autosómica recesiva de la mutación en el gen PC, que codifica la piruvato carboxilasa, una proteína crítica en el ciclo del ácido cítrico y en la gluconeogénesis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
