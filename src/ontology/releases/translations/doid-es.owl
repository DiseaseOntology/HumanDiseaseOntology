    <!-- http://purl.obolibrary.org/obo/DOID_12571 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1686"/>
        <obo:IAO_0000115 xml:lang="en">A glaucoma characterized by glaucomatous optic atrophy secondary to a lens abnormality and has_symptom progressive decreased vision, especially decreased peripheral vision. Phacogenic glaucoma can be caused by cataracts, trauma to the eye, or age-related damage that obstructs aqueous outflow, leading to inappropriately increased intraocular pressure and eventual optic nerve atrophy with associated vision loss.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:365.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:84333006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0271142</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12571</oboInOwl:id>
        <rdfs:label xml:lang="es">glaucoma facogénico</rdfs:label>
        <skos:exactMatch>UMLS_CUI:C0271142</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A glaucoma characterized by glaucomatous optic atrophy secondary to a lens abnormality and has_symptom progressive decreased vision, especially decreased peripheral vision. Phacogenic glaucoma can be caused by cataracts, trauma to the eye, or age-related damage that obstructs aqueous outflow, leading to inappropriately increased intraocular pressure and eventual optic nerve atrophy with associated vision loss.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://eyewiki.aao.org/Lens_Induced_Glaucomas</oboInOwl:hasDbXref>
