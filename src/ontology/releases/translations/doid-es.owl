    <!-- http://purl.obolibrary.org/obo/DOID_9392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000882"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad traqueal que consiste en una infección bacteriana de la tráquea causada a menudo por Staphylococcus aureus y estreptococos que sigue a una infección vírica reciente de las vías respiratorias altas. Los síntomas son tos seca, chirridos al respirar, sensación de picor en la garganta, fiebre alta y producción de grandes cantidades de secreciones con pus.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:0050149</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9391</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J04.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:464.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C78643</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155507000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:62994001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0040584</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0149513</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">traqueítis aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">traqueítis crónica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9392</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">traqueítis</rdfs:label>
        <skos:exactMatch>MESH:D014136</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9392"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad traqueal que consiste en una infección bacteriana de la tráquea causada a menudo por Staphylococcus aureus y estreptococos que sigue a una infección vírica reciente de las vías respiratorias altas. Los síntomas son tos seca, chirridos al respirar, sensación de picor en la garganta, fiebre alta y producción de grandes cantidades de secreciones con pus.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmpe/sec19/ch277/ch277j.html?qt=tracheitis&amp;alt=sh</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_9395 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1579"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa del sistema respiratorio que implica inflamación, edema y posterior obstrucción de la laringe, la tráquea y los bronquios. La enfermedad está causada por virus, bacterias, alergias e irritantes inhalados. Se caracteriza por episodios de dificultad respiratoria y tos ronca y metálica en lactantes y niños pequeños. El crup está causado por el virus de la parainfluenza (tipos 1 y 2), los virus de la gripe A y B, el virus del sarampión, el adenovirus, el virus respiratorio sincitial, el estafilococo y el estreptococo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:J05.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:464.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D003440</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C26735</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:71186008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0010380</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Laringitis obstructiva aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Laringotraqueobronquitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome del crup</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">laringotraqueobronquitis aguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9395</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">crup</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9395"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa del sistema respiratorio que implica inflamación, edema y posterior obstrucción de la laringe, la tráquea y los bronquios. La enfermedad está causada por virus, bacterias, alergias e irritantes inhalados. Se caracteriza por episodios de dificultad respiratoria y tos ronca y metálica en lactantes y niños pequeños. El crup está causado por el virus de la parainfluenza (tipos 1 y 2), los virus de la gripe A y B, el virus del sarampión, el adenovirus, el virus respiratorio sincitial, el estafilococo y el estreptococo.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007640"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
        <oboInOwl:hasDbXref>url:http://books.google.com/books?id=G6k0tpPMRsIC&amp;pg=PA254&amp;lpg=PA254&amp;dq#v=onepage&amp;q=&amp;f=false</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.nlm.nih.gov/medlineplus/ency/article/000959.htm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.merriam-webster.com/dictionary/croup#medicalDictionary</oboInOwl:hasDbXref>
    </owl:Axiom>
    


