                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001197"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A congenital disorder of glycosylation I that is characterized by developmental delay, intellectual disability, failure to thrive, hypotonia and seizures and has_material_basis_in homozygous mutation in the STT3A gene on chromosome 11q24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:615596</oboInOwl:hasDbXref>
