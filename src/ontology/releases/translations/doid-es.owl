    <!-- http://purl.obolibrary.org/obo/DOID_0070555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050428"/>
