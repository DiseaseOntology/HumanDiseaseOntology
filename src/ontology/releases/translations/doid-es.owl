            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad rectal que consiste en la inflamación de la mucosa rectal como consecuencia de una infección, una enfermedad inflamatoria intestinal o una radiación. En la enfermedad intervienen patógenos de transmisión sexual (Neisseria gonorrhoeae, Chlamydia trachomatis, virus del herpes simple 1 y 2, Treponema pallidum) y patógenos entéricos (Campylobacter, Shigella, Salmonella). Los síntomas son molestias y hemorragias rectales.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:K62.89</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D011349</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C38011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266534007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0033246</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym xml:lang="es">proctitis ulcerosa</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3127</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">proctitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad rectal que consiste en la inflamación de la mucosa rectal como consecuencia de una infección, una enfermedad inflamatoria intestinal o una radiación. En la enfermedad intervienen patógenos de transmisión sexual (Neisseria gonorrhoeae, Chlamydia trachomatis, virus del herpes simple 1 y 2, Treponema pallidum) y patógenos entéricos (Campylobacter, Shigella, Salmonella). Los síntomas son molestias y hemorragias rectales.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.cdc.gov/std/Treatment/2006/proctitis.htm</oboInOwl:hasDbXref>
