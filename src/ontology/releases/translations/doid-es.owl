        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_7602"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Osteosarcoma óseo que se caracteriza por la presencia de matriz extracelular osteoide y que surge de la porción medular del hueso. Afecta a los huesos largos y, con mayor frecuencia, al fémur distal, la tibia proximal y el húmero proximal. La presentación clínica más frecuente es dolor con o sin masa palpable.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://radiopaedia.org/articles/osteosarcoma</oboInOwl:hasDbXref>
