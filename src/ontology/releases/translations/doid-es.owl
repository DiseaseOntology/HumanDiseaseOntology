        <oboInOwl:hasExactSynonym xml:lang="es">bronquiolitis obliterante idiopática con neumonía organizada</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">neumonitis organizada criptogénica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">neumonía organizada criptogénica</oboInOwl:hasExactSynonym>
