    <!-- http://purl.obolibrary.org/obo/DOID_0050398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11102"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_774"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una bartonelosis que resulta_en infección que se_ubica_en células endoteliales o se_ubica_en glóbulos rojos, tiene_como_base la Bartonella bacilliformis, que se_transmite_por flebótomos del género Lutzomyia. La infección tiene fases aguda y crónica. La fase aguda se caracteriza por una anemia hemolítica grave y una inmunosupresión transitoria. La fase crónica se caracteriza por lesiones de verruga peruana que pueden ulcerarse y sangrar.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="es">enfermedad de Carrión</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">fiebre de Oroya</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050398</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">enfermedad de Carrión</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050398"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una bartonelosis que resulta_en infección que se_ubica_en células endoteliales o se_ubica_en glóbulos rojos, tiene_como_base la Bartonella bacilliformis, que se_transmite_por flebótomos del género Lutzomyia. La infección tiene fases aguda y crónica. La fase aguda se caracteriza por una anemia hemolítica grave y una inmunosupresión transitoria. La fase crónica se caracteriza por lesiones de verruga peruana que pueden ulcerarse y sangrar.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Carrion%27s_disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    


