    <!-- http://purl.obolibrary.org/obo/DOID_0111060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_420"/>
        <obo:IAO_0000115 xml:lang="es">La hipertricosis se caracteriza por la herencia autosómica dominante de la presencia de vello de tipo velloso en todo el cuerpo, especialmente en la cara, las orejas y los hombros, con excepción de las palmas de las manos, las plantas de los pies y las mucosas y tiene_base_material_en anomalías cromosómicas en la región 8q22.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:Q84.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C536605</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:145701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:1023</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Ambras</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111060</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">hipertricosis universalis congénita tipo Ambras</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La hipertricosis se caracteriza por la herencia autosómica dominante de la presencia de vello de tipo velloso en todo el cuerpo, especialmente en la cara, las orejas y los hombros, con excepción de las palmas de las manos, las plantas de los pies y las mucosas y tiene_base_material_en anomalías cromosómicas en la región 8q22.</owl:annotatedTarget>
