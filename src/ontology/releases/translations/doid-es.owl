        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/21210154</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080015"/>
        <obo:IAO_0000115 xml:lang="en">A physical disorder characterized by mandibular hypoplasia or agnathia, ventromedial auricular malposition (melotia) and/or auricular fusion (synotia), and microstomia with oroglossal hypoplasia or aglossia. Holoprosencephaly is the most commonly identified association, but skeletal, genitourinary and cardiovascular anomalies and situs inversus have been reported.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-05-26T16:14:08Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>ICD10CM:Q18.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C562503</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:202650</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:990</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">holoprosencefalia-agnatia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">otocefalia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de agnatia holoprosencefalia-situs inversus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060341</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">complejo de agnatia-otocefalia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060341"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A physical disorder characterized by mandibular hypoplasia or agnathia, ventromedial auricular malposition (melotia) and/or auricular fusion (synotia), and microstomia with oroglossal hypoplasia or aglossia. Holoprosencephaly is the most commonly identified association, but skeletal, genitourinary and cardiovascular anomalies and situs inversus have been reported.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/17438667</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1934"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SO_0000704"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A dysostosis characterized by cranium bifidum, severe hypertelorism, median cleft lip and palate, nasal bifurcation, brachycephaly, large fontanelle, tibial hemimelia, preaxial polydactyly of the feet and brain malformations and that has_material_basis_in heterozygous mutation in the ZSWIM6 gene on chromosome 5q12.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-05-26T16:44:46Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>GARD:5539</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C566345</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:603671</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:1827</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060342</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">disostosis frontonasal acromélica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060342"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A dysostosis characterized by cranium bifidum, severe hypertelorism, median cleft lip and palate, nasal bifurcation, brachycephaly, large fontanelle, tibial hemimelia, preaxial polydactyly of the feet and brain malformations and that has_material_basis_in heterozygous mutation in the ZSWIM6 gene on chromosome 5q12.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/15264282</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060343 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11476"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000369"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An osteoporosis caused by chronic glucocorticoid use. Glucocorticoids impair the replication, differentiation and function of osteoblasts and induce the apoptosis of mature osteoblasts and osteocytes; the also favor osteoclastogenesis leading to an increase in bone resorption.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-05-27T17:07:43Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym xml:lang="es">osteoporosis inducida por esteroides</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060343</oboInOwl:id>
        <rdfs:label xml:lang="es">osteoporosis inducida por glucocorticoides</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060343"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An osteoporosis caused by chronic glucocorticoid use. Glucocorticoids impair the replication, differentiation and function of osteoblasts and induce the apoptosis of mature osteoblasts and osteocytes; the also favor osteoclastogenesis leading to an increase in bone resorption.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/17566815</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/22870429</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060344 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2722"/>
        <obo:IAO_0000115 xml:lang="es">Una acrodermatitis caracterizada por un curso crónicamente progresivo, que conduce a una atrofia generalizada de la piel. Es una manifestación clínica de la borreliosis de Lyme.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-05-28T14:45:56Z</oboInOwl:creation_date>
