    <!-- http://purl.obolibrary.org/obo/DOID_0081334 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081332"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0011463"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome progeroide que se caracteriza por lipoatrofia, osteoporosis y osteólisis muy grave. Los pacientes no presentan alteraciones cardiovasculares, diabetes mellitus ni hipertrigliceridemia, pero sufren profundas anomalías esqueléticas que afectan a su calidad de vida y que presenta una mutación homocigota en el gen BANF1 del cromosoma 11q13. El inicio se produce después de los 2 años de edad.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:11008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:614008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:280576</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de progeria de inicio en la infancia con osteólisis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081334</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de progeria Nestor-Guillermo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081334"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome progeroide que se caracteriza por lipoatrofia, osteoporosis y osteólisis muy grave. Los pacientes no presentan alteraciones cardiovasculares, diabetes mellitus ni hipertrigliceridemia, pero sufren profundas anomalías esqueléticas que afectan a su calidad de vida y que presenta una mutación homocigota en el gen BANF1 del cromosoma 11q13. El inicio se produce después de los 2 años de edad.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/32783369/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081335 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
