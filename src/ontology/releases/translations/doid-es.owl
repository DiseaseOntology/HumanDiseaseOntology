        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de depleción del ADN mitocondrial hepatocerebral relacionado con MPV17</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
