    <!-- http://purl.obolibrary.org/obo/DOID_7408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_7408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2101"/>
        <obo:IAO_0000115 xml:lang="es">Carcinoma de células escamosas de la vulva de crecimiento rápido, autolimitado y caracterizado por la presencia de un cráter central que contiene células escamosas. Las células escamosas proliferantes se infiltran en la dermis inferior y producen masas de queratina que son empujadas hacia la superficie del tumor. Se considera una variante del carcinoma de células escamosas bien diferenciado con un comportamiento clínico distinto.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C128167</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C4288007</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:7408</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">queratoacantoma vulvar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_7408"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Carcinoma de células escamosas de la vulva de crecimiento rápido, autolimitado y caracterizado por la presencia de un cráter central que contiene células escamosas. Las células escamosas proliferantes se infiltran en la dermis inferior y producen masas de queratina que son empujadas hacia la superficie del tumor. Se considera una variante del carcinoma de células escamosas bien diferenciado con un comportamiento clínico distinto.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://ncit.nci.nih.gov/ncitbrowser/ConceptReport.jsp?dictionary=NCI_Thesaurus&amp;ns=ncit&amp;code=C40288</oboInOwl:hasDbXref>
