    <!-- http://purl.obolibrary.org/obo/DOID_2710 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2710">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_841"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000504"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000868"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019177"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Alveolitis alérgica extrínseca que se caracteriza por un conjunto de síntomas como dolor de cabeza, fatiga, irritación ocular y dificultades respiratorias que afectan a los trabajadores de los modernos edificios de oficinas herméticos. La enfermedad está causada por contaminantes de interior (como humos de formaldehído, partículas o microorganismos), y los síntomas tienden a desaparecer cuando los afectados abandonan el edificio.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D018877</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:19076009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0037050</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2710</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome del edificio enfermo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2710"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Alveolitis alérgica extrínseca que se caracteriza por un conjunto de síntomas como dolor de cabeza, fatiga, irritación ocular y dificultades respiratorias que afectan a los trabajadores de los modernos edificios de oficinas herméticos. La enfermedad está causada por contaminantes de interior (como humos de formaldehído, partículas o microorganismos), y los síntomas tienden a desaparecer cuando los afectados abandonan el edificio.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
        <oboInOwl:hasDbXref>url:https://www.merriam-webster.com/dictionary/sick%20building%20syndrome#medicalDictionary</oboInOwl:hasDbXref>
    </owl:Axiom>
    


