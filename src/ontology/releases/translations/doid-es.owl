    <!-- http://purl.obolibrary.org/obo/DOID_10323 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10316"/>
