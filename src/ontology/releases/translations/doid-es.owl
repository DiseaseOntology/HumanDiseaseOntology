        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">linfohistiocitosis hemofagocítica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050120"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del sistema linfático que se caracteriza por una expansión de la población de monocitos-macrófagos y una hemofagocitosis intensa. Puede aparecer de novo, pero lo más frecuente es que se produzca en el contexto de otro trastorno, normalmente una infección o una neoplasia maligna. Un cuadro clínico de fiebre, hepatoesplenomegalia, linfadenopatía y pancitopenia periférica. El sello morfológico de este síndrome es la fagocitosis de elementos hematopoyéticos por macrófagos morfológicamente normales.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
