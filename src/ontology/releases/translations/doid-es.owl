    <!-- http://purl.obolibrary.org/obo/DOID_9180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9180">
        <obo:IAO_0000115 xml:lang="en">An amebiasis that involves infection of the intestine with the protozoan parasite Entamoeba histolytica trophozoites resulting in intermittent nondysenteric diarrhea with abdominal pain, mucus, flatulence, and weight loss. Chronic infection manifests as tender, palpable masses or annular lesions (amebomas) in the cecum and ascending colon.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9180</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete amebic colitis</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9180"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An amebiasis that involves infection of the intestine with the protozoan parasite Entamoeba histolytica trophozoites resulting in intermittent nondysenteric diarrhea with abdominal pain, mucus, flatulence, and weight loss. Chronic infection manifests as tender, palpable masses or annular lesions (amebomas) in the cecum and ascending colon.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/DPDx/HTML/Amebiasis.htm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmpe/sec14/ch185/ch185b.html?qt=amebic%20colitis&amp;alt=sh</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_9181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2789"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_5759"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000570"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa producida por protozoos parásitos y causada por la ameba Entamoeba histolytica. La invasión amebiana de la mucosa intestinal provoca disentería, colitis o diarrea. La infección también puede propagarse por la sangre al hígado y, en raras ocasiones, a los pulmones, el cerebro u otros órganos.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:11901</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:11904</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GARD:652</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A06</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000562</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84551</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:387754006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0002438</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">amebiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">entamoebiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">amebiasis intestinal crónica</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:9181</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">amebiasis</rdfs:label>
        <skos:exactMatch>MESH:D000562</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
