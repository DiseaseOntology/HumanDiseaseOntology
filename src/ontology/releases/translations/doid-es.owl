    <!-- http://purl.obolibrary.org/obo/DOID_0060937 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_543"/>
