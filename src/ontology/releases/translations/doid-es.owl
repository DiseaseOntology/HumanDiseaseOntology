        <oboInOwl:hasExactSynonym xml:lang="es">Inmunodeficiencia combinada debido a la deficiencia de PGM3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Trastorno congénito de la glicosilación relacionado con PGM3</oboInOwl:hasExactSynonym>
