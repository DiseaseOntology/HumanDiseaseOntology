        <oboInOwl:hasDbXref>UMLS_CUI:C0023860</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Listeria monocytogenes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por listeria</oboInOwl:hasExactSynonym>
