    <!-- http://purl.obolibrary.org/obo/DOID_0080824 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080824">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080809"/>
        <obo:IAO_0000115 xml:lang="es">Asma crónica que se caracteriza por la gravedad con síntomas dos o menos días por semana, despertares nocturnos dos o menos veces al mes, uso de beta agonista de acción corta para el control de los síntomas varias veces al día y actividad normal extremadamente limitada.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080824</oboInOwl:id>
