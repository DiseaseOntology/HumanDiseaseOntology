                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000446"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A scleral disease that is characterized by painful inflammation of the episcleral tissues that, importantly, spares the sclera itself and has_symptom pain, red eyes, photophobia, tearing, and blurry vision. Episcleritis periodica fugax is typically self-limited but may be related to vascular congestion within the superficial episcleral plexus and associated with autoimmune disease, connective tissue disease, malignancies, trauma, infection, and medications, especially topiramate and pamidronate.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H15.11</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:379.01</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:194141004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0155351</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12124</oboInOwl:id>
        <rdfs:label xml:lang="es">episcleritis periodica fugax</rdfs:label>
    </owl:Class>
    <owl:Axiom>
