        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070531"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad de la retina caracterizada por hipoplasia foveal con disminución de la agudeza visual y nistagmo que tiene material base en una mutación homocigota o heterocigota compuesta en el gen SLC38A8 en el cromosoma 16q23.3. También se observan con frecuencia defectos de decusación del nervio óptico y disgenesia del segmento anterior.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
