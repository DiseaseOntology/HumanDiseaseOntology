    <!-- http://purl.obolibrary.org/obo/DOID_6677 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_6677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se produce en pacientes seropositivos al virus de la inmunodeficiencia humana (VIH), que se acompaña de una disminución de la función renal. El espectro de afectación renal incluye enfermedad renal aguda o crónica, proteinuria principalmente tubular e infiltrados tubulointersticiales linfocíticos densos compuestos predominantemente por células T CD8.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C35699</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:449784008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1333292</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:6677</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome de linfocitosis infiltrativa difusa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_6677"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que se produce en pacientes seropositivos al virus de la inmunodeficiencia humana (VIH), que se acompaña de una disminución de la función renal. El espectro de afectación renal incluye enfermedad renal aguda o crónica, proteinuria principalmente tubular e infiltrados tubulointersticiales linfocíticos densos compuestos predominantemente por células T CD8.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Diffuse_infiltrative_lymphocytosis_syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/21295898</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_6678 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_6678">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0000014"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001037"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001091"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001705"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome que afecta a los dientes, las uñas, el pelo y/o la piel. Se caracteriza por la ausencia (hipodoncia) y/o malformación de ciertos dientes primarios (deciduos) y secundarios (permanentes) que se produce en asociación con un desarrollo inadecuado de las uñas, en particular de las uñas de los pies.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C536736</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:189500</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C40553</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:400036004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0406735</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Witkop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de esmalte hipoplásico-onicólisis-hipohidrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:6678</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome de dientes y uñas</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_6678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que afecta a los dientes, las uñas, el pelo y/o la piel. Se caracteriza por la ausencia (hipodoncia) y/o malformación de ciertos dientes primarios (deciduos) y secundarios (permanentes) que se produce en asociación con un desarrollo inadecuado de las uñas, en particular de las uñas de los pies.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:http://www.rarediseases.org/search/rdbdetail_abstract.html?disname=Tooth%20and%20Nail%20Syndrome</oboInOwl:hasDbXref>
