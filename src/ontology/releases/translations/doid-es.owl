    <!-- http://purl.obolibrary.org/obo/DOID_0060820 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060820">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060309"/>
        <obo:IAO_0000115 xml:lang="es">Discapacidad intelectual sindrómica ligada al cromosoma X caracterizada por discapacidad intelectual con rasgos dismórficos, como cabeza grande, sinofosis, crestas supraorbitarias prominentes, ojos almendrados y hundidos, orejas grandes, boca ancha, aspecto mixedematoso, hirsutismo, verticilos capilares anormales, micropene y onicodistrofia que tiene_como_base una mutación en el gen UBE2A del cromosoma Xq24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q87.8</oboInOwl:hasDbXref>
