    <!-- http://purl.obolibrary.org/obo/DOID_0080070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080488"/>
        <obo:IAO_0000115 xml:lang="es">Mucolipidosis que se caracteriza por baja estatura, anomalías esqueléticas, cardiomegalia y retraso del desarrollo, causada por un defecto en la fosforilación y localización adecuadas de enzimas lisosomales, que da lugar a la acumulación de sustratos lisosomales, y que presenta una mutación homocigota o heterocigota compuesta en el gen GNPTAB.</obo:IAO_0000115>
