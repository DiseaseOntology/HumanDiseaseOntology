        <oboInOwl:hasDbXref>UMLS_CUI:C1864723</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Convulsiones dependientes de piridoxal fosfato</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Convulsiones que responden al fosfato de piridoxal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de PNPO</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Deficiencia de piridoxamina 5&apos;-oxidasa</oboInOwl:hasExactSynonym>
