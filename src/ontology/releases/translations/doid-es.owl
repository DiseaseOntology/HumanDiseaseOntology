    <!-- http://purl.obolibrary.org/obo/DOID_3251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3252"/>
        <obo:IAO_0000115 xml:lang="es">Rabdomiosarcoma de próstata que es más frecuente en niños y que se caracteriza por un alto grado de malignidad, tanto por el rápido crecimiento local con formación de grandes masas pélvicas, que a menudo conducen a insuficiencia renal debido a la obstrucción uretral, como por la diseminación sistémica, comúnmente a los pulmones, el hígado y los huesos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C5525</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1335508</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Rabdomiosarcoma embrionario de próstata</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3251</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">rabdomiosarcoma embrionario de próstata</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
