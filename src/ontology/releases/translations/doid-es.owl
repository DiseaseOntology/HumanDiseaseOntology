    <!-- http://purl.obolibrary.org/obo/DOID_0060008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_627"/>
        <obo:IAO_0000115 xml:lang="es">Inmunodeficiencia combinada grave que se caracteriza por una inmunodeficiencia grave mediada por células y anticuerpos con infecciones bacterianas, víricas y fúngicas recurrentes, se_desarrolla_a partir_de la deficiencia de la cinasa Jano 3 y tiene_como_base la herencia autosómica recesiva de la mutación en el gen JAK3 del cromosoma 19p13.11, responsable de la diferenciación y maduración normales de las células inmunitarias B y T.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:600802</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060008</oboInOwl:id>
        <rdfs:label xml:lang="es">deficiencia de cinasa Jano 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Inmunodeficiencia combinada grave que se caracteriza por una inmunodeficiencia grave mediada por células y anticuerpos con infecciones bacterianas, víricas y fúngicas recurrentes, se_desarrolla_a partir_de la deficiencia de la cinasa Jano 3 y tiene_como_base la herencia autosómica recesiva de la mutación en el gen JAK3 del cromosoma 19p13.11, responsable de la diferenciación y maduración normales de las células inmunitarias B y T.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/jak3-deficient-severe-combined-immunodeficiency#inheritance</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_627"/>
        <obo:IAO_0000115 xml:lang="es">Inmunodeficiencia combinada grave que se caracteriza por infecciones bacterianas, víricas y fúngicas recurrentes, especialmente de pulmón, y granulomas necrotizantes estériles de la piel, que se_desarrolla_a_partir_de deficiencia o disminución de la expresión superficial del CMH de clase I, tiene_como_base la herencia autosómica recesiva de la mutación que afecta a la producción o expresión del CMH de clase I e implica con frecuencia a las subunidades TAP1 y TAP2, y suele ser asintomática en la infancia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:604571</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060009</oboInOwl:id>
        <rdfs:label xml:lang="es">deficiencia de MHC clase I</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Inmunodeficiencia combinada grave que se caracteriza por infecciones bacterianas, víricas y fúngicas recurrentes, especialmente de pulmón, y granulomas necrotizantes estériles de la piel, que se_desarrolla_a_partir_de deficiencia o disminución de la expresión superficial del CMH de clase I, tiene_como_base la herencia autosómica recesiva de la mutación que afecta a la producción o expresión del CMH de clase I e implica con frecuencia a las subunidades TAP1 y TAP2, y suele ser asintomática en la infancia.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Bare_lymphocyte_syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/25001848</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_627"/>
