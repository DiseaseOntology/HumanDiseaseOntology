        <rdfs:label xml:lang="es">fiebre de las trincheras</rdfs:label>
        <skos:exactMatch>MESH:D014205</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11101"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa bacteriana primaria que provoca una infección sistémica tiene material base en Bartonella quintana, que es transmitida por los piojos del cuerpo (Pediculus humanus corporis). La infección tiene como síntoma la fiebre recurrente, dolor de cabeza, dolor de espinillas y dolor de los músculos de las piernas y de la espalda.</owl:annotatedTarget>
