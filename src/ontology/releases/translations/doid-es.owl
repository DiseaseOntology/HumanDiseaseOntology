    <!-- http://purl.obolibrary.org/obo/DOID_10525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0002116"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000321"/>
