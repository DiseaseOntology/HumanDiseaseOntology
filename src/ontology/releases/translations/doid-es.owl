            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una RASopatía que se caracteriza por la herencia autosómica dominante de manchas cutáneas marrones llamadas lentigos que son similares a las pecas, defectos cardíacos, ojos muy separados un pecho hundido o protuberante y baja estatura.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:1100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D044542</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS151100</oboInOwl:hasDbXref>
