                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000634"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad pulmonar que consiste en una crisis vasooclusiva de la vasculatura pulmonar que se observa en pacientes con anemia falciforme. La crisis se inicia por una infección pulmonar, y la inflamación resultante y la pérdida de tensión de oxígeno conducen a la falcificación de los eritrocitos y a una mayor vasooclusión. La enfermedad tiene_síntoma de fiebre, tiene_síntoma de dolor torácico pleurítico, tiene_síntoma de taquipnea, tiene_síntoma de tos, tiene_síntoma de hipoxemia, tiene_síntoma de marcada leucocitosis, y tiene_síntoma de infiltrados difusos en la radiografía de tórax.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:517.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D056586</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C138179</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:372146004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0742343</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1584</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome torácico agudo</rdfs:label>
        <skos:exactMatch>MESH:D056586</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
