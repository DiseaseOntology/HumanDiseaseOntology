    <!-- http://purl.obolibrary.org/obo/DOID_0070834 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070834">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050538"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf>
