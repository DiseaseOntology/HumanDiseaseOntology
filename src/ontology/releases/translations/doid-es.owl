    <!-- http://purl.obolibrary.org/obo/DOID_8962 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8962">
        <obo:IAO_0000115 xml:lang="en">A Measles virus infectious disease that results_in inflammation located_in cornea and located_in conjunctiva, has_material_basis_in Measles virus, which is transmitted_by contact with oronasal secretions, or semen of an infected person. The infection has_symptom mucopurulent discharge from the eye, has_symptom pain in the eye, and has_symptom redness.</obo:IAO_0000115>
