        <oboInOwl:hasDbXref>NCI:C53482</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155559006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0021400</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">gripe</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">influenza con manifestación no respiratoria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">influenza con otras manifestaciones</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8469</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">influenza</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8469"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
