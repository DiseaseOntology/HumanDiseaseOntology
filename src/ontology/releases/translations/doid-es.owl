        <rdfs:label xml:lang="es">Síndrome de Clouston</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14693"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Displasia ectodérmica que se caracteriza por anomalías del cabello, las uñas y la piel, sin afectación de los dientes ni las glándulas sudoríparas, y que tiene base material en mutación heterocigota en el gen GJB6, que codifica la conexina-30, en el cromosoma 13q12.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/8845850/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


