                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019161"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Poliomielitis que da lugar a una atrofia localizada en el músculo, muchos años después de la infección inicial, tiene base material en el poliovirus humano 1, tiene base material en el poliovirus humano 2, o tiene base material el poliovirus humano 3. Se caracteriza por un nuevo debilitamiento en los músculos previamente afectados por la infección de polio y en los músculos que no estaban afectados. La infección tiene síntoma de debilidad muscular, tiene síntoma de dolor muscular, tiene síntoma de apnea del sueño y tiene síntoma de problemas respiratorios.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:4454</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G14</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D016262</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:31097004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0080040</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4952</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome postpoliomielítico</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4952"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Poliomielitis que da lugar a una atrofia localizada en el músculo, muchos años después de la infección inicial, tiene base material en el poliovirus humano 1, tiene base material en el poliovirus humano 2, o tiene base material el poliovirus humano 3. Se caracteriza por un nuevo debilitamiento en los músculos previamente afectados por la infección de polio y en los músculos que no estaban afectados. La infección tiene síntoma de debilidad muscular, tiene síntoma de dolor muscular, tiene síntoma de apnea del sueño y tiene síntoma de problemas respiratorios.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Postpolio_syndrome</oboInOwl:hasDbXref>
