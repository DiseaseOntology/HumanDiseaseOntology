    <!-- http://purl.obolibrary.org/obo/DOID_2409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050291"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa parasitaria por Ichthyosporea que es una infección granulomatosa crónica de las membranas mucosas causada por el parásito Rhinosporidium seeberi, que se manifiesta como pólipos friables vasculares que surgen de la mucosa nasal o de las estructuras externas del ojo. También se han observado enfermedades de la piel, la boca, las vías respiratorias superiores, el oído, los genitales y el recto.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B48.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:117.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D012227</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:18140003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0035469</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Rhinosporidium seeberi</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2409</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">rinosporidiosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2409"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa parasitaria por Ichthyosporea que es una infección granulomatosa crónica de las membranas mucosas causada por el parásito Rhinosporidium seeberi, que se manifiesta como pólipos friables vasculares que surgen de la mucosa nasal o de las estructuras externas del ojo. También se han observado enfermedades de la piel, la boca, las vías respiratorias superiores, el oído, los genitales y el recto.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.sciencedirect.com/science/article/abs/pii/S2213219817305093?via%3Dihub</oboInOwl:hasDbXref>
