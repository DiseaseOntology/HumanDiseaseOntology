    <!-- http://purl.obolibrary.org/obo/DOID_0060453 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060441"/>
        <obo:IAO_0000115 xml:lang="es">Una distrofia epitelio-estromal TGFBI que se caracteriza por erosiones recurrentes y opacificación geográfica irregular que se_ubica_en la córnea, depósitos proteináceos en el estroma anterior y el subepitelio, y pérdida progresiva y temprana de la visión, y tiene_como_base la mutación heterocigótica del gen inducido por el factor de crecimiento transformante beta localizado en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías conducen a un aumento del depósito de proteínas y a la alteración, especialmente, de la membrana de Bowman de la córnea.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-16T17:51:03Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>MESH:C535476</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:608470</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:98961</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:231930000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0339278</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia corneal geográfica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia corneal granular tipo III</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia de la membrana limitante anterior tipo I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060453</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">distrofia corneal de Reis-Bucklers</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060453"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distrofia epitelio-estromal TGFBI que se caracteriza por erosiones recurrentes y opacificación geográfica irregular que se_ubica_en la córnea, depósitos proteináceos en el estroma anterior y el subepitelio, y pérdida progresiva y temprana de la visión, y tiene_como_base la mutación heterocigótica del gen inducido por el factor de crecimiento transformante beta localizado en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías conducen a un aumento del depósito de proteínas y a la alteración, especialmente, de la membrana de Bowman de la córnea.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/608470</oboInOwl:hasDbXref>
    </owl:Axiom>
    


