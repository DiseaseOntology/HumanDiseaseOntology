        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de dismorfismo craneofacial, anomalías esqueléticas y retraso mental</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081072"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que se caracteriza por un desarrollo anormal del cerebro y de las estructuras de la cara y el torso, incluyendo dismorfismo facial, déficit intelectual anomalías costovertebrales y retraso en el desarrollo de las habilidades del habla y el movimiento (motoras).</owl:annotatedTarget>
