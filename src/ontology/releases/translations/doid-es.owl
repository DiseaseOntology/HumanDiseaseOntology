    <!-- http://purl.obolibrary.org/obo/DOID_11379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_883"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_61463"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La enfermedad infecciosa helmintiásica parasitaria que consiste en una infección parasitaria debida a la migración de gusanos inmaduros de Gnathostoma spinigerum o Gnathostoma hispidum, que se produce al comer pescado o aves de corral poco cocinados que contienen larvas de tercer estadio, o al beber agua que contiene larvas infectivas de segundo estadio en Cyclops. La migración en los tejidos subcutáneos provoca hinchazones intermitentes migratorias, dolorosas y pruriginosas (larva migrans cutánea). La migración a otros tejidos (larva migrans visceral) provoca tos hematuria y afectación ocular, siendo las manifestaciones más graves la meningitis eosinofílica con mieloencefalitis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9286</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B83.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:128.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D058429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C128395</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:44086001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0018013</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad infecciosa por gnatostoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Gnatostomiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11379</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">gnatomiasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11379"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa helmintiásica parasitaria que consiste en una infección parasitaria debida a la migración de gusanos inmaduros de Gnathostoma spinigerum o Gnathostoma hispidum, que se produce al comer pescado o aves de corral poco cocinados que contienen larvas de tercer estadio, o al beber agua que contiene larvas infectivas de segundo estadio en Cyclops. La migración en los tejidos subcutáneos provoca hinchazones intermitentes migratorias, dolorosas y pruriginosas (larva migrans cutánea). La migración a otros tejidos (larva migrans visceral) provoca tos hematuria y afectación ocular, siendo las manifestaciones más graves la meningitis eosinofílica con mieloencefalitis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Gnathostomiasis.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


