        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/x-linked-severe-combined-immunodeficiency#synonyms</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_627"/>
        <obo:IAO_0000115 xml:lang="es">Inmunodeficiencia combinada grave que es una enfermedad autosómica recesiva con disfunción de los linfocitos T y B, debida a una gran deleción en un alelo y a una mutación puntual en el otro. La mutación puntual provocó la alteración de la secuencia intermedia 13 sitio de empalme donante. La población de linfocitos T está disminuida y no responde a la estimulación con mitógenos. El nivel del número de linfocitos B y la inmunoglobulina sérica disminuyeron con la edad.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060014</oboInOwl:id>
        <rdfs:label xml:lang="es">deficiencia de CD45</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Inmunodeficiencia combinada grave que es una enfermedad autosómica recesiva con disfunción de los linfocitos T y B, debida a una gran deleción en un alelo y a una mutación puntual en el otro. La mutación puntual provocó la alteración de la secuencia intermedia 13 sitio de empalme donante. La población de linfocitos T está disminuida y no responde a la estimulación con mitógenos. El nivel del número de linfocitos B y la inmunoglobulina sérica disminuyeron con la edad.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/29366662</oboInOwl:hasDbXref>
    </owl:Axiom>
    


