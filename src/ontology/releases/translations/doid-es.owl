        <obo:IAO_0000115 xml:lang="es">Neoplasia benigna del tejido conjuntivo que surge de los tejidos blandos extraesqueléticos próximos a tendones y articulaciones. Es un tumor bien circunscrito caracterizado por la presencia de condrocitos, un patrón de crecimiento lobulado de cartílago hialino y, en algunos casos, calcificación.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C9482</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">condroma extraesquelético</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3814</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">condroma de tejidos blandos</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3814"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neoplasia benigna del tejido conjuntivo que surge de los tejidos blandos extraesqueléticos próximos a tendones y articulaciones. Es un tumor bien circunscrito caracterizado por la presencia de condrocitos, un patrón de crecimiento lobulado de cartílago hialino y, en algunos casos, calcificación.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://radiopaedia.org/articles/soft-tissue-chondroma</oboInOwl:hasDbXref>
    </owl:Axiom>
    


