    <!-- http://purl.obolibrary.org/obo/DOID_11554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2566"/>
        <obo:IAO_0000115 xml:lang="en">A corneal dystrophy that is characterized by corneal edema, iris atrophy, and secondary angle-closure glaucoma caused by an inflammatory or infectious insult that causes the endothelium to fail to pump aqueous humor from the cornea, leading to fluid accumulation, microcystic edema, and angle-closure glaucoma.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D057129</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:404632009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0544008</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Distrofia corneal de membrana posterior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Distrofia corneal endotelial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Distrofia del endotelio corneal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de chandler</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11554</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome de Chandler</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11554"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A corneal dystrophy that is characterized by corneal edema, iris atrophy, and secondary angle-closure glaucoma caused by an inflammatory or infectious insult that causes the endothelium to fail to pump aqueous humor from the cornea, leading to fluid accumulation, microcystic edema, and angle-closure glaucoma.</owl:annotatedTarget>
