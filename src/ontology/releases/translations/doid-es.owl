        <oboInOwl:hasDbXref>NCI:C27070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:111584000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0272167</oboInOwl:hasDbXref>
