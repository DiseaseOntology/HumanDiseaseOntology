        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Diabetes insípida nefrogénica que se caracteriza por la incapacidad de los conductos colectores renales para absorber agua en respuesta a la hormona antidiurética y que presenta una mutación heterocigota, homocigota o heterocigota compuesta en el gen que codifica el canal de agua acuaporina-2 (AQP2), que se localiza en el cromosoma 12q13.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://medlineplus.gov/ency/article/000511.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081062">
        <obo:IAO_0000115 xml:lang="en">A glucose metabolism disease that is characterized by high blood glucose.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
