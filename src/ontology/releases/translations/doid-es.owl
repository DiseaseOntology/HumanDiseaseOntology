        <oboInOwl:id>DOID:0050148</oboInOwl:id>
        <rdfs:label xml:lang="es">laringotraqueitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050148"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad de las vías respiratorias superiores que involucra la inflamación de la laringe y la tráquea, a menudo causada por una infección vírica. La infección puede cerrar la tráquea.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
