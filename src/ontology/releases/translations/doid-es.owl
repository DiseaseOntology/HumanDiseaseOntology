    <!-- http://purl.obolibrary.org/obo/DOID_0060935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060308"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Trastorno autosómico recesivo del desarrollo intelectual caracterizado por un desarrollo psicomotor muy deficiente, si es que existe, un habla deficiente, incapacidad para caminar de forma independiente y aparición al nacer o en la primera infancia que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen TBCK del cromosoma 4q24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:616900</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:488632</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:1172628002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C5567480</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de discapacidad intelectual relacionado con TBCK</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060935</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">hipotonía infantil con retraso psicomotor y facies-3 característica</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060935"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Trastorno autosómico recesivo del desarrollo intelectual caracterizado por un desarrollo psicomotor muy deficiente, si es que existe, un habla deficiente, incapacidad para caminar de forma independiente y aparición al nacer o en la primera infancia que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen TBCK del cromosoma 4q24.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/27040691/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/27040692/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/30103036/</oboInOwl:hasDbXref>
