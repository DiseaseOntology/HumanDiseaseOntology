        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia familiar de HDL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">hipoalfalipoproteinemia familiar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080957</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">hipolipoproteinemia primaria 1</rdfs:label>
    </owl:Class>
