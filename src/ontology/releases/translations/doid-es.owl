    <!-- http://purl.obolibrary.org/obo/DOID_0050159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2797"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una neumonía intersticial idiopática que implica una infiltración intersticial difusa de las zonas implicadas principalmente con linfocitos T, células plasmáticas y macrófagos. Con frecuencia se observa hiperplasia linfoide. El inicio suele ser lento, con un aumento gradual de la tos y la disnea a lo largo de 3 o más años. Ocasionalmente se encuentran fiebre, pérdida de peso, dolor torácico y artralgia. Pueden detectarse crepitaciones a medida que avanza la enfermedad.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C562489</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050159</oboInOwl:id>
        <rdfs:label xml:lang="es">neumonía intersticial linfoidea</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una neumonía intersticial idiopática que implica una infiltración intersticial difusa de las zonas implicadas principalmente con linfocitos T, células plasmáticas y macrófagos. Con frecuencia se observa hiperplasia linfoide. El inicio suele ser lento, con un aumento gradual de la tos y la disnea a lo largo de 3 o más años. Ocasionalmente se encuentran fiebre, pérdida de peso, dolor torácico y artralgia. Pueden detectarse crepitaciones a medida que avanza la enfermedad.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/11790668</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_7427"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
