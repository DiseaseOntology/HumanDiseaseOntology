    <!-- http://purl.obolibrary.org/obo/DOID_4109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4110"/>
        <obo:IAO_0000115 xml:lang="es">La enfermedad infecciosa ectoparasitaria que consiste en la infestación parasitaria de animales y humanos por garrapatas hematófagas de las familias Ixodidae y Argasidae. Las garrapatas son vectores de varias enfermedades, como la enfermedad de Lyme, la fiebre Q, la fiebre por garrapatas de Colorado, la tularemia, la fiebre recurrente transmitida por garrapatas, la babesiosis, la ehrlichiosis y la meningoencefalitis transmitida por garrapatas, así como la anaplasmosis en el ganado y la ictericia canina.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D013984</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0040196</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4109</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">infestación por garrapatas</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4109"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad infecciosa ectoparasitaria que consiste en la infestación parasitaria de animales y humanos por garrapatas hematófagas de las familias Ixodidae y Argasidae. Las garrapatas son vectores de varias enfermedades, como la enfermedad de Lyme, la fiebre Q, la fiebre por garrapatas de Colorado, la tularemia, la fiebre recurrente transmitida por garrapatas, la babesiosis, la ehrlichiosis y la meningoencefalitis transmitida por garrapatas, así como la anaplasmosis en el ganado y la ictericia canina.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Tick</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.dpd.cdc.gov/dpdx/HTML/Ticks.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


