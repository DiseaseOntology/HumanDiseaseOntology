        <oboInOwl:hasDbXref>NCI:C85171</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:2806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:192685000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0038522</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Leucoencefalitis esclerosante de Van Bogaert</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">leucoencefalopatía esclerosante subaguda</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
