        <rdfs:label xml:lang="es">inmunodeficiencia 23</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111953"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A combined T cell and B cells immunodeficiency characterized by marked atopy and autoimmunity caused by increased T(H)2 and T(H)17 cytokine production by CD4(+) T cells, T-cell lymphopenia, reduced memory B-cell numbers, recurrent respiratory and skin infections beginning in early childhood, increased serum IgE, and variable developmental delay or intellectual impairment that has_material_basis_in homozygous or compound heterozygous mutation in the PGM3 gene on chromosome 6q14.1.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/14981714/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/24589341/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


