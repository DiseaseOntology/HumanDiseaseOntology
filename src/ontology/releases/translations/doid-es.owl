        <rdfs:label xml:lang="es">aspergilosis invasiva</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una aspergilosis que es una infección fúngica grave del pulmón con neumonía causada por Aspergillus, que se propaga a otras partes del cuerpo a través del torrente sanguíneo en pacientes con leucemia aguda y receptores de trasplantes de tejidos. Los síntomas clínicos incluyen nódulos pulmonares y hemorragias.</owl:annotatedTarget>
