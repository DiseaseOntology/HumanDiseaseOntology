    <!-- http://purl.obolibrary.org/obo/DOID_0060737 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060737">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3209"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una epidermólisis bullosa juntural caracterizada por la herencia autosómica recesiva de ampollas graves y erosiones extensas, localizadas en la piel y las mucosas, que provoca un retraso del crecimiento y que tiene_como_base mutaciones en 1 cualquiera de los 3 genes que codifican las subunidades de la laminina-5: LAMA3, LAMB3 y LAMC2. El tipo Herlitz es más grave que el tipo relacionado no Herlitz de epidermólisis bullosa juntural.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q81.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:226700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79404</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060737</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">epidermólisis ampollosa de unión tipo Herlitz</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060737"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una epidermólisis bullosa juntural caracterizada por la herencia autosómica recesiva de ampollas graves y erosiones extensas, localizadas en la piel y las mucosas, que provoca un retraso del crecimiento y que tiene_como_base mutaciones en 1 cualquiera de los 3 genes que codifican las subunidades de la laminina-5: LAMA3, LAMB3 y LAMC2. El tipo Herlitz es más grave que el tipo relacionado no Herlitz de epidermólisis bullosa juntural.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/18374450</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/8012393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/8586427</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060738 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060738">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3209"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una epidermólisis bullosa juntural caracterizada por ampollas en la piel y las mucosas, distrofia ungueal o ausencia de uñas e hipoplasia del esmalte y que tiene_como_base una mutación homocigota o heterocigota compuesta en varios genes, entre ellos COL17A1, ITGB4 y los 3 genes que codifican las subunidades de la laminina-5: LAMA3, LAMB3 y LAMC2. El tipo no Herlitz es menos grave que el tipo Herlitz relacionado de epidermólisis bullosa juntural.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q81.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:226650</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79402</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:89840</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">epidermólisis bullosa atrófica generalizada benigna</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060738</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">epidermólisis ampollosa de unión tipo no Herlitz</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060738"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una epidermólisis bullosa juntural caracterizada por ampollas en la piel y las mucosas, distrofia ungueal o ausencia de uñas e hipoplasia del esmalte y que tiene_como_base una mutación homocigota o heterocigota compuesta en varios genes, entre ellos COL17A1, ITGB4 y los 3 genes que codifican las subunidades de la laminina-5: LAMA3, LAMB3 y LAMC2. El tipo no Herlitz es menos grave que el tipo Herlitz relacionado de epidermólisis bullosa juntural.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/10792571</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/11810295</oboInOwl:hasDbXref>
