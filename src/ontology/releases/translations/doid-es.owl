    <!-- http://purl.obolibrary.org/obo/DOID_0060536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_700"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad del metabolismo mitocondrial caracterizada por una amplia gama de manifestaciones que incluyen acidosis láctica marcada y a menudo mortal, cardiomiopatía, leucoencefalopatía, miopatía pura y hepatopatía con tubulopatía. Entre los numerosos fenotipos clínicos observados se encuentran el síndrome de Leigh, la neuropatía óptica hereditaria de Leber y el síndrome MELAS. Puede tener una base material en mutaciones en múltiples genes diferentes, tanto codificados en el núcleo como en la mitocondria.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:3908</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C537475</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:2609</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:237988006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1838979</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada de NADH-CoQ reductasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada de NADH-coenzima Q reductasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada de NADH-ubiquinona reductasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada del complejo I de la cadena respiratoria mitocondrial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060536</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">deficiencia del complejo I mitocondrial</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060536"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad del metabolismo mitocondrial caracterizada por una amplia gama de manifestaciones que incluyen acidosis láctica marcada y a menudo mortal, cardiomiopatía, leucoencefalopatía, miopatía pura y hepatopatía con tubulopatía. Entre los numerosos fenotipos clínicos observados se encuentran el síndrome de Leigh, la neuropatía óptica hereditaria de Leber y el síndrome MELAS. Puede tener una base material en mutaciones en múltiples genes diferentes, tanto codificados en el núcleo como en la mitocondria.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:http://www.omim.org/entry/252010</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060537 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_700"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SO_0001537"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A mitochondrial metabolism disease characterized by a highly variable phenotype. Some patients have multisystem involvement of the brain, heart, muscle, liver, and kidneys resulting in death in infancy, whereas others have only isolated cardiac or muscle involvement with onset in adulthood and normal cognition. It has_material_basis_in homozygous or compound heterozygous mutation in the nuclear-encoded SDHA gene on chromosome 5p, the nuclear-encoded SDHAF1 gene on chromosome 19q, or the nuclear-encoded SDHD gene on chromosome 11q23.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:5053</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G71.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C565375</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:252011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:3208</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada de succinato-CoQ reductasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada de succinato-coenzima Q reductasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada de succinato-ubiquinona reductasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia aislada del complejo II de la cadena respiratoria mitocondrial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060537</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">deficiencia del complejo mitocondrial II</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060537"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A mitochondrial metabolism disease characterized by a highly variable phenotype. Some patients have multisystem involvement of the brain, heart, muscle, liver, and kidneys resulting in death in infancy, whereas others have only isolated cardiac or muscle involvement with onset in adulthood and normal cognition. It has_material_basis_in homozygous or compound heterozygous mutation in the nuclear-encoded SDHA gene on chromosome 5p, the nuclear-encoded SDHAF1 gene on chromosome 19q, or the nuclear-encoded SDHD gene on chromosome 11q23.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/23322652</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060538 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3326"/>
