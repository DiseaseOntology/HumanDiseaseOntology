        <oboInOwl:hasDbXref>url:http://www.springerlink.com/content/c7286n02m8327567/fulltext.pdf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050088 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050088">
        <obo:IAO_0000115 xml:lang="en">A opportunistic mycosis that results_in fungal infection located_in gastrointestinal tract, has_material_basis_in Mucorales molds in immunocompromised patients, results_in_formation_of intra-abdominal abscess and has_symptom abdominal pain, has_symptom distention, has_symptom nausea, and has_symptom vomiting.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050088</oboInOwl:id>
