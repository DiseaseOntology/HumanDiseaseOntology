    <!-- http://purl.obolibrary.org/obo/DOID_0060865 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060863"/>
        <obo:IAO_0000115 xml:lang="es">Una distrofia macular con patrón caracterizada por un patrón de &quot;tierra árida y desértica&quot; del fondo de ojo, que afecta inicialmente al polo posterior y progresa desde la fóvea temporal hasta la periferia de la retina, que se desarrolla en la cuarta o quinta década de la vida y que tiene_como_base una mutación heterocigota en el gen MAPKAPK3 del cromosoma 3p21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617111</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060865</oboInOwl:id>
        <rdfs:label xml:lang="es">distrofia macular con patrón 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060865"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
