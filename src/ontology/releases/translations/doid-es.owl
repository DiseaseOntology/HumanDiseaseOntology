        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">mielopatía asociada a HTLV-1/paraparesia espástica tropical</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_321"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A viral infectious disease that results in inflammation located in spinal cord, has_material_basis_in human T-cell leukemia virus type 1 (Deltaretrovirus priTlym1), which is transmitted by sexual contact, and transmitted by breast feeding. The infection has symptom spastic weakness of both legs, has symptom muscle stiffness, has symptom sensory disturbance, and has symptom spasms.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Tropical_spastic_paraparesis</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.merckmanuals.com/professional/neurologic-disorders/spinal-cord-disorders/htlv-1-associated-myelopathy-tropical-spastic-paraparesis-ham-tsp</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK560825/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ninds.nih.gov/health-information/disorders/htlv-1-associated-myelopathy-hamtropical-spastic-paraparesis-tsp</oboInOwl:hasDbXref>
    </owl:Axiom>
    


