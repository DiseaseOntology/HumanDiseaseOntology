        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:389261002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C2931048</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Condrodistrofia letal autosómica recesiva con hidropsía congénita</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia HEM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia esquelética, tipo Greenberg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Displásia esquelética de Greenberg</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
