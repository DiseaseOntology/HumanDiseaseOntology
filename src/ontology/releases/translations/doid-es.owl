    <!-- http://purl.obolibrary.org/obo/DOID_0080952 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080578"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000930"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por un retraso global del desarrollo con deterioro del desarrollo intelectual, aparición de insuficiencia de la médula ósea y síndrome mielodisplásico en la infancia, y crecimiento general deficiente con estatura baja y que presenta una mutación homocigota o heterocigota compuesta en el gen ADH5 en el cromosoma 4q acompañada de un alelo homocigota o heterocigota específico en el gen ALDH2 (E504K) en el cromosoma 12q24. Los defectos en ambos genes son necesarios para que se manifieste el trastorno, lo que concuerda con la herencia digénica.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:619151</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080952</oboInOwl:id>
        <rdfs:label xml:lang="es">Síndrome AMED</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080952"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que se caracteriza por un retraso global del desarrollo con deterioro del desarrollo intelectual, aparición de insuficiencia de la médula ósea y síndrome mielodisplásico en la infancia, y crecimiento general deficiente con estatura baja y que presenta una mutación homocigota o heterocigota compuesta en el gen ADH5 en el cromosoma 4q acompañada de un alelo homocigota o heterocigota específico en el gen ALDH2 (E504K) en el cromosoma 12q24. Los defectos en ambos genes son necesarios para que se manifieste el trastorno, lo que concuerda con la herencia digénica.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/33355142/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


