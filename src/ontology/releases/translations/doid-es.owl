        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de sordera, distonía y atrofia óptica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de sordera, distonía y neuronopatía óptica</oboInOwl:hasExactSynonym>
