            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000132"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003593"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La enfermedad autoinmune del sistema cardiovascular se caracteriza por el inicio en la infancia de una vasculopatía autoinflamatoria que provoca lesiones cutáneas graves, que afectan especialmente a la cara, las orejas, la nariz y los dedos, y que provocan ulceración, formación de escaras, necrosis y en algunos casos amputación y tiene_base_material_en una mutación heterocigótica de ganancia de función en el gen TMEM173 del cromosoma 5q31.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12357</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:615934</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:425120</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111457</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">vasculopatía asociada a STING con inicio en la infancia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111457"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad autoinmune del sistema cardiovascular se caracteriza por el inicio en la infancia de una vasculopatía autoinflamatoria que provoca lesiones cutáneas graves, que afectan especialmente a la cara, las orejas, la nariz y los dedos, y que provocan ulceración, formación de escaras, necrosis y en algunos casos amputación y tiene_base_material_en una mutación heterocigótica de ganancia de función en el gen TMEM173 del cromosoma 5q31.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/25029335</oboInOwl:hasDbXref>
    </owl:Axiom>
    


