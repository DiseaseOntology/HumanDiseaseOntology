    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A opisthorchiasis that involves parasitic infection of the liver, biliary ducts, pancreas and pancreatic ducts by Opisthorchis felineus. The symptoms include fever, general malaise, skin rash, gastrointestinal disturbances, severe anemia and liver damage.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Opisthorchis_felineus</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13250"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000570"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Diarrea de aparición y curso rápidos caracterizada por deposiciones líquidas o blandas frecuentes. La diarrea aguda es una causa común de muerte en los países en desarrollo y la segunda causa más frecuente de mortalidad infantil en todo el mundo.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050140</oboInOwl:id>
        <rdfs:label xml:lang="es">diarrea aguda</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050140"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Diarrea de aparición y curso rápidos caracterizada por deposiciones líquidas o blandas frecuentes. La diarrea aguda es una causa común de muerte en los países en desarrollo y la segunda causa más frecuente de mortalidad infantil en todo el mundo.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Diarrhea</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050141 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11976"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002451"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El botulismo consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA, B, E y F) en adultos, tiene_como_base el Clostridium botulinum A, tiene_como_base el Clostridium botulinum B, tiene_como_base el Clostridium botulinum E y tiene_como_base el Clostridium botulinum F, que se transmiten por ingestión de esporas bacterianas, que luego crecen en el intestino y liberan toxinas.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050141</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">botulismo intestinal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050141"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El botulismo consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA, B, E y F) en adultos, tiene_como_base el Clostridium botulinum A, tiene_como_base el Clostridium botulinum B, tiene_como_base el Clostridium botulinum E y tiene_como_base el Clostridium botulinum F, que se transmiten por ingestión de esporas bacterianas, que luego crecen en el intestino y liberan toxinas.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:http://www.who.int/mediacentre/factsheets/fs270/en/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://jnnp.bmj.com/content/75/suppl_3/iii35</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050143 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_12205"/>
