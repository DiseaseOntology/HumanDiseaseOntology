    <!-- http://purl.obolibrary.org/obo/DOID_6688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_6688">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2916"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de tipo IV por reacción de hipersensibilidad que es un trastorno hereditario en el que el organismo no puede regular adecuadamente el número de células del sistema inmunitario (linfocitos). Se caracteriza por la producción de un número anormalmente elevado de linfocitos. La acumulación de un exceso de linfocitos provoca el agrandamiento de los ganglios linfáticos el hígado y el bazo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:8686</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:D89.82</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:279.41</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D056735</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:601859</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C37864</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:3261</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:702444009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1328840</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Canale-Smith</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:6688</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Síndrome linfoproliferativo autoinmune</rdfs:label>
        <skos:exactMatch>MESH:D056735</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_6688"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad de tipo IV por reacción de hipersensibilidad que es un trastorno hereditario en el que el organismo no puede regular adecuadamente el número de células del sistema inmunitario (linfocitos). Se caracteriza por la producción de un número anormalmente elevado de linfocitos. La acumulación de un exceso de linfocitos provoca el agrandamiento de los ganglios linfáticos el hígado y el bazo.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://ghr.nlm.nih.gov/condition/autoimmune-lymphoproliferative-syndrome</oboInOwl:hasDbXref>
    </owl:Axiom>
    


