        <oboInOwl:hasDbXref>ORDO:6</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">3-metilcrotonilglicinuria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de 3MCC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de BMCC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050710</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">deficiencia de 3-metilcrotonil-CoA carboxilasa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050710"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un trastorno metabólico de aminoácidos que se clasifica por niveles inadecuados de la enzima 3-metilcrotonil-CoA carboxilasa que ayuda a descomponer las proteínas que contienen el aminoácido leucina. Esta enfermedad tiene_como_síntoma hipotonía muscular (tono muscular débil), tiene_como_síntoma atrofia muscular, tiene_como_síntoma dificultades de alimentación, tiene_como_síntoma episodios recurrentes de vómitos y diarrea, y tiene_como_síntoma letargia.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/3-Methylcrotonyl-CoA_carboxylase_deficiency</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://omim.org/entry/210200</oboInOwl:hasDbXref>
    </owl:Axiom>
    


