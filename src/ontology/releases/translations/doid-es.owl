    <!-- http://purl.obolibrary.org/obo/DOID_0080249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050467"/>
