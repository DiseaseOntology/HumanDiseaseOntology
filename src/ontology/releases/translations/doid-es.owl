    <!-- http://purl.obolibrary.org/obo/DOID_0080058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050950"/>
        <obo:IAO_0000115 xml:lang="es">Una ataxia cerebelosa autosómica recesiva que se caracteriza por retraso en el desarrollo psicomotor, ataxia grave de la marcha de aparición temprana, anomalías en los movimientos oculares, atrofia cerebelosa en las imágenes cerebrales y discapacidad intelectual, la cual presenta una mutación homocigota en el gen SPTBN2 del cromosoma 11q13.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-07T14:55:44Z</oboInOwl:creation_date>
