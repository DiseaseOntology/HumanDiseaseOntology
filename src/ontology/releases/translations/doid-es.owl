        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081329"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad por almacenamiento de glucógeno que se caracteriza por hipoglucemia grave y hepatomegalia causada por la acumulación de glucógeno. Los individuos afectados presentan retraso del crecimiento, retraso de la pubertad, acidemia láctica, hiperlipidemia, hiperuricemia y, en los adultos, una alta incidencia de adenomas hepáticos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Glycogen_storage_disease_type_I</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK1312/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/232200#33</oboInOwl:hasDbXref>
    </owl:Axiom>
    


