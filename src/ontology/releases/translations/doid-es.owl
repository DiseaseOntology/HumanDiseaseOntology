    <!-- http://purl.obolibrary.org/obo/DOID_0070701 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070701">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_870"/>
        <obo:IAO_0000115 xml:lang="en">A neuropathy that solely or predominantly affects small myelinated A-delta (Aδ) fibers and unmyelinated C fibers resulting in sensory changes, autonomic dysfunction, or both. Common symptoms include burning, sharp and/or deep pain, allodynia, hyperalgesia, thermal and pinprick hypoesthesia, dry mouth, dry eyes, constipation, bladder incontinence, orthostatic dizziness, sexual dysfunction, red or white skin discoloration, or trouble sweating.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D000071075</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C125389</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:709489006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C3276706</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070701</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">small fiber neuropathy</rdfs:label>
        <skos:exactMatch>MESH:D000071075</skos:exactMatch>
        <skos:exactMatch>NCI:C125389</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C3276706</skos:exactMatch>
        <skos:narrowMatch>ORDO:306577</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070701"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A neuropathy that solely or predominantly affects small myelinated A-delta (Aδ) fibers and unmyelinated C fibers resulting in sensory changes, autonomic dysfunction, or both. Common symptoms include burning, sharp and/or deep pain, allodynia, hyperalgesia, thermal and pinprick hypoesthesia, dry mouth, dry eyes, constipation, bladder incontinence, orthostatic dizziness, sexual dysfunction, red or white skin discoloration, or trouble sweating.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pmc.ncbi.nlm.nih.gov/articles/PMC12419023/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/books/NBK582147/</oboInOwl:hasDbXref>
