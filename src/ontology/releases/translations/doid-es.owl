        <oboInOwl:hasDbXref>UMLS_CUI:C0268353</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Cutis laxa ligada al cromosoma X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Ehlers-Danlos tipo 9</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Ehlers-Danlos tipo IX</oboInOwl:hasExactSynonym>
