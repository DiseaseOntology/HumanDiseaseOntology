        <oboInOwl:hasDbXref>NCI:C84699</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:17460002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0014848</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">acalasia del cardias</oboInOwl:hasExactSynonym>
