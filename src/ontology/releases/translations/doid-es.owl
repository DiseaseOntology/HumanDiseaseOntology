        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:18504008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0600327</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">shock tóxico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14115</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">síndrome de shock tóxico</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14115"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una enfermedad infecciosa bacteriana comensal que resulta en infección que tiene base material en Streptococcus pyogenes o tiene base material en Staphylococcus aureus, que producen toxinas que se absorben sistémicamente y producen las manifestaciones sistémicas. La infección tiene síntoma de de fiebre, tiene síntoma de erupción cutánea, tiene síntoma de hipotensión, tiene síntomas de fallo multiorgánico, tiene síntoma de descamación, tiene síntoma de vómitos, tiene síntoma de diarrea, tiene síntoma de cefalea y tiene síntoma de anomalías neurológicas no focales.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Toxic_shock_syndrome</oboInOwl:hasDbXref>
