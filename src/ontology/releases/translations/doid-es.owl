                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An autosomal recessive intellectual developmental disorder characterized by mild to moderate global developmental delay, mildly to moderately impaired intellectual development, and progressive spasticity of the lower limbs with hyperreflexia that has_material_basis_in homozygous or compound heterozygous mutations in the RPS6KC1 gene on chromosome 1q32.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:621460</oboInOwl:hasDbXref>
