    <!-- http://purl.obolibrary.org/obo/SYMP_0020056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0020056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000480"/>
        <obo:IAO_0000115>A nervous system symptom that is characterized by a loss of blood flow to part of the brain, which damages brain tissue. Cerebrovascular accidents are caused by blood clots and broken blood vessels in the brain.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>apoplexy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebral accident</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cerebral hemorrhage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0020056</oboInOwl:id>
        <rdfs:label>cerebrovascular accident</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nervous system symptom that is characterized by a loss of blood flow to part of the brain, which damages brain tissue. Cerebrovascular accidents are caused by blood clots and broken blood vessels in the brain.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.healthline.com/health/cerebrovascular-accident</oboInOwl:hasDbXref>
    </owl:Axiom>
    


