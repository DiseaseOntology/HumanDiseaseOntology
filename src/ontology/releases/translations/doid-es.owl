        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Trombocitopenia ligada al cromosoma X con beta-talasemia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
