        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Leishmaniasis que consiste en un proceso inflamatorio crónico que afecta a la mucosa nasal, faríngea y laríngea, que puede provocar una extensa destrucción tisular, causada por parásitos protozoarios pertenecientes al género Leishmania. La infección se caracteriza por lesiones granulomatosas que pueden destruir la mucosa del tracto respiratorio superior.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
