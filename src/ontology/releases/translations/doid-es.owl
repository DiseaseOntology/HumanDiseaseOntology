    <!-- http://purl.obolibrary.org/obo/DOID_6657 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_6657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3459"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000132"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Carcinoma de mama que se caracteriza por células de gran tamaño, forma poligonal, baja relación núcleo-citoplasma, citoplasma eosinofílico finamente granular, nucleolos ocasionalmente prominentes, palidez periférica, mitosis y necrosis, y en el que más del 50% de las células tumorales son positivas para marcadores neuroendocrinos (NSE, cromogranina A, sinaptofisina).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C40356</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1511316</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
