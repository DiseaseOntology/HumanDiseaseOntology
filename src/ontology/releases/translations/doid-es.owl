    <!-- http://purl.obolibrary.org/obo/DOID_0111865 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3146"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Un trastorno del metabolismo lipídico caracterizado por un defecto en la biosíntesis de esteroles que da lugar a rasgos variables que incluyen discapacidad intelectual, baja estatura, escoliosis, anomalías digitales, cataratas y anomalías dermatológicas que tiene su base material en la mutación hemicigótica en EBP en el cromosoma Xp11.23.</obo:IAO_0000115>
