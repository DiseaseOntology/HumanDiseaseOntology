    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050180">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in inflammation located_in brain, has_material_basis_in Colorado tick fever virus which is transmitted_by rocky mountain wood tick, Dermacentor andersoni. The infection has_symptom fever, has_symptom headache, has_symptom nausea, has_symptom stiff neck, has_symptom chills, has_symptom hallucinations, has_symptom disorientation, and has_symptom memory loss.</obo:IAO_0000115>
