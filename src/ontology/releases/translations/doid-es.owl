        <oboInOwl:hasDbXref>UMLS_CUI:C0007947</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Ulcus molle, piel</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
