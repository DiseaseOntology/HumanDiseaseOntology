    <!-- http://purl.obolibrary.org/obo/DOID_0060916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060913"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080578"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000930"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome autoinflamatorio asociado al proteasoma que se caracteriza por dermatitis nodular, fiebre recurrente, miositis, lipodistrofia inducida por paniculitis, linfadenopatía y desregulación de la respuesta inmunitaria, particularmente asociado con un patrón anormal de expresión génica inducida por interferón tipo I con inicio en la primera infancia y que tiene_como_base una mutación homocigota en el gen PSMB4 del cromosoma 1q21 o una mutación heterocigota en el gen PSMB4 y una mutación heterocigota en el gen PSMB9 del cromosoma 6p21.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617591</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060916</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome autoinflamatorio asociado al proteasoma 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060916"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome autoinflamatorio asociado al proteasoma que se caracteriza por dermatitis nodular, fiebre recurrente, miositis, lipodistrofia inducida por paniculitis, linfadenopatía y desregulación de la respuesta inmunitaria, particularmente asociado con un patrón anormal de expresión génica inducida por interferón tipo I con inicio en la primera infancia y que tiene_como_base una mutación homocigota en el gen PSMB4 del cromosoma 1q21 o una mutación heterocigota en el gen PSMB4 y una mutación heterocigota en el gen PSMB9 del cromosoma 6p21.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/26524591/</oboInOwl:hasDbXref>
