    <!-- http://purl.obolibrary.org/obo/DOID_11285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4109"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000032"/>
