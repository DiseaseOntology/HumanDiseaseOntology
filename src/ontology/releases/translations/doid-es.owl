        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:400128006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0406585</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">dermopatía restrictiva infantil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">dermopatía restrictiva letal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de hiperqueratosis-contractura</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060762</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
