    <!-- http://purl.obolibrary.org/obo/DOID_13074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4123"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_8913"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001705"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una dermatofitosis que resulta_en infección por hongos localizada en la uña, tiene base material en hongos Ascomycota que pertenecen a un grupo llamado dermatofitos, que causan separación de la lámina ungueal del lecho ungueal y tiene síntoma de engrosamiento de la zona subungueal. A veces, se observan islas blancas en las placas ungueales externas. Estos se unen gradualmente hasta que toda la placa de la uña se ve afectada.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:10462</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:11399</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:11761</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:12844</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:12845</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:12846</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:12847</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:12848</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:13119</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9412</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9690</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9691</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD9CM:681.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0007644</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Dermatofitosis de la uña</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Onicomicosis por dermatofitos</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Oniquia dermatofítica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">celulitis y absceso de dedo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">celulitis y absceso de la región glútea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">celulitis y absceso de nalga</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">celulitis y absceso de tronco</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">onicomicosis dermatofítica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">celulitis y abscesos</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:13074</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">tiña ungueal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13074"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una dermatofitosis que resulta_en infección por hongos localizada en la uña, tiene base material en hongos Ascomycota que pertenecen a un grupo llamado dermatofitos, que causan separación de la lámina ungueal del lecho ungueal y tiene síntoma de engrosamiento de la zona subungueal. A veces, se observan islas blancas en las placas ungueales externas. Estos se unen gradualmente hasta que toda la placa de la uña se ve afectada.</owl:annotatedTarget>
