        <rdfs:label xml:lang="es">síndrome de Zaki</rdfs:label>
        <skos:exactMatch>MIM:619648</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070473"/>
