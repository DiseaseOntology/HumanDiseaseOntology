    <!-- http://www.w3.org/2004/02/skos/core#broadMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch">
        <obo:IAO_0000115>A skos concept mapping used to state a hierarchical mapping link between two concepts where the DO concept is broad and the xref is narrow (represents subtypes).</obo:IAO_0000115>
        <rdfs:label>has broader match</rdfs:label>
    </owl:AnnotationProperty>
    <owl:Axiom>
