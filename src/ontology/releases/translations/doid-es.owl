        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000600</oboInOwl:id>
        <rdfs:label>apnea</rdfs:label>
    </owl:Class>
