            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_8741"/>
        <obo:IAO_0000115 xml:lang="es">Dermatitis seborreica que consiste en una infección fúngica del cuero cabelludo de los recién nacidos causada por Malassezia furfur. En ocasiones está relacionada con trastornos inmunitarios. Los síntomas incluyen escamas gruesas, costrosas, amarillas o marrones sobre el cuero cabelludo del niño.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:8823</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:L21.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:690.11</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D063807</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:48596006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0221244</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Dermatitis seborreica del cuero cabelludo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Dermatitis seborreica generalizada del lactante</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Dermatitis seborreica infantil</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Disfunción del complemento 5</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">costra láctea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8941</oboInOwl:id>
        <rdfs:label xml:lang="es">dermatitis seborreica infantil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8941"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Dermatitis seborreica que consiste en una infección fúngica del cuero cabelludo de los recién nacidos causada por Malassezia furfur. En ocasiones está relacionada con trastornos inmunitarios. Los síntomas incluyen escamas gruesas, costrosas, amarillas o marrones sobre el cuero cabelludo del niño.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007640"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Cradle_cap</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.nlm.nih.gov/medlineplus/ency/article/000963.htm</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_8943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una distrofia epitelio-estromal TGFBI que se caracteriza por erosiones recurrentes y refractilidad de la línea reticular y opacificación tipo motas que se_ubica_en la córnea, depósitos amiloides que comienzan en el estroma anterior y pérdida progresiva de la visión en etapas posteriores de la vida, y tiene_como_base la herencia autosómica dominante de la mutación del gen inducido por el factor de crecimiento transformador beta localizado en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías provocan un aumento del depósito de proteína amiloide y la alteración de la superficie corneal.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C537935</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:122200</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">neuropatía amiloide familiar de tipo finlandés</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8943</oboInOwl:id>
        <rdfs:label xml:lang="es">distrofia corneal reticular</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_8943"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distrofia epitelio-estromal TGFBI que se caracteriza por erosiones recurrentes y refractilidad de la línea reticular y opacificación tipo motas que se_ubica_en la córnea, depósitos amiloides que comienzan en el estroma anterior y pérdida progresiva de la visión en etapas posteriores de la vida, y tiene_como_base la herencia autosómica dominante de la mutación del gen inducido por el factor de crecimiento transformador beta localizado en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías provocan un aumento del depósito de proteína amiloide y la alteración de la superficie corneal.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:https://webeye.ophth.uiowa.edu/eyeforum/cases/43-corneal-stromal-dystrophies.htm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/122200</oboInOwl:hasDbXref>
    </owl:Axiom>
    


