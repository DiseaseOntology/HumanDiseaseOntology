    <!-- http://purl.obolibrary.org/obo/DOID_0060912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080578"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2340"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000930"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una craneosinostosis caracterizada por la deformidad del cráneo y la incapacidad del crecimiento del cráneo para seguir el ritmo del cerebro en desarrollo que tiene_como_base una mutación heterocigota débilmente penetrante en el gen SMAD6 en el cromosoma 15q22, típicamente con el alelo de riesgo de una variante común cerca del gen BMP2 en el cromosoma 20p12, dando lugar a una elevación potencial de la presión intracraneal.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617439</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060912</oboInOwl:id>
        <rdfs:label xml:lang="es">craneosinostosis 7</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060912"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una craneosinostosis caracterizada por la deformidad del cráneo y la incapacidad del crecimiento del cráneo para seguir el ritmo del cerebro en desarrollo que tiene_como_base una mutación heterocigota débilmente penetrante en el gen SMAD6 en el cromosoma 15q22, típicamente con el alelo de riesgo de una variante común cerca del gen BMP2 en el cromosoma 20p12, dando lugar a una elevación potencial de la presión intracraneal.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/23438589/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0051000"/>
        <obo:IAO_0000115 xml:lang="en">An autoinflammatory disease that is characterized by early onset, dermatitis, dysregulation of the immune response and variable features of recurrent fever, joint contractures, lipodystrophy, hepatosplenomegaly, anemia and calcifications.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:PS256040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:324977</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060913</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome autoinflamatorio asociado al proteosoma</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060913"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An autoinflammatory disease that is characterized by early onset, dermatitis, dysregulation of the immune response and variable features of recurrent fever, joint contractures, lipodystrophy, hepatosplenomegaly, anemia and calcifications.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/25521013/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


