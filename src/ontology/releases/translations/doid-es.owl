    <!-- http://purl.obolibrary.org/obo/DOID_0061306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0061306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0061302"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An oocyte/zygote/embryo maturation arrest that is characterized by phenotypic variability, with some oocytes exhibiting maturation arrest at the germinal vesicle stage and others at the metaphase I stage. In some patients, a few oocytes progress to polar body I; those oocytes either undergo fertilization failure or, in those that are fertilized, early embryonic arrest and that has_material_basis_in homozygous or compound heterozygous mutation in the PATL2 gene on chromosome 15q21.1.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617743</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:488191</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C5567489</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0061306</oboInOwl:id>
        <rdfs:label xml:lang="en">oocyte/zygote/embryo maturation arrest 4</rdfs:label>
        <skos:narrowMatch>ORDO:488191</skos:narrowMatch>
        <skos:narrowMatch>UMLS_CUI:C5567489</skos:narrowMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0061306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An oocyte/zygote/embryo maturation arrest that is characterized by phenotypic variability, with some oocytes exhibiting maturation arrest at the germinal vesicle stage and others at the metaphase I stage. In some patients, a few oocytes progress to polar body I; those oocytes either undergo fertilization failure or, in those that are fertilized, early embryonic arrest and that has_material_basis_in homozygous or compound heterozygous mutation in the PATL2 gene on chromosome 15q21.1.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/28965849/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


