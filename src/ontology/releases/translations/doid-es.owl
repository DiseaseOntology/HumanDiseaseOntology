            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in infection, located_in skin, has_material_basis_in Vaccinia virus (Orthopoxvirus vaccinia), which is used as a live vaccine against smallpox. The virus is transmitted_by contact with the vaccination site before it has healed, or transmitted_by fomites that have been contaminated with live virus from the vaccination site. The infection has_symptom rash, has_symptom fever, and has_symptom body aches.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D014615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:111852003</oboInOwl:hasDbXref>
