        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111682"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La enfermedad renal quística se caracteriza por una displasia quística difusa no sindrómica de los riñones y tiene_base_material_en una mutación heterocigota en el gen BICC1 en la cromosoma 10q21.1. La misma mutación puede encontrarse en padres no afectados, lo que sugiere una penetrancia incompleta del trastorno o que se requieren factores ambientales adicionales para su desarrollo.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://radiopaedia.org/articles/cystic-renal-dysplasia</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/21922595</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/8725780</oboInOwl:hasDbXref>
    </owl:Axiom>
    


