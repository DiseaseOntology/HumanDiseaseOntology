    <!-- http://purl.obolibrary.org/obo/DOID_0060762 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad cutánea caracterizada por una piel fina, adherente y translúcida con erosiones en los puntos de flexión, vasos superficiales, dismorfismo facial típico y anquilosis articular generalizada. Los signos prenatales pueden incluir retraso del crecimiento intrauterino, reducción de los movimientos fetales, polihidramnios y rotura prematura de membranas. La mayoría de los bebés mueren en la primera semana de vida.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:1516</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C536920</oboInOwl:hasDbXref>
