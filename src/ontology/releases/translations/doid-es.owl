    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8915">
        <obo:IAO_0000115 xml:lang="en">A Varicellovirus infectious disease that results_in inflammation located_in meninges, has_material_basis_in Human herpesvirus 3, which reactivates after the primary infection. The infection has_symptom fever, has_symptom headache, has_symptom cervical rigidity, has_symptom seizure, has_symptom ataxia, and has_symptom skin lesions.</obo:IAO_0000115>
