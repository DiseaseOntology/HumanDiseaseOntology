    <!-- http://purl.obolibrary.org/obo/DOID_0060444 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_12318"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una distrofia granular de la córnea que se caracteriza por erosiones recurrentes y opacificación estrellada o en forma de espina que se_ubica_en la córnea, depósitos hialinos y amiloides en el estroma y pérdida progresiva de la visión en etapas posteriores de la vida, y tiene_como_base la herencia autosómica dominante de la mutación del gen inducido por el factor de crecimiento transformante beta en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías conducen a un aumento de la deposición de proteínas hialinas y amiloides y a la alteración de la superficie corneal.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-16T16:44:27Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>MESH:C535474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:607541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:98963</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:397568004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1275685</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia corneal de Avellino</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia corneal granular tipo 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">distrofia corneal tipo Avellino</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060444</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">distrofia corneal granular 2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060444"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distrofia granular de la córnea que se caracteriza por erosiones recurrentes y opacificación estrellada o en forma de espina que se_ubica_en la córnea, depósitos hialinos y amiloides en el estroma y pérdida progresiva de la visión en etapas posteriores de la vida, y tiene_como_base la herencia autosómica dominante de la mutación del gen inducido por el factor de crecimiento transformante beta en el cromosoma 5q31.1, que codifica la queratoepitelina. Las anomalías conducen a un aumento de la deposición de proteínas hialinas y amiloides y a la alteración de la superficie corneal.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:https://webeye.ophth.uiowa.edu/eyeforum/cases/43-corneal-stromal-dystrophies.htm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/607541</oboInOwl:hasDbXref>
    </owl:Axiom>
    


