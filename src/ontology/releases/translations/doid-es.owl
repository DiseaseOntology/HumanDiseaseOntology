    <!-- http://purl.obolibrary.org/obo/DOID_2060 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060109"/>
        <obo:IAO_0000115 xml:lang="es">Neoplasia vulvar benigna que se caracteriza por nódulos con focos quísticos en la parte alta de la dermis en el examen macroscópico y deriva del conducto excretor distal de la glándula sudorípara. Histológicamente se caracteriza por nidos o lobulillos de células que se asemejan al poroma ecrino con citoplasma claro o metaplasia escamosa prominente y lúmenes revestidos por células ductales cuboidales o células secretoras columnares.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>NCI:C40312</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1520091</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2060</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">hidradenoma nodular vulvar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Neoplasia vulvar benigna que se caracteriza por nódulos con focos quísticos en la parte alta de la dermis en el examen macroscópico y deriva del conducto excretor distal de la glándula sudorípara. Histológicamente se caracteriza por nidos o lobulillos de células que se asemejan al poroma ecrino con citoplasma claro o metaplasia escamosa prominente y lúmenes revestidos por células ductales cuboidales o células secretoras columnares.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:http://www.pathologyoutlines.com/topic/skintumornonmelanocyticeccrineacrospiroma.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


