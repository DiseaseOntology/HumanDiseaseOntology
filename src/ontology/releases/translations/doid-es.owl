            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in infection located_in skin, has_material_basis_in Orf virus (Parapoxvirus orf), which is transmitted_by contact with infected or recently vaccinated animals, or transmitted_by fomites carrying the virus. The infection has_symptom lesions on the finger, hand, arm, face, and penis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B08.02</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:051.2</oboInOwl:hasDbXref>
