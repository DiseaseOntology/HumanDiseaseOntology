    <!-- http://purl.obolibrary.org/obo/DOID_0110122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0110122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_14686"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004019"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SO_0001537"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">An Axenfeld-Rieger characterized by an anteriorly displaced Schwalbe line, the presence of another ocular anomaly (hypoplasia of iris stroma, corectopia, or iridocorneal adhesions), and nonocular anomalies including maxillary hypoplasia, hypodontia, microdontia, protuberant periumbilical skin, sensorineural hearing loss, and congenital cardiac or renal anomalies syndrome that has_material_basis_in heterozygous mutation in the FOXC1 gene on chromosome 6p25.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q13.8</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:602482</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Rieger tipo 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0110122</oboInOwl:id>
        <rdfs:label xml:lang="es">Síndrome de Axenfeld-Rieger tipo 3</rdfs:label>
    </owl:Class>
