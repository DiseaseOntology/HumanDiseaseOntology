    <!-- http://purl.obolibrary.org/obo/DOID_3209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2730"/>
        <obo:IAO_0000115 xml:lang="es">Una epidermólisis bullosa que se caracteriza por ampollas recurrentes localizadas en la lámina lúcida de la membrana basal secundarias a traumatismos menores, que pueden causar heridas limitadas, deshidratación, anomalías electrolíticas, infección grave, entre otros problemas, y que tiene_como_base una mutación en genes relacionados con la laminina 332, que refuerza la piel.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:2152</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D016109</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C90598</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:76905008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0079301</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3209</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">epidermólisis bullosa juntural</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una epidermólisis bullosa que se caracteriza por ampollas recurrentes localizadas en la lámina lúcida de la membrana basal secundarias a traumatismos menores, que pueden causar heridas limitadas, deshidratación, anomalías electrolíticas, infección grave, entre otros problemas, y que tiene_como_base una mutación en genes relacionados con la laminina 332, que refuerza la piel.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
