    <!-- http://purl.obolibrary.org/obo/DOID_4336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4337"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_4890"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002200"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0100699"/>
