    <!-- http://purl.obolibrary.org/obo/DOID_9563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1176"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad bronquial que es una afección inflamatoria crónica de uno o más bronquios o bronquiolos caracterizada por la dilatación y la pérdida de elasticidad de las paredes como consecuencia de daños en la pared de las vías respiratorias que conducen a la formación de pequeños sacos en la pared bronquial y al deterioro de la movilidad de los cilios en el pulmón. La inflamación de la pared bronquial aumenta la secreción de moco, que sirve de caldo de cultivo para las bacterias. Las bronquiectasias están causadas por infecciones respiratorias repetidas, trastornos por inmunodeficiencia, trastornos hereditarios (fibrosis quística o discinesia ciliar primaria), factores mecánicos (objeto inhalado o un tumor pulmonar) o la inhalación de sustancias tóxicas.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:11046</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:11047</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9571</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J47</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:494</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D001987</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS211400</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84475</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:60033</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155580000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0006267</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Bronquiectasia polinesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9563</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">bronquiectasia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9563"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad bronquial que es una afección inflamatoria crónica de uno o más bronquios o bronquiolos caracterizada por la dilatación y la pérdida de elasticidad de las paredes como consecuencia de daños en la pared de las vías respiratorias que conducen a la formación de pequeños sacos en la pared bronquial y al deterioro de la movilidad de los cilios en el pulmón. La inflamación de la pared bronquial aumenta la secreción de moco, que sirve de caldo de cultivo para las bacterias. Las bronquiectasias están causadas por infecciones respiratorias repetidas, trastornos por inmunodeficiencia, trastornos hereditarios (fibrosis quística o discinesia ciliar primaria), factores mecánicos (objeto inhalado o un tumor pulmonar) o la inhalación de sustancias tóxicas.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
        <oboInOwl:hasDbXref>url:http://www.merck.com/mmhe/sec04/ch047/ch047a.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.merriam-webster.com/dictionary/bronchiectasis#medicalDictionary</oboInOwl:hasDbXref>
    </owl:Axiom>
    


