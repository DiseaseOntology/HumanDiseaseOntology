        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una epidermólisis ampollosa simple caracterizada por ampollas cutáneas que se originan en las zonas más profundas del citoplasma de las células basales, justo por encima de los hemidesmosomas, hematomas cutáneos y que tiene_como_base una mutación heterocigota en el gen PLEC1 del cromosoma 8q24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q81.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:131950</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79401</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060736</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">epidermolysis bullosa simplex 5A Ogna type</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060736"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una epidermólisis ampollosa simple caracterizada por ampollas cutáneas que se originan en las zonas más profundas del citoplasma de las células basales, justo por encima de los hemidesmosomas, hematomas cutáneos y que tiene_como_base una mutación heterocigota en el gen PLEC1 del cromosoma 8q24.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
