        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099"/>
        <obo:IAO_0000115>A pain that is characterized by a leg pain in the calf, or thigh, which is caused by inadequate blood flow to the leg muscles and is brought on by leg exercise such as walking.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>blockage of leg arteries</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000424</oboInOwl:id>
        <rdfs:label>claudication</rdfs:label>
    </owl:Class>
    <owl:Axiom>
