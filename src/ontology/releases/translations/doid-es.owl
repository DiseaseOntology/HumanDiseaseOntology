        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:16140007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0001247</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
