    <!-- http://purl.obolibrary.org/obo/DOID_2217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1247"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A blood coagulation disease characterized by autosomal recessive inheritance of mucosal bleeding, purpuric skin bleeding, epistaxis, and menorrhagia with prolonged bleeding times, enlarged platelets and absence of platelet aggregation in response to von Willebrand factor that has_material_basis_in mutation in the GP1BA gene, the GP1BB gene, or the GP9 gene which are subunits of the platelet membrane von Willebrand factor receptor complex, glycoprotein Ib. The forms of BSS caused by homozygous or compound heterozygous mutation in these genes are here referred to as types A1, B, and C, respectively.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D001606</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:231200</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84595</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:274</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:54569005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0005129</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de Bernard Soulier</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de plaquetas gigantes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Trombocitopenia distrófica hemorrágica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Trombopatía de Bernard-Soulier</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Trombopatía, Bernard-Soulier</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2217</oboInOwl:id>
