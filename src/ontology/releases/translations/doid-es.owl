        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Hiperfenilalaninemia por deficiencia de tetrahidrobiopterina (BH4)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081132"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Trastorno metabólico de aminoácidos que se caracteriza fenotípicamente por hiperfenilalaninemia, depleción de los neurotransmisores dopamina y serotonina, y déficits cognitivos y motores progresivos, y que presenta mutaciones autosómicas recesivas en los genes que codifican enzimas implicadas en la síntesis o regeneración de BH4.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://medlineplus.gov/genetics/condition/tetrahydrobiopterin-deficiency/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/11388593/</oboInOwl:hasDbXref>
