    <!-- http://purl.obolibrary.org/obo/DOID_0060345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11102"/>
        <obo:IAO_0000115 xml:lang="es">Una bartonelosis que tiene_como_base la Bartonella henselae o tiene_como_base la Bartonella quintana. La enfermedad se caracteriza por la proliferación de vasos sanguíneos, lo que hace que formen masas similares a tumores en la piel y otros órganos.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-05-28T16:26:12Z</oboInOwl:creation_date>
