    <!-- http://purl.obolibrary.org/obo/DOID_0060347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome caracterizado por defectos de las extremidades, generalmente bilaterales, como manos o pies hendidos y defectos longitudinales que afectan al radio o el cúbito, la tibia o el peroné y anomalías renales que incluyen agenesia, hipoplasia y, raramente, riñones poliquísticos. Otras malformaciones pueden afectar a la región oromandibular, la tráquea y los pulmones, los derivados de la piel, incluyendo las glándulas sudoríparas, las glándulas mamarias, el útero, los conductos deferentes, las placodas nasales y los ojos.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-06-04T14:51:42Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>MESH:C563159</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:102520</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:201310</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:720458005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C3495490</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060347</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome acrorrenal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome caracterizado por defectos de las extremidades, generalmente bilaterales, como manos o pies hendidos y defectos longitudinales que afectan al radio o el cúbito, la tibia o el peroné y anomalías renales que incluyen agenesia, hipoplasia y, raramente, riñones poliquísticos. Otras malformaciones pueden afectar a la región oromandibular, la tráquea y los pulmones, los derivados de la piel, incluyendo las glándulas sudoríparas, las glándulas mamarias, el útero, los conductos deferentes, las placodas nasales y los ojos.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/26019842</oboInOwl:hasDbXref>
    </owl:Axiom>
    


