                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002240"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results in inflammation located in spinal cord, has_material_basis_in human T-cell leukemia virus type 1 (Deltaretrovirus priTlym1), which is transmitted by sexual contact, and transmitted by breast feeding. The infection has symptom spastic weakness of both legs, has symptom muscle stiffness, has symptom sensory disturbance, and has symptom spasms.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:G04.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D015493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:159580</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C179058</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:45129002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0030481</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Mielopatía asociada al HTLV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Paraplejia espástica tropical</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Parálisis espástica tropical</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
