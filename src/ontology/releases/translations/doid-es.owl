    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2907">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome que se caracteriza por un desarrollo incompleto de la oreja, la nariz, el paladar blando, el labio y la mandíbula. Se asocia a un desarrollo anómalo del primer arco branquial y del segundo arco branquial.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:6540</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:Q87.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D006053</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:164210</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84740</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:374</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:46567003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0265240</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Disostosis otomandibular</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Displasia oculoauriculovertebral (OAV)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Espectro facio-aurículo-vertebral</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome del primer Y segundo arco branquial</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome del primer arco</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2907</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">síndrome de Goldenhar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_2907"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que se caracteriza por un desarrollo incompleto de la oreja, la nariz, el paladar blando, el labio y la mandíbula. Se asocia a un desarrollo anómalo del primer arco branquial y del segundo arco branquial.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Goldenhar_syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.healthline.com/galecontent/goldenhar-syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.faces-cranio.org/goldenhar</oboInOwl:hasDbXref>
    </owl:Axiom>
    


