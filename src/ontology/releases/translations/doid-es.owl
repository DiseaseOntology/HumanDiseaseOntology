    <!-- http://purl.obolibrary.org/obo/DOID_0111253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_8712"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una neurofibromatosis caracterizada por múltiples máculas café con leche, pecas en los pliegues cutáneos, neurofibromas, gliomas ópticos, nódulos de Lisch o anomalías coroideas en el ojo, o una anomalía ósea específica que tiene_como_base el gen NF1 del cromosoma 17q11.2. Las anomalías óseas incluyen una lesión ósea distintiva como la displasia del esfenoides, el arqueamiento anterolateral de la tibia o la pseudoartrosis de un hueso largo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q85.01</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:237.71</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D009456</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:162200</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3273</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:92824003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0027831</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de von Recklinghausen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurofibromatosis de Recklinghausen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Neurofibromatosis periférica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">neurofibromatosis tipo I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
