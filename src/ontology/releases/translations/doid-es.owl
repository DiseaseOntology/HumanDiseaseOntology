        <oboInOwl:hasDbXref>UMLS_CUI:C0030759</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infestación por Phthirus pubis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Pediculosis Pubis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Phthirus pubis</oboInOwl:hasExactSynonym>
