        <rdfs:label xml:lang="en">Charcot-Marie-tooth disease type 1I</rdfs:label>
        <skos:exactMatch>MIM:619742</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C5676914</skos:exactMatch>
    </owl:Class>
