    <!-- http://purl.obolibrary.org/obo/DOID_0070798 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_231"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A motor neuron disease characterized by acute onset of progressive muscle weakness and axonal sensorimotor neuropathy following an infection or febrile episode in infancy or early childhood that has_material_basis_in homozygous or compound heterozygous mutation in the RCC1 gene on chromosome 1p35. Affected individuals may have progressive cerebral and cerebellar atrophy and may have recurrent episodes resulting in loss of ambulation, long-term ventilatory support, or early death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:621333</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C6065907</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070798</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">infection-induced acute-onset axonal neuropathy</rdfs:label>
        <skos:exactMatch>MIM:621333</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C6065907</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0070798"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A motor neuron disease characterized by acute onset of progressive muscle weakness and axonal sensorimotor neuropathy following an infection or febrile episode in infancy or early childhood that has_material_basis_in homozygous or compound heterozygous mutation in the RCC1 gene on chromosome 1p35. Affected individuals may have progressive cerebral and cerebellar atrophy and may have recurrent episodes resulting in loss of ambulation, long-term ventilatory support, or early death.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/40683276/</oboInOwl:hasDbXref>
