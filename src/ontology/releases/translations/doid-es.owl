        <rdfs:label>has narrower match</rdfs:label>
    </owl:AnnotationProperty>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.w3.org/2004/02/skos/core#narrowMatch"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
