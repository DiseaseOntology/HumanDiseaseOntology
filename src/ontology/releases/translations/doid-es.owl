        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_5425"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad ovárica que se caracteriza por el agrandamiento quístico de los ovarios y un desplazamiento de líquido desde el espacio intravascular al tercero y tiene síntoma dolor abdominal, tiene síntoma de náuseas y tiene síntoma vómitos. Esta enfermedad es una complicación iatrogénica de la tecnología de reproducción asistida.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3205536/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


