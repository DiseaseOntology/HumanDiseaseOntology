        <oboInOwl:hasDbXref>UMLS_CUI:C0018081</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad infecciosa gonocócica crónica del tracto genitourinario inferior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad infecciosa gonocócica crónica del tracto genitourinario superior</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
