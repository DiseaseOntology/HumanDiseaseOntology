    <!-- http://purl.obolibrary.org/obo/DOID_9283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1686"/>
        <obo:IAO_0000115 xml:lang="es">Glaucoma caracterizado por rasgos clínicos y factores de riesgo que se asocian con una alta probabilidad de desarrollar atrofia óptica secundaria a glaucoma en el futuro. Estas características pueden incluir presión intraocular elevada, anomalías de la capa de fibras nerviosas de la retina, ángulos anormales de la cámara anterior y/o antecedentes familiares positivos de glaucoma sin evidencia de atrofia actual del nervio óptico.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H40.00</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:365.00</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:359633007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0549470</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Preglaucoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9283</oboInOwl:id>
        <rdfs:label xml:lang="es">glaucoma límite</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Glaucoma caracterizado por rasgos clínicos y factores de riesgo que se asocian con una alta probabilidad de desarrollar atrofia óptica secundaria a glaucoma en el futuro. Estas características pueden incluir presión intraocular elevada, anomalías de la capa de fibras nerviosas de la retina, ángulos anormales de la cámara anterior y/o antecedentes familiares positivos de glaucoma sin evidencia de atrofia actual del nervio óptico.</owl:annotatedTarget>
