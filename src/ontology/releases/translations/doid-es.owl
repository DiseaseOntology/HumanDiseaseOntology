            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una enfermedad infecciosa bacteriana primaria que resulta_en una infección, tiene_como_base la Neorickettsia sennetsu, que se_transmite_por ingestión de salmonetes crudos o poco cocinados infectados con los trematodos. La infección tiene_como_síntoma fiebre, tiene_como_síntoma malestar, tiene_como_síntoma anorexia, tiene_como_síntoma linfadenopatía, tiene_como_síntoma hepatoesplenomegalia, tiene_como_síntoma fatiga, tiene_como_síntoma escalofríos, tiene_como_síntoma dolor de cabeza, tiene_como_síntoma dolor de espalda y tiene_como_síntoma mialgia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:120</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C537582</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">erliquiosis de Sennetsu</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050485</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-negative_bacterial_infectious_disease"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">fiebre sennetsu</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050485"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una enfermedad infecciosa bacteriana primaria que resulta_en una infección, tiene_como_base la Neorickettsia sennetsu, que se_transmite_por ingestión de salmonetes crudos o poco cocinados infectados con los trematodos. La infección tiene_como_síntoma fiebre, tiene_como_síntoma malestar, tiene_como_síntoma anorexia, tiene_como_síntoma linfadenopatía, tiene_como_síntoma hepatoesplenomegalia, tiene_como_síntoma fatiga, tiene_como_síntoma escalofríos, tiene_como_síntoma dolor de cabeza, tiene_como_síntoma dolor de espalda y tiene_como_síntoma mialgia.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://rarediseases.org/rare-diseases/sennetsu-fever/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


