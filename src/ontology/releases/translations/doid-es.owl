    <!-- http://purl.obolibrary.org/obo/DOID_3488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_65"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002384"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad cutánea en la que se produce una infección difusa del tejido conjuntivo con inflamación grave de las capas dérmica y subcutánea de la piel. La celulitis puede estar causada por la flora cutánea normal o por bacterias exógenas, y suele producirse en lugares donde la piel se ha roto previamente: grietas en la piel, cortes, ampollas, quemaduras, picaduras de insectos, heridas quirúrgicas o lugares de inserción de catéteres intravenosos.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:2472</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:L03.90</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002481</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C26715</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34454</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:267833003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:74276003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0007642</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0007646</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3488</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">celulitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3488"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad cutánea en la que se produce una infección difusa del tejido conjuntivo con inflamación grave de las capas dérmica y subcutánea de la piel. La celulitis puede estar causada por la flora cutánea normal o por bacterias exógenas, y suele producirse en lugares donde la piel se ha roto previamente: grietas en la piel, cortes, ampollas, quemaduras, picaduras de insectos, heridas quirúrgicas o lugares de inserción de catéteres intravenosos.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
