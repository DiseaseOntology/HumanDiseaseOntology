    <!-- http://purl.obolibrary.org/obo/DOID_14421 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14421">
        <obo:IAO_0000115 xml:lang="en">A filarial elephantiasis that involves parasitic infection by the nematode Brugia malayi, which inhabits the lymphatics. The symptoms include fever, lymphadenitis, lymphangitis, lymphedema, and secondary bacterial infection.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14421</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete Brugia malayi filariasis</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_14422 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1080"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5614"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000014"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000970"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000132"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Filariasis zoonótica causada por el nematodo del género Dipetalonema, que los mosquitos transmiten accidentalmente a los humanos desde puercoespines, castores y otros mamíferos. Los gusanos adultos viven por vía subcutánea o en cavidades corporales o en los ojos de los humanos. Los gusanos muertos provocan necrosis por hipersensibilidad con eosinófilos, seguida de reacción granulomatosa y fibrosis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9CM:125.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004154</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34540</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:15629006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0012517</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Dipetalonema</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Dipetalonema perstans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">dipetalonema enfermedad infecciosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14422</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="en">dipetalonemiasis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14422"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Filariasis zoonótica causada por el nematodo del género Dipetalonema, que los mosquitos transmiten accidentalmente a los humanos desde puercoespines, castores y otros mamíferos. Los gusanos adultos viven por vía subcutánea o en cavidades corporales o en los ojos de los humanos. Los gusanos muertos provocan necrosis por hipersensibilidad con eosinófilos, seguida de reacción granulomatosa y fibrosis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007646"/>
