            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A combined T cell and B cell immunodeficiency characterized by hypo- or agammaglobulinemia, normal lymphocyte counts, intermittent neutropenia, intermittent thrombocytopenia, decreased numbers of memory B cells, impaired immunoglobulin class-switching, and decreased proliferative responses of T cells that has_material_basis_in homozygous or compound heterozygous mutation in the TFRC gene on chromosome 3q29.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:616740</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:476113</oboInOwl:hasDbXref>
