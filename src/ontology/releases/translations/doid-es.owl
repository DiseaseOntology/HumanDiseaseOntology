        <obo:IAO_0000115 xml:lang="en">A dengue disease that occurs when a person experiences a second infection with a heterologous Dengue virus (Orthoflavivirus denguei) serotype, which is transmitted_by Aedes mosquito bite. The infection has_symptom hemorrhagic lesions of the skin, has_symptom thrombocytopenia, has_symptom reduction in the fluid part of the blood, and has_symptom high fever. Four distinct Dengue virus serotypes have been identified.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:A91</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D019595</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34683</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:20927009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0019100</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="es">Fiebre hemorrágica del dengue</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:12206</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">fiebre hemorrágica del dengue</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A dengue disease that occurs when a person experiences a second infection with a heterologous Dengue virus (Orthoflavivirus denguei) serotype, which is transmitted_by Aedes mosquito bite. The infection has_symptom hemorrhagic lesions of the skin, has_symptom thrombocytopenia, has_symptom reduction in the fluid part of the blood, and has_symptom high fever. Four distinct Dengue virus serotypes have been identified.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007640"/>
