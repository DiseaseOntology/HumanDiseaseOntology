            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A spondylometaphyseal dysplasia characterized by neonatal lethality, severe metaphyseal chondrodysplasia with mild limb shortening, platyspondyly, delayed epiphyseal ossification, irregular iliac crests, pulmonary hemorrhage, severe hypotonia and cardiorespiratory problems that has_material_basis_in homozygous or compound heterozygous mutation in the GPX4 gene on chromosome 19p13.3.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:4993</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C535798</oboInOwl:hasDbXref>
