        <oboInOwl:hasExactSynonym xml:lang="es">Atrofia glaucomatosa [ahuecamiento] del disco óptico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10337</oboInOwl:id>
