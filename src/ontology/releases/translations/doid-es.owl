        <oboInOwl:hasRelatedSynonym xml:lang="es">Fiebre de Gibraltar</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="es">Fiebre de Malta</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym xml:lang="es">Fiebre mediterránea</oboInOwl:hasRelatedSynonym>
