        <oboInOwl:hasExactSynonym xml:lang="es">síndrome lácrimo-auriculo-dento-digital 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050331</oboInOwl:id>
        <rdfs:label xml:lang="es">síndrome lacrimoauriculodentodigital 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome que tiene_como_base una mutación heterocigota en el dominio tirosina quinasa del gen FGFR2 en el cromosoma 10q26 y que se caracteriza por la herencia autosómica dominante de anomalías que afectan a las glándulas y conductos lagrimales y salivales, las orejas, los dientes y los dedos de manos y pies.</owl:annotatedTarget>
