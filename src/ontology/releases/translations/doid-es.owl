    <!-- http://purl.obolibrary.org/obo/DOID_850 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_850">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DOID_4"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002048"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050161"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de las vías respiratorias inferiores en la que la función de los pulmones se ve afectada negativamente por el estrechamiento o la obstrucción de las vías respiratorias, lo que provoca un flujo de aire deficiente, una pérdida de elasticidad en los pulmones que produce una disminución del volumen total de aire que los pulmones son capaces de retener, y la coagulación, cicatrización o inflamación de los vasos sanguíneos que afectan a la capacidad de los pulmones para captar oxígeno y liberar dióxido de carbono.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:11894</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:11895</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:29</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:766</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:J98.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008171</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3198</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266374002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0024115</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:850</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_RAD_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">enfermedad pulmonar</rdfs:label>
    </owl:Class>
