        <oboInOwl:hasExactSynonym xml:lang="es">IDDM-síndrome de diarrea secretora</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome de desregulación autoinmunitaria-alérgica ligado al cromosoma X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">diabetes mellitus congénita insulinodependiente con diarrea secretora mortal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de autoinmunidad-inmunodeficiencia ligado al cromosoma X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0090110</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de desregulación inmunitaria-polielendocrinopatía-enteropatía ligada al X</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0090110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad autoinmunitaria que se caracteriza por la aparición en la infancia de diarrea refractaria, endocrinopatías, diabetes mellitus de tipo 1 y dermatitis que presenta material base en mutación recesiva ligada al X en el gen caja de horquilla P3 (FOXP3) del cromosoma Xp11.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/immune-dysregulation-polyendocrinopathy-enteropathy-x-linked-syndrome</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/304790</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0090111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A syndrome that is characterized by the association of the features of Waardenburg-Shah syndrome (sensorineural hearing loss, pigmentary abnormalities and Hirschsprung disease; see this term) with neurological features, including: neonatal hypotonia, intellectual deficit (of variable severity), nystagmus, progressive spasticity, ataxia and epilepsy, and has_material_basis_in heterozygous mutation in the SRY-box 10 (SOX10) gene on chromosome 22q13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:E75.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:609136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:163746</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Síndrome neurológico de Waardenburg-Shah</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0090111</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome PCWH</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0090111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A syndrome that is characterized by the association of the features of Waardenburg-Shah syndrome (sensorineural hearing loss, pigmentary abnormalities and Hirschsprung disease; see this term) with neurological features, including: neonatal hypotonia, intellectual deficit (of variable severity), nystagmus, progressive spasticity, ataxia and epilepsy, and has_material_basis_in heterozygous mutation in the SRY-box 10 (SOX10) gene on chromosome 22q13.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/gene/SOX10#conditions</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/609136</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0090112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0090112">
