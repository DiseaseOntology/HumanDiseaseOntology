        <oboInOwl:hasDbXref>UMLS_CUI:C0936215</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome carencial de vitamina B6</oboInOwl:hasExactSynonym>
