        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A inner ear infectious disease caused by a viral infection which involves inflammation of the vestibular nerve. It usually results as a complication of an upper respiratory infection. This causes sudden and severe vertigo, nausea and vomiting. Auditory symptoms are usually absent.</owl:annotatedTarget>
