        <oboInOwl:hasDbXref>ORDO:294963</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:205820002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0265259</oboInOwl:hasDbXref>
