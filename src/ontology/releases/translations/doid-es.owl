        <oboInOwl:hasDbXref>ORDO:340</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:186701001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0019101</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">fiebre hemorrágica rusa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">nefropatía por virus Puumala</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">nefrosonefritis hemorrágica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
