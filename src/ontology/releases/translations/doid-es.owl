    <!-- http://purl.obolibrary.org/obo/DOID_0050278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050135"/>
        <obo:IAO_0000115 xml:lang="es">Micosis subcutánea que consiste en una infección fúngica inflamatoria o granulomatosa crónica del tejido subcutáneo de las extremidades, el tórax, la espalda o las nalgas causada por Basidiobolus ranarum. Las lesiones aparecen como nódulos subcutáneos que se convierten en hinchazones masivas, firmes, induradas, indoloras, que se mueven libremente sobre el músculo subyacente, pero están adheridas a la piel, que puede hiperpigmentarse pero no ulcerarse.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050278</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">basidiobolomicosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050278"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Micosis subcutánea que consiste en una infección fúngica inflamatoria o granulomatosa crónica del tejido subcutáneo de las extremidades, el tórax, la espalda o las nalgas causada por Basidiobolus ranarum. Las lesiones aparecen como nódulos subcutáneos que se convierten en hinchazones masivas, firmes, induradas, indoloras, que se mueven libremente sobre el músculo subyacente, pero están adheridas a la piel, que puede hiperpigmentarse pero no ulcerarse.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Basidiobolomycosis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050279 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050135"/>
        <obo:IAO_0000115 xml:lang="es">Micosis subcutánea que es una infección fúngica inflamatoria o granulomatosa crónica causada por especies de Conidiobolus, que se limita a la submucosa nasal y se caracteriza por pólipos o masas subcutáneas restringidas palpables. Los síntomas incluyen obstrucción nasal, supuración y dolor sinusal. Se desarrollan nódulos subcutáneos en las regiones nasal y perinasal.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050279</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <rdfs:label xml:lang="es">conidiobolomicosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050279"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Micosis subcutánea que es una infección fúngica inflamatoria o granulomatosa crónica causada por especies de Conidiobolus, que se limita a la submucosa nasal y se caracteriza por pólipos o masas subcutáneas restringidas palpables. Los síntomas incluyen obstrucción nasal, supuración y dolor sinusal. Se desarrollan nódulos subcutáneos en las regiones nasal y perinasal.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Conidiobolomycosis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050280 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050280">
