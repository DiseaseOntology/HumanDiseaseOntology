    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14311">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in inflammation located_in stomach and located_in intestine, has_material_basis_in Norovirus, which is transmitted_by ingestion of contaminated food or water, or transmitted_by fomites. The infection has_symptom vomiting, has_symptom watery diarrhea, has_symptom abdominal cramps, has_symptom nausea, and has_symptom fever.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:11749</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:2330</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14311</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete Norovirus gastroenteritis</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
