    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3532">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in infection in ruminants, has_material_basis_in Peste-des-petits-ruminants virus, which is transmitted_by contact with oronasal and ocular secretions, urine, and feces. The infection results_in_formation_of lesions on the gums, lips and palate.</obo:IAO_0000115>
