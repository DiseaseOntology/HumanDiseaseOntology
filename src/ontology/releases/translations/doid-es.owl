        <oboInOwl:hasDbXref>NCI:C34970</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266205000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0034362</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Coxiella burnetii</oboInOwl:hasExactSynonym>
