        <oboInOwl:hasDbXref>UMLS_CUI:C0268647</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">aminoaciduria dibásica II</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">aminoaciduria hiperdibásica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060439</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">intolerancia a las proteínas lisinúricas</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060439"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Trastorno metabólico de los aminoácidos caracterizado por la incapacidad del organismo para descomponer eficazmente la lisina, la arginina y la ornitina y por una hiperdiaminoaciduria renal, especialmente lisinuria, y por una formación alterada de urea con hiperamonemia después de la ingestión de proteínas que tiene_como_base una mutación homocigota o heterocigota compuesta en el gen transportador de aminoácidos SLC7A7 en el cromosoma 14q11.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007646"/>
        <oboInOwl:hasDbXref>url:http://ghr.nlm.nih.gov/condition/lysinuric-protein-intolerance</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:http://www.ncbi.nlm.nih.gov/books/NBK1361/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Lysinuric_protein_intolerance</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/1155480</oboInOwl:hasDbXref>
    </owl:Axiom>
    


