    <!-- http://purl.obolibrary.org/obo/DOID_0050139 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050139">
        <obo:IAO_0000115 xml:lang="en">A opisthorchiasis that involves parasitic infection of the liver, biliary ducts, pancreas and pancreatic ducts by Opisthorchis felineus. The symptoms include fever, general malaise, skin rash, gastrointestinal disturbances, severe anemia and liver damage.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050139</oboInOwl:id>
        <rdfs:label xml:lang="en">obsolete Opisthorchis felineus infectious disease</rdfs:label>
