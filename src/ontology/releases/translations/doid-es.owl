    <!-- http://purl.obolibrary.org/obo/DOID_11302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1395"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004026"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000014"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La esquistosomiasis que es una respuesta inflamatoria cutánea de corta duración asociada a la penetración en la piel de las cercarias del esquistosoma aviar, Austrobilharzia variglandis. La enfermedad tiene como síntoma el enrojecimiento de la piel, picor de la piel en el agua o inmediatamente después de emerger y también tiene como síntoma el picor y pápulas elevadas que se producen a las pocas horas de la infección.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9747</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B65.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:120.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:187115002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0546996</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Esquistosomiasis cutánea</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11302</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">dermatitis cercarial</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11302"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La esquistosomiasis que es una respuesta inflamatoria cutánea de corta duración asociada a la penetración en la piel de las cercarias del esquistosoma aviar, Austrobilharzia variglandis. La enfermedad tiene como síntoma el enrojecimiento de la piel, picor de la piel en el agua o inmediatamente después de emerger y también tiene como síntoma el picor y pápulas elevadas que se producen a las pocas horas de la infección.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
