        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060388"/>
        <obo:IAO_0000115 xml:lang="es">Síndrome de deleción cromosómica caracterizado por trigonocefalia, occipucio aplanado hipoplasia del tercio medio facial, filtrum largo, frente prominente, puente nasal ancho y plano, narinas antevertidas, orejas externas malformadas, hipertelorismo, hipertonía, retraso del desarrollo psicomotor y que tiene_como_base una deleción génica contigua en el brazo corto del cromosoma 9.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q93.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C538024</oboInOwl:hasDbXref>
