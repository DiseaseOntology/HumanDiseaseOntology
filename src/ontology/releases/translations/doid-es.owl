    <!-- http://purl.obolibrary.org/obo/DOID_0081022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050795"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una distrofia de conos que se caracteriza por la aparición en la primera o segunda década de la vida de fotofobia muy marcada, miopía, visión reducida de los colores a lo largo del eje rojo-verde con discriminación tritana relativamente conservada, y escotomata central con pérdida de sensibilidad generalizada periférica predominante en el campo visual superior y que presenta una mutación homocigota o heterocigota compuesta en el gen KCNV2 del cromosoma 9p24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10649</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C563678</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:610356</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:209932</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081022</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">cone dystrophy with supernormal rod responses</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una distrofia de conos que se caracteriza por la aparición en la primera o segunda década de la vida de fotofobia muy marcada, miopía, visión reducida de los colores a lo largo del eje rojo-verde con discriminación tritana relativamente conservada, y escotomata central con pérdida de sensibilidad generalizada periférica predominante en el campo visual superior y que presenta una mutación homocigota o heterocigota compuesta en el gen KCNV2 del cromosoma 9p24.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/15722315/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


