        <obo:IAO_0000115 xml:lang="en">A parasitic helminthiasis infectious disease that involves parasitic infection by the genus Spirometra. A painful nodule develops after the plerocercoid larvae migrate to the brain causing cerebral sparganosis. Subcutaneous tissue, breast, orbit, urinary tract, pleural cavity, lungs, abdominal viscera and inner ear can be infected.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:B70.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:123.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C35030</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:187152002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0037753</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Sparganum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10080</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">esparganosis</rdfs:label>
        <skos:exactMatch>MESH:D013031</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
