    <!-- http://purl.obolibrary.org/obo/DOID_0080059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050950"/>
        <obo:IAO_0000115 xml:lang="es">Una ataxia cerebelosa autosómica recesiva que se caracteriza por la aparición de dificultades progresivas en la marcha, anomalías en los movimientos oculares y disartria en la primera o segunda década de la vida y que presenta una mutación heterocigota compuesta en el gen TPP1 del cromosoma 11p15.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-07T14:55:44Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>GARD:12232</oboInOwl:hasDbXref>
