        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">Síndrome de insensibilidad parcial a los andrógenos</rdfs:label>
    </owl:Class>
