    <!-- http://purl.obolibrary.org/obo/DOID_0080672 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
