        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Childhood_absence_epilepsy</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_1826 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1826">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_936"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad cerebral que se caracteriza por la aparición de al menos dos crisis no provocadas, resultado de una anomalía epileptógena persistente del cerebro capaz de generar espontáneamente actividad paroxística y que se manifiesta típicamente por episodios breves y repentinos de alteración o disminución de la conciencia, movimientos involuntarios o convulsiones.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0000474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G40.909</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:345.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004827</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C3020</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:267698007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0014544</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de epilepsia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome epiléptico</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1826</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_FlyBase_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">epilepsia</rdfs:label>
        <skos:exactMatch>ICD10CM:G40</skos:exactMatch>
        <skos:narrowMatch>ICD10CM:G40.9</skos:narrowMatch>
        <skos:narrowMatch>ICD10CM:G40.909</skos:narrowMatch>
    </owl:Class>
