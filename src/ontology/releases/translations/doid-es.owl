        <oboInOwl:hasDbXref>MESH:C535932</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:69665</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">colestasis intrahepática gravídica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">colestasis intrahepática recurrente del embarazo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">colestasis relacionada con el embarazo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070227</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">colestasis intrahepática del embarazo</rdfs:label>
