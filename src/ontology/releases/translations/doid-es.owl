        <oboInOwl:hasDbXref>MESH:D007816</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C34758</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:87121004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0023049</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Toxascaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección por Toxocara</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">larva migrans visceral</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
