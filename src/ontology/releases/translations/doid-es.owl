    <!-- http://purl.obolibrary.org/obo/DOID_0080818 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080818">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080809"/>
        <obo:IAO_0000115 xml:lang="es">Asma crónico que se caracteriza por la combinación de fenotipo fisiopatológico (endotipo) de no atópico, fumador, relacionado con la obesidad y anciano y que se caracteriza por inflamación neutrofílica (neutrófilos en esputo &gt; 40-60%) o paucigranulocítica (es decir, niveles normales de eosinófilos y neutrófilos en esputo) y falta de respuesta al tratamiento con corticosteroides.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym xml:lang="es">endotipo bajo tipo 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080818</oboInOwl:id>
        <rdfs:label xml:lang="es">Asma T2-bajo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080818"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Asma crónico que se caracteriza por la combinación de fenotipo fisiopatológico (endotipo) de no atópico, fumador, relacionado con la obesidad y anciano y que se caracteriza por inflamación neutrofílica (neutrófilos en esputo &gt; 40-60%) o paucigranulocítica (es decir, niveles normales de eosinófilos y neutrófilos en esputo) y falta de respuesta al tratamiento con corticosteroides.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/21281866/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


