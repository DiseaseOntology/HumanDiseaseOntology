        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Deficiencia de cortisona reductasa 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0090141"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una deficiencia de cortisona reductasa que se caracteriza por la incapacidad de regenerar el cortisol a través de la enzima 11-beta-hidroxiesteroide deshidrogenasa que requiere la regeneración de NADPH por la hexosa-6-fosfato deshidrogenasa, lo que resulta en hiperandrogenismo suprarrenal mediado por ACTH. Tiene material base en autosómico Herencia recesiva de mutación homocigótica o heterocigótica compuesta en el gen de la hexosa-6-fosfato deshidrogenasa (H6PD) en el cromosoma 1p36.</owl:annotatedTarget>
