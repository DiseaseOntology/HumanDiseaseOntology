        <oboInOwl:hasDbXref>NCI:C128411</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:195649005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0149512</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050127</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">sinusitis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad de los senos paranasales que consiste en la inflamación de los senos paranasales como consecuencia de una infección bacteriana, fúngica, vírica, alérgica o autoinmune. Los síntomas pueden incluir fiebre, debilidad, fatiga, tos y congestión. También puede haber secreción de mucosidad en la parte posterior de la garganta, lo que se denomina goteo postnasal.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
