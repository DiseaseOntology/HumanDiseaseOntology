    <!-- http://purl.obolibrary.org/obo/DOID_0112061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0112061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0111962"/>
