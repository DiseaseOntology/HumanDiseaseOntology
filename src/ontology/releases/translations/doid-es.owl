    <!-- http://purl.obolibrary.org/obo/DOID_0081379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_332"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Esclerosis lateral amiotrófica que se caracteriza por debilidad muscular rápidamente progresiva y muerte por insuficiencia respiratoria y que presenta herencia autosómica recesiva con una mutación heterocigota en el gen KIF5A del cromosoma 12q13. La ELA25 puede tener una mediana de edad de aparición más baja (46,5 años) y una mediana de supervivencia más larga (10 años) que la encontrada en estudios epidemiológicos (62,5 años y 20 a 30 meses, respectivamente).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617921</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0081379</oboInOwl:id>
        <rdfs:label xml:lang="es">esclerosis lateral amiotrófica tipo 25</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0081379"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Esclerosis lateral amiotrófica que se caracteriza por debilidad muscular rápidamente progresiva y muerte por insuficiencia respiratoria y que presenta herencia autosómica recesiva con una mutación heterocigota en el gen KIF5A del cromosoma 12q13. La ELA25 puede tener una mediana de edad de aparición más baja (46,5 años) y una mediana de supervivencia más larga (10 años) que la encontrada en estudios epidemiológicos (62,5 años y 20 a 30 meses, respectivamente).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/29566793/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


