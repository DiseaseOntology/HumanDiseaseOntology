        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:1362020006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1720957</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">deficiencia de CD40</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">inmunodeficiencia hiper-IgM tipo 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome de hiper-IgM por deficiencia de CD40</oboInOwl:hasExactSynonym>
