    <!-- http://purl.obolibrary.org/obo/DOID_0080075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050721"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000369"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una deficiencia de serina que se caracteriza por múltiples malformaciones mortales, incluyendo ictiosis, microcefalia, anomalías del sistema nervioso central, deformidades de las extremidades, restricción del crecimiento intrauterino, proptosis, anasarca y micrognatia, y que presenta una herencia autosómica recesiva de mutación en el gen PSAT1 en el cromosoma 9q21.1, causando problemas para producir el aminoácido serina.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-19T14:47:01Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>MIM:616038</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080075</oboInOwl:id>
        <rdfs:label xml:lang="es">Síndrome Neu-Laxova 2</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una deficiencia de serina que se caracteriza por múltiples malformaciones mortales, incluyendo ictiosis, microcefalia, anomalías del sistema nervioso central, deformidades de las extremidades, restricción del crecimiento intrauterino, proptosis, anasarca y micrognatia, y que presenta una herencia autosómica recesiva de mutación en el gen PSAT1 en el cromosoma 9q21.1, causando problemas para producir el aminoácido serina.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:https://www.omim.org/entry/616038</oboInOwl:hasDbXref>
    </owl:Axiom>
    


