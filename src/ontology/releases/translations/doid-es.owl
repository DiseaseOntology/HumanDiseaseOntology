    <!-- http://purl.obolibrary.org/obo/DOID_13544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004005"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MIM_606657"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0004029"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DOID_9282"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Glaucoma de ángulo abierto caracterizado por un aumento de la resistencia intrínseca al flujo acuoso sin causas secundarias conocidas, un ángulo anatómico estrecho de la cámara anterior o una presión intraocular elevada en comparación con la media de la población. El glaucoma de tensión normal tiene_síntoma disminución progresiva de la visión y pérdida progresiva de la visión periférica.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H40.12</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:365.12</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D057066</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:155124000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0152136</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Glaucoma de tensión normal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13544</oboInOwl:id>
        <rdfs:label xml:lang="es">glaucoma de baja tensión</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_13544"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Glaucoma de ángulo abierto caracterizado por un aumento de la resistencia intrínseca al flujo acuoso sin causas secundarias conocidas, un ángulo anatómico estrecho de la cámara anterior o una presión intraocular elevada en comparación con la media de la población. El glaucoma de tensión normal tiene_síntoma disminución progresiva de la visión y pérdida progresiva de la visión periférica.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://eyewiki.aao.org/Primary_Open-Angle_Glaucoma</oboInOwl:hasDbXref>
    </owl:Axiom>
    


