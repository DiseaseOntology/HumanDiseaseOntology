        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:85807000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0002831</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
