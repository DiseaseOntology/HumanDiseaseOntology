    <!-- http://purl.obolibrary.org/obo/DOID_3376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3347"/>
        <obo:IAO_0000115 xml:lang="es">Osteosarcoma que es una neoplasia mesenquimal maligna formadora de hueso, generalmente agresiva, que surge del hueso. Puede surgir de novo o de una lesión ósea preexistente. El dolor y una masa palpable son los signos y síntomas clínicos más frecuentes. Puede extenderse a otras localizaciones anatómicas, en particular a los pulmones.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:8580</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>NCI:C53707</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:307576001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0585442</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3376</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_cancer_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">osteosarcoma óseo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Osteosarcoma que es una neoplasia mesenquimal maligna formadora de hueso, generalmente agresiva, que surge del hueso. Puede surgir de novo o de una lesión ósea preexistente. El dolor y una masa palpable son los signos y síntomas clínicos más frecuentes. Puede extenderse a otras localizaciones anatómicas, en particular a los pulmones.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://my.clevelandclinic.org/health/diseases/15041-osteosarcoma</oboInOwl:hasDbXref>
    </owl:Axiom>
    


