                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003581"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">La miopatía distal se caracteriza por la aparición en la edad adulta de debilidad y atrofia muscular distal lentamente progresiva que afecta a las extremidades superiores e inferiores, provoca dificultades para utilizar las manos y dificultades para caminar y que tiene una vinculación significativa con 2 regiones distintas en los cromosomas 8p22-q11 y 12q13-q22 y tiene_base_material_en una mutación heterocigota en el gen HNRNPA1 en el cromosoma 12q13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:610099</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:399086</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Distrofia muscular distal 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Miopatía distal tipo 3</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111189</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">miopatía distal 3</rdfs:label>
    </owl:Class>
