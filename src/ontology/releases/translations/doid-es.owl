    <!-- http://purl.obolibrary.org/obo/DOID_0060707 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060704"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002488"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0011463"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Síndrome linfoproliferativo caracterizado por herencia autosómica recesiva, aparición en la infancia temprana de una desregulación inmunitaria asociada al virus de Epstein-Barr que se manifiesta típicamente como linfoma, granulomatosis linfomatoide, linfohistiocitosis hemofagocítica, enfermedad de Hodgkin y/o hipogammaglobulinemia y que tiene_como_base una mutación homocigota en el gen ITK del cromosoma 5q32.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:D47.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:613011</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060707</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome linfoproliferativo 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060707"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Síndrome linfoproliferativo caracterizado por herencia autosómica recesiva, aparición en la infancia temprana de una desregulación inmunitaria asociada al virus de Epstein-Barr que se manifiesta típicamente como linfoma, granulomatosis linfomatoide, linfohistiocitosis hemofagocítica, enfermedad de Hodgkin y/o hipogammaglobulinemia y que tiene_como_base una mutación homocigota en el gen ITK del cromosoma 5q32.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
