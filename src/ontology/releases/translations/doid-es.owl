    <!-- http://purl.obolibrary.org/obo/DOID_0060022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_628"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Una inmunodeficiencia combinada de células T y células B que es una inmunodeficiencia ligada al cromosoma X con hiperinmunoglobulina M (XHIM) que afecta al cambio de isotipo y está causada por la ausencia del ligando CD40 que normalmente se expresa en las células T CD4+ activadas. Los individuos con esta mutación son incapaces de pasar de IgM a IgG, IgA e IgE.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:308230</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">síndrome hiper-IgM ligado al X</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060022</oboInOwl:id>
        <rdfs:label xml:lang="es">Deficiencia de ligando CD40</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una inmunodeficiencia combinada de células T y células B que es una inmunodeficiencia ligada al cromosoma X con hiperinmunoglobulina M (XHIM) que afecta al cambio de isotipo y está causada por la ausencia del ligando CD40 que normalmente se expresa en las células T CD4+ activadas. Los individuos con esta mutación son incapaces de pasar de IgM a IgG, IgA e IgE.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/30681380</oboInOwl:hasDbXref>
    </owl:Axiom>
    


