    <!-- http://purl.obolibrary.org/obo/DOID_0111728 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_870"/>
        <obo:IAO_0000115 xml:lang="es">La neuropatía periférica se caracteriza por dolor intenso recurrente, estereotipado y episódico, que se produce predominantemente en la parte superior del cuerpo o en las extremidades inferiores, y que se desencadena o exacerba con la fatiga, la exposición al frío, el ayuno, los cambios climáticos y/o el estrés o el esfuerzo físico.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12684</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:PS615040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:391384</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111728</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de dolor episódico familiar</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111728"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La neuropatía periférica se caracteriza por dolor intenso recurrente, estereotipado y episódico, que se produce predominantemente en la parte superior del cuerpo o en las extremidades inferiores, y que se desencadena o exacerba con la fatiga, la exposición al frío, el ayuno, los cambios climáticos y/o el estrés o el esfuerzo físico.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/24813307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/28298626</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0111729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0111728"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El síndrome de dolor episódico familiar se caracteriza por la aparición en la infancia de dolor episódico debilitante en la parte superior del cuerpo desencadenado por el ayuno, el frío y el estrés físico y tiene_base_material_en una mutación heterocigota en el gen TRPA1 del cromosoma 8q13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:615040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:391389</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111729</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de dolor episódico familiar 1</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111729"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El síndrome de dolor episódico familiar se caracteriza por la aparición en la infancia de dolor episódico debilitante en la parte superior del cuerpo desencadenado por el ayuno, el frío y el estrés físico y tiene_base_material_en una mutación heterocigota en el gen TRPA1 del cromosoma 8q13.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/20547126</oboInOwl:hasDbXref>
