    <!-- http://purl.obolibrary.org/obo/DOID_0080932 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050639"/>
        <obo:IAO_0000115 xml:lang="es">Amiloidosis cutánea primaria que se caracteriza por depósitos de amiloide derivado de queratinocitos en la piel y que presenta una mutación homocigota o heterocigota compuesta en el gen GPNMB del cromosoma 7p15. La enfermedad aparece antes de la pubertad y consiste en una hiperpigmentación macular o reticulada mezclada con lesiones guttatas hipopigmentadas e hiperpigmentadas distribuidas simétricamente.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:617920</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080932</oboInOwl:id>
        <rdfs:label xml:lang="es">Amiloidosis cutánea localizada primaria 3</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080932"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Amiloidosis cutánea primaria que se caracteriza por depósitos de amiloide derivado de queratinocitos en la piel y que presenta una mutación homocigota o heterocigota compuesta en el gen GPNMB del cromosoma 7p15. La enfermedad aparece antes de la pubertad y consiste en una hiperpigmentación macular o reticulada mezclada con lesiones guttatas hipopigmentadas e hiperpigmentadas distribuidas simétricamente.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/25866143/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


