        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:728</oboInOwl:id>
        <rdfs:label xml:lang="es">epiescleritis nodular</rdfs:label>
    </owl:Class>
