    <!-- http://purl.obolibrary.org/obo/DOID_9577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1508"/>
        <obo:IAO_0000115 xml:lang="es">Candidiasis que consiste en una infección fúngica en neonatos causada por especies de Candida. El bajo peso al nacer y la edad, el cateterismo intravascular prolongado y el uso de antibióticos son las principales condiciones que predisponen a la candidiasis sistémica en neonatos.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:P37.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:771.7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C116810</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:3973009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0276682</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Infección neonatal por monilia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">infección neonatal por cándida</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">moniliasis neonatal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9577</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">candidiasis neonatal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_9577"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Candidiasis que consiste en una infección fúngica en neonatos causada por especies de Candida. El bajo peso al nacer y la edad, el cateterismo intravascular prolongado y el uso de antibióticos son las principales condiciones que predisponen a la candidiasis sistémica en neonatos.</owl:annotatedTarget>
