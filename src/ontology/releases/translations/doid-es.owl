        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Omodisplasia que se caracteriza por micromelia congénita grave con acortamiento y estrechamiento distal de los húmeros y los fémures para dar un aspecto de garrote y que presenta una mutación homocigota o heterocigota compuesta en el gen GPC6 del cromosoma 13q32.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/17823719/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


