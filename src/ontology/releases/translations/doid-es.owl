                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002452"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019177"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de los senos paranasales que consiste en la inflamación de los senos paranasales como consecuencia de una infección bacteriana, fúngica, vírica, alérgica o autoinmune. Los síntomas pueden incluir fiebre, debilidad, fatiga, tos y congestión. También puede haber secreción de mucosidad en la parte posterior de la garganta, lo que se denomina goteo postnasal.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:2052</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:9564</oboInOwl:hasAlternativeId>
