    <!-- http://purl.obolibrary.org/obo/DOID_9155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9065"/>
