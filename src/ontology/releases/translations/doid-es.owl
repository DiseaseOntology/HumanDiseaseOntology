    <!-- http://purl.obolibrary.org/obo/DOID_0050553 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060913"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080578"/>
