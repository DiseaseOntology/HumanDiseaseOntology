    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1221">
        <obo:IAO_0000115 xml:lang="en">A pulmonary tuberculosis that is characterized by filling of airspaces with fluid, inflammatory exudates (pus, proteins and immunological substances) or cells (malignant cells and red blood cells) in a region of the lung.</obo:IAO_0000115>
