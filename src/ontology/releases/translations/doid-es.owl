    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12900"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Una enfermedad autoinmune que se caracteriza por el agrandamiento crónico de las glándulas de la cabeza y el cuello, tiene síntoma bultos de la cara y el cuello, ojos secos, boca seca, y fiebre intermitente, y con frecuencia se asocia con un trastorno autoinmune subyacente, malignidad hematológica, infección por tuberculosis, o infección por sífilis.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <oboInOwl:hasDbXref>url:https://rarediseases.org/rare-diseases/mikulicz-syndrome/</oboInOwl:hasDbXref>
