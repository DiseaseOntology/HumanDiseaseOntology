        <owl:annotatedTarget xml:lang="en">An osteosclerosis that has_material_basis_in lack of bone resorption which results_in abnormally hard and brittle bones.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Osteopetrosis</oboInOwl:hasDbXref>
    </owl:Axiom>
    


