        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad hereditaria por deficiencia del factor XIII</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad por deficiencia de factor XIII</oboInOwl:hasExactSynonym>
