        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000459"/>
        <obo:IAO_0000115>Dyspepsia is a digestive system symptom referred to as indigestion resulting from an impairment to digestion caused by ulcer, gall bladder disease or inflamed colon. Related symptoms include weakness, loss of appetite, and depression.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>indigestion</oboInOwl:hasExactSynonym>
