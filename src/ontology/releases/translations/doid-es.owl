    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10263">
        <obo:IAO_0000115 xml:lang="en">A Mumps virus infectious disease that results_in inflammation located_in liver, has_material_basis_in Mumps virus, which is transmitted_by contact with the oronasal secretions of an infected person. The infection causes swelling of parotid gland and has_symptom fever, has_symptom nausea, has_symptom anorexia, and has_symptom dark urine.</obo:IAO_0000115>
