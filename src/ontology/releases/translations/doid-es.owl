    <!-- http://purl.obolibrary.org/obo/DOID_0080714 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080712"/>
