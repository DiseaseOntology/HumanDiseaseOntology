    <!-- http://purl.obolibrary.org/obo/DOID_10527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10527">
        <obo:IAO_0000115 xml:lang="en">A Haemophilus influenzae infectious disease that is caused by the strains of Haemophilus influenzae resulting in pleural effusions. This disease occurs in individuals with disorders that impaired the normal defense mechanisms and with pre-existing lung disease. H. influenzae causes bronchopneumonia making the patients wheezy and progressively more breathless.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10527</oboInOwl:id>
