    <!-- http://purl.obolibrary.org/obo/DOID_0111260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080012"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_655"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000149"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">El trastorno metabólico hereditario se caracteriza por una mayor síntesis de fosforibosilpirofosfato que da lugar a una mayor producción de ácido úrico y purina y tiene_base_material_en una herencia recesiva ligada al cromosoma X de mutaciones en PRPS1 en Xq22.3 que dan lugar a una mayor actividad del gen. La forma leve de la enfermedad tiene un inicio en la juventud tardía o en la edad adulta temprana, mientras que la forma más grave tiene un inicio en la infancia o en la niñez temprana.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C567064</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:300661</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:3222</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:723454008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C1970827</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Superactividad PRPS1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Superactividad de la PRPP sintetasa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111260</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">superactividad de la fosforibosilpirofosfato sintetasa</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">El trastorno metabólico hereditario se caracteriza por una mayor síntesis de fosforibosilpirofosfato que da lugar a una mayor producción de ácido úrico y purina y tiene_base_material_en una herencia recesiva ligada al cromosoma X de mutaciones en PRPS1 en Xq22.3 que dan lugar a una mayor actividad del gen. La forma leve de la enfermedad tiene un inicio en la juventud tardía o en la edad adulta temprana, mientras que la forma más grave tiene un inicio en la infancia o en la niñez temprana.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/20301734</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/8253776</oboInOwl:hasDbXref>
    </owl:Axiom>
    


