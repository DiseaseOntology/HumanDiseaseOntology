                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa bacteriana primaria que consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA, B, E y F) localizadas en la unión neuromuscular que provoca una parálisis muscular descendente, tiene_como_base el Clostridium botulinum A, tiene_como_base el Clostridium botulinum B, tiene_como_base el Clostridium botulinum E y tiene_como_base el Clostridium botulinum F.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:943</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A05.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D001906</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84599</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:154276003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0006057</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">infección por Clostridium botulinum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">intoxicación alimentaria por Clostridium botulinum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11976</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label xml:lang="es">botulismo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_11976"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Enfermedad infecciosa bacteriana primaria que consiste en una intoxicación causada por neurotoxinas botulínicas (BoNTA, B, E y F) localizadas en la unión neuromuscular que provoca una parálisis muscular descendente, tiene_como_base el Clostridium botulinum A, tiene_como_base el Clostridium botulinum B, tiene_como_base el Clostridium botulinum E y tiene_como_base el Clostridium botulinum F.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
