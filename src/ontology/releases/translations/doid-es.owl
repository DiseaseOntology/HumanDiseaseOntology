    <!-- http://purl.obolibrary.org/obo/DOID_10652 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_680"/>
        <obo:IAO_0000115 xml:lang="es">Una tauopatía que se caracteriza por lapsus de memoria, confusión, inestabilidad emocional y pérdida progresiva de la capacidad mental que provoca pérdida progresiva de memoria, deterioro del pensamiento, desorientación y cambios en la personalidad y el estado de ánimo que, en casos avanzados, conducen a un profundo deterioro del funcionamiento cognitivo y físico caracterizada histológicamente por la degeneración de las neuronas cerebrales, especialmente en la corteza cerebral, y por la presencia de ovillos neurofibrilares que contienen placas de beta-amiloide.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:0110051</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GARD:10254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G30</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:331.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>KEGG:05010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D000544</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C2866</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:73768007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0002395</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Alzheimer demencia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Enfermedad de Alzheimer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:10652</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_RAD_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">Enfermedad de Alzheimer</rdfs:label>
    </owl:Class>
