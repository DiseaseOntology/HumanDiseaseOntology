    <!-- http://purl.obolibrary.org/obo/DOID_0080918 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080918">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_936"/>
        <obo:IAO_0000115 xml:lang="en">A brain disease that is characterized by malformation of the developing brain characterized by abnormal cortical lamination and an unusual folding pattern of the cerebral cortex such that all or part of the brain surface is taken up by an excessive number of small folds (gyri).</obo:IAO_0000115>
