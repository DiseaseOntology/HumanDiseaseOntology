    <!-- http://purl.obolibrary.org/obo/DOID_1335 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1335">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results_in infection in ruminants, has_material_basis_in Bluetongue virus, which is transmitted_by Culicoides imicola midge. The infection has_symptom fever, has_symptom excessive salivation, has_symptom swelling of the face and tongue, and has_symptom cyanosis of the tongue.</obo:IAO_0000115>
