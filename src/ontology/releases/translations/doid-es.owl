        <oboInOwl:hasExactSynonym xml:lang="es">CID por deficiencia de TFRC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Inmunodeficiencia combinada por deficiencia de TFRC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Inmunodeficiencia combinada relacionada con TFRC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0111948</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
