        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019161"/>
        <obo:IAO_0000115>A muscle pain that is characterized by being severe in nature.  Myalgia may be acute in nature, stemming from overuse of a muscle group or viral infection.  It may also be chronic and caused by  metabolic myopathy, some nutritional deficiencies, and chronic fatigue syndrome.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>symptoms</oboInOwl:hasOBONamespace>
        <oboInOwl:id>SYMP:0000379</oboInOwl:id>
