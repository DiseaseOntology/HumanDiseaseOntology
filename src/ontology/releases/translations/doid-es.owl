        <oboInOwl:hasExactSynonym xml:lang="es">Enanismo platispondílico letal de extremidades cortas, tipo Torrance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">displasia tanatofórica variante de Torrance</oboInOwl:hasExactSynonym>
