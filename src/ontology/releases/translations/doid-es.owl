        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0111515"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La oftalmoplejia externa progresiva crónica se caracteriza por la aparición en la edad adulta de oftalmoplejia externa progresiva, intolerancia al ejercicio, debilidad muscular y signos y síntomas de ataxia espinocerebelosa y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen RNASEH1 en el cromosoma 2p25.3.</owl:annotatedTarget>
