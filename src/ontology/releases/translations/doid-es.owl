    <!-- http://purl.obolibrary.org/obo/DOID_0050145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_974"/>
        <rdfs:subClassOf>
