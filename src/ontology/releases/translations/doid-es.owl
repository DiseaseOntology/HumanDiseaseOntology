    <!-- http://purl.obolibrary.org/obo/DOID_4807 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4807">
        <obo:IAO_0000115 xml:lang="en">An Enterovirus infectious disease that results_in infection, has_material_basis_in Swine vesicular disease virus, which is transmitted_by ingestion of contaminated food, or transmitted_by contact with an infected animal. The infection results_in_formation_of vesicles in the mouth, snout and feet, and has_symptom lameness.</obo:IAO_0000115>
