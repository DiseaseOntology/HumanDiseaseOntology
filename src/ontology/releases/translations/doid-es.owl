    <!-- http://purl.obolibrary.org/obo/DOID_0060705 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060704"/>
