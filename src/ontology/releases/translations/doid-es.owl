        <rdfs:label xml:lang="es">atrofia muscular espinal juvenil</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_12376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">La atrofia muscular espinal infantil que tiene una edad de aparición posterior a los 18 meses y se caracteriza por debilidad muscular tras la primera infancia y la capacidad de ponerse de pie y caminar y tiene_base_material_en una mutación homocigota o heterocigota compuesta en el gen SMN1 del cromosoma 5q13.</owl:annotatedTarget>
