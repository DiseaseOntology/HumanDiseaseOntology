    <!-- http://purl.obolibrary.org/obo/DOID_11249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5113"/>
