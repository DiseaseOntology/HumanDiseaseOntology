        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#zoonotic_infectious_disease"/>
        <rdfs:label xml:lang="es">carbunco orofaríngeo</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0050059"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Un carbunco gastrointestinal que provoca una infección localizada en la mucosa de la orofaringe, tiene_como_base la Bacillus anthracis, que se transmite por ingestión de carne infectada de carbunco. La infección presenta como síntomas lesiones, vómitos de sangre, diarrea severa, pérdida de apetito.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/3934300</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050338"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IDO_0000664"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_1648"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002451"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/TRANS_0000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="es">Enfermedad infecciosa bacteriana primaria que resulta_en una infección que se_ubica_en la piel, tiene_como_base la Erysipelothrix rhusiopathiae, que se_transmite_por contacto con animales infectados. La infección tiene_como_síntoma enrojecimiento de la piel, tiene_como_síntoma sensibilidad de la piel y tiene_como_síntoma calor de la piel.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:D004887</oboInOwl:hasDbXref>
