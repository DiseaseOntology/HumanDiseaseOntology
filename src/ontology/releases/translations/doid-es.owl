        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:66071002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0019163</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">hepatitis B crónica</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">infección por hepatitis B</oboInOwl:hasExactSynonym>
