        <oboInOwl:id>DOID:0060805</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="es">síndrome de Prieto</rdfs:label>
    </owl:Class>
    <owl:Axiom>
