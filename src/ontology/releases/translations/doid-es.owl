                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GENO_0000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A syndrome characterized by a skeletal dysplasia consisting of advanced bone maturation, short and dysplastic bones, and disproportionate body measurements; facial dysmorphisms and dental anomalies; and neurodevelopmental delays ranging in severity from isolated fine motor delays to impaired intellectual development that has_material_basis_in heterozygous mutation in the PTBP1 gene on chromosome 19p13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:621495</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
