        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3480"/>
        <obo:IAO_0000115 xml:lang="es">Cáncer ocular que se localiza en la úvea, que son las capas pigmentadas del ojo formadas por el iris, el cuerpo ciliar y la coroides. La úvea es la localización más frecuente de neoplasias intraoculares en adultos y suele estar causada por un subtipo de cáncer que surge de los melanocitos.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:12754</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>NCI:C6105</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C3665670</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="es">Neoplasia maligna del tracto uveal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Tumor uveal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="es">Tumor uveal maligno</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3479</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="es">cáncer uveal</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_3479"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="es">Cáncer ocular que se localiza en la úvea, que son las capas pigmentadas del ojo formadas por el iris, el cuerpo ciliar y la coroides. La úvea es la localización más frecuente de neoplasias intraoculares en adultos y suele estar causada por un subtipo de cáncer que surge de los melanocitos.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://www.umkelloggeye.org/conditions-treatments/uveal-melanoma-ocular-melanoma</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_530"/>
        <obo:IAO_0000115 xml:lang="es">Enfermedad de los párpados que se caracteriza por exacerbaciones y remisiones del edema palpebral, lo que da lugar a un estiramiento y posterior atrofia del tejido palpebral, que conduce a la formación de pliegues redundantes sobre los márgenes del párpado.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:H02.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:374.34</oboInOwl:hasDbXref>
