        <owl:annotatedTarget>A sensation perception that is characterized by a diminished sensitivity to painful stimulation.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/SYMP_0000836 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000836">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000892"/>
        <obo:IAO_0000115>A sensation perception that is characterized by an increased response to a painful stimulus.</obo:IAO_0000115>
