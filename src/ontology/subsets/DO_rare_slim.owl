        <oboInOwl:hasExactSynonym xml:lang="en">MED13L syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MED13L-related intellectual disability</oboInOwl:hasExactSynonym>
