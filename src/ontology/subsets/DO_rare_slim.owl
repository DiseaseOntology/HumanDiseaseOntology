        <oboInOwl:hasDbXref>UMLS_CUI:C0004576</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Babesiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection by babesia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">piroplasmosis</oboInOwl:hasExactSynonym>
