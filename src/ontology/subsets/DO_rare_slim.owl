        <oboInOwl:hasExactSynonym xml:lang="en">2q37 microdeletion syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Albright hereditary osteodystrophy type 3</oboInOwl:hasExactSynonym>
