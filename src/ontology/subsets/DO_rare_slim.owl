    <!-- http://purl.obolibrary.org/obo/DOID_0050429 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9182"/>
        <obo:IAO_0000115 xml:lang="en">A pemphigus that is characterized by recurring blistering most commonly occurring in the folds of the skin, particularly the groin and axillary regions, and has_material_basis_in mutations in the ATP2C1 gene that result in loss of adhesion within the skin. Other sites of the body, such as the neck, perianal, and submammary regions, may likewise be affected.</obo:IAO_0000115>
