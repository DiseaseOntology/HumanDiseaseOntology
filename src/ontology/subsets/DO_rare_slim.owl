    <!-- http://purl.obolibrary.org/obo/DOID_0070776 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070776">
        <obo:IAO_0000115 xml:lang="en">A syndromic intellectual disability characterized by mild-to-profound developmental delay, intellectual disability, speech delay, hypotonia, variable congenital heart defects, and distinctive dysmorphic facial features including frontal bossing, upslanting palpebral fissures, depressed nasal bridge with bulbous tip, and macrostomia that has_material_basis_in heterozygous mutation in the MED13L gene on chromosome 12q24.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q87.85</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:616789</oboInOwl:hasDbXref>
