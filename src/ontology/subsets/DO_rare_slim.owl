        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A congenital disorder of glycosylation I that is characterized by facial dysmorphism (prominent forehead, large ears, thin upper lip), generalized hypotonia, feeding difficulties, moderate to severe developmental delay, progressive microcephaly, frequent upper respiratory tract infections due to impaired immunity with decreased immunoglobulin levels, and decreased coagulation factors and has_material_basis_in homozygous or compound heterozygous mutation in the gene encoding dolichyl-P-mannose:Man-7-GlcNAc-2-PP-dolichyl-alpha-6-mannosyltransferase on chromosome 22q13.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
