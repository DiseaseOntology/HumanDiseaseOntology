    <!-- http://purl.obolibrary.org/obo/DOID_0050246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050246">
        <obo:IAO_0000115 xml:lang="en">A parasitic protozoa infectious disease that results in infection of the brain caused by Acanthamoeba or Balamuthia mandrillaris. The symptoms include headaches, altered mental status, and focal neurologic deficit, which progresses over several weeks to death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:12651</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Acanthamoeba encephalitis</oboInOwl:hasExactSynonym>
