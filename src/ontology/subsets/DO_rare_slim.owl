    <!-- http://purl.obolibrary.org/obo/DOID_14472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14472">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results in infection located in lung, has_material_basis_in Orthohantavirus sinnombreense, transmitted by deer mouse (Myodes glareolus), has_material_basis_in Orthohantavirus nigrorivense, transmitted by cotton rat (Sigmodon hispidus), has_material_basis_in Orthohantavirus bayoui, transmitted by marsh rice rat (Oryzomys palustris), has_material_basis_in Orthohantavirus negraense, transmitted by small vesper mouse (Calomys laucha), or has_material_basis_in Orthohantavirus andesense, transmitted by rice rat (Oligoryzomys longicaudatus). The infection has _symptom fever, muscle pain, headache, cough, vomiting, and chills which rapidly progress to bilateral interstitial pulmonary infiltrates occurrence, pulmonary edema and hypoxia often resulting in death from shock or cardiac complications.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:69</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D018804</oboInOwl:hasDbXref>
