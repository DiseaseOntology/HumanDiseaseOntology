        <oboInOwl:hasDbXref>UMLS_CUI:C0034362</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection due to Coxiella burnetii</oboInOwl:hasExactSynonym>
