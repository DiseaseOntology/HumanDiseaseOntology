    <!-- http://purl.obolibrary.org/obo/DOID_0060958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060958">
        <obo:IAO_0000115 xml:lang="en">An orofaciodigital syndrome that is characterized by severe microcephaly, trigonocephaly, severe intellectual disability and micropenis, in addition to oral, facial and digital malformations (gingival frenulae, lingual hamartomas, cleft/lobulated tongue, cleft palate, telecanthus, up-slanting palpebral fissures, microretrognathia, postaxial polydactyly of hands and duplication of hallux) that has_material_basis_in homozygous or compound heterozygous mutation in the C2CD3 gene on chromosome 11q13.</obo:IAO_0000115>
