        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13533"/>
        <obo:IAO_0000115 xml:lang="en">An osteopetrosis characterized by autosomal dominant inheritance of sclerosis predominantly involving the spine, the pelvis, and the skull base, bone fragility and dental abscesses that has_material_basis_in mutation in the CLCN7 gene on chromosome 16p13.</obo:IAO_0000115>
