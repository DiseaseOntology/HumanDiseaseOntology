    <!-- http://purl.obolibrary.org/obo/DOID_0060444 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060444">
        <obo:IAO_0000115 xml:lang="en">An corneal granular dystrophy that is characterized by recurrent erosions and stellate or thorn-like opacification located_in the cornea, hyaline and amyloid deposits in the stroma, and progressive vision loss later in life, and has_material_basis_in autosomal dominant inheritance of mutation of transforming growth factor beta-induced gene on chromosome 5q31.1, which encodes keratoepithelin. Abnormalities lead to increased hyaline and amyloid protein deposition and disruption of the corneal surface.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-10-16T16:44:27Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>MESH:C535474</oboInOwl:hasDbXref>
