    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081419">
        <obo:IAO_0000115 xml:lang="en">A dystonia that is characterized by characterized by onset of involuntary movements in the first decade of life and that has_material_basis_in homozygous or compound heterozygous mutation in the MECR gene on chromosome 1p35. Optic atrophy develops around the same time or slightly later.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:13488</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:617282</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:508093</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">DYSTONIA 29, CHILDHOOD-ONSET</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DYTOABG</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MECR-related neurologic disorder</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MEPAN syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mitochondrial Enoyl CoA Reductase Protein-Associated Neurodegeneration</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
