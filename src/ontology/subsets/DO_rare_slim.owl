    <!-- http://purl.obolibrary.org/obo/DOID_0080559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5212"/>
        <obo:IAO_0000115 xml:lang="en">A congenital disorder of glycosylation I that is characterized by facial dysmorphism (prominent forehead, large ears, thin upper lip), generalized hypotonia, feeding difficulties, moderate to severe developmental delay, progressive microcephaly, frequent upper respiratory tract infections due to impaired immunity with decreased immunoglobulin levels, and decreased coagulation factors and has_material_basis_in homozygous or compound heterozygous mutation in the gene encoding dolichyl-P-mannose:Man-7-GlcNAc-2-PP-dolichyl-alpha-6-mannosyltransferase on chromosome 22q13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9833</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:607143</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79324</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ALG12-congenital disorder of glycosylation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">congenital disorder of glycosylation 1g</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080559</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">congenital disorder of glycosylation Ig</rdfs:label>
    </owl:Class>
