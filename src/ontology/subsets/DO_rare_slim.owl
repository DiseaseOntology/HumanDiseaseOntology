    <!-- http://purl.obolibrary.org/obo/DOID_0040093 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0040093">
        <obo:IAO_0000115 xml:lang="en">A lupus erythematosus caused by chronic use of certain drugs.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:M32.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C000730515</oboInOwl:hasDbXref>
