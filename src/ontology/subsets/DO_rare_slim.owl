    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060646">
        <obo:IAO_0000115 xml:lang="en">A pleural disease characterized by the accumulation of chyle within the pleural space leading to respiratory distress, malnutrition and immunological compromise, either immediately after birth or within the first few weeks of life.</obo:IAO_0000115>
