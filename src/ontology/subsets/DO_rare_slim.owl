        <oboInOwl:hasDbXref>url:https://pmc.ncbi.nlm.nih.gov/articles/PMC8009587/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.who.int/news-room/fact-sheets/detail/rift-valley-fever</oboInOwl:hasDbXref>
