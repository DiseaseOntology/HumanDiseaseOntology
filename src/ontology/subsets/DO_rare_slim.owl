        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A syndrome that is characterized by the presence of multiple dysplastic nevi (atypical moles) and a history of melanoma in two family members.</owl:annotatedTarget>
