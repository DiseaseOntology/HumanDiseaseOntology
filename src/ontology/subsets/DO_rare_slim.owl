        <oboInOwl:hasExactSynonym xml:lang="en">Disappearing bone disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Gorham disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">essential osteolysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">massive osteolysis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">phantom bone disease</oboInOwl:hasExactSynonym>
