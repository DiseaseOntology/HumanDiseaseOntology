        <oboInOwl:hasExactSynonym xml:lang="en">brachymelic primordial dwarfism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">cephaloskeletal dysplasia</oboInOwl:hasExactSynonym>
