    <!-- http://purl.obolibrary.org/obo/DOID_1733 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1733">
        <obo:IAO_0000115 xml:lang="en">A coccidiosis that involves a parasitic protozoan infection of the intestine of humans and a wide range of animals caused by Cryptosporidium species, through contaminated water and food, The symptoms include watery diarrhea, dehydration, weight loss, abdominal pain, fever, nausea and vomiting. Cryptosporidium infections have also been found in other digestive tract organs, the lungs, and conjunctiva. Immunocompromised persons are at greater risk of developing the infection.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:1732</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GARD:6219</oboInOwl:hasDbXref>
