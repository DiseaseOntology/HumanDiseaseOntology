        <oboInOwl:hasDbXref>UMLS_CUI:C0035222</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ARDS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Non-cardiogenic pulmonary edema</oboInOwl:hasExactSynonym>
