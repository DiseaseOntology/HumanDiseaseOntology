        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081132"/>
        <obo:IAO_0000115 xml:lang="en">A tetrahydrobiopterin (BH4)-deficient hyperphenylalaninemia that is characterized by mild transient hyperphenylalaninemia often detected by newborn screening and that has_material_basis_in homozygous or compound heterozygous mutation in the PCBD gene, which encodes an enzyme involved in the salvage pathway for BH4, on chromosome 10q22.</obo:IAO_0000115>
