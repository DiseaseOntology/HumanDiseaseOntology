        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/6301273</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/6325502</oboInOwl:hasDbXref>
    </owl:Axiom>
