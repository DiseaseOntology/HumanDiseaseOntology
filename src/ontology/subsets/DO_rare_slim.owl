    <!-- http://purl.obolibrary.org/obo/DOID_0081326 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9252"/>
        <obo:IAO_0000115 xml:lang="en">An amino acid metabolic disorder that is characterized by infantile and pediatric onset basal ganglia-associated movement disorders, hypotonia, developmental delays, ataxia, and seizures and that has_material_basis_in homozygous mutation in the oxoglutarate dehydrogenase gene (OGDH) on chromosome 7p13.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:617</oboInOwl:hasDbXref>
