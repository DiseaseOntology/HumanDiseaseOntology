    <!-- http://purl.obolibrary.org/obo/DOID_4952 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4953"/>
        <obo:IAO_0000115 xml:lang="en">A poliomyelitis that results in atrophy located in muscle, many years after the initial infection, has_material_basis_in Human poliovirus 1, has_material_basis_in Human poliovirus 2, or has_material_basis_in Human poliovirus 3. It is characterized by new weakening in muscles that were previously affected by the polio infection and in muscles that were unaffected. The infection has symptom muscle weakness, has symptom muscle pain, has symptom sleep apnea, and has symptom breathing problems.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:4454</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:G14</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D016262</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:31097004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0080040</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Postpolio syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:4952</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">postpoliomyelitis syndrome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_4952"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A poliomyelitis that results in atrophy located in muscle, many years after the initial infection, has_material_basis_in Human poliovirus 1, has_material_basis_in Human poliovirus 2, or has_material_basis_in Human poliovirus 3. It is characterized by new weakening in muscles that were previously affected by the polio infection and in muscles that were unaffected. The infection has symptom muscle weakness, has symptom muscle pain, has symptom sleep apnea, and has symptom breathing problems.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
