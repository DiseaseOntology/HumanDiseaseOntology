        <rdfs:label xml:lang="en">immunodysregulation with variable immunodeficiency and autoimmunity</rdfs:label>
        <skos:closeMatch>UMLS_CUI:C5968970</skos:closeMatch>
        <skos:exactMatch>MIM:621233</skos:exactMatch>
        <skos:exactMatch>ORDO:697389</skos:exactMatch>
