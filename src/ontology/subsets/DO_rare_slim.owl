        <oboInOwl:hasDbXref>MESH:D050030</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:170390</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84559</oboInOwl:hasDbXref>
