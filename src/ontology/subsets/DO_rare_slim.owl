        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:266134000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0039223</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Posterior spinal sclerosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tabes dorsalis - neurosyphilis</oboInOwl:hasExactSynonym>
