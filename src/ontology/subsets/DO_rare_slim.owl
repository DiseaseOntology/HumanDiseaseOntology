    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10608">
        <obo:IAO_0000115 xml:lang="en">An autoimmune disease of gastrointestinal tract that is caused by a reaction located_in small intestine to gliadin, a prolamin (gluten protein) found in wheat, and similar proteins found in the crops of the tribe Triticeae. The disease is associated with HLA-DQ gene. It has_symptom abdominal pain, has_symptom constipation, has_symptom diarrhea, has_symptom nausea and vomiting, and has_symptom loss of appetite.</obo:IAO_0000115>
