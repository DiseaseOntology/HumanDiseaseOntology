    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13413">
        <obo:IAO_0000115 xml:lang="en">A brain disease that is characterized by loss of brain function, the occurrence of confusion, altered level of consciousness, and coma that results when the liver is unable to remove toxins from the blood.</obo:IAO_0000115>
