    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0081329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2978"/>
        <obo:IAO_0000115 xml:lang="en">A glycogen storage disease that is characterized by severe hypoglycemia and hepatomegaly caused by the accumulation of glycogen. Affected individuals exhibit growth retardation, delayed puberty, lactic acidemia, hyperlipidemia, hyperuricemia, and in adults a high incidence of hepatic adenomas.</obo:IAO_0000115>
