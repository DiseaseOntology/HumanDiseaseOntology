        <oboInOwl:hasExactSynonym xml:lang="en">mental retardation with optic atrophy, deafness and seizures</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
