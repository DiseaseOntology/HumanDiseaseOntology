    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_13359"/>
        <obo:IAO_0000115 xml:lang="en">An Ehlers-Danlos syndrome that has_material_basis_in heterozygous mutation in the C1S gene on chromosome 12p13.</obo:IAO_0000115>
