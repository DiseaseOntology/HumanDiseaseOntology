        <oboInOwl:hasDbXref>UMLS_CUI:C0085261</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="en">Wiedemann&apos;s syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:13482</oboInOwl:id>
