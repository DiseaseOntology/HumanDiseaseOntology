    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081386">
        <obo:IAO_0000115 xml:lang="en">A syndrome that is characterized by episodic metabolic degeneration affecting skeletal muscle, cardiac muscle, and the nervous system and that has_material_basis_in homozygous or compound heterozygous mutation in the TANGO2 gene on chromosome 22q11.</obo:IAO_0000115>
