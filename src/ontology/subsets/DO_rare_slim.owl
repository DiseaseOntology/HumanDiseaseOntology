        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">congenital disorder of glycosylation Ih</rdfs:label>
    </owl:Class>
