        <oboInOwl:hasExactSynonym xml:lang="en">combined granular-lattice corneal dystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">corneal dystrophy, Avellino type</oboInOwl:hasExactSynonym>
