        <oboInOwl:hasDbXref>UMLS_CUI:C0010418</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Cryptosporidial gastroenteritis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection by Cryptosporidium</oboInOwl:hasExactSynonym>
