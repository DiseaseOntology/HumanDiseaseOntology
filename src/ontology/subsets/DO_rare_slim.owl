        <rdfs:label xml:lang="en">X-linked neurodevelopmental disorder with poor or absent speech and behavioral abnormalities</rdfs:label>
        <skos:exactMatch>MIM:301164</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
