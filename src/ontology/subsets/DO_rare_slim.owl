        <oboInOwl:hasDbXref>url:https://en.wikipedia.org/wiki/Lujo_virus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pmc.ncbi.nlm.nih.gov/articles/PMC2866397/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pmc.ncbi.nlm.nih.gov/articles/PMC4230886/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/19478873/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.cdc.gov/lujo-fever/about/index.html</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050242">
        <obo:IAO_0000115 xml:lang="en">A parasitic protozoa infectious disease that involves infection of the central nervous system caused by Naegleria fowleri. The symptoms include headache, nausea, rigidity of the neck muscles, vomiting, delirium, seizures and coma.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:9554</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Naegleria fowleri infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050242</oboInOwl:id>
