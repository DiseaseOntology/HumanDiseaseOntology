    <!-- http://purl.obolibrary.org/obo/DOID_0080129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0070329"/>
        <obo:IAO_0000115 xml:lang="en">A mitochondrial DNA depletion syndrome that is characterized by onset in childhood or adulthood of progressive external ophthalmoplegia (PEO), muscle weakness and atrophy, exercise intolerance, and respiratory insufficiency due to muscle weakness, and has_material_basis_in autosomal recessive inheritance of homozygous mutation in the mitochondrial genome maintenance exonuclease 1 gene on chromosome 20p11.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:615084</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:352447</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">progressive external ophthalmoplegia-myopathy-emaciation syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080129</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">mitochondrial DNA depletion syndrome 11</rdfs:label>
    </owl:Class>
