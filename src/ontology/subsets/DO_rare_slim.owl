    <!-- http://purl.obolibrary.org/obo/DOID_0080053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4184"/>
        <obo:IAO_0000115 xml:lang="en">A pseudohypoparathyroidism that characterized by shortening and widening of long bones located_in the hand or located_in the foot along with short stature, obesity, rounded face, and lack of responsiveness to parathyroid hormone that has_material_basis_in a mutation resulting in loss of function of the Gs-alpha isoform of the GNAS gene on the maternal allele. This results in expression of the Gs-alpha protein only from the paternal allele.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7486</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:103580</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:79443</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Albright hereditary osteodystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Albright&apos;s hereditary osteodystrophy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">PHP Ia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080053</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">pseudohypoparathyroidism type 1A</rdfs:label>
    </owl:Class>
