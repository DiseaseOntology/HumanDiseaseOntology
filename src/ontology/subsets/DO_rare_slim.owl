        <oboInOwl:hasDbXref>UMLS_CUI:C0011633</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Polymyositis with skin involvement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">dermatopolymyositis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="en">Amyopathic dermatomyositis</oboInOwl:hasRelatedSynonym>
