        <oboInOwl:hasExactSynonym xml:lang="en">glycogen storage disease type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">glycogenosis type I</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">von Gierke disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">von Gierke&apos;s disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
