        <oboInOwl:hasExactSynonym xml:lang="en">2-methyl-3-hydroxybutyricacidemia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">3-ketothiolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">3-oxothiolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mitochondrial acetoacetyl-CoA Thiolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">alpha-methylacetoaceticaciduria</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">peroxisomal thiolase deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
