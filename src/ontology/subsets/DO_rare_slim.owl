        <oboInOwl:hasDbXref>UMLS_CUI:C1328840</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ALPS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Canale-Smith syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
