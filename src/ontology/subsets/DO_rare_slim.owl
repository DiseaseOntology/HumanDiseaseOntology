        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:192808003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0752347</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Dementia with Lewy bodies</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Diffuse Lewy body disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Lewy body disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Senile dementia of the Lewy body type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:12217</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
