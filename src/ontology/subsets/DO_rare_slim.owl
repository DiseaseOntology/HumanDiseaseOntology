    <!-- http://purl.obolibrary.org/obo/DOID_0070797 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070797">
        <obo:IAO_0000115 xml:lang="en">An immune system disease characterized by variable manifestations ranging from immunodeficiency, including recurrent respiratory infections and chronic fungal or viral infections often associated with lymphopenia and hypogammaglobulinemia, to features of a primary immune regulatory disorder, including autoimmunity, autoinflammation, lymphoproliferation, systemic lupus erythematosus, and EBV-associated hemophagocytic lymphohistiocytosis, that has_material_basis_in putative loss-of-function mutation in the IKZF2 gene on chromosome 2q34.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:621233</oboInOwl:hasDbXref>
