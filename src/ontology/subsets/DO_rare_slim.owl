    <!-- http://purl.obolibrary.org/obo/DOID_1562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1562">
        <obo:IAO_0000115 xml:lang="en">A subcutaneous mycosis that is a chronic subcutaneous fungal infection, which presents as nodular or verrucoid, ulcerated, or crusted skin lesions on exposed areas of skin caused by Fonsecaea pedrosoi, Fonsecaea compacta, Cladophialophora carrionii or Phialophora verrucosa. Histological examination reveals muriform cells (with perpendicular septations) or thick walled, dark-colored, rounded forms (copper pennies) that are characteristic of this infection.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:1319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B43.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:117.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002862</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:187079000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008582</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Chromomycosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mossy foot disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1562</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">chromoblastomycosis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_1562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A subcutaneous mycosis that is a chronic subcutaneous fungal infection, which presents as nodular or verrucoid, ulcerated, or crusted skin lesions on exposed areas of skin caused by Fonsecaea pedrosoi, Fonsecaea compacta, Cladophialophora carrionii or Phialophora verrucosa. Histological examination reveals muriform cells (with perpendicular septations) or thick walled, dark-colored, rounded forms (copper pennies) that are characteristic of this infection.</owl:annotatedTarget>
