        <oboInOwl:hasExactSynonym xml:lang="en">cystic leukoencephalopathy without megalencephaly</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">infantile-onset RNASET2 deficient cystic leukoencephalopathy</oboInOwl:hasExactSynonym>
