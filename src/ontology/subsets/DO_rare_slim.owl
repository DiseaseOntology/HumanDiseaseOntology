        <oboInOwl:hasExactSynonym xml:lang="en">Granulomatous Amebic Encephalitis due to Acanthamoeba</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">granulomatous amoebic encephalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050246</oboInOwl:id>
