        <oboInOwl:hasExactSynonym xml:lang="en">CTLN2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">adolescent- or adult-onset citrin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">citrin deficiency</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
