    <!-- http://purl.obolibrary.org/obo/DOID_0070531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070531">
        <obo:IAO_0000115 xml:lang="en">A retinal disease characterized by foveal hypoplasia with decreased visual acuity and nystagmus that has_material_basis_in homozygous or compound heterozygous mutation in the SLC38A8 gene on chromosome 16q23.3. Optic nerve decussation defects and anterior segment dysgenesis are also frequently seen.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:609218</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:397618</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:782754006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C5190596</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">FVH2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">foveal hypoplasia 2 with or without optic nerve misrouting and/or anterior segment dysgenesis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">FHONDA</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">FHONDA syndrome</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym xml:lang="en">foveal hypoplasia, optic nerve decussation defects, and anterior segment dysgenesis</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0070531</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:comment xml:lang="en">FHONDA syndrome refers to a subset of FVH2 with both optic nerve decussation defects and anterior segment dysgenesis. These characteristics are not sufficient for distinction from FVH2 at this time [JAB, 2024-01-23].</rdfs:comment>
        <rdfs:label xml:lang="en">foveal hypoplasia 2</rdfs:label>
        <skos:exactMatch>MIM:609218</skos:exactMatch>
        <skos:exactMatch>ORDO:397618</skos:exactMatch>
        <skos:exactMatch>SNOMEDCT_US_2023_03_01:782754006</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C5190596</skos:exactMatch>
    </owl:Class>
