    <!-- http://purl.obolibrary.org/obo/DOID_4184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4184">
        <obo:IAO_0000115 xml:lang="en">A metal metabolism disorder that is characterized by end-organ resistance to parathyroid hormone and/or a constellation of symptoms collectively termed Albright’s hereditary osteodystrophy, which include shortening and widening of long bones located_in the hand or located_in the foot along with short stature, obesity, and rounded face.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:10758</oboInOwl:hasDbXref>
