    <!-- http://purl.obolibrary.org/obo/DOID_643 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_643">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that involves reactivation of JC polyomavirus (Betapolyomavirus secuhominis) in immune-compromised individuals which causes the loss of white matter (which is made up of myelin, a substance the surrounds and protects nerve fibers) in multiple areas of the brain. The symptoms include hemiparesis, aphasia, dysarthria, hemianopia, cognitive impairment and coma.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:7468</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A81.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:046.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007968</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C26815</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:22255007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0023524</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="en">PML</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:643</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_infectious_disease_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:label xml:lang="en">progressive multifocal leukoencephalopathy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_643"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A viral infectious disease that involves reactivation of JC polyomavirus (Betapolyomavirus secuhominis) in immune-compromised individuals which causes the loss of white matter (which is made up of myelin, a substance the surrounds and protects nerve fibers) in multiple areas of the brain. The symptoms include hemiparesis, aphasia, dysarthria, hemianopia, cognitive impairment and coma.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007643"/>
