        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:27312002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0272340</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Fitzgerald trait</oboInOwl:hasExactSynonym>
