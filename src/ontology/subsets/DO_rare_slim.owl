        <oboInOwl:hasDbXref>UMLS_CUI:C0041228</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">African sleeping sickness</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">African trypanosomiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
