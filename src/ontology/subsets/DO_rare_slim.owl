        <oboInOwl:hasDbXref>MESH:D014355</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C84629</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:3386</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:77506005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0041234</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Chagas&apos; disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">chagas&apos; disease with digestive system involvement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">chagas&apos; disease with nervous system involvement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">chagas&apos; disease with other organ involvement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="en">American trypanosomiasis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:12140</oboInOwl:id>
