    <!-- http://purl.obolibrary.org/obo/DOID_0080174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080173"/>
        <obo:IAO_0000115 xml:lang="en">A bladder exstrophy-epispadias-cloacal exstrophy complex that is characterized by an evaginated bladder plate, epispadias and an anterior defect of the pelvis, pelvic floor and abdominal wall. The rear portion of the bladder wall (posterior vesical wall) turns outward (exstrophy) through an opening in the abdominal wall and urine is excreted through this opening.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:Q64.10</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:753.5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D001746</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:600057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:93930</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0080174</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">bladder exstrophy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080174"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A bladder exstrophy-epispadias-cloacal exstrophy complex that is characterized by an evaginated bladder plate, epispadias and an anterior defect of the pelvis, pelvic floor and abdominal wall. The rear portion of the bladder wall (posterior vesical wall) turns outward (exstrophy) through an opening in the abdominal wall and urine is excreted through this opening.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007636"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
