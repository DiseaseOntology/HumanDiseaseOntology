        <oboInOwl:hasDbXref>ORDO:231111</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:80258006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0263591</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">DIL</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">DILE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
