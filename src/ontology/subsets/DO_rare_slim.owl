        <oboInOwl:hasExactSynonym xml:lang="en">congenital scoliosis with unilateral unsegmented bar</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">congenital synspondylism</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">spondylocarpotarsal syndrome</oboInOwl:hasExactSynonym>
