        <oboInOwl:hasDbXref>UMLS_CUI:C1843042</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Boyadjiev-Jabs Syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">cranio-lenticulo-sutural dysplasia, CLSD</oboInOwl:hasExactSynonym>
