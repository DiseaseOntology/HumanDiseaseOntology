        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_14723"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An amino acid metabolic disorder characterized by inability to process isoleucine and ketones, has_symptom recurrent ketoacidotic attacks in infancy marked by vomiting, lethargy, dehydration, and seizures, and has_material_basis_in mutation in the ACAT1 gene of chromosome 11q22.3 responsible for producing the ACAT1 enzyme in mitochondria, which processes isoleucine and ketones.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
        <oboInOwl:hasDbXref>url:https://ghr.nlm.nih.gov/condition/beta-ketothiolase-deficiency#statistics</oboInOwl:hasDbXref>
    </owl:Axiom>
    


