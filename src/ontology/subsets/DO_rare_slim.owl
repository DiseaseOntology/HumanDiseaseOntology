    <!-- http://purl.obolibrary.org/obo/DOID_11729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11729">
        <obo:IAO_0000115 xml:lang="en">A primary bacterial infectious disease that results_in infection, has_material_basis_in Borrelia burgdorferi, which is transmitted_by blacklegged tick (Ixodes scapularis) or transmitted_by western blacklegged tick (Ixodes pacificus). The infection has_symptom fever, has_symptom headache, has_symptom fatigue, and has_symptom skin rash called erythema migrans. If left untreated, infection can spread to joints, the heart, and the nervous system.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>DOID:12233</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>GARD:12073</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A69.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:088.81</oboInOwl:hasDbXref>
