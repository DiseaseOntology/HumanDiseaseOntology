    <!-- http://purl.obolibrary.org/obo/DOID_0060366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060366">
        <obo:IAO_0000115 xml:lang="en">A lymphatic system disease characterized by he presence of intestinal lymphangiectasia, mental retardation, and characteristic facial anomalies. It is inherited in an autosomal recessive pattern. Most individuals with Hennekam syndrome have characteristic facial abnormalities, such as a flat face with accompanying puffy eyelids and hypertelorism; the nasal bridge is typically flat and the ears are typically small. Congenital extremity and genital lymphedema is present in most patients.</obo:IAO_0000115>
        <oboInOwl:creation_date>2015-09-17T16:36:59Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>GARD:3318</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C537255</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:235510</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:616006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:2136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:234146006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0340834</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Hennekam lymphangiectasia-lymphedema syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">lymphedem-lymphangiectasia-intellectual disability syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0060366</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">Hennekam syndrome</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0060366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A lymphatic system disease characterized by he presence of intestinal lymphangiectasia, mental retardation, and characteristic facial anomalies. It is inherited in an autosomal recessive pattern. Most individuals with Hennekam syndrome have characteristic facial abnormalities, such as a flat face with accompanying puffy eyelids and hypertelorism; the nasal bridge is typically flat and the ears are typically small. Congenital extremity and genital lymphedema is present in most patients.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007637"/>
