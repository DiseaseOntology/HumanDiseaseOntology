    <!-- http://purl.obolibrary.org/obo/DOID_13487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13487">
        <obo:IAO_0000115 xml:lang="en">A pervasive developmental disorder that is a rare condition characterized by late onset (greater than 3 years of age) of developmental delays in language, social function, and motor skills where children who have had previously normal development who then appear to regress.</obo:IAO_0000115>
