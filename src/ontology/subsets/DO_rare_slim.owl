    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0111260">
        <obo:IAO_0000115 xml:lang="en">An inherited metabolic disorder characterized by increased synthesis of phosphoribosylpyrophosphate resulting in increased production of uric acid and purine that has_material_basis_in X-linked recessive inheritance of mutations in PRPS1 on Xq22.3 that result in increased activity of the gene. The mild form of the disease has late-juvenile or early adult onset while the more severe form has infantile or early-childhood onset.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MESH:C567064</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:300661</oboInOwl:hasDbXref>
