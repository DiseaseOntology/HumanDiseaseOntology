    <!-- http://purl.obolibrary.org/obo/DOID_0081333 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0081333">
        <obo:IAO_0000115 xml:lang="en">A progeroid syndrome that is characterized by intrauterine growth retardation, failure to thrive, short stature, a progeroid appearance, hypotonia, and variable mental impairment and that has_material_basis_in compound heterozygous mutation in the POLR3A gene on chromosome 10q22.</obo:IAO_0000115>
