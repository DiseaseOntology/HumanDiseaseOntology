    <!-- http://purl.obolibrary.org/obo/DOID_0080163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0061170"/>
        <obo:IAO_0000115 xml:lang="en">An autoinflammation, panniculitis, and dermatosis syndrome characterized by neonatal onset of recurrent fever, erythematous rash with painful nodules, painful joints, and lipodystrophy and has_material_basis_in homozygous or compound heterozygous loss-of-function mutation in the OTULIN gene on chromosome 5p15.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:13198</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIM:617099</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C174441</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:500062</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2025_09_01:765435009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C4310614</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">ORAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OTULIN-related autoinflammatory syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">otulipenia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="en">autoinflammation, panniculitis and dermatosis syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:0080163</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#NCIthesaurus"/>
        <rdfs:comment xml:lang="en">In 2024, patients with an autosomal dominant ORAS-like disease were identified. The terms OTULIN-related autoinflammatory syndrome (ORAS) and otulipenia have thus far referred only to this autosomal recessive form, but may become more generally used to mean both inherited forms [JAB, 2025-07-31].</rdfs:comment>
        <rdfs:label xml:lang="en">autosomal recessive autoinflammation, panniculitis, and dermatosis syndrome</rdfs:label>
        <skos:exactMatch>GARD:13198</skos:exactMatch>
        <skos:exactMatch>MIM:617099</skos:exactMatch>
        <skos:exactMatch>NCI:C174441</skos:exactMatch>
        <skos:exactMatch>ORDO:500062</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C4310614</skos:exactMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080163"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An autoinflammation, panniculitis, and dermatosis syndrome characterized by neonatal onset of recurrent fever, erythematous rash with painful nodules, painful joints, and lipodystrophy and has_material_basis_in homozygous or compound heterozygous loss-of-function mutation in the OTULIN gene on chromosome 5p15.</owl:annotatedTarget>
        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007645"/>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/27523608</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/27559085</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.nih.gov/news-events/news-releases/nih-researchers-discover-otulipenia-new-inflammatory-disease</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget xml:lang="en">ORAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080163"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget xml:lang="en">autoinflammation, panniculitis and dermatosis syndrome</owl:annotatedTarget>
        <rdfs:comment>Initially, this term was used only for the autosomal recessive disease but, in 2024, a new autosomal dominant form was identified and its use broadened to encompass both [JAB, 2025-07-31].</rdfs:comment>
    </owl:Axiom>
    


