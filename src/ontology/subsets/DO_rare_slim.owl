        <oboInOwl:hasDbXref>UMLS_CUI:C0020413</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Hymenolepis infectious disease</oboInOwl:hasExactSynonym>
