    <!-- http://purl.obolibrary.org/obo/DOID_12926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12926">
        <obo:IAO_0000115 xml:lang="en">A myiasis that involves parasitic infestation of warble flies of the genus Hypoderma, on cattle and deer and Dermatobia hominis on humans. The larvae of human botfly, Dermatobia hominis, feed in a subdermal cavity causing cutaneous swellings on the body or scalp that may produce discharges and be painful.</obo:IAO_0000115>
