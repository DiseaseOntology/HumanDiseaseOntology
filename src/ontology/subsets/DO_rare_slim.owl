    <!-- http://purl.obolibrary.org/obo/DOID_5213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_5213">
        <obo:IAO_0000115 xml:lang="en">An autoimmune disease of peripheral nervous system that is characterized by inflammation of nerve roots and peripheral nerves and destruction of the fatty protective covering (myelin sheath) over the nerves. This affects how fast the nerve signals are transmitted and leads to loss of nerve fibers.</obo:IAO_0000115>
