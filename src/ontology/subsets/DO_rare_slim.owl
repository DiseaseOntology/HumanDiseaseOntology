        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050794"/>
        <obo:IAO_0000115 xml:lang="en">A multiple synostoses syndrome is characterized by multiple joint fusions, usually commencing in the hands, conductive deafness, and characteristic facial features, including a broad, tubular-shaped nose and a thin upper vermilion and that has_material_basis_in heterozygous mutation in the NOG gene on chromosome 17q22.</obo:IAO_0000115>
