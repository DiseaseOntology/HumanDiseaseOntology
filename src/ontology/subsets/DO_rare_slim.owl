    <!-- http://purl.obolibrary.org/obo/DOID_0070473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070473">
        <obo:IAO_0000115 xml:lang="en">A syndrome characterized by developmental delay, progressive microcephaly, short stature, and dysmorphic features including sparse scalp hair, cupped ears, wide nose and mouth, short philtrum, and high-arched palate that has_material_basis_in homozygous or compound heterozygous mutation in the WLS gene on chromosome 1p31.3. Additional variable features may include ocular, skeletal, cardiac, and renal anomalies.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MIM:619648</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
