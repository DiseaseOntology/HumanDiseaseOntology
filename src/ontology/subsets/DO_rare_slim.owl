    <!-- http://purl.obolibrary.org/obo/DOID_10223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10223">
        <obo:IAO_0000115 xml:lang="en">A myositis that results_in inflammation located_in muscle or located_in skin where a skin rash is often seen prior to the onset of muscle weakness. The disease may result from either a viral infection or an autoimmune reaction.</obo:IAO_0000115>
