    <!-- http://purl.obolibrary.org/obo/DOID_12205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12205">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results in infection, has_material_basis_in Dengue virus (Orthoflavivirus denguei), which are transmitted by Aedes mosquito bite. The infection has symptom fever, has symptom severe headache, has symptom severe pain behind the eyes, has symptom joint pain, has symptom muscle and bone pain, has symptom rash, and has symptom mild bleeding.</obo:IAO_0000115>
