    <!-- http://purl.obolibrary.org/obo/DOID_6688 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_6688">
        <obo:IAO_0000115 xml:lang="en">A hypersensitivity reaction type IV disease that is an inherited disorder in which the body cannot properly regulate the number of immune system cells (lymphocytes). It is characterized by the production of an abnormally large number of lymphocytes. Accumulation of excess lymphocytes results in enlargement of the lymph nodes, the liver, and the spleen.</obo:IAO_0000115>
