        <oboInOwl:hasExactSynonym xml:lang="en">JEN-nH</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">generalized atrophic benign epidermolysis bullosa</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">generalized junctional epidermolysis bullosa, non-Herlitz type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">junctional epidermolysis bullosa generalisata mitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">junctional epidermolysis bullosa, Disentis type</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
