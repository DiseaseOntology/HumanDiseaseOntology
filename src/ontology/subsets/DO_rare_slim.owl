    <!-- http://purl.obolibrary.org/obo/DOID_0050266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050266">
        <obo:IAO_0000115 xml:lang="en">A parasitic ectoparasitic infectious disease that is an inflammatory skin disease caused by the parasitic infestation of the female chigoe flea, Tunga penetrans in animals and humans. The symptoms include skin inflammation, severe pain, itching, and a lesion at the site of infection that is characterized by a black dot at the center of a swollen red lesion, surrounded a white halo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GARD:393</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D058285</oboInOwl:hasDbXref>
