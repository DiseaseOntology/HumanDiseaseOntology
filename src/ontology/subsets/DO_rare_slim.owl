    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14464">
        <obo:IAO_0000115 xml:lang="en">A nervous system disease that is characterized by hyperthermia, muscular rigidity, autonomic dysfunction and altered consciousness and is associated with administration of antipsychotic and other central dopaminergic blockers.</obo:IAO_0000115>
