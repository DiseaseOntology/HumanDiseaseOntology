        <dc:type rdf:resource="http://purl.obolibrary.org/obo/ECO_0007638"/>
        <oboInOwl:hasDbXref>url:http://en.wikipedia.org/wiki/Albright%27s_hereditary_osteodystrophy</oboInOwl:hasDbXref>
