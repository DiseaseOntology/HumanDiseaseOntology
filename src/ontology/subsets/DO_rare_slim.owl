    <!-- http://purl.obolibrary.org/obo/DOID_10074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10074">
        <obo:IAO_0000115 xml:lang="en">A parasitic helminthiasis infectious disease that involves infection of the bowel by Hymenolepis nana or Hymenolepis diminuta. The symptoms include diarrhea, gastrointestinal discomfort, itchy anus, poor appetite and weakness.</obo:IAO_0000115>
