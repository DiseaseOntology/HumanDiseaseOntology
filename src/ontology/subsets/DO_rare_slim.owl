    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060558">
        <obo:IAO_0000115 xml:lang="en">A syndrome characterized by congenital nonprogressive joint contractures. The contractures can involve the upper or lower limbs and/or the vertebral column, leading to various degrees of flexion or extension limitations evident at birth.</obo:IAO_0000115>
