    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12859">
        <obo:IAO_0000115 xml:lang="en">A movement disease characterized by brief, semi-directed, irregular movements that not repetitive or rhythmic, but appear to flow from one muscle to the next.</obo:IAO_0000115>
