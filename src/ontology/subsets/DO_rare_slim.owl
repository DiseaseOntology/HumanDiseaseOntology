        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0081388"/>
        <obo:IAO_0000115 xml:lang="en">A primary progressive aphasia that is characterized by the progressive, amodal and profound loss of semantic knowledge and behavioral abnormalities, attributable to the degeneration of the anterior temporal lobes.</obo:IAO_0000115>
