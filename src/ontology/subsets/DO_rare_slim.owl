        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">Ehlers-Danlos syndrome periodontal type 1</rdfs:label>
        <skos:broadMatch>GARD:12474</skos:broadMatch>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/DOID_0080986"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">An Ehlers-Danlos syndrome that is characterized by an Ehlers-Danlos syndrome phenotype combined with severe periodontal inflammation and that has_material_basis_in heterozygous mutation in the C1R gene on chromosome 12p13.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>url:https://pubmed.ncbi.nlm.nih.gov/27745832/</oboInOwl:hasDbXref>
    </owl:Axiom>
    


