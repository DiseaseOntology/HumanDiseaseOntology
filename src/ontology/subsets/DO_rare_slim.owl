        <rdfs:comment xml:lang="en">MeSH obsoleted this term and ID, merged with parent term.[LS]</rdfs:comment>
        <rdfs:label xml:lang="en">pseudohypoparathyroidism type 1B</rdfs:label>
    </owl:Class>
