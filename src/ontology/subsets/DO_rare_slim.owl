    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4837">
        <obo:IAO_0000115 xml:lang="en">A syndrome that is characterized by bone loss (osteolysis) which is often associated with swelling or abnormal blood vessel growth (angiomatous proliferation). Bone loss can occur in just one bone or spread to soft tissue and adjacent bones.</obo:IAO_0000115>
