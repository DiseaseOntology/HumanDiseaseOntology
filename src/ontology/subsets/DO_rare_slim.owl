    <!-- http://purl.obolibrary.org/obo/DOID_4953 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_4953">
        <obo:IAO_0000115 xml:lang="en">A viral infectious disease that results in destruction located in motor neurons and has_material_basis_in Human poliovirus 1, 2, or 3, serotypes of Enterovirus coxsackiepol, which are transmitted by ingestion of food or water contaminated with feces, or transmitted by direct contact with the oral secretions. The infection has symptom fever, has symptom sore throat, has symptom headache, has symptom vomiting, has symptom fatigue, has symptom neck stiffness, has symptom muscle spasms, and has symptom acute flaccid paralysis.</obo:IAO_0000115>
