        <oboInOwl:hasExactSynonym xml:lang="en">MAA2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">MCOPS2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OFCD syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">cataract-microphthalmia-radiculomegaly-cardiac septal defect syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">microphthalmia cataracts radiculomegaly and septal heart defects</oboInOwl:hasExactSynonym>
