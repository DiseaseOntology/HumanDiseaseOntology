    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12900">
        <obo:IAO_0000115 xml:lang="en">An autoimmune disease that is characterized by chronic enlargement of the glands of the head and neck, has_symptom lumps of the face and neck, dry eyes, dry mouth, and intermittent fever, and is often associated with an underlying autoimmune disorder, hematologic malignancy, tuberculosis infection, or syphilis infection.</obo:IAO_0000115>
