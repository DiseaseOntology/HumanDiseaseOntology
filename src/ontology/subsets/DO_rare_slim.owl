        <oboInOwl:hasExactSynonym xml:lang="en">Spinal muscular atrophy 1</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">hereditary motor neuropathy proximal type I</oboInOwl:hasExactSynonym>
