    <!-- http://purl.obolibrary.org/obo/DOID_0070783 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070783">
        <obo:IAO_0000115 xml:lang="en">A generalized epilepsy characterized by partial epilepsy, with onset usually early in the first decade of life, that evolves to include complex partial seizures and secondary generalized tonic-clonic seizures associated with focal, and sometimes diffuse, EEG abnormalities that has_material_basis_in compound heterozygous mutation in the ZFHX3 gene on chromosome 16q22.</obo:IAO_0000115>
