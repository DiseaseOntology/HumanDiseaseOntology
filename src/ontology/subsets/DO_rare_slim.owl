        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/doid#DO_rare_slim"/>
        <rdfs:label xml:lang="en">Ehlers-Danlos syndrome spondylodysplastic type 1</rdfs:label>
        <skos:exactMatch>ORDO:75496</skos:exactMatch>
        <skos:exactMatch>UMLS_CUI:C4552003</skos:exactMatch>
    </owl:Class>
