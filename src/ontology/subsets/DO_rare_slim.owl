    <!-- http://purl.obolibrary.org/obo/DOID_0050485 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050485">
        <obo:IAO_0000115 xml:lang="en">A primary bacterial infectious disease that results_in infection, has_material_basis_in Neorickettsia sennetsu, which is transmitted_by ingestion of raw or under-cooked gray mullet fish infected with the trematodes. The infection has_symptom fever, has_symptom malaise, has_symptom anorexia, has_symptom lymphadenopathy, has_symptom hepatosplenomegaly, has_symptom fatigue, has_symptom chills, has_symptom headache, has_symptom backache and has_symptom myalgia.</obo:IAO_0000115>
