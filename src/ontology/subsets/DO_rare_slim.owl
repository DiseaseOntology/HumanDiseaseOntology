        <oboInOwl:hasDbXref>url:https://rarediseases.org/rare-diseases/bladder-exstrophy-epispadias-cloacal-exstrophy-complex/</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/21929991</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>url:https://www.ncbi.nlm.nih.gov/pubmed/22055685</oboInOwl:hasDbXref>
    </owl:Axiom>
    


