    <!-- http://purl.obolibrary.org/obo/DOID_0060858 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060858">
        <obo:IAO_0000115 xml:lang="en">A syndrome that has_material_basis_in homozygous deletion on chromosome 2p21 that disrupts the SLC3A1 and PREPL genes. The deletion ranges in size from 23.8 to 75.5 kb. Itis characterized_by neonatal and infantile hypotonia and failure to thrive, cystinuria type 1 and nephrolithiasis, growth retardation due to growth hormone deficiency, and minor facial dysmorphism.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD10CM:E72.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:C564710</oboInOwl:hasDbXref>
